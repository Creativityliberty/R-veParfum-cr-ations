      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Star, \n  MessageSquare, \n  Plus, \n  Check, \n  Award, \n  Sparkles, \n  Facebook, \n  Instagram, \n  Smartphone, \n  Send, \n  Heart, \n  ShieldCheck, \n  ArrowRight,\n  MessageCircle,\n  Clock,\n  ThumbsUp,\n  UserCheck\n} from \'lucide-react\';\nimport { Review } from \'../types\';\nimport { REVIEWS } from \'../data\';\n\ninterface ReviewSectionProps {\n  onAddReviewNotification?: (text: string) => void;\n  onNavigateToBoutique?: () => void;\n  onNavigateToQuiz?: () => void;\n}\n\nexport default function ReviewSection({ \n  onAddReviewNotification, \n  onNavigateToBoutique,\n  onNavigateToQuiz\n}: ReviewSectionProps) {\n  const [reviewsList, setReviewsList] = useState<Review[]>(REVIEWS);\n  const [authorName, setAuthorName] = useState(\"\");\n  const [rating, setRating] = useState(5);\n  const [reviewTxt, setReviewTxt] = useState(\"\");\n  const [source, setSource] = useState<\'Facebook\' | \'Messenger\' | \'Client\' | \'Google\'>(\'Client\');\n  const [submitted, setSubmitted] = useState(false);\n  const [selectedScreenshotId, setSelectedScreenshotId] = useState<number | null>(null);\n\n  // Styled mock screen captures of reviews for the gallery (confidentiality respected)\n  const mockScreenshots = [\n    {\n      id: 1,\n      author: \"Marie-Laure V.\",\n      source: \"Facebook\",\n      date: \"Command\303\251 en Avril 2026\",\n      text: \"Le coulage est hyper soign\303\251, c\'est un travail colossal ! Les fleurs s\303\251ch\303\251es sont parfaitement incrust\303\251es sur le cadre parfum\303\251. L\'Atelier R\303\252ve a tout mon respect.\",\n      product: \"Cadre parfum\303\251 aux fleurs d\'oranger\",\n      avatarBg: \"bg-purple-950\",\n      avatarColor: \"text-purple-200\"\n    },\n    {\n      id: 2,\n      author: \"Julien R.\",\n      source: \"Messenger\",\n      date: \"Command\303\251 en Mai 2026\",\n      text: \"Un grand merci \303\240 M\303\251lanie pour ses pr\303\251cieux conseils olfactifs. Les petits fondants au Caramel Beurre Sal\303\251 embaument toute notre entr\303\251e en quelques minutes seulement !\",\n      product: \"Fondant Caramel\",\n      avatarBg: \"bg-rose-950\",\n      avatarColor: \"text-rose-200\"\n    },\n    {\n      id: 3,\n      author: \"Sarah L.\",\n      source: \"Instagram DM\",\n      date: \"Command\303\251 en F\303\251vrier 2026\",\n      text: \"La m\303\250che en bois qui cr\303\251pite doucement, c\'est tellement relaxant. Notre salon de Bourgogne se transforme en cocon d\'h\303\264tel 5 \303\251toiles. H\303\242te de recommander cet automne !\",\n      product: \"Bougie C\303\251ramique Divine\",\n      avatarBg: \"bg-amber-950\",\n      avatarColor: \"text-amber-200\"\n    },\n    {\n      id: 4,\n      author: \"Camilia de Dijon\",\n      source: \"Facebook Group\",\n      date: \"Command\303\251 en Mars 2026\",\n      text: \"Toutes nos amies ont \303\251t\303\251 charm\303\251es par les petites attentions personnalis\303\251es lors de la baby shower. Le parfum de fleur de cerisier est d\'une d\303\251licatesse absolue.\",\n      product: \"Miniature \303\211v\303\251nementielle\",\n      avatarBg: \"bg-cyan-950\",\n      avatarColor: \"text-cyan-200\"\n    }\n  ];\n\n  const handleReviewSubmission = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!authorName.trim() || !reviewTxt.trim()) return;\n\n    const newReview: Review = {\n      id: `review-custom-${Date.now()}`,\n      author: authorName,\n      rating: rating,\n      text: reviewTxt,\n      date: \"Aujourd\'hui\",\n      source: source,\n      avatar: undefined\n    };\n\n    setReviewsList([newReview, ...reviewsList]);\n    setSubmitted(true);\n    setAuthorName(\"\");\n    setReviewTxt(\"\");\n    setRating(5);\n\n    if (onAddReviewNotification) {\n      onAddReviewNotification(\"Merci. Votre magnifique t\303\251moignage a \303\251t\303\251 simul\303\251 et ajout\303\251 avec succ\303\250s au catalogue.\");\n    }\n\n    setTimeout(() => {\n      setSubmitted(false);\n    }, 4000);\n  };\n\n  const getSourceIcon = (src: string) => {\n    switch (src) {\n      case \'Facebook\':\n        return <Facebook className=\"w-3.5 h-3.5 text-blue-400 shrink-0\" />;\n      case \'Messenger\':\n        return <MessageCircle className=\"w-3.5 h-3.5 text-cyan-400 shrink-0\" />;\n      case \'Instagram DM\':\n        return <Instagram className=\"w-3.5 h-3.5 text-pink-400 shrink-0\" />;\n      case \'Google\':\n        return <Award className=\"w-3.5 h-3.5 text-amber-400 shrink-0\" />;\n      default:\n        return <Smartphone className=\"w-3.5 h-3.5 text-brand-pink shrink-0\" />;\n    }\n  };\n\n  // Stagger wrapper for beautiful entrance animations\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    show: {\n      opacity: 1,\n      transition: {\n        staggerChildren: 0.08\n      }\n    }\n  };\n\n  const itemVariants = {\n    hidden: { opacity: 0, y: 15 },\n    show: { opacity: 1, y: 0, transition: { type: \"spring\", stiffness: 100 } }\n  };\n\n  return (\n    <div className=\"space-y-20 pt-4\">\n      \n      {/* 1. HERO AVIS */}\n      <section className=\"text-center space-y-6 relative max-w-3xl mx-auto py-10\">\n        <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-48 h-48 bg-brand-pink/10 rounded-full blur-[60px] pointer-events-none\" />\n        \n        <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-pink/10 border border-brand-pink/20 text-brand-pink text-xs font-mono font-bold uppercase tracking-widest leading-none\">\n          <Award className=\"w-3.5 h-3.5 text-brand-pink\" />\n          Retours clients &amp; Confiance\n        </div>\n\n        <h1 className=\"text-4xl md:text-6xl font-serif font-bold text-brand-cream tracking-tight leading-tight\">\n          Vos mots doux sur nos <span className=\"font-light italic text-brand-purple\">cr\303\251ations</span>\n        </h1>\n\n        <p className=\"text-sm md:text-base text-brand-text-muted max-w-xl mx-auto leading-relaxed\">\n          Merci du fond du c\305\223ur \303\240 notre merveilleuse communaut\303\251 pour vos messages, vos t\303\251moignages spontan\303\251s et la confiance que vous accordez \303\240 notre atelier bourguignon.\n        </p>\n\n        <div className=\"flex flex-wrap items-center justify-center gap-4 pt-4\">\n          <a\n            href=\"#laisser-avis\"\n            className=\"px-6 py-3 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md flex items-center gap-1.5 cursor-pointer\"\n          >\n            <MessageSquare className=\"w-4 h-4\" />\n            Laisser un avis pr\303\251cieux\n          </a>\n          <button\n            onClick={onNavigateToBoutique}\n            className=\"px-6 py-3 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 font-bold text-xs tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer\"\n          >\n            D\303\251couvrir l\'Atelier\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </section>\n\n      {/* STATS OVERVIEW */}\n      <section className=\"grid grid-cols-1 md:grid-cols-3 gap-6 relative\">\n        <div className=\"bg-brand-depth border border-brand-pink/10 rounded-2xl p-6 text-center shadow-lg relative overflow-hidden group\">\n          <div className=\"absolute top-2 right-2 opacity-5\">\n            <Star className=\"w-24 h-24 text-brand-pink\" />\n          </div>\n          <span className=\"block text-4xl md:text-5xl font-serif font-bold text-brand-pink mb-1\">4.9/5</span>\n          <div className=\"flex justify-center my-2 text-amber-300 gap-0.5\">\n            {[...Array(5)].map((_, i) => <Star key={i} className=\"w-4 h-4 fill-amber-300 text-amber-300\" />)}\n          </div>\n          <p className=\"text-[10px] text-brand-text-muted mt-2 font-mono uppercase tracking-widest\">Note moyenne globale</p>\n        </div>\n\n        <div className=\"bg-brand-depth border border-brand-pink/10 rounded-2xl p-6 text-center shadow-lg relative overflow-hidden group\">\n          <div className=\"absolute top-2 right-2 opacity-5\">\n            <Award className=\"w-24 h-24 text-brand-pink\" />\n          </div>\n          <span className=\"block text-4xl md:text-5xl font-serif font-bold text-brand-pink mb-1\">100%</span>\n          <div className=\"flex justify-center my-2 text-brand-pink\">\n            <UserCheck className=\"w-6 h-6\" />\n          </div>\n          <p className=\"text-[10px] text-brand-text-muted mt-2 font-mono uppercase tracking-widest\">Client\303\250les rachetantes &amp; satisfied</p>\n        </div>\n\n        <div className=\"bg-brand-depth border border-brand-pink/10 rounded-2xl p-6 text-center shadow-lg relative overflow-hidden group\">\n          <div className=\"absolute top-2 right-2 opacity-5\">\n            <Sparkles className=\"w-24 h-24 text-brand-pink\" />\n          </div>\n          <span className=\"block text-4xl md:text-5xl font-serif font-bold text-brand-pink mb-1\">Cire Saine</span>\n          <div className=\"flex justify-center my-2 text-brand-purple\">\n            <Sparkles className=\"w-6 h-6 animate-pulse\" />\n          </div>\n          <p className=\"text-[10px] text-brand-text-muted mt-2 font-mono uppercase tracking-widest\">Cire de soja bio-qualifi\303\251e &amp; saine</p>\n        </div>\n      </section>\n\n      {/* 2. GRILLE D\'AVIS PRINCIPALS */}\n      <section className=\"space-y-8\">\n        <div className=\"text-left border-b border-brand-pink/10 pb-4 flex flex-col md:flex-row justify-between items-start md:items-end gap-4\">\n          <div>\n            <span className=\"text-xs font-mono font-semibold uppercase tracking-widest text-brand-pink block mb-1\">T\303\251moignages</span>\n            <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n              Fiches de retours d\303\251taill\303\251es\n            </h2>\n          </div>\n          <p className=\"text-xs text-brand-text-muted max-w-sm font-mono tracking-wide leading-relaxed\">\n            Les t\303\251moignages de dur\303\251es de fragrances ou d\'ambiance peuvent varier agr\303\251ablement d\'un int\303\251rieur \303\240 un autre.\n          </p>\n        </div>\n\n        <motion.div \n          variants={containerVariants}\n          initial=\"hidden\"\n          whileInView=\"show\"\n          viewport={{ once: true, margin: \"-100px\" }}\n          className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\"\n        >\n          {reviewsList.map((rev) => (\n            <motion.div \n              key={rev.id}\n              variants={itemVariants}\n              className=\"bg-brand-depth/35 border border-brand-pink/10 rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden group hover:border-brand-pink/30 hover:bg-brand-depth/50 transition-all duration-300\"\n            >\n              {/* Source stamp */}\n              <div className=\"absolute top-4 right-4 py-1 px-2.5 rounded-full bg-brand-bg border border-brand-pink/5 text-[10px] font-mono tracking-widest uppercase flex items-center gap-1.5 text-brand-text-muted\">\n                {getSourceIcon(rev.source)}\n                {rev.source}\n              </div>\n\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center gap-3\">\n                  {rev.avatar ? (\n                    <img \n                      src={rev.avatar} \n                      alt={rev.author} \n                      className=\"w-10 h-10 rounded-full object-cover border border-brand-pink/15\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  ) : (\n                    <div className=\"w-10 h-10 rounded-full bg-brand-pink/10 text-brand-pink flex items-center justify-center font-bold text-sm border border-brand-pink/20\">\n                      {rev.author[0]}\n                    </div>\n                  )}\n                  <div>\n                    <h4 className=\"font-semibold text-brand-cream text-xs tracking-wide\">{rev.author}</h4>\n                    <span className=\"text-[9px] text-brand-text-muted font-mono block\">{rev.date}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex text-amber-300 gap-0.5\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star \n                      key={i} \n                      className={`w-3.5 h-3.5 ${i < rev.rating ? \'fill-amber-300 ml-0.5 text-amber-300\' : \'text-gray-600\'}`} \n                    />\n                  ))}\n                </div>\n\n                <p className=\"text-xs text-brand-text-muted leading-relaxed italic pr-2 font-light\">\n                  \"{rev.text}\"\n                </p>\n              </div>\n\n              <div className=\"mt-4 pt-3 border-t border-brand-pink/5 flex justify-between items-center text-[10px] font-mono text-brand-pink/70\">\n                <span className=\"flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-3.5 h-3.5 text-brand-pink\" />\n                  Avis V\303\251rifi\303\251 \n                </span>\n                <span className=\"text-[9px] text-brand-text-muted/60\">Bourgogne Artisanat</span>\n              </div>\n            </motion.div>\n          ))}\n        </motion.div>\n      </section>\n\n      {/* 3. BLOC SP\303\211CIAL \"SENTEUR DURABLE\" */}\n      <section className=\"relative overflow-hidden rounded-3xl p-1 md:p-0\">\n        <div className=\"absolute top-0 right-0 w-80 h-80 bg-brand-purple/5 rounded-full blur-[100px] pointer-events-none\" />\n        <div className=\"liquid-strong p-8 md:p-12 rounded-3xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center text-left\">\n          <div className=\"lg:col-span-8 space-y-4\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-purple/10 border border-brand-purple/20 text-brand-purple text-[10px] font-mono font-bold uppercase tracking-widest\">\n              <Clock className=\"w-3 h-3\" />\n              Senteurs persistantes &amp; Curation saine\n            </span>\n            <h3 className=\"text-2xl md:text-4xl font-serif font-bold text-brand-cream\">\n              Des fragrances qui impr\303\250gnent vos pr\303\251cieux souvenirs\n            </h3>\n            <p className=\"text-xs md:text-sm text-brand-text-muted leading-relaxed font-light\">\n              De nombreuses clientes r\303\251guli\303\250res nous ont confi\303\251 que leurs fondants fleurant bon le dessert ou leurs bouquets de rotin parfumaient subtilement leur espace de vie pendant plusieurs semaines, voire des mois complets. Chaque int\303\251rieur poss\303\250de ses propres dynamiques de temp\303\251rature et de courants d\'air, mais notre s\303\251lection exclusive d\'huiles de Grasse garantit une tenue noble.\n            </p>\n          </div>\n          <div className=\"lg:col-span-4 flex justify-start lg:justify-end\">\n            <button\n              onClick={onNavigateToQuiz}\n              className=\"px-6 py-3.5 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md flex items-center gap-2 cursor-pointer w-full justify-center lg:w-auto\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              Prendre le Guide Senteurs\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* 4. GRILLE CAPTURES D\'\303\211CRAN / MOCK UPS DE DISCUSSIONS */}\n      <section className=\"space-y-8\">\n        <div className=\"text-center space-y-2\">\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Instants partag\303\251s &amp; Messages d\'encouragement\n          </h2>\n          <p className=\"text-xs text-brand-text-muted max-w-xl mx-auto\">\n            Nous pr\303\251servons scrupuleusement la confidentialit\303\251 de nos clients. Voici des reconstitutions haute-fid\303\251lit\303\251 de messages r\303\251els re\303\247us sur notre messagerie Instagram, Facebook ou par SMS.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {mockScreenshots.map((item) => (\n            <div \n              key={item.id}\n              className=\"p-6 bg-brand-depth/40 border border-brand-pink/10 rounded-2xl text-left space-y-4 relative hover:border-brand-pink/20 transition-all cursor-pointer\"\n              onClick={() => setSelectedScreenshotId(item.id)}\n            >\n              <div className=\"flex items-center justify-between border-b border-brand-pink/5 pb-3\">\n                <div className=\"flex items-center gap-2.5\">\n                  <div className={`w-9 h-9 rounded-full ${item.avatarBg} ${item.avatarColor} flex items-center justify-center font-bold text-xs`}>\n                    {item.author[0]}\n                  </div>\n                  <div>\n                    <h4 className=\"text-xs font-semibold text-brand-cream\">{item.author}</h4>\n                    <span className=\"text-[9px] text-brand-text-muted/75 font-mono\">{item.date}</span>\n                  </div>\n                </div>\n                <span className=\"text-[10px] font-mono uppercase bg-brand-bg/50 px-2.5 py-1 rounded-full border border-brand-pink/5 text-brand-pink flex items-center gap-1\">\n                  {getSourceIcon(item.source)}\n                  {item.source}\n                </span>\n              </div>\n\n              <div className=\"relative pl-3 border-l-2 border-brand-purple/20\">\n                <p className=\"text-xs text-brand-text-muted italic leading-relaxed font-light\">\n                  \"{item.text}\"\n                </p>\n              </div>\n\n              <div className=\"flex justify-between items-center pt-2\">\n                <span className=\"text-[9px] font-mono text-brand-pink/80 bg-brand-pink/5 px-2 py-0.5 rounded\">\n                  Fiche commande : {item.product}\n                </span>\n                <span className=\"text-[10px] text-brand-purple font-mono flex items-center gap-1\">\n                  <ThumbsUp className=\"w-3 h-3\" />\n                  Priv\303\251 &amp; Prot\303\251g\303\251\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 5. SECTION LAISSER UN AVIS */}\n      <section id=\"laisser-avis\" className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\">\n        \n        {/* Intro column */}\n        <div className=\"lg:col-span-4 space-y-6 text-left\">\n          <div className=\"space-y-3\">\n            <h3 className=\"text-2xl font-serif font-bold text-brand-cream\">\n              Votre recommandation illumine notre travail\n            </h3>\n            <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n              R\303\252ve Parfum\303\251 Cr\303\251ation est une aventure humaine artisanale con\303\247ue par Christelle et M\303\251lanie. Votre soutien, vos conseils et vos gentils commentaires nous aident \303\240 nous faire conna\303\256tre et \303\240 continuer \303\240 couler de superbes cires saines.\n            </p>\n          </div>\n\n          <div className=\"space-y-4\">\n            <span className=\"block text-xs uppercase font-mono tracking-wider font-bold text-brand-pink\">\n              Canaux d\'avis officiels :\n            </span>\n            <div className=\"space-y-2.5\">\n              <a \n                href=\"https://facebook.com\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"w-full p-4 rounded-xl bg-brand-depth hover:bg-brand-pink/10 border border-brand-pink/10 hover:border-brand-pink/30 flex items-center justify-between text-xs transition-all cursor-pointer group\"\n              >\n                <span className=\"flex items-center gap-2 font-medium text-brand-cream\">\n                  <Facebook className=\"w-4 h-4 text-brand-pink shrink-0\" />\n                  Page Facebook Officielle\n                </span>\n                <ArrowRight className=\"w-4 h-4 text-brand-pink group-hover:translate-x-1 transition-transform\" />\n              </a>\n              <div \n                className=\"w-full p-4 rounded-xl bg-brand-depth/40 border border-brand-pink/15 flex items-center justify-between text-xs select-none\"\n                title=\"Bient\303\264t disponible\"\n              >\n                <span className=\"flex items-center gap-2 font-medium text-brand-text-muted/60\">\n                  <Award className=\"w-4 h-4 text-brand-text-muted/50 shrink-0\" />\n                  Fiche Google Business\n                </span>\n                <span className=\"text-[9px] font-mono px-2 py-0.5 rounded bg-brand-bg text-brand-text-muted uppercase\">Bient\303\264t</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Form Column */}\n        <div className=\"lg:col-span-8 bg-brand-depth border border-brand-pink/15 rounded-3xl p-6 md:p-8 space-y-6 text-left\">\n          <div>\n            <span className=\"block text-xs font-mono text-brand-pink tracking-widest uppercase mb-1\">Formulaire</span>\n            <h4 className=\"text-lg font-serif font-bold text-brand-cream\">\n              Simuler l\'envoi d\'un avis de cire\n            </h4>\n            <p className=\"text-xs text-brand-text-muted\">\n              Postez votre exp\303\251rience directement via notre formulaire de d\303\251monstration. L\'avis s\'affichera directement sur cette session pour embellir notre boutique !\n            </p>\n          </div>\n\n          <form onSubmit={handleReviewSubmission} className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Votre Pr\303\251nom / Nom</label>\n                <input \n                  type=\"text\" \n                  required\n                  placeholder=\"Ex: Sophie de Bourgogne\"\n                  value={authorName}\n                  onChange={(e) => setAuthorName(e.target.value)}\n                  className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Senteur pr\303\251f\303\251r\303\251e \303\251valu\303\251e</label>\n                <select\n                  value={source}\n                  onChange={(e) => setSource(e.target.value as any)}\n                  className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                >\n                  <option value=\"Client\">Parcours Client G\303\251n\303\251ral</option>\n                  <option value=\"Facebook\">Post sur notre Facebook</option>\n                  <option value=\"Messenger\">Retour par Messenger priv\303\251</option>\n                  <option value=\"Google\">Session Directe</option>\n                </select>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-2\">Votre note d\'appr\303\251ciation</label>\n              <div className=\"flex items-center gap-1\">\n                {[1, 2, 3, 4, 5].map((num) => (\n                  <button\n                    key={num}\n                    type=\"button\"\n                    onClick={() => setRating(num)}\n                    className=\"p-1 focus:outline-none cursor-pointer group transition-transform hover:scale-110\"\n                  >\n                    <Star className={`w-6 h-6 transition-all ${num <= rating ? \'fill-amber-300 text-amber-300\' : \'text-gray-600\'}`} />\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Votre texte de retour libre</label>\n              <textarea \n                required\n                placeholder=\"Partagez votre ressenti sur la texture de la cire, l\'\303\251l\303\251gance du parfum de Grasse ou le superbe contact avec M\303\251lanie et Christelle...\"\n                value={reviewTxt}\n                onChange={(e) => setReviewTxt(e.target.value)}\n                className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors min-h-[120px]\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3.5 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-1.5 shadow-md cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              Soumettre notre avis sur l\'atelier\n            </button>\n          </form>\n\n          {/* Submitted notification toast simulated */}\n          <AnimatePresence>\n            {submitted && (\n              <motion.div \n                initial={{ opacity: 0, scale: 0.95 }}\n                animate={{ opacity: 1, scale: 1 }}\n                exit={{ opacity: 0, scale: 0.95 }}\n                className=\"p-4 rounded-xl bg-brand-pink/10 border border-brand-pink/30 text-center text-xs text-brand-pink flex items-center justify-center gap-1.5\"\n              >\n                <Check className=\"w-4 h-4\" />\n                Votre note a \303\251t\303\251 m\303\251moris\303\251e avec succ\303\250s sur ce navigateur de d\303\251monstration !\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </section>\n\n      {/* 6. FINAL CTA */}\n      <section className=\"text-center bg-brand-depth/40 border border-brand-pink/10 rounded-3xl p-8 md:p-12 space-y-6 max-w-3xl mx-auto relative overflow-hidden\">\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 bg-brand-pink/5 rounded-full blur-[90px] pointer-events-none\" />\n        <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-purple\">\303\211largissez vos sens</span>\n        <h3 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n          Vous souhaitez succomber \303\240 votre tour ?\n        </h3>\n        <p className=\"text-xs text-brand-text-muted max-w-md mx-auto leading-relaxed\">\n          Rejoignez la longue lign\303\251e d\'amateurs de cire artisanale bienfaisante. Choisissez votre contenant et votre senteur pr\303\251f\303\251r\303\251e en Bourgogne !\n        </p>\n        <div className=\"pt-2\">\n          <button\n            onClick={onNavigateToBoutique}\n            className=\"px-8 py-3.5 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md inline-flex items-center gap-2 cursor-pointer\"\n          >\n            D\303\251couvrir le Catalogue Commande Assist\303\251e\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </section>\n\n      {/* 4. MODAL DIALOG ON CLICKING CHANGER */}\n      <AnimatePresence>\n        {selectedScreenshotId !== null && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-bg/90 backdrop-blur-md\">\n            <motion.div \n              initial={{ scale: 0.95, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              exit={{ scale: 0.95, opacity: 0 }}\n              className=\"w-full max-w-lg bg-brand-depth border border-brand-pink/20 rounded-3xl p-6 md:p-8 space-y-6 text-left relative shadow-2xl\"\n            >\n              <button \n                onClick={() => setSelectedScreenshotId(null)}\n                className=\"absolute top-4 right-4 p-2.5 rounded-full bg-brand-bg border border-brand-pink/5 text-brand-text-muted hover:text-brand-cream hover:border-brand-pink/25 cursor-pointer\"\n              >\n                <Plus className=\"w-5 h-5 rotate-45\" />\n              </button>\n\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-12 h-12 rounded-full bg-brand-pink/10 text-brand-pink flex items-center justify-center font-bold font-mono border border-brand-pink/15\">\n                  M\n                </div>\n                <div>\n                  <h3 className=\"font-serif font-bold text-lg text-brand-cream\">\n                    Message de preuve d\'un client\n                  </h3>\n                  <span className=\"text-xs text-brand-text-muted font-mono\">\n                    Validation amicale anonymis\303\251e\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"p-5 rounded-2xl bg-brand-bg/60 border border-brand-pink/5 space-y-4\">\n                <p className=\"text-sm text-brand-cream font-light leading-relaxed italic\">\n                  \"{mockScreenshots.find(s => s.id === selectedScreenshotId)?.text}\"\n                </p>\n                <div className=\"flex items-center justify-between text-[11px] font-mono text-brand-pink\">\n                  <span className=\"flex items-center gap-1\">\n                    <ShieldCheck className=\"w-3.5 h-3.5\" />\n                    Anonymisation compl\303\250te active\n                  </span>\n                  <span>\n                    Note : 5.0 / 5.0\n                  </span>\n                </div>\n              </div>\n\n              <p className=\"text-[11px] text-brand-text-muted leading-relaxed\">\n                Ce retour client direct illustre l\'authenticit\303\251 de nos coulages en Bourgogne. M\303\251lanie et Christelle apportent un soin tout particulier \303\240 chaque exp\303\251dition, avec protections multicouches.\n              </p>\n\n              <div className=\"flex gap-4\">\n                <button\n                  onClick={() => {\n                    setSelectedScreenshotId(null);\n                    onNavigateToBoutique && onNavigateToBoutique();\n                  }}\n                  className=\"flex-1 py-3 bg-brand-pink text-brand-bg font-bold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover text-center transition-colors cursor-pointer\"\n                >\n                  Commander ce type d\'ouvrage\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n\n    </div>\n  );\n}\n"
    }
