        target_content: "  const handleWhatsAppSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.name) {\n      onSuccess(\"Veuillez renseigner au moins votre nom pour d\303\251buter la discussion.\");\n      return;\n    }\n\n    const message = `Bonjour, je souhaite une cr\303\251ation personnalis\303\251e :\nType de produit : ${formData.productType}\nSenteur : ${formData.scent}\nCouleurs : ${formData.colors || \'Non sp\303\251cifi\303\251\'}\nOccasion : ${formData.occasion}\nDate souhait\303\251e : ${formData.date || \'D\303\250s que possible\'}\nD\303\251tails : ${formData.details || \'Aucun d\303\251tail suppl\303\251mentaire\'}\nNom demand\303\251 : ${formData.name}\nT\303\251l\303\251phone : ${formData.phone || \'Non sp\303\251cifi\303\251\'}\n\nMerci`;\n\n    const encodedText = encodeURIComponent(message);\n    const whatsappUrl = `https://wa.me/33600000000?text=${encodedText}`;\n    \n    onSuccess(\"Ouverture de WhatsApp pour finaliser votre cr\303\251ation sur-mesure...\");\n    window.open(whatsappUrl, \'_blank\', \'noopener,noreferrer\');\n  };"
        replacement_content: "  const handleWhatsAppSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.name) {\n      onSuccess(\"Veuillez renseigner au moins votre nom pour d\303\251buter la discussion.\");\n      return;\n    }\n\n    const message = `Bonjour M\303\251lanie et Christelle, je souhaite concevoir un projet de cr\303\251ation personnalis\303\251e et sur-mesure :\n\n[ PROJET DE PERSONNALISATION ]\n* Base de Cr\303\251ation : ${formData.productType}\n* Fragrance S\303\251lectionn\303\251e : ${formData.scent}\n* Nuances & Harmonie de Couleurs : ${formData.colors || \'\303\200 d\303\251finir ensemble (Pastels, Neutres, etc.)\'}\n* Occasion C\303\251l\303\251br\303\251e : ${formData.occasion}\n* Date Limite de Retrait / Livraison : ${formData.date || \'\303\200 convenir\'}\n\n[ COORDONN\303\211ES CLIENT ]\n* Nom Complet : ${formData.name}\n* T\303\251l\303\251phone : ${formData.phone || \'Non sp\303\251cifi\303\251\'}\n\n[ SOUHAITS PARTICULIERS & FINITIONS ]\n${formData.details || \'Aucun d\303\251tail suppl\303\251mentaire sp\303\251cifi\303\251 pour le moment. Discutons des options florales, rubans de lin et gravures ensemble !\'}\n\nMerci pour votre savoir-faire pr\303\251cieux !`;\n\n    const encodedText = encodeURIComponent(message);\n    const whatsappUrl = `https://wa.me/33600000000?text=${encodedText}`;\n    \n    onSuccess(\"Ouverture de WhatsApp pour l\'envoi direct de votre cahier des charges...\");\n    window.open(whatsappUrl, \'_blank\', \'noopener,noreferrer\');\n  };"
