      replacement_content: "import { Product, Review } from \'./types\';\n\nexport const CATEGORIES = [\n  \"Tous\",\n  \"Bouquets parfum\303\251s\",\n  \"Fondants\",\n  \"Bougies en pot\",\n  \"Cadres parfum\303\251s\",\n  \"Brumes\",\n  \"Poudres aspirateur\",\n  \"Suspensions voiture\",\n  \"Coffrets cadeaux\"\n];\n\nexport const SCENT_FAMILIES = {\n  \"Floral\": \"Doux, printanier, po\303\251tique (F\303\251minin, \303\251l\303\251gant)\",\n  \"Gourmand\": \"Sucr\303\251, r\303\251confortant, rappelant l\'enfance\",\n  \"Fruit\303\251\": \"P\303\251tillant, juteux, gorg\303\251 de soleil\",\n  \"Frais\": \"Propre, vivifiant, id\303\251al pour a\303\251rer l\'esprit\",\n  \"Doux / Poudr\303\251\": \"Cocooning, rassurant, id\303\251al pour la chambre\",\n  \"Chaleureux / Bois\303\251\": \"Myst\303\251rieux, bois\303\251, id\303\251al pour les soir\303\251es cocooning\"\n};\n\nexport const SCENTS = [\n  { name: \"Fleur de Cerisier\", family: \"Floral\", icon: \"\360\237\214\270\" },\n  { name: \"Lavande de Provence\", family: \"Floral\", icon: \"\360\237\214\276\" },\n  { name: \"Vanille des \303\256les\", family: \"Gourmand\", icon: \"\360\237\215\246\" },\n  { name: \"Caramel beurre sal\303\251\", family: \"Gourmand\", icon: \"\360\237\245\236\" },\n  { name: \"Fleur de Coton\", family: \"Doux / Poudr\303\251\", icon: \"\342\230\201\357\270\217\" },\n  { name: \"Poudre de Riz\", family: \"Doux / Poudr\303\251\", icon: \"\360\237\222\250\" },\n  { name: \"P\303\252che Velout\303\251e\", family: \"Fruit\303\251\", icon: \"\360\237\215\221\" },\n  { name: \"Fruits Rouges Sauvages\", family: \"Fruit\303\251\", icon: \"\360\237\215\223\" },\n  { name: \"Eucalyptus & Menthe\", family: \"Frais\", icon: \"\360\237\214\277\" },\n  { name: \"Mono\303\257 Absolu\", family: \"Chaleureux / Bois\303\251\", icon: \"\360\237\245\245\" },\n  { name: \"Ambre Imp\303\251rial\", family: \"Chaleureux / Bois\303\251\", icon: \"\360\237\224\245\" }\n];\n\nexport const PRODUCTS: Product[] = [\n  {\n    id: \"bouquet-parfume\",\n    name: \"Bouquet Parfum\303\251 Artisanal\",\n    category: \"Bouquets parfum\303\251s\",\n    description: \"Diffuseur \303\240 b\303\242tonnets de rotin avec flacon en verre \303\251l\303\251gant et collet minimaliste.\",\n    longDescription: \"Un diffuseur d\'ambiance haute performance d\'une contenance de 100ml. Pratique et sans combustion, il diffuse par capillarit\303\251 un parfum d\303\251licat de Grasse s\303\251lectionn\303\251 avec soin durant 6 \303\240 8 semaines. Son design int\303\250gre des fleurs s\303\251ch\303\251es naturelles pour un effet champ\303\252tre \303\251l\303\251gant.\",\n    price: 18.50,\n    priceText: \"\303\240 partir de 18,50 \342\202\254\",\n    rating: 4.9,\n    image: \"https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Cire 100% soja biod\303\251gradable\", \"Parfums de Grasse sans CMR ni phtalates\", \"Dur\303\251e d\'ambiance : 2 mois\", \"Rotin biologique naturel\"],\n    scents: [\"Fleur de Coton\", \"Fleur de Cerisier\", \"Lavande de Provence\", \"Eucalyptus & Menthe\", \"Ambre Imp\303\251rial\"],\n    customizable: true,\n    hasPreorderBadge: true,\n    hasHandmadeBadge: true,\n    weight: \"100 ml\"\n  },\n  {\n    id: \"fondants-collec\",\n    name: \"Sachet de Fondants Coeur Fleur\",\n    category: \"Fondants\",\n    description: \"Petits galets de cire parfum\303\251e \303\240 faire fondre dans un br\303\273le-parfum pour lib\303\251rer rapidement les senteurs.\",\n    longDescription: \"Sachet de 6 fondants artisanaux coul\303\251s \303\240 la main et agr\303\251ment\303\251s de v\303\251ritables p\303\251tales de fleurs s\303\251ch\303\251es. Un seul coeur diffuse jusqu\'\303\240 10 heures d\'un parfum intense et chaleureux. Id\303\251al pour changer r\303\251guli\303\250rement d\'ambiance parfum\303\251e.\",\n    price: 6.90,\n    priceText: \"6,90 \342\202\254 (le paquet de 6)\",\n    rating: 5.0,\n    image: \"https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Se d\303\251pose dans tout br\303\273le-parfum\", \"Parfum imm\303\251diat et puissant\", \"Pinc\303\251e de fleurs s\303\251ch\303\251es locales\", \"Cire v\303\251g\303\251tale saine sans fum\303\251e\"],\n    scents: [\"Caramel beurre sal\303\251\", \"Vanille des \303\256les\", \"Fruits Rouges Sauvages\", \"P\303\252che Velout\303\251e\", \"Fleur de Cerisier\"],\n    customizable: false,\n    hasPreorderBadge: false,\n    hasHandmadeBadge: true,\n    weight: \"sachet de 60g\"\n  },\n  {\n    id: \"bougie-ceramique\",\n    name: \"Bougie C\303\251ramique Divine\",\n    category: \"Bougies en pot\",\n    description: \"Bougie parfum\303\251e coul\303\251e dans un contenant en c\303\251ramique artisanale beige cire tourn\303\251 \303\240 la main.\",\n    longDescription: \"Une oeuvre d\'art unique con\303\247ue en partenariat avec une c\303\251ramiste locale. Une fois la bougie termin\303\251e (m\303\250che cr\303\251pitante en bois de cerisier), le pot en gr\303\250s \303\251maill\303\251 se r\303\251utilise en magnifique tasse \303\240 caf\303\251 ou pot \303\240 bijoux. Coul\303\251 au c\305\223ur de l\'atelier de Christelle et M\303\251lanie.\",\n    price: 26.00,\n    priceText: \"\303\240 partir de 26,00 \342\202\254\",\n    rating: 4.8,\n    image: \"https://images.unsplash.com/photo-1596435707261-05600be4742e?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Pot en c\303\251ramique r\303\251utilisable\", \"M\303\250che en bois de cerisier cr\303\251pitante\", \"40 heures de combustion saine\", \"Cire de soja premium\"],\n    scents: [\"Ambre Imp\303\251rial\", \"Vanille des \303\256les\", \"Fleur de Coton\", \"Poudre de Riz\"],\n    customizable: true,\n    hasPreorderBadge: true,\n    hasHandmadeBadge: true,\n    weight: \"220g de cire\"\n  },\n  {\n    id: \"cadre-suspendu\",\n    name: \"Cadre & Tablette Suspendue Fleurie\",\n    category: \"Cadres parfum\303\251s\",\n    description: \"Suspension d\303\251corative fleurie qui parfume d\303\251licatement vos petits espaces (armoires, tiroirs).\",\n    longDescription: \"Une alliance magnifique entre cire florale rigide et design d\'antan. Orn\303\251 de rubans en lin et de fleurs s\303\251ch\303\251es dispos\303\251es une \303\240 une \303\240 l\'aiguille. Diffuse une douce odeur poudr\303\251e ou fruit\303\251e dans vos dressing ou sur une poign\303\251e de commode pendant plusieurs mois.\",\n    price: 8.50,\n    priceText: \"8,50 \342\202\254\",\n    rating: 4.9,\n    image: \"https://images.unsplash.com/photo-1541532713592-79a0317b6b77?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Cire dure coul\303\251e \303\240 froid\", \"Inclusions de p\303\251tales de rose, jasmin ou bl\303\251\", \"Ruban lin raffin\303\251 inclus\", \"Efficace 4 \303\240 6 mois\"],\n    scents: [\"Poudre de Riz\", \"Fleur de Coton\", \"P\303\252che Velout\303\251e\", \"Lavande de Provence\"],\n    customizable: true,\n    hasPreorderBadge: true,\n    hasHandmadeBadge: true,\n    weight: \"35g\"\n  },\n  {\n    id: \"brume-oreiller\",\n    name: \"Brume Douce Nuit d\'Ambiance\",\n    category: \"Brumes\",\n    description: \"Brume d\'ambiance et textile \303\240 pulv\303\251riser pour envelopper vos nuits de douceur.\",\n    longDescription: \"Formul\303\251e sans alcool nocif, cette brume d\303\251licate se vaporise sur vos oreillers, rideaux, et canap\303\251s. Une signature olfactive apaisante qui favorise la d\303\251tente et apporte un vent de fra\303\256cheur instantan\303\251.\",\n    price: 12.00,\n    priceText: \"12,00 \342\202\254\",\n    rating: 4.9,\n    image: \"https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Sans solvant chimique\", \"S\303\273r sur les textiles d\303\251licats\", \"Flacon vaporisateur ambr\303\251\", \"Id\303\251al avant le coucher\"],\n    scents: [\"Fleur de Coton\", \"Lavande de Provence\", \"Poudre de Riz\"],\n    customizable: false,\n    hasPreorderBadge: false,\n    hasHandmadeBadge: true,\n    weight: \"50 ml\"\n  },\n  {\n    id: \"poudre-aspirateur\",\n    name: \"Poudre Parfum\303\251e Reine du M\303\251nage\",\n    category: \"Poudres aspirateur\",\n    description: \"Poudre parfum\303\251e \303\240 base d\'ingr\303\251dients naturels pour assainir et d\303\251sodoriser les pi\303\250ces.\",\n    longDescription: \"Saupoudrez simplement l\'\303\251quivalent d\'une cuill\303\250re \303\240 soupe sur le tapis ou le sol, puis aspirez. La chaleur du moteur de l\'aspirateur diffuse aussit\303\264t une senteur irr\303\251sistible dans toute la maison tout en neutralisant les odeurs de sac ou de filtres.\",\n    price: 7.50,\n    priceText: \"7,50 \342\202\254\",\n    rating: 4.7,\n    image: \"https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Bicarbonate de sodium assainissant\", \"Combat les acariens et odeurs\", \"Senteur fra\303\256che de Grasse\", \"Sachet kraft herm\303\251tique refermable\"],\n    scents: [\"Eucalyptus & Menthe\", \"Fleur de Coton\", \"Mono\303\257 Absolu\"],\n    customizable: false,\n    hasPreorderBadge: false,\n    hasHandmadeBadge: true,\n    weight: \"150g\"\n  },\n  {\n    id: \"suspension-voiture\",\n    name: \"Suspension \303\211lixir de Voyage\",\n    category: \"Suspensions voiture\",\n    description: \"Petite fiole en verre avec bouchon en bois de h\303\252tre pour embaumer l\'int\303\251rieur de votre v\303\251hicule.\",\n    longDescription: \"Fini les arbres en carton chimiques. Cette adorable suspension diffuse en douceur un parfum naturel par absorption du bois de son bouchon. Retournez simplement la fiole 2 secondes toutes les semaines pour un parfum toujours impeccable.\",\n    price: 5.00,\n    priceText: \"5,00 \342\202\254\",\n    rating: 4.9,\n    image: \"https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Bouchon en bois de h\303\252tre diffuseur\", \"Esth\303\251tique et discret\", \"Dure plus d\'un mois\", \"Sans colorant chimique\"],\n    scents: [\"P\303\252che Velout\303\251e\", \"Fleur de Coton\", \"Mono\303\257 Absolu\", \"Caramel beurre sal\303\251\"],\n    customizable: false,\n    hasPreorderBadge: false,\n    hasHandmadeBadge: true,\n    weight: \"8 ml\"\n  },\n  {\n    id: \"coffret-douceur\",\n    name: \"Coffret Cadeau Cocooning R\303\252ve\",\n    category: \"Coffrets cadeaux\",\n    description: \"Une s\303\251lection magique de cr\303\251ations parfum\303\251es pr\303\251sent\303\251es dans un bel \303\251crin pr\303\252t \303\240 offrir.\",\n    longDescription: \"Comprend une mini-bougie en pot, 1 suspension fleurie, et un sachet de 3 fondants assortis. Une attention divine pour un anniversaire, une f\303\252te des m\303\250res, un mariage ou un cadeau de No\303\253l naturel et chaleureux.\",\n    price: 32.00,\n    priceText: \"32,00 \342\202\254\",\n    rating: 5.0,\n    image: \"https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&fit=crop&w=600&q=80\",\n    features: [\"Pr\303\252t \303\240 offrir avec ruban de lin\", \"Carte de remerciement personnalis\303\251e\", \"Emballage kraft biod\303\251gradable\", \"Assortiment senteur de saison\"],\n    scents: [\"Fleur de Coton\", \"Vanille des \303\256les\", \"Fleur de Cerisier\"],\n    customizable: true,\n    hasPreorderBadge: true,\n    hasHandmadeBadge: true,\n    weight: \"Coffret complet\"\n  }\n];\n\nexport const REVIEWS: Review[] = [\n  {\n    id: \"rev-1\",\n    author: \"Sophie Dumont\",\n    rating: 5,\n    text: \"Une merveille ! Le bouquet parfum\303\251 \303\240 la Fleur de Coton dure depuis bient\303\264t deux mois dans mon salon et l\'odeur reste tout aussi d\303\251licate. Je recommande \303\240 100% Christelle et M\303\251lanie !\",\n    date: \"14 Mai 2026\",\n    source: \"Facebook\",\n  },\n  {\n    id: \"rev-2\",\n    author: \"Jean-Baptiste L.\",\n    rating: 5,\n    text: \"J\'ai command\303\251 des fondants au Caramel Beurre Sal\303\251 et \303\240 la P\303\252che pour les offrir. Emballage impeccable, livraison soign\303\251e au boulot. L\'odeur de caramel qui embaume la pi\303\250ce est juste divine et gourmande.\",\n    date: \"2 Mai 2026\",\n    source: \"Messenger\",\n  },\n  {\n    id: \"rev-3\",\n    author: \"Mireille Roussel\",\n    rating: 5,\n    text: \"La bougie c\303\251ramique est un v\303\251ritable coup de c\305\223ur esth\303\251tique et olfactif. Le cr\303\251pitement de la m\303\250che en bois donne une petite ambiance de feu de chemin\303\251e relaxante. Une tr\303\250s belle id\303\251e cadeau.\",\n    date: \"18 Avril 2026\",\n    source: \"Google\",\n  },\n  {\n    id: \"rev-4\",\n    author: \"Elodie Bertin\",\n    rating: 5,\n    text: \"J\'ai personnalis\303\251 40 miniatures fleurs parfum\303\251es pour le mariage de ma s\305\223ur. Christelle a \303\251t\303\251 adorable, r\303\251active et \303\240 l\'\303\251coute des moindres d\303\251tails pour correspondre aux couleurs v\303\251g\303\251tales de l\'\303\251v\303\251nement. Tout le monde a ador\303\251 !\",\n    date: \"28 Mars 2026\",\n    source: \"Facebook\",\n  }\n];\n"
    }
