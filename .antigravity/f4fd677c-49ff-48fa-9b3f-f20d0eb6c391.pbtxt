    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "          {/* ==================== 5. AVIS CLIENTS TAB ==================== */}\n          {currentTab === \'avis\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <ReviewSection onAddReviewNotification={(text) => triggerToast(text)} />\n            </motion.div>\n          )}\n\n          {/* ==================== 6. LIVRAISON & INFORMATION TAB ==================== */}\n          {currentTab === \'livraison\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"max-w-4xl mx-auto space-y-12\"\n            >\n              <div className=\"text-center space-y-3\">\n                <Truck className=\"w-10 h-10 text-brand-pink mx-auto animate-pulse\" />\n                <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream\">\n                  Exp\303\251dition, Retrait & Informations\n                </h1>\n                <p className=\"text-sm text-brand-text-muted\">\n                  Chez R\303\252ve Parfum\303\251 Cr\303\251ation, chaque produit n\'attend pas sur une \303\251tag\303\250re froide. Nous fabriquons \303\240 la demande pour pr\303\251server les puissances odorantes.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                \n                {/* Rule Card 1 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Clock className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">D\303\251lai global de 2 semaines</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Nous n\'utilisons aucun process industriel de s\303\251chage forc\303\251. Vos bougies, bouquets artisanaux et suspensions florales reposent un temps r\303\251glementaire de cure en atelier pour lib\303\251rer l\'expression optimale de l\'huile de parfum. Comptez environ deux semaines entre votre validation WhatsApp et la dispo.\n                  </p>\n                </div>\n\n                {/* Rule Card 2 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Truck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">Livraisons de Septembre \303\240 Mars</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    La cire 100% v\303\251g\303\251tale de soja et les fondants coeurs poss\303\250dent une temp\303\251rature de fusion basse de 48\302\260C. Afin d\'\303\251viter tout dommage thermique et coulures durant les acheminements postaux d\'\303\251t\303\251, les colis de livraison sont assur\303\251s de Septembre \303\240 Mars.\n                  </p>\n                </div>\n\n                {/* Rule Card 3 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Compass className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">Retrait gratuit \303\240 l\'Atelier</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Le retrait direct \303\240 l\'adresse de notre atelier (ou lors de nos r\303\251unions) est privil\303\251gi\303\251 toute l\'ann\303\251e. Prenez date avec Christelle ou M\303\251lanie lors de votre conversation WhatsApp. Vos cr\303\251ations vous attendront pr\303\252tes \303\240 offrir dans notre cocon.\n                  </p>\n                </div>\n\n                {/* Rule Card 4 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <ShieldCheck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">Charte \303\211co-Responsable</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Nous recyclons nos contenants verre, offrons des recharges fondants \303\240 poser et n\'imprimons que le strict n\303\251cessaire d\'\303\251tiquette d\'envoi. Un choix \303\251thique au service de la po\303\251sie olfactive !\n                  </p>\n                </div>\n\n              </div>\n\n              {/* Legal information notice footer */}\n              <div className=\"p-8 bg-brand-depth/40 border border-brand-pink/5 rounded-3xl text-left space-y-4\">\n                <h3 className=\"font-serif font-bold text-xl text-brand-cream\">Mentions L\303\251gales & CGV Transparentes</h3>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 text-[11px] text-brand-text-muted font-mono leading-relaxed\">\n                  <div className=\"space-y-1\">\n                    <p className=\"font-bold text-brand-pink uppercase mb-1\">R\303\252ve Parfum\303\251 Cr\303\251ation</p>\n                    <p>Co-dirig\303\251 par : Christelle L. & M\303\251lanie G.</p>\n                    <p>Micro-entreprises enregistr\303\251es en France.</p>\n                    <p>Siret : 123 456 789 00018 / 987 654 321 00021</p>\n                    <p>Courriel : contact@reveparfume.fr</p>\n                  </div>\n                  <div className=\"space-y-1\">\n                    <p className=\"font-bold text-brand-pink uppercase mb-1\">R\303\250gles Commerciales</p>\n                    <p>Moyen de paiement accept\303\251s : PayPal, Wero, Virement</p>\n                    <p>Retours accept\303\251s sous 14 jours si scell\303\251s.</p>\n                    <p>Frais d\'exp\303\251dition calcul\303\251s lors du chat WhatsApp selon le barom\303\250tre postal.</p>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          )}\n\n        </AnimatePresence>\n      </main>\n\n      {/* ==================== INLINE CUSTOM CHEKOUT MODAL ==================== */}\n      {selectedProduct && (\n        <ProductDetailsModal \n          product={selectedProduct} \n          onClose={() => setSelectedProduct(null)} \n        />\n      )}\n\n      {/* ==================== FOOTER ==================== */}\n      <footer className=\"mt-24 border-t border-brand-pink/10 py-12 bg-brand-depth/20\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"text-left\">\n            <h3 className=\"text-lg font-serif font-bold text-brand-pink\">R\303\252ve Parfum\303\251 Cr\303\251ation</h3>\n            <p className=\"text-xs text-brand-text-muted font-light mt-1\">Concepteur de douceurs parfum\303\251es saines et artisanales \303\240 base de cire de soja.</p>\n          </div>\n          \n          <div className=\"flex flex-wrap gap-4 text-xs text-brand-text-muted\">\n            <button onClick={() => setCurrentTab(\'accueil\')} className=\"hover:text-brand-pink transition-colors\">Accueil</button>\n            <button onClick={() => setCurrentTab(\'boutique\')} className=\"hover:text-brand-pink transition-colors\">Boutique</button>\n            <button onClick={() => setCurrentTab(\'evenements\')} className=\"hover:text-brand-pink transition-colors\">Mariages & \303\211v\303\251nements</button>\n            <button onClick={() => setCurrentTab(\'reunions\')} className=\"hover:text-brand-pink transition-colors\">Atelier \303\240 Domicile</button>\n            <button onClick={() => setCurrentTab(\'livraison\')} className=\"hover:text-brand-pink transition-colors\">CGV & Informations</button>\n          </div>\n\n          <div className=\"text-xs text-brand-text-muted font-mono\">\n            &copy; {new Date().getFullYear()} R\303\252ve Parfum\303\251 \302\267 Fait main en France\n          </div>\n        </div>\n      </footer>"
      replacement_content: "          {/* ==================== 5. AVIS CLIENTS TAB ==================== */}\n          {currentTab === \'avis\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <ReviewSection onAddReviewNotification={(text) => triggerToast(text)} />\n            </motion.div>\n          )}\n\n          {/* ==================== 6. LIVRAISON & INFORMATION TAB ==================== */}\n          {currentTab === \'livraison\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"max-w-4xl mx-auto space-y-12\"\n            >\n              <div className=\"text-center space-y-3\">\n                <Truck className=\"w-10 h-10 text-brand-pink mx-auto animate-pulse\" />\n                <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream\">\n                  Exp\303\251dition, Retrait & Informations\n                </h1>\n                <p className=\"text-sm text-brand-text-muted\">\n                  Chez R\303\252ve Parfum\303\251 Cr\303\251ation, chaque produit n\'attend pas sur une \303\251tag\303\250re froide. Nous fabriquons \303\240 la demande pour pr\303\251server les puissances odorantes et la vitalit\303\251 des fleurs.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                \n                {/* Rule Card 1 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Clock className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">D\303\251lai moyen de fabrication</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Toutes nos cr\303\251ations sont pr\303\251par\303\251es sur commande avec un d\303\251lai moyen de fabrication d\342\200\231environ deux semaines. Ce laps de temps permet \303\240 la pure cire v\303\251g\303\251tale de soja de durcir paisiblement et de se lier de fa\303\247on optimale aux essences parfum\303\251es de Grasse.\n                  </p>\n                </div>\n\n                {/* Rule Card 2 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Truck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">P\303\251riodes d\342\200\231envoi de colis</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Les colis de cires saines et fondants c\305\223ur sont exp\303\251di\303\251s principalement d\'<strong>octobre \303\240 mars</strong> pour \303\251viter le risque d\'alt\303\251ration thermique lors des chaleurs postales d\'\303\251t\303\251. Durant les p\303\251riodes hors-envois, le retrait direct \303\240 domicile est chaleureusement encourag\303\251.\n                  </p>\n                </div>\n\n                {/* Rule Card 3 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <MapPin className=\"w-5 h-5 text-brand-pink\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">Retrait physique \303\240 domicile</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Le retrait gratuit s\'effectue directement \303\240 notre atelier en Bourgogne, sur rendez-vous souple fix\303\251 avec vous. L\'adresse exacte de rendez-vous est partag\303\251e lors de la finalisation amicale de votre commande de cire sur WhatsApp.\n                  </p>\n                </div>\n\n                {/* Rule Card 4 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <ShieldCheck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">Protection active des colis</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Vos cadres parfum\303\251s en cire dure, brumes d\342\200\231ambiance en flacon de verre ambr\303\251 et bougies en pot de Gr\303\250s c\303\251ramique sont amoureusement matelass\303\251s. Une photo ou vid\303\251o de votre colis ouvert peut \303\252tre conserv\303\251e avant le d\303\251p\303\264t postal afin d\'assurer un suivi parfait.\n                  </p>\n                </div>\n\n              </div>\n\n              {/* Delivery rates details block */}\n              <div className=\"p-8 bg-brand-depth/60 border border-brand-pink/10 rounded-3xl text-left space-y-4\">\n                <h3 className=\"font-serif font-bold text-xl text-brand-cream\">Nos Transporteurs & Frais Postaux</h3>\n                <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                  Nous exp\303\251dions nos douceurs de cire via <strong>La Poste / Colissimo</strong> de m\303\252me qu\'en Point Relais \303\251conomique avec <strong>Mondial Relay</strong>. Les frais d\'envoi r\303\251els sont calcul\303\251s \303\240 prix co\303\273tant en fonction du poids global des cr\303\251ations et valid\303\251s avec vous avant le r\303\250glement PayPal ou Wero.\n                </p>\n                <div className=\"flex flex-wrap gap-4 pt-2\">\n                  <button \n                    onClick={() => {\n                      setLegalSubTab(\'livraison-retrait\');\n                      setCurrentTab(\'legals\');\n                      window.scrollTo({ top: 0, behavior: \'smooth\' });\n                    }}\n                    className=\"px-5 py-2.5 rounded-full bg-brand-pink/10 text-brand-pink hover:bg-brand-pink hover:text-brand-bg transition-all font-semibold text-xs uppercase cursor-pointer\"\n                  >\n                    Consulter la Politique Livraison l\303\251gale\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          )}\n\n          {/* ==================== 7. PERSONNALISATION TAB ==================== */}\n          {currentTab === \'personnalisation\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <CustomizationPage onSuccess={(text) => triggerToast(text)} />\n            </motion.div>\n          )}\n\n          {/* ==================== 8. \303\200 PROPOS TAB ==================== */}\n          {currentTab === \'a-propos\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <AboutPage />\n            </motion.div>\n          )}\n\n          {/* ==================== 9. CONTACT TAB ==================== */}\n          {currentTab === \'contact\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <ContactPage setCurrentTab={setCurrentTab} onSuccess={(text) => triggerToast(text)} />\n            </motion.div>\n          )}\n\n          {/* ==================== 10. LEGAL PAGES SUB-TABS ==================== */}\n          {currentTab === \'legals\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <LegalPages initialSubTab={legalSubTab} />\n            </motion.div>\n          )}\n\n        </AnimatePresence>\n      </main>\n\n      {/* ==================== INLINE CUSTOM CHEKOUT MODAL ==================== */}\n      {selectedProduct && (\n        <ProductDetailsModal \n          product={selectedProduct} \n          onClose={() => setSelectedProduct(null)} \n        />\n      )}\n\n      {/* ==================== FOOTER ==================== */}\n      <footer className=\"mt-28 border-t border-brand-pink/10 py-16 bg-brand-depth/40 relative\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-12 gap-10 items-start\">\n            \n            {/* Column 1: Intro brand */}\n            <div className=\"md:col-span-5 text-left space-y-4\">\n              <h3 className=\"text-2xl font-serif font-bold text-brand-pink tracking-wide\">\n                R\303\252ve Parfum\303\251 <span className=\"font-light italic text-brand-purple\">Cr\303\251ation</span>\n              </h3>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Des cr\303\251ations parfum\303\251es faites main, pens\303\251es pour offrir, d\303\251corer et parfumer avec douceur. Concepteur de douceurs parfum\303\251es saines et artisanales \303\240 base de pure cire v\303\251g\303\251tale de soja et de v\303\251ritables fleurs s\303\251ch\303\251es locales.\n              </p>\n              <div className=\"pt-2 text-[11px] font-mono text-brand-pink/80\">\n                Bourgogne, France \302\267 Co-g\303\251r\303\251 par Christelle & M\303\251lanie\n              </div>\n            </div>\n\n            {/* Column 2: Navigation Links */}\n            <div className=\"md:col-span-4 text-left\">\n              <h4 className=\"text-xs uppercase font-mono tracking-widest text-brand-cream font-bold mb-4\">L\'Atelier R\303\252ve</h4>\n              <div className=\"grid grid-cols-2 gap-y-2.5 gap-x-4 text-xs text-brand-text-muted\">\n                <button onClick={() => { setCurrentTab(\'boutique\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">Boutique</button>\n                <button onClick={() => { setCurrentTab(\'personnalisation\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">Personnalisation</button>\n                <button onClick={() => { setCurrentTab(\'evenements\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">Mariages & \303\211v\303\251nements</button>\n                <button onClick={() => { setCurrentTab(\'reunions\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">R\303\251unions \303\240 Domicile</button>\n                <button onClick={() => { setCurrentTab(\'avis\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">Avis clients</button>\n                <button onClick={() => { setCurrentTab(\'livraison\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">Livraison & Info</button>\n                <button onClick={() => { setCurrentTab(\'a-propos\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">\303\200 Propos</button>\n                <button onClick={() => { setCurrentTab(\'contact\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors text-left\">Contact</button>\n              </div>\n            </div>\n\n            {/* Column 3: Social grids */}\n            <div className=\"md:col-span-3 text-left\">\n              <h4 className=\"text-xs uppercase font-mono tracking-widest text-brand-cream font-bold mb-4\">Rejoignez-nous</h4>\n              <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light mb-4\">Suivez notre fabrication artisanale au jour le jour sur nos r\303\251seaux sociaux d\'artistes.</p>\n              <div className=\"flex gap-4\">\n                <a \n                  href=\"https://facebook.com\" \n                  target=\"_blank\" \n                  rel=\"noopener noreferrer\" \n                  className=\"px-4 py-2 rounded-xl bg-white/5 hover:bg-brand-pink hover:text-brand-bg text-brand-text-muted transition-all font-mono text-xs cursor-pointer\"\n                >\n                  Facebook\n                </a>\n                <a \n                  href=\"https://instagram.com\" \n                  target=\"_blank\" \n                  rel=\"noopener noreferrer\" \n                  className=\"px-4 py-2 rounded-xl bg-white/5 hover:bg-brand-pink hover:text-brand-bg text-brand-text-muted transition-all font-mono text-xs cursor-pointer\"\n                >\n                  Instagram\n                </a>\n              </div>\n            </div>\n\n          </div>\n\n          {/* Footer second raw for technical / legal links & copyright */}\n          <div className=\"pt-10 border-t border-brand-pink/10 flex flex-col sm:flex-row items-center justify-between gap-6 text-[11px] text-brand-text-muted\">\n            <div className=\"flex flex-wrap justify-center sm:justify-start gap-4\">\n              <button onClick={() => { setLegalSubTab(\'mentions\'); setCurrentTab(\'legals\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors\">Mentions L\303\251gales</button>\n              <button onClick={() => { setLegalSubTab(\'cgv\'); setCurrentTab(\'legals\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors\">CGV</button>\n              <button onClick={() => { setLegalSubTab(\'confidentialite\'); setCurrentTab(\'legals\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors\">Politique de Confidentialit\303\251</button>\n              <button onClick={() => { setLegalSubTab(\'livraison-retrait\'); setCurrentTab(\'legals\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }} className=\"hover:text-brand-pink transition-colors\">Politique Livraison / Retrait</button>\n            </div>\n            \n            <div className=\"font-mono\">\n              &copy; {new Date().getFullYear()} R\303\252ve Parfum\303\251 \302\267 Fabriqu\303\251 avec amour en France\n            </div>\n          </div>\n\n        </div>\n      </footer>"
    }
