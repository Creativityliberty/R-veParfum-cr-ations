    instruction: "Replace basic reviews and delivery tabs blocks with upgraded premium pages"
    replacement_infos {
      original_chunk {
        target_content: "          {/* ==================== 5. AVIS CLIENTS TAB ==================== */}\n          {currentTab === \'avis\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <ReviewSection onAddReviewNotification={(text) => triggerToast(text)} />\n            </motion.div>\n          )}\n\n          {/* ==================== 6. LIVRAISON & INFORMATION TAB ==================== */}\n          {currentTab === \'livraison\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"max-w-4xl mx-auto space-y-12\"\n            >\n              <div className=\"text-center space-y-3\">\n                <Truck className=\"w-10 h-10 text-brand-pink mx-auto animate-pulse\" />\n                <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream\">\n                  Exp\303\251dition, Retrait & Informations\n                </h1>\n                <p className=\"text-sm text-brand-text-muted\">\n                  Chez R\303\252ve Parfum\303\251 Cr\303\251ation, chaque produit n\'attend pas sur une \303\251tag\303\250re froide. Nous fabriquons \303\240 la demande pour pr\303\251server les puissances odorantes et la vitalit\303\251 des fleurs.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                \n                {/* Rule Card 1 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Clock className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">D\303\251lai moyen de fabrication</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Toutes nos cr\303\251ations sont pr\303\251par\303\251es sur commande avec un d\303\251lai moyen de fabrication d\342\200\231environ deux semaines. Ce laps de temps permet \303\240 la pure cire v\303\251g\303\251tale de soja de durcir paisiblement et de se lier de fa\303\247on optimale aux essences parfum\303\251es de Grasse.\n                  </p>\n                </div>\n\n                {/* Rule Card 2 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Truck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">P\303\251riodes d\342\200\231envoi de colis</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Les colis de cires saines et fondants c\305\223ur sont exp\303\251di\303\251s principalement d\'<strong>octobre \303\240 mars</strong> pour \303\251viter le risque d\'alt\303\251ration thermique lors des chaleurs postales d\'\303\251t\303\251. Durant les p\303\251riodes hors-envois, le retrait direct \303\240 domicile est chaleureusement encourag\303\251.\n                  </p>\n                </div>\n\n                {/* Rule Card 3 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <MapPin className=\"w-5 h-5 text-brand-pink\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">Retrait physique \303\240 domicile</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Le retrait gratuit s\'effectue directement \303\240 notre atelier en Bourgogne, sur rendez-vous souple fix\303\251 avec vous. L\'adresse exacte de rendez-vous est partag\303\251e lors de la finalisation amicale de votre commande de cire sur WhatsApp.\n                  </p>\n                </div>\n\n                {/* Rule Card 4 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3 text-left\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <ShieldCheck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream font-medium\">Protection active des colis</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Vos cadres parfum\303\251s en cire dure, brumes d\342\200\231ambiance en flacon de verre ambr\303\251 et bougies en pot de Gr\303\250s c\303\251ramique sont amoureusement matelass\303\251s. Une photo ou vid\303\251o de votre colis ouvert peut \303\252tre conserv\303\251e avant le d\303\251p\303\264t postal afin d\'assurer un suivi parfait.\n                  </p>\n                </div>\n\n              </div>\n\n              {/* Delivery rates details block */}\n              <div className=\"p-8 bg-brand-depth/60 border border-brand-pink/10 rounded-3xl text-left space-y-4\">\n                <h3 className=\"font-serif font-bold text-xl text-brand-cream\">Nos Transporteurs & Frais Postaux</h3>\n                <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                  Nous exp\303\251dions nos douceurs de cire via <strong>La Poste / Colissimo</strong> de m\303\252me qu\'en Point Relais \303\251conomique avec <strong>Mondial Relay</strong>. Les frais d\'envoi r\303\251els sont calcul\303\251s \303\240 prix co\303\273tant en fonction du poids global des cr\303\251ations et valid\303\251s avec vous avant le r\303\250glement PayPal ou Wero.\n                </p>\n                <div className=\"flex flex-wrap gap-4 pt-2\">\n                  <button \n                    onClick={() => {\n                      setLegalSubTab(\'livraison-retrait\');\n                      setCurrentTab(\'legals\');\n                      window.scrollTo({ top: 0, behavior: \'smooth\' });\n                    }}\n                    className=\"px-5 py-2.5 rounded-full bg-brand-pink/10 text-brand-pink hover:bg-brand-pink hover:text-brand-bg transition-all font-semibold text-xs uppercase cursor-pointer\"\n                  >\n                    Consulter la Politique Livraison l\303\251gale\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          )}"
        replacement_content: "          {/* ==================== 5. AVIS CLIENTS TAB ==================== */}\n          {currentTab === \'avis\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <ReviewSection \n                onAddReviewNotification={(text) => triggerToast(text)} \n                onNavigateToBoutique={() => { setCurrentTab(\'boutique\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                onNavigateToQuiz={() => {\n                  setShowQuizModal(true);\n                  const quizEl = document.getElementById(\'scent-finder-anchor\');\n                  if (quizEl) {\n                    quizEl.scrollIntoView({ behavior: \'smooth\' });\n                  }\n                }}\n              />\n            </motion.div>\n          )}\n\n          {/* ==================== 6. LIVRAISON & INFORMATION TAB ==================== */}\n          {currentTab === \'livraison\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <DeliveryPage \n                onNavigateToContact={() => { setCurrentTab(\'contact\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                onNavigateToBoutique={() => { setCurrentTab(\'boutique\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n              />\n            </motion.div>\n          )}"
      }
      num_matches: 1
    }
  }
}
