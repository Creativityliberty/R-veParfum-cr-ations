    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  const handleWhatsAppCheckout = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!clientName.trim()) {\n      alert(\"S\'il vous pla\303\256t, saisissez votre nom pour que Christelle et M\303\251lanie puissent vous adresser.\");\n      return;\n    }\n\n    // Build precisely formatted message matching section 6 instructions\n    const msg = `Bonjour, je souhaite commander :\nProduit : ${product.name}\nCat\303\251gorie : ${product.category}\nParfum : ${selectedScent}\nCouleur : ${selectedColor}\nQuantit\303\251 : ${quantity}\nPersonnalisation : ${personalization ? personalization : \"Aucune sp\303\251cifi\303\251e\"}\nMode souhait\303\251 : ${deliveryMode}\nNom : ${clientName}\nMerci \360\237\230\212`;\n\n    const encoded = encodeURIComponent(msg);\n    // WhatsApp redirect (replace with appropriate general number)\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto backdrop-blur-md bg-black/60\">\n      <div className=\"relative w-full max-w-4xl bg-brand-bg border border-brand-pink/20 rounded-3xl overflow-hidden shadow-2xl max-h-[90vh] flex flex-col md:flex-row\">\n        \n        {/* Close Button */}\n        <button \n          onClick={onClose}\n          className=\"absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-brand-bg/85 border border-brand-pink/15 text-brand-text-muted hover:text-brand-pink flex items-center justify-center transition-colors cursor-pointer\"\n          title=\"Fermer\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        {/* Product Visual Scroll Column */}\n        <div className=\"w-full md:w-1/2 p-6 md:p-8 bg-brand-depth flex flex-col justify-start border-r border-brand-pink/10 overflow-y-auto\">\n          <div className=\"sticky top-0\">\n            <div className=\"rounded-2xl overflow-hidden border border-brand-pink/15 mb-6 aspect-square bg-brand-bg\">\n              <img \n                src={product.image} \n                alt={product.name} \n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n\n            <div className=\"space-y-4\">\n              <div className=\"flex flex-wrap gap-2\">\n                <span className=\"px-3 py-1 rounded bg-brand-pink/15 font-mono text-[10px] text-brand-pink uppercase tracking-widest font-semibold\">\n                  {product.category}\n                </span>\n                {product.hasHandmadeBadge && (\n                  <span className=\"px-3 py-1 rounded bg-brand-cream/5 font-mono text-[10px] text-brand-cream/80 uppercase tracking-widest\">\n                    \342\255\220 Fait Main\n                  </span>\n                )}\n              </div>\n\n              <h2 className=\"text-3xl font-serif font-bold text-brand-cream leading-tight\">\n                {product.name}\n              </h2>\n\n              <p className=\"text-sm text-brand-text-muted italic leading-relaxed\">\n                {product.longDescription}\n              </p>\n\n              <div className=\"p-4 bg-brand-bg/40 border border-brand-pink/10 rounded-xl space-y-2\">\n                <h4 className=\"text-xs font-mono font-bold uppercase tracking-wider text-brand-pink\">Atelier Charte Naturelle :</h4>\n                <ul className=\"text-xs text-brand-text-muted space-y-1.5 list-disc pl-4\">\n                  {product.features.map((feat, i) => (\n                    <li key={i}>{feat}</li>\n                  ))}\n                </ul>\n              </div>\n\n              <div className=\"text-xs text-brand-purple italic flex items-center gap-2\">\n                <Snail className=\"w-4 h-4 text-brand-pink\" />\n                D\303\251lai estim\303\251 : ~ deux semaines (fabrication artisanale)\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Configurations Forms Column */}\n        <div className=\"w-full md:w-1/2 p-6 md:p-8 overflow-y-auto\">\n          <form onSubmit={handleWhatsAppCheckout} className=\"space-y-6\">\n            <div>\n              <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">S\303\211LECTION PARFUM\303\211E</span>\n              <div className=\"grid grid-cols-2 gap-2 mt-2\">\n                {product.scents.map((scentName) => (\n                  <button\n                    key={scentName}\n                    type=\"button\"\n                    onClick={() => setSelectedScent(scentName)}\n                    className={`p-3 text-left rounded-xl text-xs font-medium border transition-colors cursor-pointer ${\n                      selectedScent === scentName \n                        ? \'bg-brand-pink/15 border-brand-pink text-brand-pink\' \n                        : \'bg-brand-depth/60 border-brand-pink/5 text-brand-text-muted hover:border-brand-pink/40\'\n                    }`}\n                  >\n                    \360\237\214\270 {scentName}\n                  </button>\n                ))}\n              </div>\n              {currentScentObj && (\n                <div className=\"mt-2 text-[11px] font-mono text-brand-purple italic\">\n                  Note : Senteur {currentScentObj.family} ({currentScentObj.family === \"Gourmand\" ? \"gourmande & sucr\303\251e\" : currentScentObj.family === \"Floral\" ? \"fleurie\" : \"douceur relaxante\"})\n                </div>\n              )}\n            </div>\n\n            {/* Colors */}\n            <div>\n              <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">COULEUR INDIVIDUALIS\303\211E</span>\n              <select\n                value={selectedColor}\n                onChange={(e) => setSelectedColor(e.target.value)}\n                className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                {colorsOption.map(co => (\n                  <option key={co} value={co}>{co}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Quantity */}\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-1/3\">\n                <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">QUANTIT\303\211</span>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  max=\"50\"\n                  value={quantity}\n                  onChange={(e) => setQuantity(Number(e.target.value))}\n                  className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/15 rounded-xl text-center text-sm font-semibold text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n\n              <div className=\"w-2/3\">\n                <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">EXP\303\211DITION / RETRAIT</span>\n                <div className=\"grid grid-cols-2 gap-2 mt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setDeliveryMode(\"Retrait \303\240 l\'Atelier\")}\n                    className={`py-2 px-3 rounded-xl text-xs font-medium border text-center transition-colors cursor-pointer ${\n                      deliveryMode === \"Retrait \303\240 l\'Atelier\" \n                        ? \'bg-brand-pink/15 border-brand-pink text-brand-pink\' \n                        : \'bg-brand-depth/60 border-brand-pink/5 text-brand-text-muted\'\n                    }`}\n                  >\n                    \360\237\217\241 Retrait gratuit\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setDeliveryMode(\"Livraison (France)\")}\n                    className={`py-2 px-3 rounded-xl text-xs font-medium border text-center transition-colors cursor-pointer ${\n                      deliveryMode === \"Livraison (France)\" \n                        ? \'bg-brand-pink/15 border-brand-pink text-brand-pink\' \n                        : \'bg-brand-depth/60 border-brand-pink/5 text-brand-text-muted\'\n                    }`}\n                  >\n                    \360\237\223\246 Envoi postal\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Personalization textarea */}\n            {product.customizable && (\n              <div>\n                <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest flex items-center justify-between\">\n                  <span>PERSONNALISATION DES \303\211TIQUETTES</span>\n                  <span className=\"text-[10px] text-brand-purple italic\">Optionnelle</span>\n                </span>\n                <textarea\n                  placeholder=\"Ex : Inscription pour \303\251tiquettes (ex: \'Bapt\303\252me de Jade 12.06.27\'), demande de rubans assortis, couleur sp\303\251ciale...\"\n                  value={personalization}\n                  onChange={(e) => setPersonalization(e.target.value)}\n                  className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors min-h-[70px]\"\n                />\n              </div>\n            )}\n\n            {/* Client name input MANDATORY for WhatsApp generation */}\n            <div>\n              <span className=\"text-xs font-mono font-bold text-brand-pink uppercase tracking-widest\">VOTRE NOM COMPLET *</span>\n              <input\n                type=\"text\"\n                required\n                placeholder=\"Renseignez votre nom et pr\303\251nom...\"\n                value={clientName}\n                onChange={(e) => setClientName(e.target.value)}\n                className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/30 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink focus:ring-1 focus:ring-brand-pink transition-colors\"\n              />\n            </div>\n\n            {/* Pricing Summary */}\n            <div className=\"p-4 rounded-xl bg-brand-depth border border-brand-pink/10 space-y-1\">\n              <div className=\"flex justify-between items-center text-xs text-brand-text-muted\">\n                <span>Prix unitaire moyen :</span>\n                <span>{product.priceText || `${product.price.toFixed(2)} \342\202\254`}</span>\n              </div>\n              <div className=\"flex justify-between items-center text-sm font-semibold text-brand-cream\">\n                <span>Estimation sous total :</span>\n                <span className=\"text-brand-pink font-mono\">{(product.price * quantity).toFixed(2)} \342\202\254</span>\n              </div>\n              <div className=\"text-[10px] text-brand-purple flex items-center gap-1 mt-2 font-mono\">\n                <Info className=\"w-3 h-3 text-brand-pink\" />\n                Les frais de livraison sont calcul\303\251s selon le poids final de votre sachet.\n              </div>\n            </div>\n\n            {/* CTA checkout */}\n            <button\n              type=\"submit\"\n              className=\"w-full py-3.5 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-xl cursor-pointer\"\n            >\n              <Send className=\"w-4 h-4 text-brand-bg fill-brand-bg\" />\n              G\303\251n\303\251rer ma commande WhatsApp\n            </button>\n          </form>\n        </div>\n\n      </div>\n    </div>\n  );"
      replacement_content: "  const handleWhatsAppCheckout = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!clientName.trim()) {\n      alert(\"S\'il vous pla\303\256t, saisissez votre nom pour que Christelle et M\303\251lanie puissent vous adresser.\");\n      return;\n    }\n\n    // Build precisely formatted message matching requirements\n    const msg = `Bonjour, je souhaite commander ce produit :\nProduit : ${product.name}\nCat\303\251gorie : ${product.category}\nParfum souhait\303\251 : ${selectedScent || \"\303\240 d\303\251finir\"}\nCouleur souhait\303\251e : ${selectedColor || \"\303\240 d\303\251finir\"}\nQuantit\303\251 : ${quantity || \"1\"}\nPersonnalisation : ${personalization || \"aucune / \303\240 d\303\251finir\"}\nMode souhait\303\251 : ${deliveryMode || \"retrait ou livraison \303\240 d\303\251finir\"}\nMerci \360\237\230\212\n\nNom du client: ${clientName}`.trim();\n\n    const encoded = encodeURIComponent(msg);\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\');\n  };\n\n  const handleWhatsAppInquiry = () => {\n    const inquiryMsg = `Bonjour Bh\303\251, je m\'int\303\251resse \303\240 votre cr\303\251ation \342\234\250${product.name}\342\234\250 et je souhaite vous poser une question \303\240 son sujet \360\237\230\212`;\n    const encoded = encodeURIComponent(inquiryMsg);\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto backdrop-blur-md bg-black/60\">\n      <div className=\"relative w-full max-w-5xl bg-brand-bg border border-brand-pink/20 rounded-3xl overflow-hidden shadow-2xl max-h-[92vh] flex flex-col md:flex-row\">\n        \n        {/* Close Button */}\n        <button \n          onClick={onClose}\n          className=\"absolute top-4 right-4 z-40 w-10 h-10 rounded-full bg-brand-bg/85 border border-brand-pink/15 text-brand-text-muted hover:text-brand-pink flex items-center justify-center transition-colors cursor-pointer\"\n          title=\"Fermer\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        {/* Product Visual Scroll Column (Left) */}\n        <div className=\"w-full md:w-1/2 p-6 md:p-8 bg-brand-depth flex flex-col justify-start border-r border-brand-pink/10 overflow-y-auto max-h-[45vh] md:max-h-[92vh]\">\n          <div>\n            <div className=\"rounded-2xl overflow-hidden border border-brand-pink/15 mb-6 aspect-square bg-brand-bg\">\n              <img \n                src={product.image} \n                alt={product.name} \n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n\n            <div className=\"space-y-6\">\n              <div className=\"flex flex-wrap gap-2\">\n                <span className=\"px-3 py-1 rounded-full bg-brand-pink/15 font-mono text-[10px] text-brand-pink uppercase tracking-widest font-semibold\">\n                  {product.category}\n                </span>\n                {product.hasHandmadeBadge && (\n                  <span className=\"px-3 py-1 rounded-full bg-brand-cream/5 font-mono text-[10px] text-brand-cream/85 uppercase tracking-widest border border-brand-pink/10\">\n                    \360\237\214\270 Atelier Fait Main\n                  </span>\n                )}\n              </div>\n\n              <h2 className=\"text-3xl font-serif font-bold text-brand-cream leading-tight\">\n                {product.name}\n              </h2>\n\n              <p className=\"text-sm text-brand-text-muted italic leading-relaxed\">\n                {product.longDescription}\n              </p>\n\n              {/* Rassurance Cards (4 Columns representation) */}\n              <div className=\"space-y-3\">\n                <h4 className=\"text-xs font-mono font-bold uppercase tracking-wider text-brand-pink\">Notre Charte R\303\251vieuse</h4>\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div className=\"p-3 rounded-xl bg-brand-bg/40 border border-brand-pink/5 text-left text-xs space-y-1\">\n                    <span className=\"text-brand-pink font-semibold\">\360\237\214\261 Cire de soja</span>\n                    <p className=\"text-[10px] text-brand-text-muted leading-tight\">Cire 100% soja v\303\251g\303\251tale biod\303\251gradable sans fum\303\251e toxique.</p>\n                  </div>\n                  <div className=\"p-3 rounded-xl bg-brand-bg/40 border border-brand-pink/5 text-left text-xs space-y-1\">\n                    <span className=\"text-brand-pink font-semibold\">\342\234\250 Parfums de Grasse</span>\n                    <p className=\"text-[10px] text-brand-text-muted leading-tight\">Huiles parfum\303\251es rigoureusement sans CMR ni phtalates.</p>\n                  </div>\n                  <div className=\"p-3 rounded-xl bg-brand-bg/40 border border-brand-pink/5 text-left text-xs space-y-1\">\n                    <span className=\"text-brand-pink font-semibold\">\360\237\221\220 Fait main</span>\n                    <p className=\"text-[10px] text-brand-text-muted leading-tight\">Confectionn\303\251e artisanalement avec pr\303\251caution en Bourgogne.</p>\n                  </div>\n                  <div className=\"p-3 rounded-xl bg-brand-bg/40 border border-brand-pink/5 text-left text-xs space-y-1\">\n                    <span className=\"text-brand-pink font-semibold\">\342\217\263 Pr\303\251commande</span>\n                    <p className=\"text-[10px] text-brand-text-muted leading-tight\">Environ deux semaines de fabrication pour soigner la cure.</p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Shipping / Delivery product block */}\n              <div className=\"p-4 rounded-xl bg-brand-purple/5 border border-brand-purple/10 text-xs text-brand-text-muted space-y-2\">\n                <span className=\"font-semibold text-brand-purple uppercase tracking-wider font-mono text-[10px] block\">\360\237\223\246 Exp\303\251ditions & Acheminements</span>\n                <p className=\"text-[11px] leading-relaxed\">\n                  <strong>Les frais d\342\200\231envoi</strong> sont confirm\303\251s avant paiement selon le poids, le volume et le transporteur choisi.\n                </p>\n                <p className=\"text-[11px] leading-relaxed italic text-brand-purple font-light\">\n                  \360\237\223\254 Envois d\342\200\231octobre \303\240 mars ; Retrait gratuit \303\240 domicile possible et chaleureusement encourag\303\251 toute l\'ann\303\251e !\n                </p>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n        {/* Configurations Forms Column (Right) */}\n        <div className=\"w-full md:w-1/2 p-6 md:p-8 overflow-y-auto max-h-[50vh] md:max-h-[92vh] space-y-6\">\n          <div className=\"border-b border-brand-pink/15 pb-4\">\n            <span className=\"text-[11px] font-mono text-brand-pink uppercase tracking-widest\">Choix de vos douceurs</span>\n            <h3 className=\"text-xl font-serif font-bold text-brand-cream\">Senteurs &amp; options artisanales</h3>\n          </div>\n\n          <form onSubmit={handleWhatsAppCheckout} className=\"space-y-6\">\n            {/* Scents Selection */}\n            <div>\n              <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">S\303\211LECTION PARFUM\303\211E DES INGR\303\211DIENTS</span>\n              <div className=\"grid grid-cols-2 gap-2 mt-2\">\n                {product.scents.map((scentName) => (\n                  <button\n                    key={scentName}\n                    type=\"button\"\n                    onClick={() => setSelectedScent(scentName)}\n                    className={`p-3 text-left rounded-xl text-xs font-medium border transition-colors cursor-pointer ${\n                      selectedScent === scentName \n                        ? \'bg-brand-pink/15 border-brand-pink text-brand-pink font-bold\' \n                        : \'bg-brand-depth/60 border-brand-pink/5 text-brand-text-muted hover:border-brand-pink/40\'\n                    }`}\n                  >\n                    \360\237\214\270 {scentName}\n                  </button>\n                ))}\n              </div>\n              {currentScentObj && (\n                <div className=\"mt-2 text-[11px] font-mono text-brand-purple italic\">\n                  Note : Senteur {currentScentObj.family} ({currentScentObj.family === \"Gourmand\" ? \"gourmande & sucr\303\251e\" : currentScentObj.family === \"Floral\" ? \"fleurie cocooning\" : \"fra\303\256cheur douce\"})\n                </div>\n              )}\n            </div>\n\n            {/* Colors */}\n            <div>\n              <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">COULEUR INDIVIDUALIS\303\211E DE LA CIRE</span>\n              <select\n                value={selectedColor}\n                onChange={(e) => setSelectedColor(e.target.value)}\n                className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                {colorsOption.map(co => (\n                  <option key={co} value={co}>{co}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Quantity and Delivery Mode */}\n            <div className=\"flex flex-col sm:flex-row gap-4\">\n              <div className=\"w-full sm:w-1/3\">\n                <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">QUANTIT\303\211</span>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  max=\"50\"\n                  value={quantity}\n                  onChange={(e) => setQuantity(Number(e.target.value))}\n                  className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/15 rounded-xl text-center text-sm font-semibold text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n\n              <div className=\"w-full sm:w-2/3\">\n                <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest\">ACHEMINEMENT</span>\n                <div className=\"grid grid-cols-2 gap-2 mt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setDeliveryMode(\"Retrait gratuit \303\240 l\'Atelier\")}\n                    className={`py-2 px-3 rounded-xl text-xs font-medium border text-center transition-all cursor-pointer ${\n                      deliveryMode === \"Retrait gratuit \303\240 l\'Atelier\" \n                        ? \'bg-brand-pink/15 border-brand-pink text-brand-pink font-semibold\' \n                        : \'bg-brand-depth/60 border-brand-pink/5 text-brand-text-muted\'\n                    }`}\n                  >\n                    \360\237\217\241 Retrait Atelier\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setDeliveryMode(\"Envoi postal (La Poste / Relay)\")}\n                    className={`py-2 px-3 rounded-xl text-xs font-medium border text-center transition-all cursor-pointer ${\n                      deliveryMode === \"Envoi postal (La Poste / Relay)\" \n                        ? \'bg-brand-pink/15 border-brand-pink text-brand-pink font-semibold\' \n                        : \'bg-brand-depth/60 border-brand-pink/5 text-brand-text-muted\'\n                    }`}\n                  >\n                    \360\237\223\246 Envoi Coli\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Personalization text */}\n            {product.customizable && (\n              <div>\n                <span className=\"text-xs font-mono font-bold text-brand-text-muted uppercase tracking-widest flex items-center justify-between\">\n                  <span>PERSONNALISATION DE L\'\303\211TIQUETTE</span>\n                  <span className=\"text-[10px] text-brand-purple italic\">Optionnelle</span>\n                </span>\n                <textarea\n                  placeholder=\"Inclusions de pr\303\251noms, dates pour vos cadeaux d\'invit\303\251s (ex : \'Jeanne & Pierre 24.06.26\'), rubans color\303\251s ou d\303\251cors sp\303\251cifiques...\"\n                  value={personalization}\n                  onChange={(e) => setPersonalization(e.target.value)}\n                  className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors min-h-[70px]\"\n                />\n              </div>\n            )}\n\n            {/* Disclaimer notice immediately pointing to options confirmation */}\n            <div className=\"p-3 bg-brand-pink/5 border border-brand-pink/10 rounded-xl text-center\">\n              <p className=\"text-[11px] text-brand-pink font-light italic\">\n                \360\237\233\241\357\270\217 Les options sont confirm\303\251es avec vous sur WhatsApp avant paiement.\n              </p>\n            </div>\n\n            {/* Client name input (Mandatory) */}\n            <div>\n              <span className=\"text-xs font-mono font-bold text-brand-pink uppercase tracking-widest\">NOTRE CONVERSATION - VOTRE NOM *</span>\n              <input\n                type=\"text\"\n                required\n                placeholder=\"Renseignez votre Nom & Pr\303\251nom...\"\n                value={clientName}\n                onChange={(e) => setClientName(e.target.value)}\n                className=\"w-full mt-2 p-3 bg-brand-depth border border-brand-pink/30 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink focus:ring-1 focus:ring-brand-pink transition-colors\"\n              />\n            </div>\n\n            {/* Pricing Details */}\n            <div className=\"p-4 rounded-xl bg-brand-depth/50 border border-brand-pink/10 space-y-1\">\n              <div className=\"flex justify-between items-center text-xs text-brand-text-muted\">\n                <span>Prix de base de la formule :</span>\n                <span>{product.priceText || `${product.price.toFixed(2)} \342\202\254`}</span>\n              </div>\n              <div className=\"flex justify-between items-center text-sm font-semibold text-brand-cream\">\n                <span>Sous-total estimatif :</span>\n                <span className=\"text-brand-pink font-mono text-base font-bold\">{(product.price * quantity).toFixed(2)} \342\202\254</span>\n              </div>\n            </div>\n\n            {/* Dual CTAs: Primary whatsapp checkout and secondary pos-questions */}\n            <div className=\"flex flex-col gap-3\">\n              <button\n                type=\"submit\"\n                className=\"w-full py-3.5 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-xl cursor-pointer\"\n              >\n                <Send className=\"w-4 h-4 text-brand-bg fill-brand-bg\" />\n                Commander ce produit sur WhatsApp\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleWhatsAppInquiry}\n                className=\"w-full py-3 bg-brand-depth text-brand-pink border border-brand-pink/20 font-bold text-xs tracking-wider uppercase rounded-full hover:bg-white/5 transition-all flex items-center justify-center gap-2 cursor-pointer\"\n              >\n                <HelpCircle className=\"w-4 h-4 text-brand-pink\" />\n                Poser une question\n              </button>\n            </div>\n          </form>\n        </div>\n\n      </div>\n    </div>\n  );"
    }
