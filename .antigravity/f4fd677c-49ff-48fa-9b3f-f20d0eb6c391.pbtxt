    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  ShieldCheck, \n  Scale, \n  FileText, \n  Truck, \n  ArrowRight, \n  AlertCircle, \n  Info, \n  Building, \n  Smartphone, \n  Globe, \n  Lock \n} from \'lucide-react\';\n\ninterface LegalPagesProps {\n  initialSubTab?: string;\n  onNavigateToContact?: () => void;\n}\n\n// 1. MODULE: LegalPageLayout\nexport function LegalPageLayout({ children }: { children: React.ReactNode }) {\n  return (\n    <div className=\"max-w-[900px] mx-auto text-left space-y-8\" id=\"legal-layout-root\">\n      {children}\n    </div>\n  );\n}\n\n// 2. MODULE: LegalHero\nexport function LegalHero({ title, subtitle }: { title: string; subtitle: string }) {\n  return (\n    <div className=\"border-b border-brand-pink/15 pb-6 space-y-2 text-left\" id=\"legal-hero-section\">\n      <h1 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">{title}</h1>\n      <p className=\"text-xs text-brand-text-muted font-light\">{subtitle}</p>\n    </div>\n  );\n}\n\n// 3. MODULE: LegalSection\nexport function LegalSection({ title, children }: { title: string; children: React.ReactNode }) {\n  return (\n    <div className=\"space-y-3 pb-6 border-b border-brand-pink/10 last:border-b-0 pt-2 text-left\">\n      <h3 className=\"font-serif font-bold text-sm text-brand-cream flex items-center gap-2\">\n        <span className=\"w-1.5 h-1.5 bg-brand-pink rounded-full\" />\n        {title}\n      </h3>\n      <div className=\"text-xs text-brand-text-muted leading-relaxed font-light space-y-2 pl-3.5\">\n        {children}\n      </div>\n    </div>\n  );\n}\n\n// 4. MODULE: LegalInfoList\nexport function LegalInfoList({ items }: { items: { label: string; value: string | React.ReactNode }[] }) {\n  return (\n    <ul className=\"space-y-2 mt-2 font-mono text-[11px] bg-brand-bg/60 border border-brand-pink/5 p-4 rounded-xl\">\n      {items.map((it, idx) => (\n        <li key={idx} className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1 border-b border-brand-pink/5 last:border-b-0 pb-1.5 last:pb-0\">\n          <span className=\"text-brand-text-muted font-medium\">{it.label} :</span>\n          <span className=\"text-brand-pink font-semibold\">{it.value}</span>\n        </li>\n      ))}\n    </ul>\n  );\n}\n\nexport default function LegalPages({ initialSubTab = \'mentions\', onNavigateToContact }: LegalPagesProps) {\n  const [subTab, setSubTab] = useState<string>(initialSubTab);\n\n  useEffect(() => {\n    setSubTab(initialSubTab);\n  }, [initialSubTab]);\n\n  const tabs = [\n    { id: \'mentions\', label: \'Mentions L\303\251gales\', icon: <Scale className=\"w-4 h-4\" /> },\n    { id: \'cgv\', label: \'Conditions G\303\251n\303\251rales (CGV)\', icon: <FileText className=\"w-4 h-4\" /> },\n    { id: \'confidentialite\', label: \'Confidentialit\303\251\', icon: <ShieldCheck className=\"w-4 h-4\" /> },\n    { id: \'livraison-retrait\', label: \'Livraison & Retrait\', icon: <Truck className=\"w-4 h-4\" /> }\n  ];\n\n  return (\n    <div className=\"space-y-10 pb-12\" id=\"legal-pages-view\">\n      \n      {/* Tab Navigation header */}\n      <div className=\"flex flex-wrap justify-center gap-2 border-b border-brand-pink/10 pb-6\">\n        {tabs.map((tab) => (\n          <button\n            key={tab.id}\n            onClick={() => {\n              setSubTab(tab.id);\n              window.scrollTo({ top: 300, behavior: \'smooth\' });\n            }}\n            className={`px-4.5 py-2.5 rounded-full text-xs font-semibold tracking-wide flex items-center gap-2 transition-all cursor-pointer ${\n              subTab === tab.id \n                ? \'bg-brand-pink text-brand-bg shadow-md\' \n                : \'bg-brand-depth/60 text-brand-text-muted border border-brand-pink/5 hover:border-brand-pink/30 hover:text-brand-cream\'\n            }`}\n          >\n            {tab.icon}\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Main card representation */}\n      <div className=\"max-w-4xl mx-auto bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-10 shadow-xl\">\n        <LegalPageLayout>\n          \n          {subTab === \'mentions\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"space-y-6\"\n            >\n              {/* exact Hero matching prompt */}\n              <LegalHero \n                title=\"Mentions l\303\251gales\" \n                subtitle=\"Informations relatives \303\240 l\342\200\231\303\251diteur, \303\240 l\342\200\231h\303\251bergement et \303\240 l\342\200\231utilisation du site.\" \n              />\n\n              {/* exact \303\211diteur du site component partition */}\n              <LegalSection title=\"1. \303\211diteur de l\'Atelier\">\n                <p>\n                  Ce site internet est l\342\200\231enseigne collective de pr\303\251sentation de notre manufacture artisanale. Ses activit\303\251s commerciales d\'art et vente assist\303\251e de bougies et fondants sont repr\303\251sent\303\251es individuellement par :\n                </p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Nom commercial\", value: \"R\303\252ve Parfum\303\251 Cr\303\251ation\" },\n                    { label: \"Responsable n\302\2601\", value: \"M\303\251lanie G. (Atelier d\'harmonie saine)\" },\n                    { label: \"Responsable n\302\2602\", value: \"Christelle L. (Atelier style & contenants)\" },\n                    { label: \"Statut l\303\251gal\", value: \"Micro-entreprises \303\240 confirmer\" },\n                    { label: \"SIRET M\303\251lanie\", value: \"[\303\200 compl\303\251ter pour M\303\251lanie]\" },\n                    { label: \"SIRET Christelle\", value: \"[\303\200 compl\303\251ter pour Christelle]\" },\n                    { label: \"Adresse professionnelle\", value: \"[\303\200 compl\303\251ter pour l\'Atelier]\" },\n                    { label: \"Contact \303\251ditrices\", value: \"contact@reveparfume.fr\" },\n                    { label: \"T\303\251l\303\251phone\", value: \"[\303\200 compl\303\251ter si affich\303\251]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              {/* exact Responsable de publication */}\n              <LegalSection title=\"2. Responsable de la Publication\">\n                <p>Le pilotage \303\251ditorial et la conformit\303\251 s\303\251mantique de notre catalogue de cire de soja sont assur\303\251s par :</p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Nom du directeur de publication\", value: \"[\303\200 compl\303\251ter]\" },\n                    { label: \"Contact d\'attention\", value: \"[\303\200 compl\303\251ter]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              {/* exact H\303\251bergeur */}\n              <LegalSection title=\"3. H\303\251bergement du Domaine\">\n                <p>Le sillage de code et les flux visuels du site sont conserv\303\251s de mani\303\250re \303\251cologique et isol\303\251e aupr\303\250s de :</p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Nom de l\'H\303\251bergeur\", value: \"[\303\200 compl\303\251ter]\" },\n                    { label: \"Adresse physique\", value: \"[\303\200 compl\303\251ter]\" },\n                    { label: \"Site internet officiel\", value: \"[\303\200 compl\303\251ter]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              {/* exact Propri\303\251t\303\251 intellectuelle */}\n              <LegalSection title=\"4. Propri\303\251t\303\251 Intellectuelle\">\n                <p className=\"font-light\">\n                  Les contenus du site, textes, photos, cr\303\251ations, visuels et \303\251l\303\251ments graphiques sont prot\303\251g\303\251s. Toute reproduction non autoris\303\251e est interdite.\n                </p>\n                <p className=\"text-[11px] italic\">\n                  Chaque ornement de fleurs s\303\251ch\303\251es, chaque moulage, et chaque sillage de mots d\303\251crivant les essences aromatiques sont n\303\251s sous nos doigts et r\303\251gis par les droits d\'auteur.\n                </p>\n              </LegalSection>\n\n              {/* exact Responsabilit\303\251 */}\n              <LegalSection title=\"5. Clause de Responsabilit\303\251\">\n                <p className=\"font-light\">\n                  Les informations pr\303\251sentes sur le site peuvent \303\251voluer. Les commandes, prix finaux, frais de livraison et d\303\251lais sont confirm\303\251s avant paiement.\n                </p>\n                <p className=\"text-[11px] italic\">\n                  R\303\252ve Parfum\303\251 Cr\303\251ation ne r\303\251alise aucun encaissement automatique ou transaction bancaire brute sans conseil assist\303\251 en amont.\n                </p>\n              </LegalSection>\n\n              {/* exact Contact section */}\n              <div className=\"pt-6 border-t border-brand-pink/10 flex flex-col sm:flex-row justify-between items-center gap-4\">\n                <p className=\"text-xs text-brand-text-muted/80 font-light\">\n                  Besoin de clarifier un point l\303\251gal ou des factures de comit\303\251 ?\n                </p>\n                <button\n                  onClick={onNavigateToContact}\n                  className=\"px-5 py-2.5 rounded-full bg-brand-pink/10 hover:bg-brand-pink text-brand-pink hover:text-brand-bg text-[11px] font-bold tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer hover:-translate-y-0.5\"\n                >\n                  Nous contacter\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n\n            </motion.div>\n          )}\n\n          {subTab === \'cgv\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"space-y-6\"\n            >\n              <LegalHero \n                title=\"Conditions G\303\251n\303\251rales de Vente (CGV)\" \n                subtitle=\"R\303\250gles contractuelles fixant les commandes personnalisables et le sillage logistique.\" \n              />\n              \n              <LegalSection title=\"1. Objet des Pr\303\251sentes\">\n                <p>Les pr\303\251sentes Conditions G\303\251n\303\251rales (CGV) encadrent la vente de cr\303\251ations parfum\303\251es v\303\251g\303\251tales de la marque R\303\252ve Parfum\303\251 Cr\303\251ation, fa\303\247onn\303\251es par Christelle L. et M\303\251lanie G., en Bourgogne.</p>\n              </LegalSection>\n\n              <LegalSection title=\"2. Prestations d\'Atelier &amp; Artisanat\">\n                <p>Nos bougies, fondants, bouquets aromatiques et suspensions d\'armoires sont fabriqu\303\251s avec de la cire de soja pure et des huiles de Grasse de premi\303\250re s\303\251lection. Des diff\303\251rences naturelles de disposition v\303\251g\303\251tale ou de teintes peuvent survenir : elles attestent de la singularit\303\251 du travail manuel.</p>\n              </LegalSection>\n\n              <LegalSection title=\"3. Tarification &amp; Devis\">\n                <p>Les prix indiqu\303\251s excluent les co\303\273ts de transport postal, factur\303\251s \303\240 prix co\303\273tant en fonction du poids global. TVA non applicable (art. 293 B du Code g\303\251n\303\251ral des imp\303\264ts).</p>\n              </LegalSection>\n\n              <LegalSection title=\"4. Commandes &amp; R\303\251tractation\">\n                <p>Les commandes sont valid\303\251es d\'un commun accord lors de l\'\303\251change WhatsApp. Conform\303\251ment au Code de la consommation fran\303\247ais, vous disposez d\'un droit de 14 jours de r\303\251tractation pour les pi\303\250ces ordinaires non ouvertes.</p>\n                <p className=\"text-[11px] border-l border-brand-pink px-2 italic\">Les pi\303\250ces confectionn\303\251es sur-mesure (\303\251tiquettes mari\303\251s, coloris exclusifs Coul\303\251s) sont explicitement priv\303\251es de droit d\'annulation apr\303\250s commencement de coulage ou de gravure.</p>\n              </LegalSection>\n            </motion.div>\n          )}\n\n          {subTab === \'confidentialite\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"space-y-6\"\n            >\n              <LegalHero \n                title=\"Politique de Confidentialit\303\251\" \n                subtitle=\"Votre tranquillit\303\251 et le respect int\303\250gre de vos coordonn\303\251es de contact.\" \n              />\n\n              <LegalSection title=\"1. Collecte &amp; Usages\">\n                <p>Nous n\342\200\231enregistrons aucun cookie publicitaire invasif sur notre site. Vos coordonn\303\251es (nom, mobile) sont temporairement transcrites sur votre canal WhatsApp afin que nous puissions affiner notre conseil de senteurs.</p>\n              </LegalSection>\n\n              <LegalSection title=\"2. Propri\303\251t\303\251 &amp; Confidentialit\303\251 absolue\">\n                <p>Vos discussions ne quittent jamais notre fil WhatsApp priv\303\251 et ne sont sous aucun pr\303\251texte divulgu\303\251es ou c\303\251d\303\251es de mani\303\250re mercantile \303\240 des tiers, \303\240 l\'exception de l\'\303\251tiquette postale Colissimo ou Mondial Relay.</p>\n              </LegalSection>\n            </motion.div>\n          )}\n\n          {subTab === \'livraison-retrait\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"space-y-6\"\n            >\n              <LegalHero \n                title=\"Logistique, Livraison &amp; Retraits d\'Atelier\" \n                subtitle=\"Des pr\303\251cautions d\'envois adapt\303\251es aux fleurs s\303\251ch\303\251es et \303\240 la texture saine de nos bougies.\" \n              />\n\n              <LegalSection title=\"1. Dur\303\251e d\'attente de cure (environ 2 semaines)\">\n                <p>La cire de soja bio exige deux semaines de solidification chimique lente en \303\251tag\303\250re ferm\303\251e pour sceller de fa\303\247on intense les concentr\303\251s odorants naturels. Prenez cela en compte pour vos pr\303\251paratifs de f\303\252tes.</p>\n              </LegalSection>\n\n              <LegalSection title=\"2. Restrictions postales de chaleur\">\n                <p>Comme notre cire v\303\251g\303\251tale saine ne comporte pas de parrafine synth\303\251tique dure, elle est \303\240 basse fusion mol\303\251culaire. Les exp\303\251ditions de colis ne s\'effectuent donc que d\'<strong>octobre \303\240 mars</strong>. En saison estivale chaude, nous vous invitons chaleureusement \303\240 retirer vos achats \303\240 l\'atelier.</p>\n              </LegalSection>\n\n              <LegalSection title=\"3. Suivi &amp; Protection visuelle des colis\">\n                <p>Pots en verre ambr\303\251, cadres et bougeoirs de c\303\251ramiques gr\303\250s sont doucement capitonn\303\251s de paille de kraft. Une illustration vid\303\251o ou photo est enregistr\303\251e par nos soins lors de l\'assemblage pour consolider le dossier d\'acheminement postal.</p>\n              </LegalSection>\n            </motion.div>\n          )}\n\n        </LegalPageLayout>\n      </div>\n\n    </div>\n  );\n}\n"
    }
