        lines {
          text: "              <div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">1. Objet & Application</h3>"
