    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Truck, \n  Clock, \n  MapPin, \n  ShieldCheck, \n  HelpCircle, \n  ChevronDown, \n  Coins, \n  MessageSquare, \n  ArrowRight, \n  CalendarSearch,\n  CheckCircle,\n  FileText,\n  Camera,\n  Layers,\n  Sparkles\n} from \'lucide-react\';\n\ninterface DeliveryPageProps {\n  onNavigateToContact?: () => void;\n  onNavigateToBoutique?: () => void;\n}\n\nexport default function DeliveryPage({ onNavigateToContact, onNavigateToBoutique }: DeliveryPageProps) {\n  const [activeFaq, setActiveFaq] = useState<number | null>(null);\n\n  const steps = [\n    {\n      num: \"01\",\n      title: \"Prise de contact amicale\",\n      desc: \"Vous formulez votre projet (s\303\251lection, personnalisations de cires ou parfums) directement sur notre WhatsApp assist\303\251.\"\n    },\n    {\n      num: \"02\",\n      title: \"Validation de la commande\",\n      desc: \"M\303\251lanie et Christelle \303\251tudient les volumes, finalisent le devis et fixent le d\303\251lai exact de cr\303\251ation.\"\n    },\n    {\n      num: \"03\",\n      title: \"Soin de la fabrication\",\n      desc: \"Chaque cire v\303\251g\303\251tale bio est coul\303\251e individuellement \303\240 la main dans notre atelier de Bourgogne (deux semaines en moyenne).\"\n    },\n    {\n      num: \"04\",\n      title: \"Emballage & Exp\303\251dition\",\n      desc: \"Vos cr\303\251ations sont emball\303\251es sous haute protection. Nous fixons un rendez-vous pour le retrait ou exp\303\251dions le colis.\"\n    }\n  ];\n\n  const seasonalMonths = [\n    {\n      title: \"Envoi \303\240 prix co\303\273tant (Octobre \303\240 Mars)\",\n      desc: \"Durant l\'automne et l\'hiver, profitez d\'envois sans risque de fonte. Nous exp\303\251dions vers toute la France m\303\251tropolitaine via nos transporteurs agr\303\251\303\251s.\",\n      active: true,\n      sub: \"Recommand\303\251 pour les commandes de bougies et fondants fins.\"\n    },\n    {\n      title: \"Retrait Atelier privil\303\251gi\303\251 (Avril \303\240 Septembre)\",\n      desc: \"Durant les fortes chaleurs estivales, nous encourageons chaleureusement le retrait gratuit directement en Bourgogne afin de pr\303\251server l\'int\303\251grit\303\251 de la cire de soja.\",\n      active: false,\n      sub: \"Les envois restent possibles mais font l\'objet d\'une validation sp\303\251cifique.\"\n    }\n  ];\n\n  const carriers = [\n    {\n      name: \"La Poste / Colissimo\",\n      speed: \"48h \303\240 72h \303\240 domicile\",\n      desc: \"L\'exp\303\251dition de confiance directement dans votre bo\303\256te aux lettres, id\303\251ale pour les colis d\'un poids moyen.\"\n    },\n    {\n      name: \"Mondial Relay\",\n      speed: \"3 \303\240 5 jours ouvr\303\251s en Point Relais\",\n      desc: \"Solution \303\251conomique de retrait de proximit\303\251, id\303\251ale pour r\303\251cup\303\251rer souplement vos bouquets et fondants.\"\n    },\n    {\n      name: \"Chronopost Express\",\n      speed: \"24h chez vous\",\n      desc: \"Pour les cadeaux urgents ou les animations de mariages dont la date approche rapidement.\"\n    }\n  ];\n\n  const faqs = [\n    {\n      q: \"Dans quel d\303\251lai vais-je recevoir mes cr\303\251ations parfum\303\251es ?\",\n      a: \"Chaque contenant c\303\251ramique ou suspension en cire est fa\303\247onn\303\251 et coul\303\251 de fa\303\247on artisanale \303\240 la commande. Notre cycle moyen de fabrication et de s\303\251chage de la cire naturelle de soja est de deux semaines. Ce temps est indispensable pour que les essences de Grasse saturent la cire de fa\303\247on saine.\"\n    },\n    {\n      q: \"Pourquoi favorisez-vous le retrait direct durant l\'\303\251t\303\251 ?\",\n      a: \"La pure cire de soja que nous utilisons fond \303\240 basse temp\303\251rature (environ 50 degr\303\251s), ce qui garantit sa puret\303\251 v\303\251g\303\251tale. Cependant, dans les camions de transport ou les bo\303\256tes aux lettres en plein soleil d\'\303\251t\303\251, ces temp\303\251ratures sont vite atteintes. Pour \303\251viter de d\303\251former vos jolis d\303\251cors ou vos fleurs s\303\251ch\303\251es incrust\303\251es, nous privil\303\251gions le retrait ou attendons un cr\303\251neau m\303\251t\303\251o doux.\"\n    },\n    {\n      q: \"Combien co\303\273tent r\303\251ellement les frais de livraison ?\",\n      a: \"Nous ne g\303\251n\303\251rons aucune marge commerciale sur le transport. Les frais de port vous sont factur\303\251s au tarif r\303\251el selon la grille d\'exp\303\251dition officielle du transporteur que vous choisissez, d\303\251termin\303\251e par le poids total th\303\251orique de vos cires et emballages.\"\n    },\n    {\n      q: \"Comment garantissez-vous que le colis n\'arrive pas d\303\251truit ?\",\n      a: \"Vos produits parfum\303\251s sont de v\303\251ritables \305\223uvres d\303\251licates. Pour les prot\303\251ger, nous doublons les colis de calages \303\251cologiques amortisseurs. Avant de sceller le carton d\'exp\303\251dition, nous r\303\251alisons syst\303\251matiquement une capture photo de contr\303\264le pour garder une trace qualitative de notre soin de pr\303\251paration.\"\n    },\n    {\n      q: \"O\303\271 se situe l\'atelier pour le retrait gratuit en Bourgogne ?\",\n      a: \"Notre atelier de cr\303\251ation se situe \303\240 proximit\303\251 de Chalon-sur-Sa\303\264ne, en Bourgogne. Les coordonn\303\251es GPS exactes ou notre adresse vous seront amicalement indiqu\303\251es par WhatsApp une fois vos produits assembl\303\251s.\"\n    },\n    {\n      q: \"Que faire si un amoncellement de produits arrive cass\303\251 ?\",\n      a: \"D\303\250s r\303\251ception, inspectez l\'\303\251tat de la bo\303\256te. En cas de choc visible occasionn\303\251 par le transporteur, prenez des photos sous plusieurs angles avant m\303\252me l\'allumage des m\303\250ches. Contactez-nous imm\303\251diatement via notre ligne WhatsApp pour que nous trouvions une solution r\303\251jouissante pour vous.\"\n    }\n  ];\n\n  const handleWhatsAppContact = () => {\n    const text = encodeURIComponent(\n      \"Bonjour Christelle et M\303\251lanie, je souhaite me renseigner sur les formalit\303\251s d\'exp\303\251dition ou de retrait \303\240 l\'atelier d\'une cr\303\251ation R\303\252ve Parfum\303\251 !\"\n    );\n    window.open(`https://wa.me/33600000000?text=${text}`, \'_blank\', \'noopener,noreferrer\');\n  };\n\n  return (\n    <div className=\"space-y-20 pt-4 text-left\">\n      \n      {/* 1. HERO EXP\303\211DITION */}\n      <section className=\"text-center space-y-6 relative max-w-3xl mx-auto py-10\">\n        <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-48 h-48 bg-brand-pink/15 rounded-full blur-[65px] pointer-events-none\" />\n        \n        <div className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand-pink/10 border border-brand-pink/20 text-brand-pink text-xs font-mono font-bold uppercase tracking-widest leading-none\">\n          <Truck className=\"w-4 h-4 text-brand-pink\" />\n          Pr\303\251commande &amp; Retrait Bourgogne\n        </div>\n\n        <h1 className=\"text-4xl md:text-6xl font-serif font-bold text-brand-cream tracking-tight leading-none\">\n          Livraison, retrait et <span className=\"font-light italic text-brand-purple\">confection</span>\n        </h1>\n\n        <p className=\"text-sm md:text-base text-brand-text-muted leading-relaxed font-light\">\n          Chaque cr\303\251ation parfum\303\251e de l\'atelier fait l\'objet d\'un coulage d\303\251di\303\251 \303\240 la commande. Nous prenons le temps n\303\251cessaire pour parfaire chaque finition.\n        </p>\n\n        <div className=\"flex flex-wrap items-center justify-center gap-4 pt-4\">\n          <button\n            onClick={handleWhatsAppContact}\n            className=\"px-6 py-3.5 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md flex items-center gap-1.5 cursor-pointer\"\n          >\n            <MessageSquare className=\"w-4 h-4\" />\n            Poser une question livraison\n          </button>\n          <button\n            onClick={onNavigateToBoutique}\n            className=\"px-6 py-3.5 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 font-bold text-xs tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer\"\n          >\n            Voir la boutique\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </section>\n\n      {/* 2. BLOC PROCESSUS PR\303\211COMMANDE */}\n      <section className=\"space-y-8 bg-brand-depth/40 border border-brand-pink/10 rounded-3xl p-8 md:p-12 relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-80 h-80 bg-brand-pink/5 rounded-full blur-[90px] pointer-events-none\" />\n        \n        <div className=\"max-w-2xl space-y-3\">\n          <span className=\"text-xs font-mono text-brand-pink tracking-widest uppercase font-semibold\">M\303\251thodologie d\'Atelier</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Chaque cr\303\251ation parfum\303\251e est fa\303\247onn\303\251e \303\240 la main\n          </h2>\n          <p className=\"text-xs md:text-sm text-brand-text-muted leading-relaxed font-light\">\n            Pour conserver toute l\'intensit\303\251 de nos huiles et fleurs s\303\251ch\303\251es, nous ne stockons aucun produit fini de longue dur\303\251e dans un hangar froid. Christelle et M\303\251lanie lancent les fabrications une fois votre commande assist\303\251e valid\303\251e.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-6\">\n          {steps.map((st, i) => (\n            <div key={i} className=\"p-6 bg-brand-depth border border-brand-pink/5 rounded-2xl space-y-3 flex flex-col justify-between hover:border-brand-pink/20 transition-all\">\n              <div className=\"space-y-2\">\n                <span className=\"block text-2xl font-mono text-brand-pink font-bold border-b border-brand-pink/10 pb-2\">\n                  {st.num}\n                </span>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream tracking-wide\">{st.title}</h3>\n                <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light\">{st.desc}</p>\n              </div>\n              <div className=\"flex items-center gap-1.5 text-[9px] font-mono text-brand-pink/70 pt-2\">\n                <CheckCircle className=\"w-3.5 h-3.5\" />\n                Valid\303\251 par l\'Atelier\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 3. TIMELINE SIMPLIFI\303\211E */}\n      <section className=\"space-y-12\">\n        <div className=\"text-center space-y-2\">\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            D\303\251lai d\'acheminement moyen\n          </h2>\n          <p className=\"text-xs text-brand-text-muted max-w-lg mx-auto leading-relaxed\">\n            Un processus paisible et transparent pour une cire d\'une qualit\303\251 aromatique irr\303\251prochable.\n          </p>\n        </div>\n\n        <div className=\"max-w-4xl mx-auto relative pl-6 sm:pl-0\">\n          {/* Vertical central path on desktop */}\n          <div className=\"hidden sm:block absolute left-1/2 top-4 bottom-4 w-px bg-brand-pink/15 -translate-x-1/2\" />\n          {/* Vertical side path on mobile */}\n          <div className=\"sm:hidden absolute left-2.5 top-2 bottom-2 w-px bg-brand-pink/15\" />\n\n          <div className=\"space-y-12 relative\">\n            \n            {/* Timeline item 1 */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 items-center\">\n              <div className=\"sm:text-right sm:pr-8 space-y-1.5 relative\">\n                <div className=\"absolute left-[-21px] sm:left-auto sm:right-[-29px] top-1.5 w-4 h-4 rounded-full bg-brand-pink border border-brand-bg shadow-sm\" />\n                <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-pink font-bold\">Jour J</span>\n                <h4 className=\"font-serif font-bold text-sm text-brand-cream\">Validation de commande</h4>\n                <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">\n                  L\'accord est scell\303\251 par WhatsApp avec la r\303\251ception de vos choix d\303\251coratifs et d\'essences de Grasse.\n                </p>\n              </div>\n              <div className=\"hidden sm:block\" />\n            </div>\n\n            {/* Timeline item 2 */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 items-center\">\n              <div className=\"hidden sm:block\" />\n              <div className=\"sm:pl-8 space-y-1.5 relative\">\n                <div className=\"absolute left-[-21px] sm:left-[-11px] top-1.5 w-4 h-4 rounded-full bg-brand-purple border border-brand-bg shadow-sm\" />\n                <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-purple font-bold\">Semaine 1</span>\n                <h4 className=\"font-serif font-bold text-sm text-brand-cream font-medium\">Pr\303\251paration &amp; Moulage</h4>\n                <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">\n                  Coulage individuel \303\240 basse temp\303\251rature de la cire de soja, ornementation florale et cristallisation \303\240 l\'abri des variations d\'air.\n                </p>\n              </div>\n            </div>\n\n            {/* Timeline item 3 */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 items-center\">\n              <div className=\"sm:text-right sm:pr-8 space-y-1.5 relative\">\n                <div className=\"absolute left-[-21px] sm:left-auto sm:right-[-29px] top-1.5 w-4 h-4 rounded-full bg-brand-pink border border-brand-bg shadow-sm\" />\n                <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-pink font-bold\">Semaine 2</span>\n                <h4 className=\"font-serif font-bold text-sm text-brand-cream\">S\303\251chage &amp; Contr\303\264le esth\303\251tique</h4>\n                <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">\n                  La cire acquiert sa fermet\303\251 de cire dure. Nous contr\303\264lons l\'harmonie des motifs floraux et le comportement des m\303\250ches de coton ou de bois.\n                </p>\n              </div>\n              <div className=\"hidden sm:block\" />\n            </div>\n\n            {/* Timeline item 4 */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 items-center\">\n              <div className=\"hidden sm:block\" />\n              <div className=\"sm:pl-8 space-y-1.5 relative\">\n                <div className=\"absolute left-[-21px] sm:left-[-11px] top-1.5 w-4 h-4 rounded-full bg-brand-purple border border-brand-bg shadow-sm\" />\n                <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-purple font-bold\">Jour J+14</span>\n                <h4 className=\"font-serif font-bold text-sm text-brand-cream font-medium\">Prise en charge postale</h4>\n                <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">\n                  Enveloppement sous carton double cannelure et remise au transporteur de votre r\303\251gion.\n                </p>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 4. P\303\211RIODES D\'ENVOI SAISONNIER */}\n      <section className=\"space-y-6\">\n        <div className=\"max-w-2xl\">\n          <span className=\"text-xs font-mono text-brand-pink tracking-widest uppercase font-semibold\">Thermodynamique de la Cire</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream mt-1\">\n            P\303\251riodes d\'envois adapt\303\251es \303\240 la m\303\251t\303\251o\n          </h2>\n          <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n            La cire de soja naturelle est particuli\303\250rement sensible aux fortes chaleurs d\'\303\251t\303\251 lors du parcours de transit postal. Nous avons mis en place des cr\303\251neaux clairs pour parer \303\240 tout d\303\251sagr\303\251ment.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 pt-2\">\n          {seasonalMonths.map((month, i) => (\n            <div \n              key={i} \n              className={`p-6 bg-brand-depth border rounded-2xl text-left space-y-4 hover:shadow-2xl transition-all duration-300 ${\n                month.active \n                  ? \'border-brand-pink/25 bg-brand-depth/60\' \n                  : \'border-brand-pink/10 opacity-80\'\n              }`}\n            >\n              <div className=\"flex items-center gap-2 border-b border-brand-pink/5 pb-2\">\n                <CalendarSearch className={`w-5 h-5 ${month.active ? \'text-brand-pink\' : \'text-brand-purple\'}`} />\n                <h3 className=\"font-serif font-bold text-base text-brand-cream\">{month.title}</h3>\n              </div>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">{month.desc}</p>\n              <div className=\"text-[11px] text-brand-pink font-mono leading-tight pl-2 border-l-2 border-brand-pink/20\">\n                {month.sub}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 5. TRANSPORTEURS DISPONIBLES */}\n      <section className=\"space-y-6\">\n        <h3 className=\"text-xl font-serif font-bold text-brand-cream border-b border-brand-pink/10 pb-3\">\n          Transporteurs &amp; Acheminements du quotidien\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {carriers.map((c, i) => (\n            <div key={i} className=\"p-5 bg-brand-depth border border-brand-pink/10 rounded-2xl text-left space-y-3 hover:border-brand-pink/20 transition-all\">\n              <span className=\"text-xs font-mono font-bold text-brand-pink uppercase bg-brand-pink/5 px-2.5 py-1 rounded-md border border-brand-pink/10 inline-block\">\n                {c.name}\n              </span>\n              <p className=\"text-xs font-bold text-brand-cream\">{c.speed}</p>\n              <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light\">{c.desc}</p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 6. FRAIS DE LIVRAISON ESTIM\303\211S */}\n      <section className=\"space-y-6\">\n        <div className=\"p-6 bg-brand-depth/40 border border-brand-pink/10 rounded-3xl space-y-4\">\n          <div className=\"flex items-center gap-2 border-b border-brand-pink/5 pb-3\">\n            <Coins className=\"w-5 h-5 text-brand-pink\" />\n            <h4 className=\"font-serif font-semibold text-lg text-brand-cream\">Calcul amical des frais de livraison</h4>\n          </div>\n          <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n            Le co\303\273t de l\'envoi postal d\303\251pend strictement du poids global pond\303\251r\303\251 de vos cr\303\251ations (cire + poids du carton et intercalaires). Les tarifs d\'exp\303\251dition vous seront valid\303\251s \303\240 prix co\303\273tant, sans aucune marge, lors de notre chiffrage amical sur WhatsApp.\n          </p>\n\n          <div className=\"overflow-x-auto pt-2\">\n            <table className=\"w-full text-left text-xs font-mono text-brand-text-muted\">\n              <thead>\n                <tr className=\"border-b border-brand-pink/15 text-[10px] text-brand-pink tracking-widest uppercase\">\n                  <th className=\"py-2.5 px-3\">Cat\303\251gorie de colis</th>\n                  <th className=\"py-2.5 px-3\">Poids estim\303\251</th>\n                  <th className=\"py-2.5 px-3 text-right\">Tarifs indicatifs</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-brand-pink/5\">\n                <tr>\n                  <td className=\"py-3 px-3 text-brand-cream font-medium\">Brumes &amp; Petits sachets de fondants</td>\n                  <td className=\"py-3 px-3\">Moins de 250g</td>\n                  <td className=\"py-3 px-3 text-right text-brand-pink font-bold\">\303\200 partir de 4.90 \342\202\254</td>\n                </tr>\n                <tr>\n                  <td className=\"py-3 px-3 text-brand-cream font-medium\">Bougies en pot de c\303\251ramique &amp; Diffuseurs</td>\n                  <td className=\"py-3 px-3\">De 500g \303\240 1kg</td>\n                  <td className=\"py-3 px-3 text-right text-brand-pink font-bold\">\303\200 partir de 6.90 \342\202\254</td>\n                </tr>\n                <tr>\n                  <td className=\"py-3 px-3 text-brand-cream font-medium\">Coffrets cadeaux garnis &amp; Commandes mariages</td>\n                  <td className=\"py-3 px-3\">De 1kg \303\240 3kg</td>\n                  <td className=\"py-3 px-3 text-right text-brand-pink font-bold\">\303\200 confirmer</td>\n                </tr>\n                <tr>\n                  <td className=\"py-3 px-3 text-brand-cream font-medium\">Grands volumes d\'animations de table d\'honneur</td>\n                  <td className=\"py-3 px-3\">Plus de 3kg</td>\n                  <td className=\"py-3 px-3 text-right text-brand-pink font-bold\">Sur-mesure offert d\303\250s un palier d\303\251fini</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </section>\n\n      {/* 7. RETRAIT \303\200 DOMICILE DIRECT */}\n      <section className=\"grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-brand-depth/25 p-6 md:p-8 rounded-3xl border border-brand-pink/10 relative overflow-hidden\">\n        <div className=\"space-y-4\">\n          <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-brand-pink/10 text-brand-pink text-[10px] font-mono uppercase tracking-wider font-bold\">\n            <MapPin className=\"w-3.5 h-3.5\" />\n            Remis en direct\n          </span>\n          <h3 className=\"text-xl font-serif font-bold text-brand-cream\">\n            Retrait \303\240 l\'atelier de Bourgogne\n          </h3>\n          <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n            Nous fixons ensemble par messagerie un cr\303\251neau souple pour votre venue. Votre commande vous est remise en mains propres, entour\303\251e d\'un sac kraft recycl\303\251 soign\303\251. L\'adresse exacte de rendez-vous vous est communiqu\303\251e d\303\250s confirmation finale de la cire v\303\251g\303\251tale coul\303\251e.\n          </p>\n          <ul className=\"space-y-2 text-[11px] font-mono text-brand-text-muted\">\n            <li className=\"flex items-center gap-2\">\n              <CheckCircle className=\"w-4 h-4 text-brand-pink shrink-0\" />\n              Retrait 100% gratuit, sans aucun frais de manutention\n            </li>\n            <li className=\"flex items-center gap-2\">\n              <CheckCircle className=\"w-4 h-4 text-brand-pink shrink-0\" />\n              Id\303\251al pour faire connaissance et partager notre amour des senteurs\n            </li>\n          </ul>\n        </div>\n        <div className=\"p-6 bg-brand-bg rounded-2xl border border-brand-pink/5 text-center space-y-4 shadow-inner\">\n          <span className=\"block text-2xl\">\360\237\217\241</span>\n          <p className=\"text-xs text-brand-cream font-serif italic\">\"Une occasion parfaite de r\303\251cup\303\251rer vos cires au vert, \303\240 l\'heure qui vous arrange.\"</p>\n          <span className=\"block text-[10px] font-mono text-brand-text-muted/60 uppercase\">Christelle &amp; M\303\251lanie \302\267 Bourgogne</span>\n        </div>\n      </section>\n\n      {/* 8. PROTECTION DES COLIS */}\n      <section className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl text-left space-y-4\">\n        <div className=\"flex items-center gap-2 border-b border-brand-pink/5 pb-3\">\n          <ShieldCheck className=\"w-5 h-5 text-brand-pink\" />\n          <h4 className=\"font-serif font-bold text-base text-brand-cream\">Soin des enveloppements &amp; protections</h4>\n        </div>\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-brand-text-muted font-light leading-relaxed\">\n          <div className=\"space-y-1.5\">\n            <div className=\"p-2 bg-brand-bg rounded-lg w-fit text-brand-pink\">\n              <Layers className=\"w-4 h-4\" />\n            </div>\n            <h5 className=\"font-semibold text-brand-cream font-serif text-sm\">Matelassage double couche</h5>\n            <p className=\"text-[11px]\">Nous enveloppons \303\240 l\'unit\303\251 chaque pot de cire afin de garantir un amorti total face aux torsions postales.</p>\n          </div>\n          <div className=\"space-y-1.5\">\n            <div className=\"p-2 bg-brand-bg rounded-lg w-fit text-brand-pink\">\n              <Camera className=\"w-4 h-4\" />\n            </div>\n            <h5 className=\"font-semibold text-brand-cream font-serif text-sm\">Archivage photo de contr\303\264le</h5>\n            <p className=\"text-[11px]\">Une photographie de l\'am\303\251nagement du colis est archiv\303\251e en atelier avant d\303\251p\303\264t du paquet.</p>\n          </div>\n          <div className=\"space-y-1.5\">\n            <div className=\"p-2 bg-brand-bg rounded-lg w-fit text-brand-pink\">\n              <FileText className=\"w-4 h-4\" />\n            </div>\n            <h5 className=\"font-semibold text-brand-cream font-serif text-sm\">Suivi temps r\303\251el</h5>\n            <p className=\"text-[11px]\">Un num\303\251ro de tra\303\247age colis vous est transmis d\303\250s d\303\251pose du carton chez le transporteur.</p>\n          </div>\n        </div>\n      </section>\n\n      {/* 9. FAQ ACCORDEON */}\n      <section className=\"space-y-8\">\n        <div className=\"text-left\">\n          <span className=\"text-xs font-mono text-brand-pink tracking-widest uppercase font-semibold\">Des doutes encore ?</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream mt-1\">\n            Foire aux questions exp\303\251ditions\n          </h2>\n        </div>\n\n        <div className=\"space-y-3 max-w-3xl\">\n          {faqs.map((faq, idx) => (\n            <div \n              key={idx}\n              className=\"bg-brand-depth/40 border border-brand-pink/10 hover:border-brand-pink/25 rounded-2xl overflow-hidden transition-all duration-300\"\n            >\n              <button\n                onClick={() => setActiveFaq(activeFaq === idx ? null : idx)}\n                className=\"w-full p-5 text-left flex justify-between items-center gap-4 text-xs font-semibold text-brand-cream font-serif tracking-wide focus:outline-none cursor-pointer\"\n              >\n                <span className=\"flex items-center gap-2\">\n                  <HelpCircle className=\"w-4 h-4 text-brand-pink shrink-0\" />\n                  {faq.q}\n                </span>\n                <ChevronDown className={`w-4 h-4 text-brand-pink transition-transform duration-300 shrink-0 ${activeFaq === idx ? \'rotate-180\' : \'\'}`} />\n              </button>\n\n              <AnimatePresence initial={false}>\n                {activeFaq === idx && (\n                  <motion.div\n                    initial={{ height: 0, opacity: 0 }}\n                    animate={{ height: \"auto\", opacity: 1 }}\n                    exit={{ height: 0, opacity: 0 }}\n                    transition={{ duration: 0.22, ease: \"easeInOut\" }}\n                  >\n                    <div className=\"px-5 pb-5 pt-1 text-xs text-brand-text-muted leading-relaxed font-light border-t border-brand-pink/5\">\n                      {faq.a}\n                    </div>\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n          ))}\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
    }
