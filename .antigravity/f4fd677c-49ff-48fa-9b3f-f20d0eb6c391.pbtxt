    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Facebook, \n  Instagram, \n  MessageSquare, \n  Send, \n  ArrowRight, \n  Sparkles, \n  ShoppingBag, \n  Palette, \n  HelpCircle, \n  Truck, \n  Calendar,\n  Lock,\n  ChevronDown,\n  Clock,\n  MapPin,\n  CheckCircle,\n  Smartphone\n} from \'lucide-react\';\n\ninterface ContactPageProps {\n  setCurrentTab: (tab: string) => void;\n  onSuccess: (text: string) => void;\n}\n\nexport default function ContactPage({ setCurrentTab, onSuccess }: ContactPageProps) {\n  const [formData, setFormData] = useState({\n    name: \'\',\n    phone: \'\',\n    subject: \'Commande\',\n    message: \'\'\n  });\n  const [activeQuestion, setActiveQuestion] = useState<number | null>(null);\n  const [isHoveredHero, setIsHoveredHero] = useState(false);\n\n  const quickMessages = {\n    order: \"Bonjour, je souhaite passer une commande R\303\252ve Parfum\303\251 Cr\303\251ation. Produit souhait\303\251 :\",\n    custom: \"Bonjour, je souhaite une cr\303\251ation personnalis\303\251e. Type de produit, couleurs, senteur et occasion :\",\n    event: \"Bonjour, je souhaite un devis pour un \303\251v\303\251nement. Type d\342\200\231\303\251v\303\251nement, date et quantit\303\251 :\",\n    meeting: \"Bonjour, je souhaite organiser une r\303\251union \303\240 domicile. Ville, nombre d\342\200\231invit\303\251s et date souhait\303\251e :\",\n    delivery: \"Bonjour, j\342\200\231ai une question concernant la livraison ou le retrait :\"\n  };\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({ ...prev, [name]: value }));\n  };\n\n  const handleWhatsAppAction = (text: string) => {\n    const encoded = encodeURIComponent(text);\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\', \'noreferrer,noopener\');\n    onSuccess(\"L\'envoi vers notre ligne WhatsApp d\'atelier a \303\251t\303\251 initi\303\251.\");\n  };\n\n  const handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.name.trim() || !formData.message.trim()) {\n      onSuccess(\"Veuillez remplir votre nom et votre pr\303\251cieux message.\");\n      return;\n    }\n\n    const text = `Bonjour M\303\251lanie et Christelle ! \360\237\222\254\nJe vous contacte depuis le site R\303\252ve Parfum\303\251 :\n - Nom : ${formData.name}\n - T\303\251l\303\251phone : ${formData.phone ? formData.phone : \"Non sp\303\251cifi\303\251\"}\n - Sujet : ${formData.subject}\n - Message : ${formData.message}\n\nJe serais ravie d\'en discuter avec vous pour finaliser mon projet de cire saine !`;\n\n    handleWhatsAppAction(text);\n  };\n\n  const contactFaqs = [\n    {\n      q: \"Quel est le meilleur moyen de vous contacter ?\",\n      a: \"Pour obtenir un conseil rapide ou personnaliser vos couleurs et parfums de Grasse, notre ligne WhatsApp est le canal le plus r\303\251actif. Vous parlez directement avec M\303\251lanie et Christelle, sans interm\303\251diaire, ce qui nous permet d\'\303\251tudier vos croquis ensemble s\'il le faut.\"\n    },\n    {\n      q: \"Peut-on demander une cr\303\251ation enti\303\250rement personnalis\303\251e ?\",\n      a: \"Absolument ! Qu\'il s\'agisse d\'un contenant en gr\303\250s c\303\251ramique patin\303\251 d\'un pr\303\251nom en dor\303\251, d\'\303\251tiquettes sur-mesure pour un bapt\303\252me ou bapt\303\252mes, ou d\'inclusions sp\303\251cifiques de bruy\303\250res ou pivoines de saison, tout est envisageable.\"\n    },\n    {\n      q: \"Quand faut-il id\303\251alement commander ?\",\n      a: \"Parce que nos coulages exigent environ deux semaines de s\303\251chage pour retenir intens\303\251ment les parfums, et que la demande est forte, nous vous sugg\303\251rons de prendre contact au moins 3 \303\240 4 semaines avant la date de votre \303\251v\303\251nement ou moment d\'offrir.\"\n    },\n    {\n      q: \"Comment se passe le paiement des cr\303\251ations pr\303\251par\303\251es ?\",\n      a: \"Une fois que nous avons valid\303\251 les volumes et les frais de livraison \303\240 prix co\303\273tant sur WhatsApp, nous vous envoyons un devis r\303\251capitulatif. Le r\303\250glement se fait sereinement par virement instantan\303\251 Wero, Paylib ou via un lien PayPal s\303\251curis\303\251.\"\n    }\n  ];\n\n  return (\n    <div className=\"space-y-20 pt-4 pb-12 text-left\" id=\"contact-page-root\">\n      \n      {/* 1. HERO CONTACT */}\n      <section \n        className=\"relative overflow-hidden rounded-[36px] bg-brand-depth border border-brand-pink/10 p-8 md:p-12 text-center space-y-6 max-w-4xl mx-auto\"\n        onMouseEnter={() => setIsHoveredHero(true)}\n        onMouseLeave={() => setIsHoveredHero(false)}\n      >\n        <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-brand-pink/10 rounded-full blur-[80px] pointer-events-none\" />\n        <div className=\"absolute -bottom-8 -right-8 w-48 h-48 bg-brand-purple/5 rounded-full blur-[60px] pointer-events-none\" />\n\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-pink/10 border border-brand-pink/20 text-brand-pink text-xs font-mono font-bold uppercase tracking-widest leading-none mx-auto\">\n          <Smartphone className=\"w-3.5 h-3.5 fill-brand-pink/20 text-brand-pink animate-pulse\" />\n          Contact Direct\n        </div>\n\n        <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream max-w-2xl mx-auto tracking-tight leading-tight\">\n          Une question ou une <span className=\"font-light italic text-brand-purple\">envie particuli\303\250re</span> ?\n        </h1>\n\n        <p className=\"text-sm text-brand-text-muted leading-relaxed max-w-xl mx-auto font-light\">\n          Contactez-nous sereinement pour commander, demander une personnalisation fleurie, un devis d\'\303\251v\303\251nement sur-mesure ou r\303\251server votre r\303\251union \303\240 domicile.\n        </p>\n\n        <div className=\"pt-2 flex justify-center\">\n          <button\n            onClick={() => handleWhatsAppAction(\"Bonjour Christelle et M\303\251lanie, j\'ai une question concernant l\'atelier d\'artisanat R\303\252ve Parfum\303\251 Cr\303\251ation \360\237\230\212\")}\n            className=\"px-8 py-3.5 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md inline-flex items-center gap-2 cursor-pointer hover:scale-[1.03]\"\n          >\n            <MessageSquare className=\"w-4 h-4 fill-brand-bg text-brand-bg shrink-0\" />\n            \303\211crire sur notre WhatsApp d\'Atelier\n          </button>\n        </div>\n\n        {/* Decorative bubbles represent direct messaging */}\n        <div className=\"hidden sm:block absolute top-6 left-6 p-2 bg-brand-bg/80 border border-brand-pink/10 rounded-2xl text-[10px] text-brand-pink font-mono tracking-wide\">\n          \360\237\222\254 Ligne directe en Bourgogne\n        </div>\n        <div className=\"hidden sm:block absolute bottom-6 right-6 p-2 bg-brand-bg/80 border border-brand-pink/10 rounded-2xl text-[10px] text-brand-purple font-mono tracking-wide\">\n          \360\237\214\277 R\303\251ponse rapide sous 24h\n        </div>\n      </section>\n\n      {/* 2. CARTES DE CONTACT RAPIDE (5 INSTANT INLETS) */}\n      <section className=\"space-y-6\">\n        <h2 className=\"font-serif font-bold text-xl text-brand-cream border-b border-brand-pink/10 pb-3\">\n          Entr\303\251es de contact instantan\303\251es\n        </h2>\n        \n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n          \n          {/* Card 1: Order */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:border-brand-pink/30 hover:-translate-y-1 transition-all group\">\n            <div className=\"space-y-2\">\n              <div className=\"p-2.5 bg-brand-pink/10 text-brand-pink rounded-xl w-fit\">\n                <ShoppingBag className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"font-serif font-semibold text-xs tracking-wide text-brand-cream\">1. Commander un produit</h3>\n              <p className=\"text-[10px] text-brand-text-muted leading-relaxed font-light\">Discutez en direct de nos cr\303\251ations en pot ou en suspension disponibles.</p>\n            </div>\n            <button\n              onClick={() => handleWhatsAppAction(quickMessages.order)}\n              className=\"w-full py-2 rounded-full border border-brand-pink/25 text-brand-pink hover:bg-brand-pink hover:text-brand-bg text-[10px] font-bold tracking-wider uppercase transition-colors\"\n            >\n              \303\211crire\n            </button>\n          </div>\n\n          {/* Card 2: Custom */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:border-brand-pink/30 hover:-translate-y-1 transition-all group\">\n            <div className=\"space-y-2\">\n              <div className=\"p-2.5 bg-brand-pink/10 text-brand-pink rounded-xl w-fit\">\n                <Palette className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"font-serif font-semibold text-xs tracking-wide text-brand-cream\">2. Personnalisation</h3>\n              <p className=\"text-[10px] text-brand-text-muted leading-relaxed font-light\">Choix d\'\303\251tiquette, de d\303\251cors floraux uniques et de cires parfum\303\251es saines.</p>\n            </div>\n            <button\n              onClick={() => handleWhatsAppAction(quickMessages.custom)}\n              className=\"w-full py-2 rounded-full border border-brand-pink/25 text-brand-pink hover:bg-brand-pink hover:text-brand-bg text-[10px] font-bold tracking-wider uppercase transition-colors\"\n            >\n              \303\211crire\n            </button>\n          </div>\n\n          {/* Card 3: Events */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:border-brand-pink/30 hover:-translate-y-1 transition-all group\">\n            <div className=\"space-y-2\">\n              <div className=\"p-2.5 bg-brand-pink/10 text-brand-pink rounded-xl w-fit\">\n                <Sparkles className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"font-serif font-semibold text-xs tracking-wide text-brand-cream\">3. Devis \303\211v\303\251nementiel</h3>\n              <p className=\"text-[10px] text-brand-text-muted leading-relaxed font-light\">Cadeaux d\'invit\303\251s fleuris pour vos somptueux mariages, bapt\303\252mes ou anniversaires.</p>\n            </div>\n            <button\n              onClick={() => handleWhatsAppAction(quickMessages.event)}\n              className=\"w-full py-2 rounded-full border border-brand-pink/25 text-brand-pink hover:bg-brand-pink hover:text-brand-bg text-[10px] font-bold tracking-wider uppercase transition-colors\"\n            >\n              \303\211crire\n            </button>\n          </div>\n\n          {/* Card 4: Meeting */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:border-brand-pink/30 hover:-translate-y-1 transition-all group\">\n            <div className=\"space-y-2\">\n              <div className=\"p-2.5 bg-brand-pink/10 text-brand-pink rounded-xl w-fit\">\n                <MessageSquare className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"font-serif font-semibold text-xs tracking-wide text-brand-cream\">4. R\303\251union \303\240 domicile</h3>\n              <p className=\"text-[10px] text-brand-text-muted leading-relaxed font-light\">Accueillez un atelier parfum\303\251 convivial entre proches autour de nos essences.</p>\n            </div>\n            <button\n              onClick={() => handleWhatsAppAction(quickMessages.meeting)}\n              className=\"w-full py-2 rounded-full border border-brand-pink/25 text-brand-pink hover:bg-brand-pink hover:text-brand-bg text-[10px] font-bold tracking-wider uppercase transition-colors\"\n            >\n              \303\211crire\n            </button>\n          </div>\n\n          {/* Card 5: Delivery */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:border-brand-pink/30 hover:-translate-y-1 transition-all group\">\n            <div className=\"space-y-2\">\n              <div className=\"p-2.5 bg-brand-pink/10 text-brand-pink rounded-xl w-fit\">\n                <Truck className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"font-serif font-semibold text-xs tracking-wide text-brand-cream\">5. Question livraison</h3>\n              <p className=\"text-[10px] text-brand-text-muted leading-relaxed font-light\">Informations sur nos emballages d\'atelier, les transporteurs et le retrait direct.</p>\n            </div>\n            <button\n              onClick={() => handleWhatsAppAction(quickMessages.delivery)}\n              className=\"w-full py-2 rounded-full border border-brand-pink/25 text-brand-pink hover:bg-brand-pink hover:text-brand-bg text-[10px] font-bold tracking-wider uppercase transition-colors\"\n            >\n              \303\211crire\n            </button>\n          </div>\n\n        </div>\n      </section>\n\n      {/* 3. FORMULAIRE G\303\211N\303\211RAL - CARD LIQUID-STRONG & INFOS PRATIQUES */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Contact Form central card liquid-strong */}\n        <div className=\"lg:col-span-7 liquid-strong p-6 md:p-8 rounded-[32px] space-y-6\">\n          <div className=\"space-y-1.5 text-left border-b border-brand-pink/10 pb-4\">\n            <span className=\"text-[10px] font-mono font-bold text-brand-pink uppercase tracking-widest\">Atelier de cire d\'art</span>\n            <h3 className=\"text-xl md:text-2xl font-serif font-bold text-brand-cream\">L\'exp\303\251rience d\'une \303\251criture libre</h3>\n            <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">\n              Formulez votre demande ci-dessous. Au clic, votre sillage de texte est fid\303\250lement encod\303\251 pour s\'ouvrir sur votre fil WhatsApp personnel.\n            </p>\n          </div>\n\n          <form onSubmit={handleFormSubmit} className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Votre Pr\303\251nom / Nom *</label>\n                <input \n                  type=\"text\" \n                  name=\"name\"\n                  required\n                  placeholder=\"Ex : Sophie\"\n                  value={formData.name}\n                  onChange={handleInputChange}\n                  className=\"w-full px-4 py-3 bg-brand-depth/80 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Votre T\303\251l\303\251phone (Optionnel)</label>\n                <input \n                  type=\"tel\" \n                  name=\"phone\"\n                  placeholder=\"Ex : 0600000000\"\n                  value={formData.phone}\n                  onChange={handleInputChange}\n                  className=\"w-full px-4 py-3 bg-brand-depth/80 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Objet de votre message d\'attention</label>\n              <select\n                name=\"subject\"\n                value={formData.subject}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-depth/80 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                <option value=\"Commande\">Demande de Commande boutique</option>\n                <option value=\"Personnalisation\">Projet de Personnalisation sur-mesure</option>\n                <option value=\"\303\211v\303\251nement\">Devis \303\211v\303\251nementiel (Mariages, Comit\303\251s d\'entreprise)</option>\n                <option value=\"R\303\251union \303\240 domicile\">Organisation d\'une R\303\251union Parfum\303\251e</option>\n                <option value=\"Livraison\">Question de livraison ou de retrait</option>\n                <option value=\"Autre\">Autre demande artistique</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-mono text-brand-text-muted uppercase tracking-wider mb-1.5\">Votre demande d\303\251taill\303\251e *</label>\n              <textarea \n                name=\"message\"\n                required\n                rows={4}\n                placeholder=\"D\303\251crivez-nous vos pr\303\251f\303\251rences d\303\251coratives, les contenants c\303\251ramiques qui vous charment ou les senteurs de Grasse que vous pr\303\251f\303\251rez...\"\n                value={formData.message}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-depth/80 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors resize-none\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-4 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer hover:scale-[1.01]\"\n            >\n              <Send className=\"w-4 h-4 text-brand-bg fill-brand-bg\" />\n              R\303\251cup\303\251rer et envoyer sur WhatsApp\n            </button>\n\n            <span className=\"block text-[10px] text-center font-mono text-brand-text-muted/65 italic\">\n              \360\237\223\214 Nous vous r\303\251pondons d\303\250s que possible, g\303\251n\303\251ralement dans la journ\303\251e.\n            </span>\n          </form>\n        </div>\n\n        {/* 4. Column right: 4 INFOS PRATIQUES CORNER */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          \n          {/* Card A: Preorder delay */}\n          <div className=\"p-5 bg-brand-depth/50 border border-brand-pink/10 rounded-2xl text-left space-y-2\">\n            <div className=\"flex items-center gap-2 text-brand-pink font-semibold text-xs border-b border-brand-pink/5 pb-2\">\n              <Clock className=\"w-4 h-4\" />\n              Cr\303\251ation \303\240 la commande\n            </div>\n            <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light\">\n              Toutes nos cires de soja sont coul\303\251es individuellement \303\240 la main. Le d\303\251lai moyen est d\342\200\231<strong>environ deux semaines</strong>, garantissant une sature aromatique irr\303\251prochable.\n            </p>\n          </div>\n\n          {/* Card B: Delivery times */}\n          <div className=\"p-5 bg-brand-depth/50 border border-brand-pink/10 rounded-2xl text-left space-y-2\">\n            <div className=\"flex items-center gap-2 text-brand-pink font-semibold text-xs border-b border-brand-pink/5 pb-2\">\n              <Truck className=\"w-4 h-4\" />\n              P\303\251riode d\'exp\303\251ditions\n            </div>\n            <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light\">\n              Afin de conserver la plastique de nos d\303\251cors botaniques, les colis sont prioritaires d\'<strong>octobre \303\240 mars</strong>. En \303\251t\303\251, le retrait \303\240 l\'atelier est de rigueur.\n            </p>\n          </div>\n\n          {/* Card C: Appt pickup */}\n          <div className=\"p-5 bg-brand-depth/50 border border-brand-pink/10 rounded-2xl text-left space-y-2\">\n            <div className=\"flex items-center gap-2 text-brand-pink font-semibold text-xs border-b border-brand-pink/5 pb-2\">\n              <MapPin className=\"w-4 h-4\" />\n              Retrait Atelier\n            </div>\n            <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light\">\n              Le retrait de vos cr\303\251ations s\'effectue sur rendez-vous \303\240 notre atelier de Bourgogne. L\'adresse pr\303\251cise vous est partag\303\251e d\303\250s solidification de la cire v\303\251g\303\251tale.\n            </p>\n          </div>\n\n          {/* Card D: Socials glass */}\n          <div className=\"p-5 bg-brand-depth/50 border border-brand-pink/10 rounded-2xl text-left space-y-3\">\n            <span className=\"block text-[10px] font-mono text-brand-text-muted/60 uppercase font-bold tracking-wider\">Trouvez-nous en direct</span>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <a \n                href=\"https://facebook.com\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"p-3 bg-brand-bg/60 hover:bg-brand-pink/10 border border-brand-pink/10 rounded-xl text-[10px] font-mono text-brand-cream hover:text-brand-pink flex items-center justify-center gap-1.5 transition-all cursor-pointer group\"\n              >\n                <Facebook className=\"w-3.5 h-3.5\" />\n                Facebook\n              </a>\n              <a \n                href=\"https://instagram.com\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"p-3 bg-brand-bg/60 hover:bg-brand-pink/10 border border-brand-pink/10 rounded-xl text-[10px] font-mono text-brand-cream hover:text-brand-pink flex items-center justify-center gap-1.5 transition-all cursor-pointer group\"\n              >\n                <Instagram className=\"w-3.5 h-3.5\" />\n                Instagram\n              </a>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n      {/* 6. MINI FAQ CONTACT */}\n      <section className=\"space-y-8\">\n        <div className=\"text-left\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Des R\303\251ponses Claires</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Foire aux questions contact &amp; commandes\n          </h2>\n        </div>\n\n        <div className=\"space-y-3 max-w-3xl\">\n          {contactFaqs.map((faq, idx) => (\n            <div \n              key={idx}\n              className=\"bg-brand-depth/40 border border-brand-pink/5 hover:border-brand-pink/15 rounded-2xl overflow-hidden transition-all duration-300\"\n            >\n              <button\n                onClick={() => setActiveQuestion(activeQuestion === idx ? null : idx)}\n                className=\"w-full p-5 text-left flex justify-between items-center gap-4 text-xs font-semibold text-brand-cream font-serif focus:outline-none cursor-pointer\"\n              >\n                <span className=\"flex items-center gap-2\">\n                  <HelpCircle className=\"w-4 h-4 text-brand-pink shrink-0\" />\n                  {faq.q}\n                </span>\n                <ChevronDown className={`w-4 h-4 text-brand-pink transition-transform duration-300 shrink-0 ${activeQuestion === idx ? \'rotate-180\' : \'\'}`} />\n              </button>\n\n              <AnimatePresence initial={false}>\n                {activeQuestion === idx && (\n                  <motion.div\n                    initial={{ height: 0, opacity: 0 }}\n                    animate={{ height: \"auto\", opacity: 1 }}\n                    exit={{ height: 0, opacity: 0 }}\n                    transition={{ duration: 0.2, ease: \"easeInOut\" }}\n                  >\n                    <div className=\"px-5 pb-5 pt-1 text-xs text-brand-text-muted leading-relaxed font-light border-t border-brand-pink/5\">\n                      {faq.a}\n                    </div>\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n          ))}\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
    }
