          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <p className=\"text-brand-cream font-serif font-bold\">Un projet sp\303\251cial en Bourgogne ?</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <p className=\"text-brand-text-muted font-light leading-relaxed\">Les commandes de mariages exigent au moins un mois d\'anticipation avant la date.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
