        }
        lines {
          text: "      if (occasionFilter === \'D\303\251tente\') matchesOccasion = p.category === \'Bougies en pot\' || p.category === \'Brumes\' || p.category === \'Bouquets parfum\303\251s\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
