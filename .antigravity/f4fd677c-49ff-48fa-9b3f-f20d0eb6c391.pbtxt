        lines {
          text: "    id: \"rev-2\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \"Jean-Baptiste L.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    rating: 5,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    text: \"J\'ai command\303\251 des fondants au Caramel Beurre Sal\303\251 et \303\240 la P\303\252che pour les offrir. Emballage impeccable, livraison soign\303\251e au boulot. L\'odeur de caramel qui embaume la pi\303\250ce est juste divine et gourmande.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    date: \"2 Mai 2026\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
