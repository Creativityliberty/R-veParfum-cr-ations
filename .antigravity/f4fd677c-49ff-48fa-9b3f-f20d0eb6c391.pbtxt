      replacement_content: "import React, { useState } from \'react\';\nimport { Sparkles, Send, Calendar, Users, HeartHandshake, Info, ShieldCheck } from \'lucide-react\';\nimport LifestyleCarousel from \'./LifestyleCarousel\';\n\nexport default function EventQuoteBuilder() {\n  const [eventType, setEventType] = useState(\"Mariage\");\n  const [productType, setProductType] = useState(\"Bougies Parfum\303\251es Miniatures\");\n  const [guestCount, setGuestCount] = useState(50);\n  const [colorTheme, setColorTheme] = useState(\"Pastel printannier (Blanc & Rose)\");\n  const [scentChoice, setScentChoice] = useState(\"Fleur de Cerisier\");\n  const [clientName, setClientName] = useState(\"\");\n  const [clientPhone, setClientPhone] = useState(\"\");\n  const [eventDate, setEventDate] = useState(\"\");\n  const [additionalDetails, setAdditionalDetails] = useState(\"\");\n\n  const handleQuoteSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!clientName.trim()) {\n      alert(\"Veuillez saisir votre nom pour que Christelle et M\303\251lanie \303\251tudient votre devis.\");\n      return;\n    }\n\n    const textMsg = `Bonjour M\303\251lanie et Christelle, je souhaiterais obtenir des informations et un devis personnalis\303\251 pour un \303\251v\303\251nement :\n\n[ DETAILS DE L\'EVENEMENT ]\n- Type d\'\303\251v\303\251nement : ${eventType}\n- Date pr\303\251vue : ${eventDate ? eventDate : \"Non stipul\303\251e pour le moment\"}\n- Cr\303\251ation parfum\303\251e souhait\303\251e : ${productType}\n- Quantit\303\251 estim\303\251e (Invit\303\251s) : ${guestCount} personnes\n- Th\303\250me couleur d\303\251sir\303\251 : ${colorTheme}\n- Senteur privil\303\251gi\303\251e : ${scentChoice}\n\n[ INFORMATIONS DE CONTACT ]\n- Nom de contact : ${clientName}\n- T\303\251l\303\251phone : ${clientPhone ? clientPhone : \"Non fourni\"}\n\n[ INSTRUCTIONS & SOUHAITS PARTICULIERS ]\n- D\303\251tails : ${additionalDetails ? additionalDetails : \"\303\200 convenir ensemble sur WhatsApp lors de notre \303\251change\"}\n\nMerci d\'avance pour votre aide pr\303\251cieuse, j\'ai h\303\242te de donner vie \303\240 notre projet !`;\n\n    const encoded = encodeURIComponent(textMsg);\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\');\n  };\n\n  return (\n    <div className=\"space-y-16\" id=\"event-quote-builder-tab\">\n      \n      {/* 1. Carousel d\'Inspirations & Mises en situation */}\n      <LifestyleCarousel />\n\n      {/* 2. Core Configurator Section */}\n      <div className=\"bg-brand-depth border border-brand-pink/15 rounded-3xl p-6 md:p-8 space-y-6 relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-48 h-48 bg-brand-pink/5 rounded-full filter blur-3xl pointer-events-none\" />\n\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <HeartHandshake className=\"w-8 h-8 text-brand-pink mx-auto\" />\n          <h3 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Configurez votre cadeau invit\303\251s unique\n          </h3>\n          <p className=\"text-sm text-brand-text-muted\">\n            Qu\'il s\'agisse d\'un mariage, d\'un bapt\303\252me ou d\'un \303\251v\303\251nement d\'entreprise, offrez une empreinte sensorielle inoubliable avec des cr\303\251ations sur-mesure !\n          </p>\n        </div>\n\n        {/* Highlight Card: Touch of White (Touche de Blanc) for custom parameters */}\n        <div className=\"max-w-3xl mx-auto p-5 bg-white border border-brand-pink/20 rounded-2xl text-zinc-900 shadow-xl space-y-3 relative overflow-hidden\">\n          <div className=\"absolute inset-y-0 right-0 w-2 bg-gradient-to-b from-brand-pink to-brand-purple\" />\n          \n          <div className=\"flex items-center gap-2\">\n            <Info className=\"w-4 h-4 text-brand-purple shrink-0\" />\n            <span className=\"text-xs font-mono uppercase tracking-widest font-bold text-zinc-900\">Charte de l\'Atelier R\303\252ve</span>\n          </div>\n          <h4 className=\"font-serif font-bold text-base text-zinc-900\">\n            Une harmonie soign\303\251e sous deux semaines de cure\n          </h4>\n          <p className=\"text-xs text-zinc-650 leading-relaxed font-light\">\n            Pour assurer la perfection olfactive et la d\303\251pose des fleurs s\303\251ch\303\251es locales, Christelle et M\303\251lanie demandent un d\303\251lai minimal de <strong>deux semaines de fabrication</strong>. Pour les grandes r\303\251ceptions, la personnalisation est modulable et gratuite d\303\250s 40 pi\303\250ces !\n          </p>\n          <div className=\"pt-1 flex flex-wrap gap-4 text-[10px] font-mono text-zinc-500\">\n            <span className=\"flex items-center gap-1\">\342\234\224 Devis gratuit sous 48h</span>\n            <span className=\"flex items-center gap-1\">\342\234\224 Tarifs d\303\251gressifs volume</span>\n            <span className=\"flex items-center gap-1\">\342\234\224 \303\211chantillon senteur possible</span>\n          </div>\n        </div>\n\n        <form onSubmit={handleQuoteSubmit} className=\"space-y-4 max-w-3xl mx-auto\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Type d\'\303\211v\303\251nement</label>\n              <select\n                value={eventType}\n                onChange={(e) => setEventType(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              >\n                <option value=\"Mariage\">Mariage</option>\n                <option value=\"Bapt\303\252me / Communion\">Bapt\303\252me / Communion</option>\n                <option value=\"Anniversaire\">Anniversaire</option>\n                <option value=\"Baby Shower\">Baby Shower</option>\n                <option value=\"Comit\303\251 d\'Entreprise / CE\">Comit\303\251 d\'Entreprise / CE</option>\n                <option value=\"Autre \303\251v\303\251nement festif\">Autre \303\251v\303\251nement festif</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Date estim\303\251e de l\'\303\211v\303\251nement</label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex : Juin 2027 ou Date exacte\"\n                value={eventDate}\n                onChange={(e) => setEventDate(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Cr\303\251ation parfum\303\251e choisie</label>\n              <select\n                value={productType}\n                onChange={(e) => setProductType(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              >\n                <option value=\"Mini-Bougies en Pot C\303\251ramique\">Mini-Bougies en Pot C\303\251ramique</option>\n                <option value=\"Mini-Tablettes Grav\303\251es Suspendues\">Mini-Tablettes Grav\303\251es Suspendues</option>\n                <option value=\"Sachets Individuels de Fondants Coeurs\">Sachets Individuels de Fondants Coeurs</option>\n                <option value=\"Fioles Mignonnes Elixir de fleurs\">Fioles Mignonnes Elixir de fleurs</option>\n                <option value=\"Mini-Bouquets \303\240 rotin rustique\">Mini-Bouquets \303\240 rotin rustique</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1 flex justify-between\">\n                <span>Nombre estim\303\251 d\'invit\303\251s</span>\n                <span className=\"text-brand-pink font-semibold font-mono\">{guestCount} pers.</span>\n              </label>\n              <input\n                type=\"range\"\n                min=\"15\"\n                max=\"500\"\n                step=\"5\"\n                value={guestCount}\n                onChange={(e) => setGuestCount(Number(e.target.value))}\n                className=\"w-full mt-2 cursor-pointer accent-brand-pink\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Th\303\250me & Harmonie de couleur</label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex : Boho sauge & terracotta, blanc \303\251pur\303\251, lin & paille...\"\n                value={colorTheme}\n                onChange={(e) => setColorTheme(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Senteur favorite projet\303\251e</label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex : Fleur de Cerisier, Fleur de Coton...\"\n                value={scentChoice}\n                onChange={(e) => setScentChoice(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Dites-nous en plus (Gravure, rubans, budget...)</label>\n            <textarea\n              placeholder=\"Ex: Nous souhaiterions inscrire \'M&G 12.08.2026\' sur le pot. Nous d\303\251sirons un devis avec des prix d\303\251gressifs, merci !\"\n              value={additionalDetails}\n              onChange={(e) => setAdditionalDetails(e.target.value)}\n              className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink min-h-[80px]\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 bg-brand-bg/40 p-4 rounded-xl border border-brand-pink/10\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-pink uppercase tracking-wider mb-1\">Votre Nom *</label>\n              <input\n                required\n                type=\"text\"\n                placeholder=\"Ex : Sophie Marceau\"\n                value={clientName}\n                onChange={(e) => setClientName(e.target.value)}\n                className=\"w-full p-3 bg-brand-depth border border-brand-pink/20 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">T\303\251l\303\251phone alternatif</label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex : 06 12 34 56 78\"\n                value={clientPhone}\n                onChange={(e) => setClientPhone(e.target.value)}\n                className=\"w-full p-3 bg-brand-depth border border-brand-pink/20 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full mt-2 py-3.5 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer animate-none\"\n          >\n            <Send className=\"w-4 h-4 text-brand-bg fill-brand-bg\" />\n            Demander mon devis sur WhatsApp\n          </button>\n\n          <div className=\"text-center\">\n            <p className=\"text-[11px] text-brand-text-muted italic\">\n              Christelle et M\303\251lanie \303\251tudient les faisabilit\303\251s sous 48h. Les devis en grand volume b\303\251n\303\251ficient de prix d\303\251gressifs exclusifs !\n            </p>\n          </div>\n        </form>\n      </div>\n\n    </div>\n  );\n}\n"
    }
