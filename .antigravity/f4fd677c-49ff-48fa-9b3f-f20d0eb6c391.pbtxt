    replacement_chunks {
      target_content: "export default function App() {\n  const [currentTab, setCurrentTab] = useState<string>(\'accueil\');\n  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null);\n  const [showQuizModal, setShowQuizModal] = useState<boolean>(false);\n  const [legalSubTab, setLegalSubTab] = useState<string>(\'mentions\');\n  \n  // Boutique state filters\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Tous\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [scentFilter, setScentFilter] = useState<string>(\'Tous\');\n  \n  // Custom toast notification state\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const triggerToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 4500);\n  };\n\n  // Filter products beautifully\n  const filteredProducts = PRODUCTS.filter(p => {\n    const matchesCategory = selectedCategory === \'Tous\' || p.category === selectedCategory;\n    const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || \n                          p.description.toLowerCase().includes(searchQuery.toLowerCase());\n    const matchesScent = scentFilter === \'Tous\' || p.scents.includes(scentFilter);\n    return matchesCategory && matchesSearch && matchesScent;\n  });\n\n  return (\n    <div className=\"min-h-screen bg-brand-bg text-brand-cream selection:bg-brand-pink selection:text-brand-bg overflow-x-hidden pt-24 md:pt-28 pb-12 font-sans relative\">\n      \n      {/* Dynamic Background decorative warm ambient light globes */}\n      <div className=\"absolute top-0 right-0 w-[45rem] h-[45rem] bg-brand-pink/5 rounded-full filter blur-[120px] pointer-events-none\" />\n      <div className=\"absolute top-[80vh] left-0 w-[35rem] h-[35rem] bg-brand-purple/5 rounded-full filter blur-[100px] pointer-events-none\" />\n      <div className=\"absolute bottom-20 right-10 w-[40rem] h-[40rem] bg-brand-wax/5 rounded-full filter blur-[140px] pointer-events-none\" />\n\n      {/* Floating Header Navigation */}\n      <Header \n        currentTab={currentTab} \n        setCurrentTab={setCurrentTab} \n        openScentQuiz={() => {\n          setShowQuizModal(true);\n          // Auto-scroll to quiz area when opened on simple page layouts\n          const quizEl = document.getElementById(\'scent-finder-anchor\');\n          if (quizEl) {\n            quizEl.scrollIntoView({ behavior: \'smooth\' });\n          }\n        }} \n      />\n\n      {/* Floating notification Toast */}\n      <AnimatePresence>\n        {toastMessage && (\n          <motion.div \n            initial={{ opacity: 0, y: 40 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: 40 }}\n            className=\"fixed bottom-6 right-6 z-50 px-6 py-4 rounded-2xl bg-brand-depth border border-brand-pink/30 text-brand-pink font-medium text-sm shadow-2xl flex items-center gap-2\"\n          >\n            <Sparkles className=\"w-5 h-5 animate-pulse text-amber-300\" />\n            <span>{toastMessage}</span>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <AnimatePresence mode=\"wait\">\n          \n          {/* ==================== 1. ACCUEIL TAB ==================== */}\n          {currentTab === \'accueil\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-24\"\n            >\n              \n              {/* Immersive Hero Section */}\n              <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-6 md:py-12\" id=\"section-hero\">\n                <div className=\"lg:col-span-7 space-y-8 text-left\">\n                  <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-pink/10 border border-brand-pink/15 text-brand-pink text-xs font-mono uppercase tracking-widest\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    Atelier artisanal \302\267 Cires & Fragrances\n                  </div>\n\n                  <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-brand-cream leading-[1.1]\">\n                    Des cr\303\251ations parfum\303\251es <br />\n                    <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-brand-pink to-brand-purple italic font-light\">\n                      artisanales & naturelles\n                    </span>\n                  </h1>\n\n                  <p className=\"text-base sm:text-lg text-brand-text-muted leading-relaxed max-w-2xl font-light\">\n                    Bougies v\303\251g\303\251tales, fondants floraux coeurs, bouquets capillarit\303\251 aux rotins naturels et cadres de cire botaniques coul\303\251s \303\240 la main. Tous nos parfums proviennent directement de <span className=\"text-brand-pink\">Grasse</span>, sans substances de synth\303\250se CMR ni phtalates.\n                  </p>\n\n                  <div className=\"flex flex-col sm:flex-row gap-4\">\n                    <button \n                      onClick={() => setCurrentTab(\'boutique\')}\n                      className=\"px-8 py-4 bg-brand-pink text-brand-bg font-extrabold text-sm tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer\"\n                    >\n                      <ShoppingBag className=\"w-4 h-4\" />\n                      D\303\251couvrir la Boutique\n                    </button>\n                    \n                    <button \n                      onClick={() => {\n                        setShowQuizModal(true);\n                        setTimeout(() => {\n                          document.getElementById(\'scent-finder-anchor\')?.scrollIntoView({ behavior: \'smooth\' });\n                        }, 100);\n                      }}\n                      className=\"px-8 py-4 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 transition-all text-sm font-semibold tracking-wider uppercase flex items-center justify-center gap-2 cursor-pointer\"\n                    >\n                      \360\237\224\256 Trouver ma senteur\n                    </button>\n                  </div>\n\n                  {/* Trust factors logos */}\n                  <div className=\"pt-4 grid grid-cols-3 gap-4 border-t border-brand-pink/10 max-w-lg\">\n                    <div>\n                      <span className=\"block text-lg font-bold font-serif text-brand-pink\">100% soja</span>\n                      <span className=\"text-xs text-brand-text-muted\">Cire v\303\251g\303\251tale saine</span>\n                    </div>\n                    <div>\n                      <span className=\"block text-lg font-bold font-serif text-brand-pink\">Grasse</span>\n                      <span className=\"text-xs text-brand-text-muted\">Fragrances sans CMR</span>\n                    </div>\n                    <div>\n                      <span className=\"block text-lg font-bold font-serif text-brand-pink\">Fait main</span>\n                      <span className=\"text-xs text-brand-text-muted\">Chaque pi\303\250ce est unique</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right side Visual Showcase */}\n                <div className=\"lg:col-span-5 relative\">\n                  {/* Glowing background ring */}\n                  <div className=\"absolute inset-0 bg-gradient-to-tr from-brand-pink/20 to-brand-purple/20 rounded-[2.5rem] filter blur-xl transform translate-x-3 translate-y-3 opacity-60 pointer-events-none\" />\n\n                  <div className=\"relative rounded-[2.5rem] overflow-hidden border border-brand-pink/15 aspect-[4/3] lg:aspect-square bg-brand-depth shadow-2xl\">\n                    <img \n                      src=\"/src/assets/images/hero_perfume_1779963676925.png\" \n                      alt=\"R\303\252ve Parfum\303\251 Cr\303\251ations artisanales\" \n                      className=\"w-full h-full object-cover select-none\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n\n                    {/* Miniature interactive tag overlay on Image */}\n                    <div className=\"absolute bottom-6 left-6 right-6 backdrop-blur-md bg-brand-bg/80 border border-brand-pink/10 p-4 rounded-2xl flex items-center justify-between\">\n                      <div>\n                        <span className=\"block text-xs uppercase font-mono tracking-widest text-brand-pink font-semibold\">Incontournable</span>\n                        <h4 className=\"font-serif text-sm font-bold text-brand-cream\">Bougie en C\303\251ramique & Rotin</h4>\n                      </div>\n                      <span className=\"font-mono text-xs bg-brand-pink text-brand-bg font-extrabold px-3 py-1.5 rounded-full\">\n                        D\303\250s 18,50 \342\202\254\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Floating abstract blossom details */}\n                  <div className=\"absolute -top-4 -left-4 w-12 h-12 rounded-full bg-brand-pink/10 flex items-center justify-center border border-brand-pink/15 text-brand-pink shadow-md animate-bounce\">\n                    \360\237\214\270\n                  </div>\n                  <div className=\"absolute -bottom-4 -right-4 w-10.5 h-10.5 rounded-full bg-brand-purple/15 flex items-center justify-center border border-brand-purple/15 text-brand-purple shadow-md animate-pulse\">\n                    \342\234\250\n                  </div>\n                </div>\n              </section>\n\n              {/* Curated Product Category Showcase Row */}\n              <section className=\"space-y-8\" id=\"section-curated-products\">\n                <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n                  <div className=\"space-y-2\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Inspirations de l\'Atelier</span>\n                    <h2 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">\n                      D\303\251couvrez nos 4 familles phares\n                    </h2>\n                  </div>\n                  <button \n                    onClick={() => setCurrentTab(\'boutique\')}\n                    className=\"group text-brand-pink font-semibold text-sm hover:text-brand-cream flex items-center gap-1.5 self-start cursor-pointer transition-colors\"\n                  >\n                    Voir tout le catalogue complet\n                    <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                  </button>\n                </div>\n\n                {/* 4 Cards Floating */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                  {PRODUCTS.slice(0, 4).map((product) => (\n                    <ProductCard \n                      key={product.id} \n                      product={product} \n                      onSelect={(p) => setSelectedProduct(p)} \n                    />\n                  ))}\n                </div>\n              </section>\n\n              {/* ================= SECTION POURQUOI CHOISIR ================= */}\n              <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">\n                <div className=\"max-w-7xl mx-auto space-y-12\">\n                  <div className=\"text-center max-w-xl mx-auto space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Un Choix Responsable & Po\303\251tique</span>\n                    <h2 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">Pourquoi voter pour R\303\252ve Parfum\303\251 ?</h2>\n                    <p className=\"text-sm text-brand-text-muted\">\n                      Des collections uniques pens\303\251es pour envelopper vos journ\303\251es d\'un cocon parfum\303\251 sans aucun compromis pour votre bien-\303\252tre.\n                    </p>\n                  </div>\n\n                  {/* Layout caf\303\251 adaptation: centered visual + 4 arguments around */}\n                  <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n                    \n                    {/* Column Left (Arguments 1 & 2) */}\n                    <div className=\"lg:col-span-4 space-y-8 text-right\">\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">01</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">100% Ingr\303\251dients Naturels</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          De la cire v\303\251g\303\251tale de soja biod\303\251gradable sans OGM, sans paraphine d\303\251riv\303\251e de p\303\251trole. Pour une combustion saine et responsable.\n                        </p>\n                      </div>\n\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">02</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Atelier Fran\303\247ais Fait Main</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          M\303\251lanie et Christelle coulent artisanalement chaque fondant, cadre et bougie \303\240 la main d\'artiste. Des fleurs s\303\251ch\303\251es aux contenants.\n                        </p>\n                      </div>\n                    </div>\n\n                    {/* Column Center (Centerpiece visual) */}\n                    <div className=\"lg:col-span-4 justify-center flex relative\">\n                      <div className=\"absolute inset-0 bg-brand-purple/5 filter blur-3xl pointer-events-none rounded-full\" />\n                      <div className=\"relative p-6 bg-brand-depth border border-brand-pink/10 rounded-full w-64 h-64 flex items-center justify-center text-center shadow-lg group\">\n                        <div className=\"bg-brand-bg/85 border border-brand-pink/20 rounded-full w-52 h-52 flex flex-col items-center justify-center p-4\">\n                          <Droplet className=\"w-8 h-8 text-brand-pink animate-pulse mb-2\" />\n                          <h4 className=\"font-serif text-base font-bold text-brand-cream leading-tight\">Grasse Essences</h4>\n                          <p className=\"text-[10px] text-brand-text-muted mt-1 uppercase tracking-widest\">Z\303\251ro phtalate</p>\n                          <p className=\"text-[9px] text-brand-purple mt-0.5\">Note olfactive s\303\273re</p>\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Column Right (Arguments 3 & 4) */}\n                    <div className=\"lg:col-span-4 space-y-8 text-left\">\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">03</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Enti\303\250rement Personnalisable</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          Nous adaptons les couleurs de cire, vos fragrances d\'ambiance et even l\'impression d\'\303\251tiquettes de voeux pour vos c\303\251r\303\251monies et cadeaux d\'invit\303\251s.\n                        </p>\n                      </div>\n\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">04</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Tradition Cadeaux d\'\303\211motion</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          Boutiques pr\303\252tes \303\240 offrir, coffrets mignons fleuris en carton biod\303\251gradable herm\303\251tiques. Une odeur r\303\251confortante qui reste.\n                        </p>\n                      </div>\n                    </div>\n\n                  </div>\n                </div>\n              </section>\n\n              {/* ================= SCENT FINDER WIZARD TRIGGER AREA ================= */}\n              <section className=\"scroll-mt-28\" id=\"scent-finder-anchor\">\n                <ScentQuiz \n                  onSelectProduct={(p) => setSelectedProduct(p)} \n                />\n              </section>\n\n              {/* ================= PARTNERSHIP SUMMARY TILES ================= */}\n              <section className=\"grid grid-cols-1 md:grid-cols-2 gap-8 pt-4\">\n                <div className=\"p-8 bg-brand-depth border border-brand-pink/15 rounded-3xl flex flex-col justify-between\">\n                  <div className=\"space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-semibold\">Cadeaux \303\211v\303\251nementiels Sur-Mesure</span>\n                    <h3 className=\"text-2xl font-serif font-bold text-brand-cream leading-tight\">Vous pr\303\251parez un mariage, bapt\303\252me ou cherchez des cadeaux CE ?</h3>\n                    <p className=\"text-sm text-brand-text-muted font-light leading-relaxed\">\n                      D\303\251couvrez nos miniatures d\'invit\303\251s adaptables \303\240 vos nuanciers floraux. Personnalisation gratuite pour les \303\251tiquettes de remerciements. Tarifs d\303\251gressifs.\n                    </p>\n                  </div>\n                  <button \n                    onClick={() => setCurrentTab(\'evenements\')}\n                    className=\"mt-6 self-start px-5 py-2.5 bg-brand-pink text-brand-bg font-bold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors\"\n                  >\n                    Estimer mon devis personnalis\303\251\n                  </button>\n                </div>\n\n                <div className=\"p-8 bg-brand-depth border border-brand-pink/15 rounded-3xl flex flex-col justify-between\">\n                  <div className=\"space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-purple uppercase tracking-widest font-semibold\">Atelier H\303\264tesse \303\240 Domicile</span>\n                    <h3 className=\"text-2xl font-serif font-bold text-brand-cream leading-tight\">Organisez une R\303\251union Parfum\303\251e chez vous</h3>\n                    <p className=\"text-sm text-brand-text-muted font-light leading-relaxed\">\n                      Inscrivez-vous pour accueillir M\303\251lanie et sa malle \303\240 senteurs olfactive lors d\'une apr\303\250s-midi cocooning. Gagnez 10% de toutes les commandes pass\303\251es en bons boutique !\n                    </p>\n                  </div>\n                  <button \n                    onClick={() => setCurrentTab(\'reunions\')}\n                    className=\"mt-6 self-start px-5 py-2.5 bg-brand-purple text-brand-bg font-bold text-xs tracking-wider uppercase rounded-full hover:bg-white/90 transition-all\"\n                  >\n                    R\303\251server une date d\'atelier\n                  </button>\n                </div>\n              </section>\n\n            </motion.div>\n          )}\n\n          {/* ==================== 2. BOUTIQUE CATALOGUE TAB ==================== */}\n          {currentTab === \'boutique\' && (\n            <motion.div"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Sparkles, \n  Leaf, \n  Calendar, \n  MessageSquare, \n  ShoppingBag, \n  Compass, \n  BookHeart, \n  Truck, \n  PhoneCall, \n  Clock, \n  Grid,\n  Heart,\n  Eye,\n  ArrowRight,\n  ArrowUpRight,\n  ShieldCheck,\n  Award,\n  ChevronRight,\n  ChevronDown,\n  Droplet,\n  MapPin,\n  Check,\n  Percent,\n  Stars,\n  HelpCircle,\n  MessageCircle\n} from \'lucide-react\';\n\nimport Header from \'./components/Header\';\nimport ScentQuiz from \'./components/ScentQuiz\';\nimport ProductCard from \'./components/ProductCard\';\nimport ProductDetailsModal from \'./components/ProductDetailsModal\';\nimport ReviewSection from \'./components/ReviewSection\';\nimport EventQuoteBuilder from \'./components/EventQuoteBuilder\';\nimport HomePartiesBuilder from \'./components/HomePartiesBuilder\';\nimport CustomizationPage from \'./components/CustomizationPage\';\nimport AboutPage from \'./components/AboutPage\';\nimport ContactPage from \'./components/ContactPage\';\nimport LegalPages from \'./components/LegalPages\';\n\nimport { PRODUCTS, CATEGORIES, SCENTS } from \'./data\';\nimport { Product } from \'./types\';\n\nexport default function App() {\n  const [currentTab, setCurrentTab] = useState<string>(\'accueil\');\n  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null);\n  const [showQuizModal, setShowQuizModal] = useState<boolean>(false);\n  const [legalSubTab, setLegalSubTab] = useState<string>(\'mentions\');\n  \n  // Boutique advanced state filters\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Tous\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [scentFilter, setScentFilter] = useState<string>(\'Tous\');\n  const [maxPrice, setMaxPrice] = useState<number>(50);\n  const [onlyCustomizable, setOnlyCustomizable] = useState<boolean>(false);\n  const [occasionFilter, setOccasionFilter] = useState<string>(\'Tous\');\n  const [deliveryRetraitFilter, setDeliveryRetraitFilter] = useState<string>(\'Tous\');\n  \n  // Custom toast notification state\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const triggerToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 4500);\n  };\n\n  // Filter products beautifully based on multiple criteria\n  const filteredProducts = PRODUCTS.filter(p => {\n    // category filter\n    const matchesCategory = selectedCategory === \'Tous\' || p.category === selectedCategory || \n                            (selectedCategory === \'Bougies\' && p.category === \'Bougies en pot\');\n    \n    // search filter\n    const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || \n                          p.description.toLowerCase().includes(searchQuery.toLowerCase()) ||\n                          p.category.toLowerCase().includes(searchQuery.toLowerCase());\n    \n    // scent family filter\n    let matchesScent = scentFilter === \'Tous\';\n    if (!matchesScent) {\n      matchesScent = p.scents.some(s => {\n        const scentObj = SCENTS.find(sc => sc.name === s);\n        return scentObj ? scentObj.family === scentFilter : false;\n      });\n    }\n\n    // occasion filter\n    let matchesOccasion = occasionFilter === \'Tous\';\n    if (!matchesOccasion) {\n      if (occasionFilter === \'Cadeau\') matchesOccasion = p.category === \'Coffrets cadeaux\' || p.customizable;\n      if (occasionFilter === \'Maison\') matchesOccasion = p.category === \'Bougies en pot\' || p.category === \'Bouquets parfum\303\251s\' || p.category === \'Fondants\' || p.category === \'Brumes\' || p.category === \'Poudres aspirateur\';\n      if (occasionFilter === \'Mariage\') matchesOccasion = p.customizable && (p.category === \'Bougies en pot\' || p.category === \'Cadres parfum\303\251s\' || p.category === \'Fondants\');\n      if (occasionFilter === \'Voiture\') matchesOccasion = p.category === \'Suspensions voiture\';\n      if (occasionFilter === \'D\303\251tente\') matchesOccasion = p.category === \'Bougies en pot\' || p.category === \'Brumes\' || p.category === \'Bouquets parfum\303\251s\';\n      if (occasionFilter === \'\303\211v\303\251nement\') matchesOccasion = p.customizable;\n    }\n\n    // customizable filter\n    const matchesCustomizable = !onlyCustomizable || p.customizable;\n\n    // price filter\n    const matchesPrice = p.price <= maxPrice;\n\n    return matchesCategory && matchesSearch && matchesScent && matchesOccasion && matchesCustomizable && matchesPrice;\n  });\n\n  const generalWhatsAppLink = `https://wa.me/33600000000?text=${encodeURIComponent(\"Bonjour, je d\303\251couvre R\303\252ve Parfum\303\251 Cr\303\251ation et je souhaite passer commande ou avoir un conseil \360\237\230\212\")}`;\n\n  return (\n    <div className=\"min-h-screen bg-brand-bg text-brand-cream selection:bg-brand-pink selection:text-brand-bg overflow-x-hidden pt-24 md:pt-28 pb-12 font-sans relative\">\n      \n      {/* Dynamic Background decorative warm ambient light globes */}\n      <div className=\"absolute top-0 right-0 w-[45rem] h-[45rem] bg-brand-pink/5 rounded-full filter blur-[120px] pointer-events-none\" />\n      <div className=\"absolute top-[80vh] left-0 w-[35rem] h-[35rem] bg-brand-purple/5 rounded-full filter blur-[100px] pointer-events-none\" />\n      <div className=\"absolute bottom-20 right-10 w-[40rem] h-[40rem] bg-brand-wax/5 rounded-full filter blur-[140px] pointer-events-none\" />\n\n      {/* Floating Header Navigation */}\n      <Header \n        currentTab={currentTab} \n        setCurrentTab={setCurrentTab} \n        openScentQuiz={() => {\n          setShowQuizModal(true);\n        }} \n      />\n\n      {/* Floating notification Toast */}\n      <AnimatePresence>\n        {toastMessage && (\n          <motion.div \n            initial={{ opacity: 0, y: 40 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: 40 }}\n            className=\"fixed bottom-6 right-6 z-50 px-6 py-4 rounded-2xl bg-brand-depth border border-brand-pink/30 text-brand-pink font-medium text-sm shadow-2xl flex items-center gap-2\"\n          >\n            <Sparkles className=\"w-5 h-5 animate-pulse text-amber-300\" />\n            <span>{toastMessage}</span>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <AnimatePresence mode=\"wait\">\n          \n          {/* ==================== 1. ACCUEIL TAB ==================== */}\n          {currentTab === \'accueil\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-24\"\n            >\n              \n              {/* Immersive Hero Section */}\n              <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-6 md:py-12\" id=\"section-hero\">\n                <div className=\"lg:col-span-7 space-y-8 text-left\">\n                  <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-pink/10 border border-brand-pink/15 text-brand-pink text-xs font-mono uppercase tracking-widest font-semibold\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    Cr\303\251ations artisanales parfum\303\251es\n                  </div>\n\n                  <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-brand-cream leading-[1.15]\">\n                    Des cr\303\251ations parfum\303\251es naturelles, <br />\n                    <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-brand-pink to-brand-purple italic font-light\">\n                      faites main\n                    </span>{\" \"}\n                    avec{\" \"}\n                    <span className=\"text-brand-pink italic font-light\">\n                      douceur\n                    </span>\n                  </h1>\n\n                  <p className=\"text-base sm:text-lg text-brand-text-muted leading-relaxed max-w-2xl font-light\">\n                    Bougies, fondants, bouquets et cadres parfum\303\251s fabriqu\303\251s \303\240 la main avec cire de soja, parfums de Grasse et contenants en c\303\251ramique artisanale.\n                  </p>\n\n                  <div className=\"flex flex-col sm:flex-row gap-4\">\n                    <a \n                      href={generalWhatsAppLink}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"px-8 py-4 bg-brand-pink text-brand-bg font-extrabold text-sm tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer text-center\"\n                    >\n                      <MessageCircle className=\"w-4 h-4 fill-brand-bg text-brand-bg\" />\n                      Commander sur WhatsApp\n                    </a>\n                    \n                    <button \n                      onClick={() => setShowQuizModal(true)}\n                      className=\"px-8 py-4 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 transition-all text-sm font-semibold tracking-wider uppercase flex items-center justify-center gap-2 cursor-pointer\"\n                    >\n                      \360\237\224\256 Trouver ma senteur\n                    </button>\n                  </div>\n\n                  {/* Trust factors logos */}\n                  <div className=\"pt-4 grid grid-cols-4 gap-2 sm:gap-4 border-t border-brand-pink/10 max-w-xl\">\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-sm font-bold text-brand-pink font-serif\">\360\237\215\203 Cire de soja</span>\n                      <span className=\"text-[10px] text-brand-text-muted\">Naturelle &amp; saine</span>\n                    </div>\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-sm font-bold text-brand-pink font-serif\">\342\234\250 Parfums de Grasse</span>\n                      <span className=\"text-[10px] text-brand-text-muted\">Sans CMR ni phtalates</span>\n                    </div>\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-sm font-bold text-brand-pink font-serif\">\342\217\263 Pr\303\251commande</span>\n                      <span className=\"text-[10px] text-brand-text-muted\">Environ 2 semaines</span>\n                    </div>\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-sm font-bold text-brand-pink font-serif\">\360\237\216\250 Personnalisable</span>\n                      <span className=\"text-[10px] text-brand-text-muted\">Selon vos envies</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right side Visual Showcase */}\n                <div className=\"lg:col-span-5 relative\">\n                  {/* Glowing background ring */}\n                  <div className=\"absolute inset-0 bg-gradient-to-tr from-brand-pink/20 to-brand-purple/20 rounded-[2.5rem] filter blur-xl transform translate-x-3 translate-y-3 opacity-60 pointer-events-none\" />\n\n                  <div className=\"relative rounded-[2.5rem] overflow-hidden border border-brand-pink/15 aspect-[4/3] lg:aspect-square bg-brand-depth shadow-2xl\">\n                    <img \n                      src=\"/src/assets/images/hero_perfume_1779963676925.png\" \n                      alt=\"R\303\252ve Parfum\303\251 Cr\303\251ations artisanales\" \n                      className=\"w-full h-full object-cover select-none\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n\n                    {/* Miniature interactive tag overlay on Image */}\n                    <div className=\"absolute bottom-6 left-6 right-6 backdrop-blur-md bg-brand-bg/85 border border-brand-pink/10 p-4 rounded-2xl flex items-center justify-between\">\n                      <div>\n                        <span className=\"block text-xs uppercase font-mono tracking-widest text-brand-pink font-semibold\">Tendance</span>\n                        <h4 className=\"font-serif text-sm font-bold text-brand-cream\">Bougie en C\303\251ramique &amp; Rotin</h4>\n                      </div>\n                      <span className=\"font-mono text-xs bg-brand-pink text-brand-bg font-extrabold px-3 py-1.5 rounded-full\">\n                        D\303\250s 18,50 \342\202\254\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Floating abstract blossom details */}\n                  <div className=\"absolute -top-4 -left-4 w-12 h-12 rounded-full bg-brand-pink/10 flex items-center justify-center border border-brand-pink/15 text-brand-pink shadow-md animate-bounce\">\n                    \360\237\214\270\n                  </div>\n                  <div className=\"absolute -bottom-4 -right-4 w-10.5 h-10.5 rounded-full bg-brand-purple/15 flex items-center justify-center border border-brand-purple/15 text-brand-purple shadow-md animate-pulse\">\n                    \342\234\250\n                  </div>\n                </div>\n              </section>\n\n              {/* Overlapping Key Custom Categories Cards */}\n              <section className=\"space-y-8 relative -mt-8 pt-4\">\n                <div className=\"text-center max-w-xl mx-auto space-y-2\">\n                  <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Inspirations de l\'Atelier</span>\n                  <h2 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">\n                    Nos Cat\303\251gories Parfum\303\251es\n                  </h2>\n                  <p className=\"text-xs text-brand-text-muted\">\n                    D\303\251couvrez nos collections phares coul\303\251es \303\240 la main dans notre atelier de Bourgogne.\n                  </p>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                  {/* Category Card 1 - Bouquets parfum\303\251s */}\n                  <div \n                    onClick={() => { setSelectedCategory(\'Bouquets parfum\303\251s\'); setCurrentTab(\'boutique\'); }}\n                    className=\"group relative rounded-2xl overflow-hidden bg-brand-depth border border-brand-pink/10 p-4 flex flex-col justify-between hover:border-brand-pink/30 hover:-translate-y-1.5 transition-all duration-300 shadow-lg cursor-pointer\"\n                  >\n                    <div>\n                      <div className=\"relative rounded-xl overflow-hidden mb-4 aspect-[4/3] bg-brand-bg\">\n                        <img \n                          src=\"https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=600&q=80\" \n                          alt=\"Bouquets parfum\303\251s\" \n                          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                        />\n                        <span className=\"absolute top-2 left-2 px-2 py-0.5 rounded bg-brand-bg/80 border border-brand-pink/10 font-mono text-[9px] uppercase tracking-wider text-brand-pink font-semibold\">\n                          \342\217\263 Pr\303\251commande\n                        </span>\n                      </div>\n                      <h3 className=\"text-lg font-serif font-semibold text-brand-cream\">Bouquets parfum\303\251s</h3>\n                      <p className=\"text-xs text-brand-text-muted mt-1 leading-relaxed\">\n                        Une composition d\303\251corative et parfum\303\251e \303\240 offrir ou \303\240 garder.\n                      </p>\n                    </div>\n                    <div className=\"mt-4 flex items-center justify-between text-xs font-mono text-brand-pink pt-2 border-t border-brand-pink/5\">\n                      <span>D\303\251couvrir</span>\n                      <span className=\"w-6 h-6 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink group-hover:bg-brand-pink group-hover:text-brand-bg transition-colors\">\n                        <ArrowUpRight className=\"w-3.5 h-3.5\" />\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Category Card 2 - Fondants */}\n                  <div \n                    onClick={() => { setSelectedCategory(\'Fondants\'); setCurrentTab(\'boutique\'); }}\n                    className=\"group relative rounded-2xl overflow-hidden bg-brand-depth border border-brand-pink/10 p-4 flex flex-col justify-between hover:border-brand-pink/30 hover:-translate-y-1.5 transition-all duration-300 shadow-lg cursor-pointer\"\n                  >\n                    <div>\n                      <div className=\"relative rounded-xl overflow-hidden mb-4 aspect-[4/3] bg-brand-bg\">\n                        <img \n                          src=\"https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=600&q=80\" \n                          alt=\"Fondants parfum\303\251s\" \n                          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                        />\n                        <span className=\"absolute top-2 left-2 px-2 py-0.5 rounded bg-brand-bg/80 border border-brand-pink/10 font-mono text-[9px] uppercase tracking-wider text-brand-pink font-semibold\">\n                          \342\217\263 Pr\303\251commande\n                        </span>\n                      </div>\n                      <h3 className=\"text-lg font-serif font-semibold text-brand-cream\">Fondants</h3>\n                      <p className=\"text-xs text-brand-text-muted mt-1 leading-relaxed\">\n                        Des senteurs \303\240 faire fondre selon l\342\200\231ambiance du moment.\n                      </p>\n                    </div>\n                    <div className=\"mt-4 flex items-center justify-between text-xs font-mono text-brand-pink pt-2 border-t border-brand-pink/5\">\n                      <span>D\303\251couvrir</span>\n                      <span className=\"w-6 h-6 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink group-hover:bg-brand-pink group-hover:text-brand-bg transition-colors\">\n                        <ArrowUpRight className=\"w-3.5 h-3.5\" />\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Category Card 3 - Bougies */}\n                  <div \n                    onClick={() => { setSelectedCategory(\'Bougies en pot\'); setCurrentTab(\'boutique\'); }}\n                    className=\"group relative rounded-2xl overflow-hidden bg-brand-depth border border-brand-pink/10 p-4 flex flex-col justify-between hover:border-brand-pink/30 hover:-translate-y-1.5 transition-all duration-300 shadow-lg cursor-pointer\"\n                  >\n                    <div>\n                      <div className=\"relative rounded-xl overflow-hidden mb-4 aspect-[4/3] bg-brand-bg\">\n                        <img \n                          src=\"https://images.unsplash.com/photo-1596435707261-05600be4742e?auto=format&fit=crop&w=600&q=80\" \n                          alt=\"Bougies parfum\303\251es\" \n                          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                        />\n                        <span className=\"absolute top-2 left-2 px-2 py-0.5 rounded bg-brand-bg/80 border border-brand-pink/10 font-mono text-[9px] uppercase tracking-wider text-brand-pink font-semibold\">\n                          \342\217\263 Pr\303\251commande\n                        </span>\n                      </div>\n                      <h3 className=\"text-lg font-serif font-semibold text-brand-cream\">Bougies en pot</h3>\n                      <p className=\"text-xs text-brand-text-muted mt-1 leading-relaxed\">\n                        Des bougies artisanales en pot, douces et \303\251l\303\251gantes.\n                      </p>\n                    </div>\n                    <div className=\"mt-4 flex items-center justify-between text-xs font-mono text-brand-pink pt-2 border-t border-brand-pink/5\">\n                      <span>D\303\251couvrir</span>\n                      <span className=\"w-6 h-6 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink group-hover:bg-brand-pink group-hover:text-brand-bg transition-colors\">\n                        <ArrowUpRight className=\"w-3.5 h-3.5\" />\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Category Card 4 - Cadres parfum\303\251s */}\n                  <div \n                    onClick={() => { setSelectedCategory(\'Cadres parfum\303\251s\'); setCurrentTab(\'boutique\'); }}\n                    className=\"group relative rounded-2xl overflow-hidden bg-brand-depth border border-brand-pink/10 p-4 flex flex-col justify-between hover:border-brand-pink/30 hover:-translate-y-1.5 transition-all duration-300 shadow-lg cursor-pointer\"\n                  >\n                    <div>\n                      <div className=\"relative rounded-xl overflow-hidden mb-4 aspect-[4/3] bg-brand-bg\">\n                        <img \n                          src=\"https://images.unsplash.com/photo-1541532713592-79a0317b6b77?auto=format&fit=crop&w=600&q=80\" \n                          alt=\"Cadres parfum\303\251s\" \n                          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                        />\n                        <span className=\"absolute top-2 left-2 px-2 py-0.5 rounded bg-brand-bg/80 border border-brand-pink/10 font-mono text-[9px] uppercase tracking-wider text-brand-pink font-semibold\">\n                          \342\217\263 Pr\303\251commande\n                        </span>\n                      </div>\n                      <h3 className=\"text-lg font-serif font-semibold text-brand-cream\">Cadres parfum\303\251s</h3>\n                      <p className=\"text-xs text-brand-text-muted mt-1 leading-relaxed\">\n                        Une cr\303\251ation parfum\303\251e d\303\251corative et personnalisable.\n                      </p>\n                    </div>\n                    <div className=\"mt-4 flex items-center justify-between text-xs font-mono text-brand-pink pt-2 border-t border-brand-pink/5\">\n                      <span>D\303\251couvrir</span>\n                      <span className=\"w-6 h-6 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink group-hover:bg-brand-pink group-hover:text-brand-bg transition-colors\">\n                        <ArrowUpRight className=\"w-3.5 h-3.5\" />\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              </section>\n\n              {/* Curated Product Catalogue Preview Row (curated highlights) */}\n              <section className=\"space-y-8\" id=\"section-curated-products\">\n                <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n                  <div className=\"space-y-2\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold font-mono\">Derni\303\250res Douceurs</span>\n                    <h2 className=\"text-3xl font-serif font-bold text-brand-cream\">\n                      Les cr\303\251ations les plus aim\303\251es\n                    </h2>\n                  </div>\n                  <button \n                    onClick={() => { setSelectedCategory(\'Tous\'); setCurrentTab(\'boutique\'); }}\n                    className=\"group text-brand-pink font-semibold text-sm hover:text-brand-cream flex items-center gap-1.5 self-start cursor-pointer transition-colors\"\n                  >\n                    Voir l\'int\303\251gralit\303\251 du catalogue\n                    <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                  </button>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                  {PRODUCTS.slice(0, 4).map((product) => (\n                    <ProductCard \n                      key={product.id} \n                      product={product} \n                      onSelect={(p) => setSelectedProduct(p)} \n                    />\n                  ))}\n                </div>\n              </section>\n\n              {/* ================= SECTION POURQUOI CHOISIR ================= */}\n              <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">\n                <div className=\"max-w-7xl mx-auto space-y-12\">\n                  <div className=\"text-center max-w-xl mx-auto space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Un choix artisanal &amp; sain</span>\n                    <h2 className=\"text-4xl font-serif font-bold text-brand-cream\">Pourquoi choisir R\303\252ve Parfum\303\251 ?</h2>\n                    <p className=\"text-sm text-brand-text-muted\">\n                      Des fragrances soign\303\251es pour envelopper votre quotidien d\'une douceur po\303\251tique.\n                    </p>\n                  </div>\n\n                  {/* Layout adaptive centering standard centerpiece + 4 args */}\n                  <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n                    \n                    {/* Left Column (Arguments 1 & 2) */}\n                    <div className=\"lg:col-span-4 space-y-8 text-left lg:text-right\">\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">1</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Naturel</h3>\n                        <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                          Cire de soja saine et biod\303\251gradable associ\303\251e \303\240 des parfums de Grasse de haute qualit\303\251, sans aucun agent chimique CMR ni phtalates.\n                        </p>\n                      </div>\n\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">2</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Fait main</h3>\n                        <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                          Chaque cr\303\251ation parfum\303\251e est coul\303\251e de mani\303\250re attentionn\303\251e \303\240 l\'unit\303\251 au sein de l\'Atelier en Bourgogne, garantissant des pi\303\250ces uniques.\n                        </p>\n                      </div>\n                    </div>\n\n                    {/* Center Column (Visual mockup and direct navigation button) */}\n                    <div className=\"lg:col-span-4 justify-center flex flex-col items-center gap-6 relative\">\n                      <div className=\"absolute inset-0 bg-brand-pink/5 filter blur-3xl rounded-full\" />\n                      <div className=\"relative rounded-full overflow-hidden border border-brand-pink/15 w-60 h-60 bg-brand-bg shadow-xl flex items-center justify-center\">\n                        <img \n                          src=\"https://images.unsplash.com/photo-1596435707261-05600be4742e?auto=format&fit=crop&w=600&q=80\" \n                          alt=\"Atelier R\303\252ve Parfum\303\251\" \n                          className=\"w-full h-full object-cover rounded-full\"\n                        />\n                      </div>\n                      <button \n                        onClick={() => { setSelectedCategory(\'Tous\'); setCurrentTab(\'boutique\'); }}\n                        className=\"px-6 py-2.5 bg-brand-depth hover:bg-brand-pink/15 border border-brand-pink/20 text-brand-pink hover:text-brand-cream text-xs font-mono uppercase tracking-widest rounded-full transition-all flex items-center gap-1.5\"\n                      >\n                        D\303\251couvrir la boutique\n                        <ArrowRight className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n\n                    {/* Right Column (Arguments 3 & 4) */}\n                    <div className=\"lg:col-span-4 space-y-8 text-left\">\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">3</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Personnalisable</h3>\n                        <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                          Couleurs, senteurs, formats et quantit\303\251s peuvent \303\252tre adapt\303\251s sur-mesure pour s\'harmoniser avec vos envies ou l\'identit\303\251 de vos \303\251v\303\251nements.\n                        </p>\n                      </div>\n\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">4</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Pens\303\251 pour offrir</h3>\n                        <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                          De jolies cr\303\251ations id\303\251ales pour d\303\251corer avec d\303\251licatesse, embaumer un salon chaleureusement et marquer durablement les moments cl\303\251s de votre vie.\n                        </p>\n                      </div>\n                    </div>\n\n                  </div>\n                </div>\n              </section>\n\n              {/* ================= SCENT FINDER WIZARD TRIGGER AREA ================= */}\n              <section className=\"scroll-mt-28\" id=\"scent-finder-anchor\">\n                <div className=\"p-8 md:p-12 rounded-3xl liquid-strong border border-brand-pink/15 relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-8\">\n                  {/* Glowing halo */}\n                  <div className=\"absolute top-[-50%] right-[-10%] w-72 h-72 bg-brand-pink/15 rounded-full filter blur-[80px]\" />\n                  <div className=\"absolute bottom-[-40%] left-[-15%] w-60 h-60 bg-brand-purple/15 rounded-full filter blur-[70px]\" />\n                  \n                  <div className=\"space-y-4 max-w-2xl relative z-10 text-left\">\n                    <span className=\"text-xs font-mono font-bold text-brand-pink uppercase tracking-widest block\">Guide Olfactif Interactif</span>\n                    <h3 className=\"text-3xl font-serif font-bold text-brand-cream leading-tight\">\n                      Tu ne sais pas quelle senteur choisir ?\n                    </h3>\n                    <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                      R\303\251ponds \303\240 quelques questions et d\303\251couvre les cr\303\251ations les plus adapt\303\251es \303\240 ton envie : florale, fruit\303\251e, gourmande, fra\303\256che, douce ou chaleureuse.\n                    </p>\n                  </div>\n                  \n                  <div className=\"relative z-10 self-start md:self-center\">\n                    <button \n                      onClick={() => setShowQuizModal(true)}\n                      className=\"px-8 py-4 bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-extrabold text-sm tracking-wider uppercase rounded-full shadow-lg transition-colors cursor-pointer whitespace-nowrap\"\n                    >\n                      Lancer le guide senteur\n                    </button>\n                  </div>\n                </div>\n              </section>\n\n              {/* ================= SECTION \303\211V\303\211NEMENTS COURTE ================= */}\n              <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-6\">\n                {/* Left block information */}\n                <div className=\"lg:col-span-6 space-y-6 text-left\">\n                  <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Pour vos Grands Moments</span>\n                  <h3 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream leading-tight\">\n                    Mariages, \303\251v\303\251nements &amp; comit\303\251s d\342\200\231entreprise\n                  </h3>\n                  <p className=\"text-sm text-brand-text-muted font-light leading-relaxed\">\n                    Des cr\303\251ations parfum\303\251es personnalis\303\251es pour vos invit\303\251s, collaborateurs ou moments importants, avec tarifs d\303\251gressifs selon quantit\303\251.\n                  </p>\n                  <button \n                    onClick={() => { setCurrentTab(\'evenements\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                    className=\"px-6 py-3 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors inline-flex items-center gap-2\"\n                  >\n                    Demander un devis personnalis\303\251\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </button>\n                </div>\n\n                {/* Right block 3 mini cards */}\n                <div className=\"lg:col-span-6 space-y-3 text-left\">\n                  <div className=\"p-4 bg-brand-depth/80 border border-brand-pink/5 rounded-2xl flex items-center gap-4\">\n                    <span className=\"w-12 h-12 rounded-xl bg-brand-pink/10 flex items-center justify-center text-brand-pink font-serif text-lg font-bold\">01</span>\n                    <div>\n                      <h4 className=\"font-serif font-semibold text-brand-cream text-base\">Mariages &amp; Bapt\303\252mes</h4>\n                      <p className=\"text-xs text-brand-text-muted\">Des bougies miniatures \303\251l\303\251gantes adapt\303\251es \303\240 vos coloris de cort\303\250ge.</p>\n                    </div>\n                  </div>\n\n                  <div className=\"p-4 bg-brand-depth/80 border border-brand-pink/5 rounded-2xl flex items-center gap-4 border-l-2 border-l-brand-pink\">\n                    <span className=\"w-12 h-12 rounded-xl bg-brand-pink/15 flex items-center justify-center text-brand-pink font-serif text-lg font-bold\">02</span>\n                    <div>\n                      <h4 className=\"font-serif font-semibold text-brand-cream text-base\">Cadeaux d\'Invit\303\251s</h4>\n                      <p className=\"text-xs text-brand-text-muted\">Des tablettes pr\303\251cieuses orn\303\251es d\'\303\251tiquettes typographi\303\251es sur-mesure.</p>\n                    </div>\n                  </div>\n\n                  <div className=\"p-4 bg-brand-depth/80 border border-brand-pink/5 rounded-2xl flex items-center gap-4\">\n                    <span className=\"w-12 h-12 rounded-xl bg-brand-pink/10 flex items-center justify-center text-brand-pink font-serif text-lg font-bold\">03</span>\n                    <div>\n                      <h4 className=\"font-serif font-semibold text-brand-cream text-base\">Comit\303\251s d\'Entreprise</h4>\n                      <p className=\"text-xs text-brand-text-muted\">De superbes coffrets olfactifs raffin\303\251s pour choyer vos \303\251quipes.</p>\n                    </div>\n                  </div>\n                </div>\n              </section>\n\n              {/* ================= SECTION AVIS COURTS ================= */}\n              <section className=\"space-y-6 text-center\">\n                <div className=\"space-y-2\">\n                  <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">T\303\251moignages Chaleureux</span>\n                  <h3 className=\"text-3xl font-serif font-bold text-brand-cream\">Elles et ils ont d\303\251j\303\240 craqu\303\251</h3>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 text-left\">\n                  {/* Review 1 */}\n                  <div className=\"p-6 rounded-2xl bg-brand-depth/60 border border-brand-pink/10 flex flex-col justify-between space-y-4\">\n                    <p className=\"text-sm text-brand-text-muted italic leading-relaxed\">\n                      \342\200\234Une odeur douce qui reste longtemps. Des cr\303\251ations soign\303\251es qui apportent un vrai r\303\251confort dans mon salon.\342\200\235\n                    </p>\n                    <div className=\"flex items-center justify-between pt-2 border-t border-brand-pink/5 text-xs\">\n                      <div>\n                        <span className=\"font-semibold text-brand-cream block\">Sophie Dumont</span>\n                        <span className=\"text-[10px] text-brand-pink\">Avis Facebook \302\267 \342\255\220\342\255\220\342\255\220\342\255\220\342\255\220</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Review 2 */}\n                  <div className=\"p-6 rounded-2xl bg-brand-depth/60 border border-brand-pink/10 flex flex-col justify-between space-y-4\">\n                    <p className=\"text-sm text-brand-text-muted italic leading-relaxed\">\n                      \342\200\234Tr\303\250s belle cr\303\251ation, parfaite pour offrir. Le sachet cadeau fleuri est magnifique et tr\303\250s chic !\342\200\235\n                    </p>\n                    <div className=\"flex items-center justify-between pt-2 border-t border-brand-pink/5 text-xs\">\n                      <div>\n                        <span className=\"font-semibold text-brand-cream block\">Jean-Baptiste L.</span>\n                        <span className=\"text-[10px] text-brand-pink\">Avis Messenger \302\267 \342\255\220\342\255\220\342\255\220\342\255\220\342\255\220</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Review 3 */}\n                  <div className=\"p-6 rounded-2xl bg-brand-depth/60 border border-brand-pink/10 flex flex-col justify-between space-y-4\">\n                    <p className=\"text-sm text-brand-text-muted italic leading-relaxed\">\n                      \342\200\234Commande soign\303\251e et \303\251change tr\303\250s agr\303\251able. Les odeurs de Grasse sont un vrai d\303\251lice au quotidien.\342\200\235\n                    </p>\n                    <div className=\"flex items-center justify-between pt-2 border-t border-brand-pink/5 text-xs\">\n                      <div>\n                        <span className=\"font-semibold text-brand-cream block\">Mireille Roussel</span>\n                        <span className=\"text-[10px] text-brand-pink\">Avis Client \302\267 \342\255\220\342\255\220\342\255\220\342\255\220\342\255\220</span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"pt-2\">\n                  <p className=\"text-xs text-brand-purple/70 italic mb-4 font-mono\">\n                    * Avis authentiques issus de retours clients Facebook / Messenger.\n                  </p>\n                  <button \n                    onClick={() => { setCurrentTab(\'avis\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                    className=\"px-6 py-2.5 rounded-full bg-brand-depth hover:bg-brand-pink/10 text-brand-pink hover:text-brand-cream text-xs font-mono uppercase tracking-widest transition-all\"\n                  >\n                    Voir tous les avis clients\n                  </button>\n                </div>\n              </section>\n\n              {/* ================= SECTION CTA DE FIN ================= */}\n              <section className=\"bg-gradient-to-br from-brand-depth to-brand-bg border border-brand-pink/20 rounded-3xl p-8 md:p-12 text-center relative overflow-hidden\">\n                <div className=\"absolute top-0 right-0 w-40 h-40 bg-brand-pink/10 rounded-full filter blur-[50px] pointer-events-none\" />\n                <div className=\"absolute bottom-0 left-0 w-40 h-40 bg-brand-purple/10 rounded-full filter blur-[50px] pointer-events-none\" />\n                \n                <div className=\"max-w-xl mx-auto space-y-6 relative z-10\">\n                  <h3 className=\"text-3xl font-serif font-bold text-brand-cream leading-tight\">\n                    Une id\303\251e, une senteur, une occasion ?\n                  </h3>\n                  <p className=\"text-sm text-brand-text-muted\">\n                    \303\211crivez-nous, on vous guide simplement sur WhatsApp pour fa\303\247onner votre prochaine douceur parfum\303\251e.\n                  </p>\n                  <a \n                    href={generalWhatsAppLink}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"px-8 py-4 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors shadow-lg inline-flex items-center gap-2\"\n                  >\n                    <MessageCircle className=\"w-4 h-4 fill-brand-bg\" />\n                    Commander ou demander conseil\n                  </a>\n                </div>\n              </section>\n\n            </motion.div>\n          )}\n\n          {/* ==================== 2. BOUTIQUE CATALOGUE TAB ==================== */}\n          {currentTab === \'boutique\' && (\n            <motion.div"
    }
    instruction: "Update App.tsx to include advanced filters state and the detailed Page 1 (Accueil) as specified"
  }
}
