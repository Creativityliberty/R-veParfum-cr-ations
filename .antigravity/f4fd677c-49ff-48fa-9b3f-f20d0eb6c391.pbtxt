          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Le Respect de l\'Art</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">Notre charte de fabrication</h2>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <p className=\"text-sm text-brand-text-muted font-light\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              De l\'achat de nos mati\303\250res premi\303\250res jusqu\'\303\240 l\'exp\303\251dition de vos d\303\251licats colis, nous ne faisons aucune concession sur la qualit\303\251 :"
