        }
        lines {
          text: "                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                Extraits de Grasse de premi\303\250re qualit\303\251"
