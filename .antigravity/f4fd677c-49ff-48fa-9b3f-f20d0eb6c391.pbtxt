      replacement_content: "import React, { useState } from \'react\';\nimport { Sparkles, Calendar, Users, MapPin, Send, Gift } from \'lucide-react\';\n\nexport default function HomePartiesBuilder() {\n  const [hostName, setHostName] = useState(\"\");\n  const [city, setCity] = useState(\"\");\n  const [guestCount, setGuestCount] = useState(6);\n  const [preferredDate, setPreferredDate] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [notes, setNotes] = useState(\"\");\n\n  const handleBookParty = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!hostName.trim() || !city.trim()) {\n      alert(\"S\'il vous pla\303\256t, indiquez votre nom et votre ville de r\303\251sidence pour convenir d\'un atelier.\");\n      return;\n    }\n\n    const text = `Bonjour M\303\251lanie et Christelle ! \360\237\217\241\360\237\214\270\nJe souhaite organiser une R\303\251union Parfum\303\251e \303\240 mon domicile :\n- Nom de l\'h\303\264te : ${hostName}\n- Ville / Commune : ${city}\n- Nombre estim\303\251 de convives : ${guestCount} personnes (minimum 5 requis)\n- Date souhait\303\251e : ${preferredDate ? preferredDate : \"\303\200 d\303\251finir ensemble\"}\n- T\303\251l\303\251phone : ${phone ? phone : \"Non sp\303\251cifi\303\251\"}\n- Notes particuli\303\250res : ${notes ? notes : \"Aucune\"}\n\nJe suis ravie d\'accueillir cet atelier et d\'offrir un moment cocooning \303\240 mes proches ! \303\200 tr\303\250s vite \360\237\230\212`;\n\n    const encoded = encodeURIComponent(text);\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\');\n  };\n\n  return (\n    <div className=\"bg-brand-depth border border-brand-pink/15 rounded-3xl p-6 md:p-8 space-y-6 relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 w-48 h-48 bg-brand-purple/5 rounded-full filter blur-3xl pointer-events-none\" />\n\n      <div className=\"text-center max-w-xl mx-auto space-y-2\">\n        <Gift className=\"w-8 h-8 text-brand-pink mx-auto animate-bounce\" />\n        <h3 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n          Invitez l\'atelier olfactif chez vous !\n        </h3>\n        <p className=\"text-sm text-brand-text-muted\">\n          Organisez une r\303\251union sensorielle et parfum\303\251e avec vos proches. En tant qu\'h\303\264tesse, b\303\251n\303\251ficiez de <span className=\"text-brand-pink font-semibold\">10% du montant total des ventes</span> en bon d\'achat cadeau !\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8 items-center max-w-5xl mx-auto\">\n        \n        {/* Rules column */}\n        <div className=\"space-y-4\">\n          <div className=\"p-5 bg-brand-bg/50 rounded-2xl border border-brand-pink/15 space-y-3\">\n            <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Comment \303\247a se passe ?</span>\n            \n            <div className=\"space-y-3\">\n              <div className=\"flex gap-3\">\n                <span className=\"w-6 h-6 rounded-full bg-brand-pink/20 text-brand-pink flex items-center justify-center font-bold text-xs shrink-0 mt-0.5\">1</span>\n                <div>\n                  <h4 className=\"font-semibold text-brand-cream text-sm\">R\303\251unissez vos proches</h4>\n                  <p className=\"text-xs text-brand-text-muted\">Rassemblez au minimum 5 invit\303\251s (amis, voisins, famille) chez vous pour une apr\303\250s-midi ou une soir\303\251e.</p>\n                </div>\n              </div>\n\n              <div className=\"flex gap-3\">\n                <span className=\"w-6 h-6 rounded-full bg-brand-pink/20 text-brand-pink flex items-center justify-center font-bold text-xs shrink-0 mt-0.5\">2</span>\n                <div>\n                  <h4 className=\"font-semibold text-brand-cream text-sm\">Atelier sensoriel & doutes</h4>\n                  <p className=\"text-xs text-brand-text-muted\">Christelle ou M\303\251lanie se d\303\251place avec la malle aux tr\303\251sors parfum\303\251e : bougies, fondants, mati\303\250res premi\303\250res et fragrances de Grasse.</p>\n                </div>\n              </div>\n\n              <div className=\"flex gap-3\">\n                <span className=\"w-6 h-6 rounded-full bg-brand-pink/20 text-brand-pink flex items-center justify-center font-bold text-xs shrink-0 mt-0.5\">3</span>\n                <div>\n                  <h4 className=\"font-semibold text-brand-cream text-sm\">Vos 10% cadeaux</h4>\n                  <p className=\"text-xs text-brand-text-muted\">Chacun s\303\251lectionne ses coups de c\305\223ur et l\'h\303\264tesse cumule 10% du chiffre d\'affaires global de la session en produits de la boutique !</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"p-4 bg-brand-pink/5 rounded-2xl border border-brand-pink/10\">\n            <p className=\"text-xs text-brand-purple leading-relaxed italic\">\n              \360\237\223\214 Les r\303\251unions sont principalement anim\303\251es dans un rayon de 40 km autour de notre atelier. Contactez-nous pour v\303\251rifier notre venue dans votre d\303\251partement !\n            </p>\n          </div>\n        </div>\n\n        {/* Booking Form */}\n        <form onSubmit={handleBookParty} className=\"bg-brand-bg/60 p-6 rounded-2xl border border-brand-pink/10 space-y-4 shadow-xl\">\n          <h4 className=\"font-serif text-lg font-bold text-brand-cream border-b border-brand-pink/10 pb-2\">R\303\251server votre date</h4>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Votre Nom complet *</label>\n              <input\n                required\n                type=\"text\"\n                placeholder=\"Ex : M\303\251lissa Perrin\"\n                value={hostName}\n                onChange={(e) => setHostName(e.target.value)}\n                className=\"w-full p-2.5 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Ville / Commune *</label>\n              <input\n                required\n                type=\"text\"\n                placeholder=\"Ex : Lyon ou alentours\"\n                value={city}\n                onChange={(e) => setCity(e.target.value)}\n                className=\"w-full p-2.5 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Date id\303\251ale envisag\303\251e</label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex : Samedi 18 Octobre\"\n                value={preferredDate}\n                onChange={(e) => setPreferredDate(e.target.value)}\n                className=\"w-full p-2.5 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Nombre d\'invit\303\251s estim\303\251</label>\n              <select\n                value={guestCount}\n                onChange={(e) => setGuestCount(Number(e.target.value))}\n                className=\"w-full p-2.5 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none\"\n              >\n                <option value=\"5\">5 invit\303\251s</option>\n                <option value=\"6\">6 \303\240 8 invit\303\251s</option>\n                <option value=\"10\">9 \303\240 12 invit\303\251s</option>\n                <option value=\"15\">Plus de 15 invit\303\251s</option>\n              </select>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-mono text-brand-pink uppercase tracking-wider mb-1\">Votre Num\303\251ro de T\303\251l\303\251phone</label>\n            <input\n              type=\"tel\"\n              placeholder=\"Ex : 06 00 00 00 00\"\n              value={phone}\n              onChange={(e) => setPhone(e.target.value)}\n              className=\"w-full p-2.5 bg-brand-depth border border-brand-pink/30 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Un mot d\'accueil ? (Pr\303\251cision d\'horaire ou envies...)</label>\n            <textarea\n              placeholder=\"Ex : Nous pr\303\251f\303\251rons un cr\303\251neau dominical en apr\303\250s-midi si possible...\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              className=\"w-full p-2.5 bg-brand-depth border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink min-h-[60px]\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full py-3 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer\"\n          >\n            <Send className=\"w-4 h-4 text-brand-bg fill-brand-bg\" />\n            R\303\251server ma date via WhatsApp\n          </button>\n        </form>\n\n      </div>\n    </div>\n  );\n}\n"
    }
