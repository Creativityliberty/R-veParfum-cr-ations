          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            >"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <LegalHero "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                title=\"Politique de confidentialit\303\251\" "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                subtitle=\"Cette page explique comment vos donn\303\251es sont utilis\303\251es dans le cadre des demandes, commandes et \303\251changes avec R\303\252ve Parfum\303\251 Cr\303\251ation.\" "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <LegalSection title=\"1. Donn\303\251es collect\303\251es de bon usage\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  Dans le cadre strict de l\'organisation artisanale de l\'Atelier, nous ne collectons que les informations indispensables pour \303\251laborer votre sillage parfum\303\251 de cire bio. Ces donn\303\251es incluent :"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                </p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
