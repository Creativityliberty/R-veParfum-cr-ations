olean;\n    showFinalCTA: boolean;\n  };\n  categories: Array<{\n    label: string;\n    description: string;\n    icon: string;\n    target: string;\n  }>;\n  featuredProducts: Array<{\n    name: string;\n    tag: string;\n    description: string;\n    image: string;\n    target: string;\n    scents: string[];\n  }>;\n  olfactoryFamilies: Array<{\n    name: string;\n    mood: string;\n    color: string;\n    scents: string[];\n  }>;\n  socialProof: {\n    title: string;\n    stats: Array<{ value: string; label: string }>;\n    marqueeItems: string[];\n  };\n  finalCta: {\n    eyebrow: string;\n    title: string;\n    description: string;\n    primaryCta: string;\n    secondaryCta: string;\n  };\n}\n\nexport const homePageConfig: HomePageConfig = {\n  brand: {\n    name: \"R\303\252ve Parfum\303\251 Cr\303\251ation\",\n    shortName: \"R\303\252ve Parfum\303\251\",\n    baseline: \"Cr\303\251ations parfum\303\251es artisanales de Bourgogne\",\n    locationLabel: \"Atelier artisanal \342\200\242 Coul\303\251 main\",\n    whatsappNumber: \"33600000000\",\n  },\n\n  media: {\n    // Unsplash premium stock video representation or ambient fallback\n    heroVideoUrl: \"https://player.vimeo.com/external/432021004.sd.mp4?s=d0092f23293e506ab64dd787f0bda17edee02421&profile_id=165&oauth2_token_id=57447761\",\n    heroPoster: \"https://images.unsplash.com/photo-1596435707261-05600be4742e?auto=format&fit=crop&w=1200&q=80\",\n    fallbackHeroImage: \"https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=1200&q=80\",\n    craftVideoUrl: \"https://player.vimeo.com/external/434045526.sd.mp4?s=c27d3c0357e9996de32fa4c30c3098f987997843&profile_id=165&oauth2_token_id=57447761\",\n  },\n\n  theme: {\n    mode: \"nocturnal-scent-atelier\",\n    radius: \"1.25rem\",\n    colors: {\n      background: \"325 34% 6%\",\n      foreground: \"38 38% 94%\",\n      mutedForeground: \"35 20% 72%\",\n      card: \"328 28% 9%\",\n      cardForeground: \"38 38% 94%\",\n      primary: \"334 45% 62%\",\n      primaryForeground: \"330 35% 8%\",\n      secondary: \"28 50% 74%\",\n      accent: \"348 55% 72%\",\n      border: \"330 20% 22%\",\n      ring: \"334 45% 62%\",\n      cream: \"#FFF7F1\",\n      blush: \"#EFC6D2\",\n      prune: \"#2A1B22\",\n      roseGold: \"#C9967E\",\n      wax: \"#E8D3B0\",\n    },\n  },\n\n  typography: {\n    displayFont: \"Cormorant Garamond\",\n    bodyFont: \"Inter\",\n    accentFont: \"Instrument Serif\",\n    importStrategy: \"Google Fonts\",\n  },\n\n  nav: {\n    links: [\n      { label: \"Accueil\", target: \"accueil\" },\n      { label: \"Nos Cr\303\251ations\", target: \"boutique\" },\n      { label: \"Personnalisation\", target: \"personalisation\" },\n      { label: \"Ateliers & \303\211v\303\251nements\", target: \"mariages\" },\n      { label: \"Mises en Situation\", target: \"inspiration\" },\n      { label: \"Avis Clients\", target: \"avis\" },\n    ],\n    cta: {\n      label: \"Cr\303\251er un projet WhatsApp\",\n      target: \"whatsapp\",\n      icon: \"MessageCircle\"\n    }\n  },\n\n  hero: {\n    eyebrow: \"Cr\303\251ations parfum\303\251es artisanales\",\n    headlineLines: [\n      \"Offrez une senteur\",\n      \"qui devient un souvenir.\"\n    ],\n    highlightedWords: [\"senteur\", \"souvenir\", \"artisanales\"],\n    subtitle: \"Bougies d\'exception, fondants floraux de saison, brumes et coffrets cadeaux imagin\303\251s avec amour pour instiller po\303\251sie et apaisement dans vos foyers.\",\n    primaryCta: {\n      label: \"D\303\251couvrir le catalogue\",\n      target: \"boutique\",\n      icon: \"ArrowRight\"\n    },\n    secondaryCta: {\n      label: \"Trouver ma senteur\",\n      target: \"scentQuiz\",\n      icon: \"Sparkles\"\n    },\n    trustBadges: [\n      \"Fait main en Bourgogne\",\n      \"Cire 100% Soja bio\",\n      \"Parfums sans CMR (Grasse)\",\n      \"Z\303\251ro pesticide & v\303\251gane\"\n    ]\n  },\n\n  motion: {\n    globalPreset: \"perfume-mist\",\n    reduceMotionSafe: true,\n    heroVideoFade: {\n      enabled: true,\n      fadeInMs: 700,\n      fadeOutMs: 700,\n      restartDelayMs: 200,\n      endFadeThreshold: 0.8\n    },\n    textReveal: {\n      type: \"blur-word-rise\",\n      wordDelay: 0.06,\n      duration: 0.85,\n      blurFrom: 16,\n      yFrom: 36,\n      ease: [0.22, 1, 0.36, 1]\n    },\n    sectionReveal: {\n      type: \"fade-blur-up\",\n      duration: 0.8,\n      y: 30,\n      blur: 10,\n      stagger: 0.15\n    },\n    cardHover: {\n      y: -6,\n      scale: 1.02,\n      rotateX: 1.5,\n      duration: 0.3\n    },\n    marquee: {\n      speedSeconds: 32,\n      pauseOnHover: true\n    }\n  },\n\n  sections: {\n    showScentWheel: true,\n    showFeaturedProducts: true,\n    showCraftStory: true,\n    showOccasions: true,\n    showQuizTeaser: true,\n    showTestimonials: true,\n    showFinalCTA: true\n  },\n\n  categories: [\n    { label: \"Bougies en pot\", description: \"Pour cr\303\251er une ambiance cocooning douce et durable\", icon: \"Flame\", target: \"Bougies en pot\" },\n    { label: \"Fondants\", description: \"D\303\251licats galets floraux qui s\'\303\251panouissent au br\303\273le-parfum\", icon: \"Sparkles\", target: \"Fondants\" },\n    { label: \"Bouquets parfum\303\251s\", description: \"Capillarit\303\251 \303\251l\303\251gante qui livre son ar\303\264me au fil des heures\", icon: \"Flower2\", target: \"Bouquets parfum\303\251s\" },\n    { label: \"Cadres parfum\303\251s\", description: \"Tablettes de cire fleurie \303\240 suspendre pour aromatiser de petits espaces\", icon: \"Gift\", target: \"Cadres parfum\303\251s\" }\n  ],\n\n  featuredProducts: [\n    {\n      name: \"La Bougie Fleurie C\303\251ramique\",\n      tag: \"Best-Seller\",\n      description: \"Coul\303\251e sur lit de lilas et de roses s\303\251ch\303\251es de notre propre cueillette.\",\n      image: \"https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=600&q=80\",\n      t