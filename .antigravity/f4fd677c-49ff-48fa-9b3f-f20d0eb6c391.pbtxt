          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <h4 className=\"font-serif italic font-bold text-brand-cream text-base\">\"Un geste artisanal lent qui c\303\251l\303\250bre le beau.\"</h4>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <p className=\"text-[11px] text-brand-text-muted font-light mt-1.5 leading-relaxed\">"
