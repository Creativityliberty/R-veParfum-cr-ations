          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <div className=\"space-y-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                Extraits de Grasse de premi\303\250re qualit\303\251"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              </h3>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                Nous choisissons nos concentr\303\251s de parfum aupr\303\250s des nez les plus r\303\251put\303\251s de Grasse. Ils respectent toutes les r\303\251gulations europ\303\251ennes les plus strictes : aucun CMR (Canc\303\251rog\303\250ne, Mutag\303\250ne, Reprotoxique) ni phtalates n\'est pr\303\251sent dans nos formules."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              </p>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
