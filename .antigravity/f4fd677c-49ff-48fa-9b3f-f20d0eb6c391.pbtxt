  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Menu, X, Instagram, Facebook, MessageSquare, ShoppingBag } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface HeaderProps {\n  currentTab: string;\n  setCurrentTab: (tab: string) => void;\n  openScentQuiz: () => void;\n}\n\nexport default function Header({ currentTab, setCurrentTab, openScentQuiz }: HeaderProps) {\n  const [isOpen, setIsOpen] = useState(false);\n\n  const navItems = [\n    { label: \'Accueil\', id: \'accueil\' },\n    { label: \'Boutique\', id: \'boutique\' },\n    { label: \'Mariages & \303\211v\303\251nements\', id: \'evenements\' },\n    { label: \'R\303\251unions \303\240 Domicile\', id: \'reunions\' },\n    { label: \'Avis Clients\', id: \'avis\' },\n    { label: \'Livraison & Info\', id: \'livraison\' }\n  ];\n\n  const handleTabClick = (id: string) => {\n    setCurrentTab(id);\n    setIsOpen(false);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 px-4 pt-4 pb-2 md:px-8\">\n      {/* Floating Capsule Container */}\n      <div className=\"max-w-7xl mx-auto backdrop-blur-md bg-brand-bg/80 border border-brand-pink/20 rounded-full px-6 py-3 shadow-lg transition-all duration-300\">\n        <div className=\"flex items-center justify-between\">\n          \n          {/* Brand Logo & Name */}\n          <button \n            onClick={() => handleTabClick(\'accueil\')} \n            className=\"flex items-center gap-2 group cursor-pointer text-left focus:outline-none\"\n          >\n            <span className=\"text-xl md:text-2xl font-serif font-semibold tracking-wide text-brand-pink drop-shadow-sm group-hover:text-amber-100 transition-colors\">\n              R\303\252ve Parfum\303\251 <span className=\"font-light italic text-brand-purple\">Cr\303\251ation</span>\n            </span>\n          </button>\n\n          {/* Nav Items (Desktop) */}\n          <nav className=\"hidden lg:flex items-center gap-1\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => handleTabClick(item.id)}\n                className={`px-4 py-1.5 rounded-full text-sm font-medium tracking-wide transition-all duration-300 cursor-pointer ${\n                  currentTab === item.id \n                    ? \'bg-brand-pink text-brand-bg shadow-sm\' \n                    : \'text-brand-text-muted hover:text-brand-cream hover:bg-white/5\'\n                }`}\n              >\n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          {/* Socials & CTA (Desktop) */}\n          <div className=\"hidden lg:flex items-center gap-4\">\n            <a \n              href=\"https://instagram.com\" \n              target=\"_blank\" \n              rel=\"noopener noreferrer\" \n              className=\"text-brand-text-muted hover:text-brand-pink transition-colors p-1\"\n              title=\"Instagram\"\n            >\n              <Instagram className=\"w-5 h-5\" />\n            </a>\n            <a \n              href=\"https://facebook.com\" \n              target=\"_blank\" \n              rel=\"noopener noreferrer\" \n              className=\"text-brand-text-muted hover:text-brand-pink transition-colors p-1\"\n              title=\"Facebook\"\n            >\n              <Facebook className=\"w-5 h-5\" />\n            </a>\n            <button \n              onClick={() => handleTabClick(\'boutique\')}\n              className=\"px-5 py-2 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-pink text-brand-bg hover:bg-brand-pink-hover transition-colors flex items-center gap-1.5 shadow-md cursor-pointer\"\n            >\n              <ShoppingBag className=\"w-3.5 h-3.5\" />\n              Commander\n            </button>\n          </div>\n\n          {/* Mobile Menu Actions */}\n          <div className=\"flex items-center gap-3 lg:hidden\">\n            <button \n              onClick={() => handleTabClick(\'boutique\')}\n              className=\"p-1.5 rounded-full bg-brand-pink/10 text-brand-pink hover:bg-brand-pink text-xs hover:text-brand-bg\"\n              title=\"Boutique\"\n            >\n              <ShoppingBag className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => setIsOpen(!isOpen)}\n              className=\"p-1.5 rounded-full text-brand-text-muted hover:text-brand-cream transition-colors cursor-pointer\"\n              aria-label=\"Toggle menu\"\n            >\n              {isOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Mobile Drawer */}\n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            transition={{ duration: 0.2 }}\n            className=\"absolute top-20 left-4 right-4 z-40 bg-brand-depth bg-opacity-95 backdrop-blur-lg border border-brand-pink/15 rounded-3xl p-6 shadow-2xl block lg:hidden\"\n          >\n            <nav className=\"flex flex-col gap-3\">\n              {navItems.map((item) => (\n                <button\n                  key={item.id}\n                  onClick={() => handleTabClick(item.id)}\n                  className={`w-full text-left px-5 py-3 rounded-xl text-base font-medium transition-all ${\n                    currentTab === item.id \n                      ? \'bg-brand-pink text-brand-bg\' \n                      : \'text-brand-text-muted hover:text-brand-cream hover:bg-white/5\'\n                  }`}\n                >\n                  {item.label}\n                </button>\n              ))}\n              \n              <div className=\"h-px bg-brand-pink/10 my-3\" />\n              \n              <div className=\"flex justify-between items-center px-4\">\n                <span className=\"text-xs text-brand-text-muted uppercase tracking-wider font-mono\">Suivez-nous :</span>\n                <div className=\"flex items-center gap-4\">\n                  <a \n                    href=\"https://instagram.com\" \n                    target=\"_blank\" \n                    rel=\"noopener noreferrer\" \n                    className=\"text-brand-text-muted hover:text-brand-pink transition-colors p-2\"\n                  >\n                    <Instagram className=\"w-5 h-5\" />\n                  </a>\n                  <a \n                    href=\"https://facebook.com\" \n                    target=\"_blank\" \n                    rel=\"noopener noreferrer\" \n                    className=\"text-brand-text-muted hover:text-brand-pink transition-colors p-2\"\n                  >\n                    <Facebook className=\"w-5 h-5\" />\n                  </a>\n                </div>\n              </div>\n\n              <button \n                onClick={() => {\n                  setIsOpen(false);\n                  openScentQuiz();\n                }}\n                className=\"w-full mt-2 py-3 rounded-full text-sm font-semibold tracking-wide bg-brand-purple text-brand-bg hover:bg-brand-cream hover:text-brand-bg transition-colors flex items-center justify-center gap-2\"\n              >\n                \360\237\224\256 Lancer le guide senteur\n              </button>\n            </nav>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </header>\n  );\n}\n"
    }
