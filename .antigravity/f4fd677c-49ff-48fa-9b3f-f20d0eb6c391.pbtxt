        lines {
          text: "    id: \"rev-1\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \"Sophie Dumont\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
