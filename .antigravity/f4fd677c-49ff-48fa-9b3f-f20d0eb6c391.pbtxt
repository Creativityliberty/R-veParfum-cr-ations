          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      q: \"O\303\271 se situe l\'atelier pour le retrait gratuit en Bourgogne ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      a: \"Notre atelier de cr\303\251ation se situe \303\240 proximit\303\251 de Chalon-sur-Sa\303\264ne, en Bourgogne. Les coordonn\303\251es GPS exactes ou notre adresse vous seront amicalement indiqu\303\251es par WhatsApp une fois vos produits assembl\303\251s.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
