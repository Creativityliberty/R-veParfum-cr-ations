    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Star, MessageSquare, Plus, Check, Award, ShieldAlert, Sparkles } from \'lucide-react\';\nimport { Review } from \'../types\';\nimport { REVIEWS } from \'../data\';\n\ninterface ReviewSectionProps {\n  onAddReviewNotification?: (text: string) => void;\n}\n\nexport default function ReviewSection({ onAddReviewNotification }: ReviewSectionProps) {\n  const [reviewsList, setReviewsList] = useState<Review[]>(REVIEWS);\n  const [authorName, setAuthorName] = useState(\"\");\n  const [rating, setRating] = useState(5);\n  const [reviewTxt, setReviewTxt] = useState(\"\");\n  const [source, setSource] = useState<\'Facebook\' | \'Messenger\' | \'Client\'>(\'Client\');\n  const [submitted, setSubmitted] = useState(false);\n\n  const handleReviewSubmission = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!authorName.trim() || !reviewTxt.trim()) return;\n\n    const newReview: Review = {\n      id: `review-custom-${Date.now()}`,\n      author: authorName,\n      rating: rating,\n      text: reviewTxt,\n      date: \"Aujourd\'hui\",\n      source: source,\n      avatar: \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80\" // high quality generic avatar\n    };\n\n    setReviewsList([newReview, ...reviewsList]);\n    setSubmitted(true);\n    setAuthorName(\"\");\n    setReviewTxt(\"\");\n    setRating(5);\n\n    if (onAddReviewNotification) {\n      onAddReviewNotification(\"Merci ! Votre avis a \303\251t\303\251 ajout\303\251 sur cette session.\");\n    }\n\n    setTimeout(() => {\n      setSubmitted(false);\n    }, 4000);\n  };\n\n  return (\n    <div className=\"space-y-12\">\n      {/* Visual stats blocks */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"bg-brand-depth border border-brand-pink/10 rounded-2xl p-6 text-center\">\n          <span className=\"block text-4xl md:text-5xl font-serif font-bold text-brand-pink\">4.9/5</span>\n          <div className=\"flex justify-center my-2 text-amber-300\">\n            {[...Array(5)].map((_, i) => <Star key={i} className=\"w-5 h-5 fill-amber-300\" />)}\n          </div>\n          <p className=\"text-xs text-brand-text-muted mt-2 font-mono uppercase tracking-wider\">Note globale sur nos r\303\251seaux</p>\n        </div>\n\n        <div className=\"bg-brand-depth border border-brand-pink/10 rounded-2xl p-6 text-center\">\n          <span className=\"block text-4xl md:text-5xl font-serif font-bold text-brand-pink\">100%</span>\n          <div className=\"flex justify-center my-2 text-brand-pink\">\n            <Award className=\"w-6 h-6\" />\n          </div>\n          <p className=\"text-xs text-brand-text-muted mt-2 font-mono uppercase tracking-wider\">Cire v\303\251g\303\251tale saine & locale</p>\n        </div>\n\n        <div className=\"bg-brand-depth border border-brand-pink/10 rounded-2xl p-6 text-center\">\n          <span className=\"block text-4xl md:text-5xl font-serif font-bold text-brand-pink\">12+</span>\n          <div className=\"flex justify-center my-2 text-brand-purple\">\n            <Sparkles className=\"w-6 h-6\" />\n          </div>\n          <p className=\"text-xs text-brand-text-muted mt-2 font-mono uppercase tracking-wider\">Semaines de diffusion moyenne</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Reviews List Column */}\n        <div className=\"lg:col-span-2 space-y-6\">\n          <h3 className=\"text-2xl font-serif font-semibold text-brand-cream border-b border-brand-pink/10 pb-4\">\n            Ce que disent nos clients gourmands :\n          </h3>\n\n          <div className=\"space-y-4\">\n            {reviewsList.map((rev) => (\n              <div \n                key={rev.id}\n                className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-2xl p-6 relative overflow-hidden group hover:border-brand-pink/25 transition-all\"\n              >\n                {/* Source stamp */}\n                <div className=\"absolute top-4 right-4 text-xs font-mono font-bold text-brand-pink uppercase bg-brand-bg px-2.5 py-1 rounded-full border border-brand-pink/5\">\n                  \360\237\223\261 {rev.source}\n                </div>\n\n                <div className=\"flex items-center gap-3 mb-3\">\n                  {rev.avatar ? (\n                    <img \n                      src={rev.avatar} \n                      alt={rev.author} \n                      className=\"w-10 h-10 rounded-full object-cover border border-brand-pink/20\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  ) : (\n                    <div className=\"w-10 h-10 rounded-full bg-brand-pink/10 text-brand-pink flex items-center justify-center font-bold font-mono\">\n                      {rev.author[0]}\n                    </div>\n                  )}\n\n                  <div>\n                    <h4 className=\"font-medium text-brand-cream text-sm\">{rev.author}</h4>\n                    <span className=\"text-[10px] text-brand-text-muted\">{rev.date}</span>\n                  </div>\n                </div>\n\n                {/* Stars ratings */}\n                <div className=\"flex text-amber-300 gap-0.5 mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star \n                      key={i} \n                      className={`w-4 h-4 ${i < rev.rating ? \'fill-amber-300 ml-0.5\' : \'text-gray-600\'}`} \n                    />\n                  ))}\n                </div>\n\n                <p className=\"text-sm text-brand-text-muted leading-relaxed italic\">\n                  \"{rev.text}\"\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Submit review Column */}\n        <div className=\"bg-brand-depth border border-brand-pink/15 rounded-3xl p-6 md:p-8 h-fit space-y-6\">\n          <div className=\"text-center\">\n            <MessageSquare className=\"w-8 h-8 text-brand-pink mx-auto mb-2\" />\n            <h3 className=\"text-xl font-serif font-bold text-brand-cream\">Partager votre \303\251motion</h3>\n            <p className=\"text-xs text-brand-text-muted mt-1\">Vous avez re\303\247u une cr\303\251ation de M\303\251lanie & Christelle ? Donnez votre avis !</p>\n          </div>\n\n          <form onSubmit={handleReviewSubmission} className=\"space-y-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Votre Pr\303\251nom / Nom</label>\n              <input \n                type=\"text\" \n                required\n                placeholder=\"Ex : Claire M.\"\n                value={authorName}\n                onChange={(e) => setAuthorName(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1\">Source de partage</label>\n              <select\n                value={source}\n                onChange={(e) => setSource(e.target.value as any)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                <option value=\"Client\">Site internet</option>\n                <option value=\"Facebook\">R\303\251seaux sociaux (Facebook)</option>\n                <option value=\"Messenger\">Messagerie (Messenger)</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-2\">Votre note :</label>\n              <div className=\"flex items-center gap-2\">\n                {[1, 2, 3, 4, 5].map((num) => (\n                  <button\n                    key={num}\n                    type=\"button\"\n                    onClick={() => setRating(num)}\n                    className=\"p-1 focus:outline-none cursor-pointer\"\n                  >\n                    <Star className={`w-6 h-6 transition-all ${num <= rating ? \'fill-amber-300 text-amber-300 scale-110\' : \'text-gray-600 hover:text-brand-pink\'}`} />\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-wider mb-1 font-bold\">Votre t\303\251moignage</label>\n              <textarea \n                required\n                placeholder=\"Ex : Le parfum \303\240 la P\303\252che est \303\240 tomber par terre, les petits coeurs sous forme de fondants durent super longtemps...\"\n                value={reviewTxt}\n                onChange={(e) => setReviewTxt(e.target.value)}\n                className=\"w-full p-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors min-h-[100px]\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-1 shadow-md cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              Publier l\'avis\n            </button>\n          </form>\n\n          {submitted && (\n            <div className=\"p-3 rounded-xl bg-brand-pink/10 border border-brand-pink/30 text-center text-xs text-brand-pink flex items-center justify-center gap-1.5 animate-pulse\">\n              <Check className=\"w-4 h-4\" />\n              Merci pour votre douceur ! Avis partag\303\251.\n            </div>\n          )}\n\n          <div className=\"p-4 bg-brand-bg/60 border border-brand-pink/5 rounded-2xl text-center\">\n            <p className=\"text-xs text-brand-text-muted\">\n              Une fois notre fiche Google Business cr\303\251\303\251e localement, vous pourrez y ajouter vos photos directement ! Retrouvez-nous d\'ici peu.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
