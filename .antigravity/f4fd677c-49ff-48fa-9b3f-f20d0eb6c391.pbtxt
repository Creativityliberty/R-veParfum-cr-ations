    replacement_chunks {
      target_content: "/* Animations and custom scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: var(--color-brand-bg);\n}\n::-webkit-scrollbar-thumb {\n  background: var(--color-brand-depth);\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-brand-pink);\n}"
      replacement_content: "/* Animations and custom scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: var(--color-brand-bg);\n}\n::-webkit-scrollbar-thumb {\n  background: var(--color-brand-depth);\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-brand-pink);\n}\n\n@layer utilities {\n  .liquid-glass {\n    background: rgba(255, 255, 255, 0.035);\n    background-blend-mode: luminosity;\n    backdrop-filter: blur(14px) saturate(145%);\n    -webkit-backdrop-filter: blur(14px) saturate(145%);\n    border: none;\n    box-shadow:\n      inset 0 1px 1px rgba(255, 255, 255, 0.12),\n      0 18px 60px rgba(0, 0, 0, 0.22);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .liquid-glass::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    padding: 1.2px;\n    background: linear-gradient(\n      180deg,\n      rgba(255,255,255,0.44) 0%,\n      rgba(255,255,255,0.16) 22%,\n      rgba(255,255,255,0.02) 48%,\n      rgba(255,255,255,0.02) 52%,\n      rgba(255,255,255,0.15) 80%,\n      rgba(255,255,255,0.34) 100%\n    );\n    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n    mask-composite: exclude;\n    pointer-events: none;\n  }\n\n  .liquid-glass-strong {\n    background: rgba(255, 241, 220, 0.07);\n    background-blend-mode: luminosity;\n    backdrop-filter: blur(42px) saturate(170%);\n    -webkit-backdrop-filter: blur(42px) saturate(170%);\n    border: none;\n    box-shadow:\n      inset 0 1px 1px rgba(255, 255, 255, 0.18),\n      inset 0 -18px 42px rgba(255, 191, 150, 0.045),\n      0 24px 80px rgba(0, 0, 0, 0.32);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .liquid-glass-strong::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    padding: 1.4px;\n    background: linear-gradient(\n      180deg,\n      rgba(255,255,255,0.54) 0%,\n      rgba(255,255,255,0.2) 22%,\n      rgba(255,255,255,0.03) 48%,\n      rgba(255,255,255,0.03) 52%,\n      rgba(255,255,255,0.2) 80%,\n      rgba(255,255,255,0.48) 100%\n    );\n    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n    mask-composite: exclude;\n    pointer-events: none;\n  }\n\n  .perfume-noise {\n    background-image:\n      radial-gradient(circle at 20% 10%, rgba(255, 205, 180, 0.08), transparent 30%),\n      radial-gradient(circle at 80% 20%, rgba(217, 164, 180, 0.08), transparent 34%),\n      radial-gradient(circle at 50% 90%, rgba(255, 241, 220, 0.05), transparent 38%);\n  }\n}"
    }
