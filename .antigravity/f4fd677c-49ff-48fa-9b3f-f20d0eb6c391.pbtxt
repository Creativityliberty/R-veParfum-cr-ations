          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (occasionFilter === \'Mariage\') matchesOccasion = p.customizable && (p.category === \'Bougies en pot\' || p.category === \'Cadres parfum\303\251s\' || p.category === \'Fondants\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
