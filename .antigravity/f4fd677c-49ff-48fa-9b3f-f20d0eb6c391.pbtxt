          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <strong className=\"text-brand-cream\">Dialogue d\'Atelier :</strong>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
