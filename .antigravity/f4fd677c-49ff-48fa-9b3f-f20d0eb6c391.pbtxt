      replacement_content: "          {/* ==================== 1. ACCUEIL TAB ==================== */}\n          {currentTab === \'accueil\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-24 relative\"\n            >\n              {/* Floating slow ambient light particles / floral petals backdrop */}\n              <div className=\"absolute inset-x-0 top-0 h-[45rem] overflow-hidden pointer-events-none z-0\">\n                {[...Array(8)].map((_, i) => (\n                  <motion.div\n                    key={i}\n                    className=\"absolute bg-brand-pink/15 rounded-full filter blur-[1px]\"\n                    style={{\n                      width: `${Math.random() * 6 + 4}px`,\n                      height: `${Math.random() * 6 + 4}px`,\n                      left: `${10 + Math.random() * 80}%`,\n                    }}\n                    initial={{ y: -20, opacity: 0 }}\n                    animate={{\n                      y: 800,\n                      opacity: [0, 0.4, 0.4, 0],\n                      x: [0, Math.sin(i) * 40, -Math.sin(i) * 30],\n                    }}\n                    transition={{\n                      duration: Math.random() * 14 + 10,\n                      repeat: Infinity,\n                      delay: Math.random() * 12,\n                      ease: \"linear\",\n                    }}\n                  />\n                ))}\n              </div>\n              \n              {/* Immersive Hero Section */}\n              <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-6 md:py-12 relative z-10\" id=\"section-hero\">"
