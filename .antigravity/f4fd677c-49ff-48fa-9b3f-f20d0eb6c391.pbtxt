      target_content: "                </div>\n              </section>\n\n              {/* ================= SECTION POURQUOI CHOISIR ================= */}\n              <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">"
      replacement_content: "                </div>\n              </section>\n\n              {/* ================= ATELIER MOOD WHEEL EXPLORER ================= */}\n              <section className=\"bg-brand-depth/45 border border-brand-pink/10 rounded-[2.5rem] p-6 md:p-10 relative overflow-hidden space-y-8\" id=\"mood-wheel\">\n                <div className=\"absolute top-0 right-0 w-72 h-72 bg-brand-pink/5 rounded-full filter blur-[75px] pointer-events-none\" />\n                <div className=\"absolute -bottom-20 -left-20 w-72 h-72 bg-brand-purple/5 rounded-full filter blur-[75px] pointer-events-none\" />\n\n                <div className=\"text-center max-w-xl mx-auto space-y-3\">\n                  <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Roue Olfactive &amp; Humeur</span>\n                  <h2 className=\"text-3xl font-serif font-bold text-brand-cream\">L\'Atelier des Sensations</h2>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    S\303\251lectionnez l\'atmosph\303\250re \303\251motionnelle que vous d\303\251sirez insuffler chez vous. Nous filtrons instantan\303\251ment les fragrances et essences correspondantes n\303\251es \303\240 l\'atelier.\n                  </p>\n                </div>\n\n                {/* Mood Buttons Grid */}\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto relative z-10\">\n                  {[\n                    { id: \'douceur\', label: \'Douceur Cosy\', desc: \'Sensation cocon, calme\', color: \'from-pink-500/10 to-brand-pink/5\', scents: [\'Fleur de Coton\', \'Poudre de Riz\', \'Fleur de Cerisier\'], icon: <Heart className=\"w-4 h-4 text-brand-pink\" /> },\n                    { id: \'fraicheur\', label: \'Fra\303\256cheur Absolue\', desc: \'Clart\303\251, air sain & vivifiant\', color: \'from-emerald-500/10 to-teal-500/5\', scents: [\'Eucalyptus & Menthe\', \'Lavande de Provence\'], icon: <Leaf className=\"w-4 h-4 text-emerald-400\" /> },\n                    { id: \'enfance\', label: \'Gourmandise d\\\'Enfance\', desc: \'Sucr\303\251, tendresse r\303\251confortante\', color: \'from-amber-500/10 to-orange-500/5\', scents: [\'Caramel beurre sal\303\251\', \'Vanille des \303\256les\'], icon: <Droplet className=\"w-4 h-4 text-amber-400\" /> },\n                    { id: \'mystere\', label: \'Sillage d\\\'Ailleurs\', desc: \'Chaud, sienne, ambre mystique\', color: \'from-purple-500/10 to-violet-500/5\', scents: [\'Ambre Imp\303\251rial\', \'Mono\303\257 Absolu\'], icon: <Sparkles className=\"w-4 h-4 text-brand-purple\" /> }\n                  ].map((mood) => {\n                    const isActive = activeMood === mood.id;\n                    return (\n                      <button\n                        key={mood.id}\n                        onClick={() => setActiveMood(mood.id)}\n                        className={`p-4 md:p-5 rounded-2xl border text-left transition-all relative overflow-hidden group cursor-pointer ${\n                          isActive \n                            ? \'bg-brand-bg border-brand-pink/50 shadow-lg translate-y-[-2px]\' \n                            : \'bg-brand-bg/40 border-brand-pink/5 hover:border-brand-pink/20 hover:bg-brand-bg/60\'\n                        }`}\n                      >\n                        <div className={`absolute inset-0 bg-gradient-to-br ${mood.color} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />\n                        <div className=\"relative space-y-3 z-10\">\n                          <div className={`w-8 h-8 rounded-xl flex items-center justify-center ${isActive ? \'bg-brand-pink/20\' : \'bg-brand-depth\'} border border-brand-pink/10`}>\n                            {mood.icon}\n                          </div>\n                          <div>\n                            <h4 className=\"font-serif font-semibold text-brand-cream text-sm leading-tight\">{mood.label}</h4>\n                            <p className=\"text-[10px] text-brand-text-muted mt-1 leading-normal font-light\">{mood.desc}</p>\n                          </div>\n                        </div>\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Scents Recommendations for Active Mood */}\n                <div className=\"bg-brand-bg/50 border border-brand-pink/10 rounded-2xl p-6 max-w-4xl mx-auto relative z-10\">\n                  <div className=\"flex flex-col md:flex-row gap-6 items-center\">\n                    <div className=\"md:w-1/3 text-left space-y-2\">\n                      <span className=\"text-[10px] font-mono text-brand-pink uppercase tracking-widest font-semibold block\">Senteurs Associ\303\251es</span>\n                      <h4 className=\"font-serif text-lg font-bold text-brand-cream leading-tight\">\n                        {activeMood === \'douceur\' && \"Les poudr\303\251s et doudous\"}\n                        {activeMood === \'fraicheur\' && \"Fra\303\256cheurs d\'Eucalyptus & Lavande\"}\n                        {activeMood === \'enfance\' && \"Les douceurs de Caramel & de Vanille\"}\n                        {activeMood === \'mystere\' && \"Les Ambr\303\251s et \303\211pices d\'Orient\"}\n                      </h4>\n                      <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                        D\303\251couvrez comment ces essences cr\303\251atrices saturent sainement notre cire de soja bio pour un sillage irr\303\251prochable.\n                      </p>\n                    </div>\n\n                    <div className=\"md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-4 w-full\">\n                      {PRODUCTS.filter(p => {\n                        const moodScents: Record<string, string[]> = {\n                          douceur: [\'Fleur de Coton\', \'Poudre de Riz\', \'Fleur de Cerisier\'],\n                          fraicheur: [\'Eucalyptus & Menthe\', \'Lavande de Provence\'],\n                          enfance: [\'Caramel beurre sal\303\251\', \'Vanille des \303\256les\'],\n                          mystere: [\'Ambre Imp\303\251rial\', \'Mono\303\257 Absolu\']\n                        };\n                        const targetScents = moodScents[activeMood] || [];\n                        return p.scents.some(s => targetScents.includes(s));\n                      }).slice(0, 2).map((p) => (\n                        <div key={p.id} className=\"p-4 rounded-xl bg-brand-depth border border-brand-pink/10 flex items-center gap-4 text-left hover:border-brand-pink/20 transition-all\">\n                          <img src={p.image} alt={p.name} className=\"w-12 h-12 object-cover rounded-lg border border-brand-pink/10 shrink-0\" />\n                          <div className=\"flex-1 min-w-0\">\n                            <h5 className=\"font-serif text-xs font-bold text-brand-cream truncate\">{p.name}</h5>\n                            <span className=\"text-[10px] text-brand-pink font-mono block mt-0.5\">{p.priceText || `${p.price} \342\202\254`}</span>\n                            <button\n                              onClick={() => setSelectedProduct(p)}\n                              className=\"text-[10px] text-brand-text-muted hover:text-brand-pink transition-colors font-medium mt-1 inline-flex items-center gap-0.5\"\n                            >\n                              Savoir plus <ArrowRight className=\"w-2.5 h-2.5\" />\n                            </button>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n\n              </section>\n\n              {/* ================= SECTION POURQUOI CHOISIR ================= */}\n              <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">"
