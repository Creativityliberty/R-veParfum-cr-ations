  file_change {
    absolute_path_uri: "file:///src/components/CustomizationPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Sparkles, Palette, Droplet, Layers, Package open, Heart, Calendar, MessageSquare, PhoneCall, Check } from \'lucide-react\';\n\ninterface CustomizationPageProps {\n  onSuccess: (msg: string) => void;\n}\n\nexport default function CustomizationPage({ onSuccess }: CustomizationPageProps) {\n  const [formData, setFormData] = useState({\n    name: \'\',\n    phone: \'\',\n    productType: \'Bouquet Parfum\303\251\',\n    scent: \'Fleur de Coton\',\n    colors: \'\',\n    occasion: \'Mariage/Bapt\303\252me\',\n    date: \'\',\n    details: \'\'\n  });\n\n  const productTypes = [\n    \"Bouquet Parfum\303\251\",\n    \"Fondants parfum\303\251s\",\n    \"Bougie en pot / C\303\251ramique\",\n    \"Cadre parfum\303\251 suspendu\",\n    \"Brume d\'ambiance\",\n    \"Suspension r\303\251troviseur voiture\",\n    \"Coffret personnalis\303\251 de saison\"\n  ];\n\n  const scents = [\n    \"Fleur de Coton\",\n    \"Fleur de Cerisier\",\n    \"Lavande de Provence\",\n    \"Vanille des \303\256les\",\n    \"Caramel beurre sal\303\251\",\n    \"Poudre de Riz\",\n    \"P\303\252che Velout\303\251e\",\n    \"Fruits Rouges Sauvages\",\n    \"Eucalyptus & Menthe\",\n    \"Mono\303\257 Absolu\",\n    \"Ambre Imp\303\251rial\"\n  ];\n\n  const customizableCards = [\n    {\n      title: \"La Senteur\",\n      desc: \"S\303\251lectionnez votre fragrance favorite de Grasse ou cr\303\251ez un accord sur-mesure pour votre int\303\251rieur ou \303\251v\303\251nement.\",\n      icon: <Droplet className=\"w-6 h-6 text-brand-pink\" />\n    },\n    {\n      title: \"Les Couleurs\",\n      desc: \"Teintes pastels douces, fleurs s\303\251ch\303\251es incrust\303\251es, ou pigments min\303\251raux naturels assortis \303\240 votre d\303\251coration.\",\n      icon: <Palette className=\"w-6 h-6 text-brand-pink\" />\n    },\n    {\n      title: \"Le Format\",\n      desc: \"Miniatures d\'invit\303\251s, cierges, pots d\'apothicaire ambr\303\251s ou grands formats en Gr\303\250s C\303\251ramique r\303\251utilisables.\",\n      icon: <Layers className=\"w-6 h-6 text-brand-pink\" />\n    },\n    {\n      title: \"La Quantit\303\251\",\n      desc: \"De la pi\303\250ce unique po\303\251tique pour offrir jusqu\'au lot harmonieux de 100+ pi\303\250ces pour vos \303\251v\303\251nements c\303\251l\303\251br\303\251s.\",\n      icon: <Check className=\"w-6 h-6 text-brand-pink\" />\n    },\n    {\n      title: \"Le Th\303\250me\",\n      desc: \"Inspirations champ\303\252tres, boh\303\250mes, florales d\'hiver ou de printemps avec rubans de lin et cachets de cire.\",\n      icon: <Sparkles className=\"w-6 h-6 text-brand-pink\" />\n    },\n    {\n      title: \"Message & \303\211tiquette\",\n      desc: \"Date, pr\303\251noms ou remerciements imprim\303\251s sur papier d\'art \303\240 texture naturelle ou \303\251tiquettes kraft personnalis\303\251es.\",\n      icon: <MessageSquare className=\"w-6 h-6 text-brand-pink\" />\n    }\n  ];\n\n  const steps = [\n    {\n      num: \"01\",\n      title: \"Choix du Produit\",\n      desc: \"Vous choisissez le mod\303\250le de cr\303\251ation qui servira de base (bougie, fondants, bouquet, etc.).\"\n    },\n    {\n      num: \"02\",\n      title: \"Expression des Envies\",\n      desc: \"Vous nous indiquez vos pr\303\251f\303\251rences color\303\251es, olfactives et de design via notre espace.\"\n    },\n    {\n      num: \"03\",\n      title: \"Validation WhatsApp\",\n      desc: \"Nous ajustons les d\303\251tails esth\303\251tiques, les d\303\251lais et le prix final ensemble sur WhatsApp.\"\n    },\n    {\n      num: \"04\",\n      title: \"Fabrication Artisanale\",\n      desc: \"Votre pi\303\250ce unique et parfum\303\251e est minutieusement coul\303\251e sous un d\303\251lai d\'environ deux semaines.\"\n    }\n  ];\n\n  const examples = [\n    {\n      title: \"Cadeaux d\'Invit\303\251s de Mariage\",\n      desc: \"Mini suspensions rondes orn\303\251es de v\303\251ritables boutons de rose s\303\251ch\303\251s et \303\251tiquettes calligraphi\303\251es aux pr\303\251noms des mari\303\251s.\",\n      emoji: \"\360\237\221\260\342\200\215\342\231\200\357\270\217\"\n    },\n    {\n      title: \"Attention de F\303\252te des M\303\250res\",\n      desc: \"Bougie fleurie dans sa tasse en c\303\251ramique artisanale, parfum\303\251e \303\240 la Fleur de Cerisier printani\303\250re.\",\n      emoji: \"\360\237\214\270\"\n    },\n    {\n      title: \"Anniversaire Chaleureux\",\n      desc: \"Coffret regroupant fondants c\305\223urs gourmands Caramel Beurre Sal\303\251 et br\303\273le-parfum sculpt\303\251.\",\n      emoji: \"\360\237\216\202\"\n    },\n    {\n      title: \"D\303\251coration de Saison\",\n      desc: \"Cadre de cire dure suspendu pour parfumer d\303\251licatement vos armoires et d\303\251corer vos portes \303\240 l\'ambiance cocooning.\",\n      emoji: \"\360\237\217\241\"\n    }\n  ];\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({ ...prev, [name]: value }));\n  };\n\n  const handleWhatsAppSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.name) {\n      onSuccess(\"Veuillez renseigner au moins votre nom pour d\303\251buter la discussion. \360\237\230\212\");\n      return;\n    }\n\n    const message = `Bonjour, je souhaite une cr\303\251ation personnalis\303\251e :\nType de produit : ${formData.productType}\nSenteur : ${formData.scent}\nCouleurs : ${formData.colors || \'Non sp\303\251cifi\303\251\'}\nOccasion : ${formData.occasion}\nDate souhait\303\251e : ${formData.date || \'D\303\250s que possible\'}\nD\303\251tails : ${formData.details || \'Aucun d\303\251tail suppl\303\251mentaire\'}\nNom demand\303\251 : ${formData.name}\nT\303\251l\303\251phone : ${formData.phone || \'Non sp\303\251cifi\303\251\'}\n\nMerci \360\237\230\212`;\n\n    const encodedText = encodeURIComponent(message);\n    const whatsappUrl = `https://wa.me/33600000000?text=${encodedText}`;\n    \n    onSuccess(\"Ouverture de WhatsApp pour finaliser votre cr\303\251ation sur-mesure... \342\234\250\");\n    window.open(whatsappUrl, \'_blank\', \'noopener,noreferrer\');\n  };\n\n  return (\n    <div className=\"space-y-20 pb-12\" id=\"customization-view-root\">\n      \n      {/* 1. Hero Personnalisation */}\n      <section className=\"text-center max-w-3xl mx-auto space-y-4\">\n        <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">L\'Atelier de Vos R\303\252ves</span>\n        <h1 className=\"text-4xl md:text-5xl font-serif font-bold text-brand-cream leading-tight\">\n          Cr\303\251ez une composition parfum\303\251e \303\240 votre image\n        </h1>\n        <p className=\"text-sm md:text-base text-brand-text-muted leading-relaxed max-w-2xl mx-auto\">\n          Choisissez les couleurs, les senteurs, le format et les plus beaux d\303\251tails floraux pour donner naissance \303\240 une cr\303\251ation unique, coul\303\251e et fignol\303\251e enti\303\250rement \303\240 la main dans notre atelier d\'art.\n        </p>\n        <div className=\"pt-2\">\n          <a\n            href=\"#customization-form\"\n            className=\"inline-flex items-center gap-2 px-6 py-3 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors shadow-lg\"\n          >\n            Faire une demande personnalis\303\251e\n          </a>\n        </div>\n      </section>\n\n      {/* 2. Ce qui est personnalisable */}\n      <section className=\"space-y-10\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Chaque d\303\251tail r\303\251invent\303\251 pour vous\n          </h2>\n          <p className=\"text-xs text-brand-text-muted\">\n            Notre sens de l\'artisanat nous permet d\'adapter l\'enti\303\250ret\303\251 de nos quatre cat\303\251gories phares \303\240 vos nuances d\'\303\251v\303\251nements.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {customizableCards.map((card, i) => (\n            <div \n              key={i} \n              className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl hover:border-brand-pink/30 transition-all duration-300 flex flex-col items-center text-center space-y-3\"\n            >\n              <div className=\"p-3.5 bg-brand-pink/10 rounded-full\">\n                {card.icon}\n              </div>\n              <h3 className=\"font-serif font-bold text-lg text-brand-cream\">{card.title}</h3>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">{card.desc}</p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 3. Processus en 4 \303\251tapes */}\n      <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">\n        <div className=\"max-w-5xl mx-auto space-y-12\">\n          <div className=\"text-center space-y-2\">\n            <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Un Accompagnement Pas-\303\240-Pas</span>\n            <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">Comment fonctionne la personnalisation ?</h2>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative\">\n            {steps.map((step, i) => (\n              <div key={i} className=\"bg-brand-depth border border-brand-pink/5 p-6 rounded-2xl space-y-4 relative group\">\n                <span className=\"absolute top-4 right-4 text-3xl font-serif font-black text-brand-purple/15 group-hover:text-brand-pink/30 transition-colors\">\n                  {step.num}\n                </span>\n                <h3 className=\"font-serif font-bold text-base text-brand-cream pt-2\">{step.title}</h3>\n                <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">{step.desc}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 4. Exemples d\'usages */}\n      <section className=\"space-y-10\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Inspirations pour vos instants de vie\n          </h2>\n          <p className=\"text-xs text-brand-text-muted\">\n            Laissez-vous charmer par les demandes les plus souvent formul\303\251es par notre aimable client\303\250le.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto\">\n          {examples.map((ex, i) => (\n            <div \n              key={i} \n              className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl flex gap-4 items-start hover:border-brand-purple/20 transition-all text-left\"\n            >\n              <div className=\"text-3xl p-3 bg-brand-bg/50 rounded-xl leading-none\">\n                {ex.emoji}\n              </div>\n              <div className=\"space-y-1.5 flex-1\">\n                <h3 className=\"font-serif font-bold text-base text-brand-cream\">{ex.title}</h3>\n                <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">{ex.desc}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 5. Formulaire de personnalisation simple */}\n      <section className=\"scroll-mt-28 max-w-2xl mx-auto bg-brand-depth border border-brand-pink/15 rounded-3xl p-8\" id=\"customization-form\">\n        <div className=\"text-center space-y-2 mb-8 border-b border-brand-pink/10 pb-6\">\n          <Palette className=\"w-8 h-8 text-brand-pink mx-auto\" />\n          <h2 className=\"text-2xl font-serif font-bold text-brand-cream\">Composer mon projet de cire</h2>\n          <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n            Remplissez vos envies initiales de parfum et couleurs, puis cliquez pour faire valider le projet imm\303\251diatement par Christelle et M\303\251lanie via WhatsApp.\n          </p>\n        </div>\n\n        <form onSubmit={handleWhatsAppSubmit} className=\"space-y-6 text-left\">\n          \n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Votre Nom *</label>\n              <input \n                type=\"text\" \n                name=\"name\"\n                required\n                placeholder=\"Ex : Isabelle Martin\"\n                value={formData.name}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">T\303\251l\303\251phone (Optionnel)</label>\n              <input \n                type=\"tel\" \n                name=\"phone\"\n                placeholder=\"Ex : 06 12 34 56 78\"\n                value={formData.phone}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Cat\303\251gorie de base</label>\n              <select\n                name=\"productType\"\n                value={formData.productType}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                {productTypes.map((t, idx) => (\n                  <option key={idx} value={t}>{t}</option>\n                ))}\n              </select>\n            </div>\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Senteur pr\303\251f\303\251r\303\251e souhait\303\251e</label>\n              <select\n                name=\"scent\"\n                value={formData.scent}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                {scents.map((s, idx) => (\n                  <option key={idx} value={s}>{s}</option>\n                ))}\n              </select>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Nuancier ou Couleurs d\303\251sir\303\251es</label>\n              <input \n                type=\"text\" \n                name=\"colors\"\n                placeholder=\"Ex : Blanc poudr\303\251, Vert d\'eau, Rose drag\303\251e...\"\n                value={formData.colors}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Occasion c\303\251l\303\251br\303\251e</label>\n              <select\n                name=\"occasion\"\n                value={formData.occasion}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                <option value=\"Mariage/Bapt\303\252me\">\360\237\221\260\342\200\215\342\231\200\357\270\217 Mariage, Bapt\303\252me ou Communion</option>\n                <option value=\"Anniversaire\">\360\237\216\202 Anniversaire / F\303\252te de famille</option>\n                <option value=\"Cadeau d\'Entreprise\">\360\237\222\274 Comit\303\251 d\'entreprise ou pro</option>\n                <option value=\"D\303\251coration Maison\">\360\237\217\241 Pour le plaisir de chez moi</option>\n                <option value=\"Autre\">\342\234\250 Autre envie po\303\251tique</option>\n              </select>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Date limite souhait\303\251e de livraison/retrait</label>\n            <input \n              type=\"date\" \n              name=\"date\"\n              value={formData.date}\n              onChange={handleInputChange}\n              className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">D\303\251taillez vos souhaits (fleurs fra\303\256ches, \303\251tiquettes...)</label>\n            <textarea\n              name=\"details\"\n              rows={4}\n              placeholder=\"Ex : Je souhaite rajouter un d\303\251licat ruban en toile de lin et \303\251crire \'Bapt\303\252me de Chlo\303\251 - 18.06.2026\'...\"\n              value={formData.details}\n              onChange={handleInputChange}\n              className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream placeholder-gray-600 focus:outline-none focus:border-brand-pink transition-colors resize-none\"\n            />\n          </div>\n\n          <button \n            type=\"submit\"\n            className=\"w-full py-4.5 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg\"\n          >\n            <PhoneCall className=\"w-4 h-4\" />\n            Envoyer ma demande sur WhatsApp\n          </button>\n\n        </form>\n      </section>\n\n    </div>\n  );\n}\n"
    }
