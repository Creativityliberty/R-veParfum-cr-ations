    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { ChevronLeft, ChevronRight, Sparkles, Heart, Camera, Info, Home, Gift } from \'lucide-react\';\n\ninterface LifestyleSlide {\n  id: number;\n  title: string;\n  category: string;\n  description: string;\n  image: string;\n  context: string;\n  quote: string;\n  accentNote?: string;\n}\n\nconst LIFESTYLE_SLIDES: LifestyleSlide[] = [\n  {\n    id: 1,\n    title: \"Cadeaux d\'Invit\303\251s & \303\211v\303\251nements d\'Amour\",\n    category: \"Mariages & C\303\251l\303\251brations\",\n    description: \"De d\303\251licates mini bougies en pots c\303\251ramiques, fleuries et grav\303\251es au pr\303\251nom de vos convives pour laisser un sillage imp\303\251rissable de votre plus belle journ\303\251e.\",\n    image: \"https://images.unsplash.com/photo-1519225495810-7512c696505a?auto=format&fit=crop&w=1200&q=80\",\n    context: \"Mis en situation : Une r\303\251ception boh\303\250me en plein air, sous les tonnelles en lin.\",\n    quote: \"\\\"Chaque convive est reparti \303\251mu, emportant avec lui l\'odeur divine de notre union.\\\" \342\200\224 Camille (Mari\303\251e 2025)\",\n    accentNote: \"Inspiration : Lin brut & Fleur de Cerisier\"\n  },\n  {\n    id: 2,\n    title: \"Le Cocon de Lecture\",\n    category: \"Int\303\251rieurs Chaleureux\",\n    description: \"Harmonisez vos moments de pause. Un sillage l\303\251ger de Fleur de Coton ou de Poudre de Riz pour envelopper votre biblioth\303\250que ou votre pi\303\250ce de vie favorite d\'une douceur infinie.\",\n    image: \"https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1200&q=80\",\n    context: \"Mis en situation : Un apr\303\250s-midi pluvieux de Bourgogne, \303\251clair\303\251 par la lueur ambr\303\251e d\'un pot d\'apothicaire.\",\n    quote: \"\\\"La bougie cr\303\251pite doucement \303\240 c\303\264t\303\251 d\'un th\303\251 fumant. Ma maison est un havre d\'apaisement.\\\" \342\200\224 M\303\251lissa\",\n    accentNote: \"Inspiration : Cosy & Fleur de Coton\"\n  },\n  {\n    id: 3,\n    title: \"La Table Raffin\303\251e en F\303\252te\",\n    category: \"Inspiration de Table\",\n    description: \"Ajoutez une touche d\'or et de cire dure florale. Nos cadres parfum\303\251s suspendus ou pos\303\251s ornent les serviettes de vos invit\303\251s, servant \303\240 la fois de marque-place po\303\251tique et de sachet souvenir parfumant.\",\n    image: \"https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=1200&q=80\",\n    context: \"Mis en situation : Une table de f\303\252te de F\303\252tes de fin d\'ann\303\251e, entre cire de soja parfum\303\251e, branches de pin et verres cristallins.\",\n    quote: \"\\\"Le parfum de cassis et cannelle s\'est m\303\252l\303\251 au rire de nos repas de famille.\\\" \342\200\224 Christelle & M\303\251lanie\",\n    accentNote: \"Inspiration : Cannelle & Cire d\'Orf\303\250vre\"\n  },\n  {\n    id: 4,\n    title: \"L\'Heure du Soin Rituel\",\n    category: \"Fra\303\256cheur & Bain d\'\303\211nergie\",\n    description: \"Un bouquet aux tiges de rotin diffusant en continu de l\'Eucalyptus et de la Menthe sauvage. Une respiration pure et d\303\251toxifiante pour recharger vos \303\251nergies d\303\250s le matin.\",\n    image: \"https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=1200&q=80\",\n    context: \"Mis en situation : Une salle d\'eau \303\251pur\303\251e \303\240 l\'ambiance spa scandinave.\",\n    quote: \"\\\"Un geste simple de diffusion naturelle qui transforme chaque douche en rituel de thalasso.\\\" \342\200\224 Pierre-Antoine\",\n    accentNote: \"Inspiration : Eucalyptus & Lin Blanc\"\n  },\n  {\n    id: 5,\n    title: \"L\'\303\202me de l\'Atelier\",\n    category: \"Coul\303\251es d\'\303\211motion\",\n    description: \"D\303\251couvrez notre quotidien artisanal. Christelle et M\303\251lanie s\303\251lectionnent les brass\303\251es de lavandes r\303\251gionales et coulent la cire velout\303\251e \303\240 temp\303\251rature parfaite pour garantir un br\303\273lage homog\303\250ne.\",\n    image: \"https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=1200&q=80\",\n    context: \"Mis en situation : Les comptoirs fleuris de notre atelier bourguignon baign\303\251 du soleil matinal.\",\n    quote: \"\\\"Rien ne remplace la main humaine pour lier le parfum \303\240 sa mati\303\250re.\\\" \342\200\224 Christelle\",\n    accentNote: \"Inspiration : Cueillette locale & Cire pure\"\n  }\n];\n\nexport default function LifestyleCarousel() {\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [direction, setDirection] = useState(0); // -1 for left, 1 for right\n\n  const handleNext = () => {\n    setDirection(1);\n    setCurrentIndex((prev) => (prev + 1) % LIFESTYLE_SLIDES.length);\n  };\n\n  const handlePrev = () => {\n    setDirection(-1);\n    setCurrentIndex((prev) => (prev - 1 + LIFESTYLE_SLIDES.length) % LIFESTYLE_SLIDES.length);\n  };\n\n  const activeSlide = LIFESTYLE_SLIDES[currentIndex];\n\n  const slideVariants = {\n    enter: (dir: number) => ({\n      x: dir > 0 ? 300 : -300,\n      opacity: 0\n    }),\n    center: {\n      x: 0,\n      opacity: 1,\n      transition: { duration: 0.4, ease: \"easeOut\" }\n    },\n    exit: (dir: number) => ({\n      x: dir < 0 ? 300 : -300,\n      opacity: 0,\n      transition: { duration: 0.3, ease: \"easeIn\" }\n    })\n  };\n\n  return (\n    <div className=\"space-y-6\" id=\"lifestyle-carousel-wrapper\">\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 max-w-5xl mx-auto\">\n        <div className=\"text-left space-y-1.5\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold flex items-center gap-1.5\">\n            <Camera className=\"w-4 h-4 text-brand-pink\" />\n            Galerie d\'Inspirations &amp; Mises en Contexte\n          </span>\n          <h3 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream leading-tight\">\n            Le Parfum prend Vie\n          </h3>\n          <p className=\"text-xs text-brand-text-muted max-w-xl font-light leading-relaxed\">\n            Parcourez nos suggestions d\'ambiances et d\303\251couvrez comment Christelle et M\303\251lanie int\303\250grent leurs cr\303\251ations dans vos pi\303\250ces \303\240 vivre et lors de vos plus beaux rituels familiaux.\n          </p>\n        </div>\n\n        {/* Carousel buttons */}\n        <div className=\"flex items-center gap-2 self-start\">\n          <button \n            onClick={handlePrev}\n            className=\"w-10 h-10 rounded-full bg-brand-bg/90 border border-brand-pink/15 text-brand-text-muted hover:text-brand-cream hover:bg-brand-pink/20 flex items-center justify-center transition-all cursor-pointer shadow\"\n            title=\"Pr\303\251c\303\251dent\"\n          >\n            <ChevronLeft className=\"w-5 h-5\" />\n          </button>\n          \n          <span className=\"font-mono text-xs text-brand-pink/90 px-3 bg-brand-depth/40 py-1.5 rounded-full border border-brand-pink/5\">\n            {currentIndex + 1} / {LIFESTYLE_SLIDES.length}\n          </span>\n\n          <button \n            onClick={handleNext}\n            className=\"w-10 h-10 rounded-full bg-brand-bg/90 border border-brand-pink/15 text-brand-text-muted hover:text-brand-cream hover:bg-brand-pink/20 flex items-center justify-center transition-all cursor-pointer shadow\"\n            title=\"Suivant\"\n          >\n            <ChevronRight className=\"w-5 h-5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Main Showcase Plate with \"Touch of White\" highlights */}\n      <div className=\"max-w-5xl mx-auto relative overflow-hidden bg-brand-depth/85 border border-brand-pink/15 rounded-3xl md:rounded-[2.5rem] shadow-2xl p-4 md:p-6\">\n        \n        {/* Absolute decorative glowing circles */}\n        <div className=\"absolute top-0 right-0 w-80 h-80 bg-brand-pink/5 rounded-full filter blur-[80px] pointer-events-none\" />\n        <div className=\"absolute bottom-0 left-0 w-80 h-80 bg-brand-purple/5 rounded-full filter blur-[80px] pointer-events-none\" />\n\n        <div className=\"relative grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n          \n          {/* Image slide area (Col span 7) */}\n          <div className=\"lg:col-span-7 relative h-64 sm:h-[400px] rounded-2xl md:rounded-3xl overflow-hidden border border-brand-pink/15 bg-brand-bg select-none\">\n            \n            <AnimatePresence mode=\"wait\" custom={direction}>\n              <motion.img\n                key={currentIndex}\n                src={activeSlide.image}\n                alt={activeSlide.title}\n                custom={direction}\n                variants={slideVariants}\n                initial=\"enter\"\n                animate=\"center\"\n                exit=\"exit\"\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </AnimatePresence>\n\n            {/* In-context light floating tag overlay (\'Touch of White\' look) */}\n            <div className=\"absolute bottom-4 left-4 right-4 md:left-6 md:right-6 backdrop-blur-md bg-white/95 text-brand-bg border border-white/40 p-3 rounded-xl flex items-center justify-between shadow-lg\">\n              <span className=\"text-[10px] font-mono text-brand-bg/85 break-words uppercase tracking-wider font-semibold flex items-center gap-1.5 leading-none\">\n                <Info className=\"w-3.5 h-3.5 text-brand-bg/80 shrink-0\" />\n                {activeSlide.context}\n              </span>\n              {activeSlide.accentNote && (\n                <span className=\"hidden sm:inline-block font-mono text-[9px] bg-brand-bg text-brand-pink rounded-full px-2 py-1 font-semibold leading-none\">\n                  {activeSlide.accentNote}\n                </span>\n              )}\n            </div>\n\n            {/* Premium Category Badges */}\n            <div className=\"absolute top-4 left-4 z-10 flex flex-wrap gap-2\">\n              <span className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-mono uppercase tracking-widest bg-brand-pink text-brand-bg font-extrabold shadow-md\">\n                <Sparkles className=\"w-3 h-3 text-brand-bg animate-pulse\" />\n                {activeSlide.category}\n              </span>\n            </div>\n          </div>\n\n          {/* Description & Quotes Panel (Col span 5 with dynamic content) */}\n          <div className=\"lg:col-span-5 text-left flex flex-col justify-between py-2 space-y-6 pl-0 lg:pl-4 relative z-10\">\n            \n            <div className=\"space-y-4\">\n              {/* Premium Crisp White Callout tag - \"Touch of White\" styling indicator */}\n              <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white border border-white text-xs font-mono font-bold text-brand-bg uppercase tracking-wide shadow-sm\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-ping\" />\n                Mise en Situation active\n              </div>\n\n              <h4 className=\"text-xl md:text-2xl font-serif font-black text-brand-cream leading-tight\">\n                {activeSlide.title}\n              </h4>\n\n              <p className=\"text-xs md:text-sm text-brand-text-muted leading-relaxed font-light\">\n                {activeSlide.description}\n              </p>\n            </div>\n\n            {/* User testimonial section */}\n            <div className=\"p-4 bg-brand-bg/70 border border-brand-pink/15 rounded-xl space-y-2 relative shadow-inner\">\n              <span className=\"text-[9px] font-mono text-brand-pink uppercase tracking-widest font-semibold block\">Retour de Cire</span>\n              <p className=\"text-xs text-brand-cream italic font-serif leading-relaxed\">\n                {activeSlide.quote}\n              </p>\n            </div>\n\n            {/* Small Quick-Guide CTA inside slide to customized options on site */}\n            <div className=\"pt-2 border-t border-brand-pink/5 flex items-center justify-between text-xs font-mono\">\n              <span className=\"text-brand-text-muted font-light\">\n                Int\303\251grable \303\240 l\'Atelier\n              </span>\n              <span className=\"text-brand-pink font-semibold flex items-center gap-1\">\n                <Heart className=\"w-3.5 h-3.5 inline text-brand-pink hover:scale-110 transition-transform\" />\n                Personnalisable \303\240 100%\n              </span>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Dots indicators for ease navigations */}\n      <div className=\"flex justify-center gap-1.5 pt-2\">\n        {LIFESTYLE_SLIDES.map((_, i) => (\n          <button\n            key={i}\n            onClick={() => {\n              setDirection(i > currentIndex ? 1 : -1);\n              setCurrentIndex(i);\n            }}\n            className={`h-2 rounded-full transition-all duration-300 ${\n              i === currentIndex ? \'w-6 bg-brand-pink\' : \'w-2 bg-brand-pink/20 hover:bg-brand-pink/50\'\n            }`}\n            title={`Slide ${i + 1}`}\n          />\n        ))}\n      </div>\n    </div>\n  );\n}\n"
    }
