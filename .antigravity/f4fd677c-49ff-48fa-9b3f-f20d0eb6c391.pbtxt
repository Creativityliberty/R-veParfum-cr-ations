          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \"rev-3\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \"Mireille Roussel\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    rating: 5,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    text: \"La bougie c\303\251ramique est un v\303\251ritable coup de c\305\223ur esth\303\251tique et olfactif. Le cr\303\251pitement de la m\303\250che en bois donne une petite ambiance de feu de chemin\303\251e relaxante. Une tr\303\250s belle id\303\251e cadeau.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    date: \"18 Avril 2026\","
