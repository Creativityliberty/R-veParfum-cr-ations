      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { homePageConfig } from \'../config/homePageConfig\';\n\ninterface AnimatedHeadlineProps {\n  lines: string[];\n  highlightWords: string[];\n}\n\nexport default function AnimatedHeadline({ lines, highlightWords }: AnimatedHeadlineProps) {\n  const isReduced = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n  const config = homePageConfig.motion.textReveal;\n\n  // Split lines into words\n  const wordsWithMetas = lines.map((line, lineIdx) => {\n    const words = line.split(\' \');\n    return {\n      lineIdx,\n      words: words.map((word) => {\n        // Strip punctuation to check matching highlight word\n        const cleanWord = word.toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()?\"\']/g, \"\");\n        const isHighlighted = highlightWords.some(h => cleanWord.includes(h.toLowerCase()));\n        return { original: word, isHighlighted };\n      })\n    };\n  });\n\n  const containerVariants = {\n    hidden: {},\n    visible: {\n      transition: {\n        staggerChildren: isReduced ? 0 : config.wordDelay,\n      }\n    }\n  };\n\n  const wordVariants = {\n    hidden: isReduced ? { opacity: 1 } : {\n      opacity: 0,\n      y: config.yFrom,\n      filter: `blur(${config.blurFrom}px)`,\n    },\n    visible: {\n      opacity: 1,\n      y: 0,\n      filter: \"blur(0px)\",\n      transition: {\n        duration: config.duration,\n        ease: config.ease,\n      }\n    }\n  };\n\n  return (\n    <motion.h1\n      variants={containerVariants}\n      initial=\"hidden\"\n      animate=\"visible\"\n      className=\"text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-serif font-black tracking-tight text-white leading-[1.04] text-left\"\n    >\n      {wordsWithMetas.map((lineObj, lIdx) => (\n        <span key={lIdx} className=\"block overflow-hidden pb-1 sm:pb-2\">\n          {lineObj.words.map((wObj, wIdx) => (\n            <motion.span\n              key={wIdx}\n              variants={wordVariants}\n              className={`inline-block mr-[0.25em] ${\n                wObj.isHighlighted\n                  ? \"text-transparent bg-clip-text bg-gradient-to-r from-[#F8EFE4] via-[#EFC6D2] to-[#FFF1DC] italic font-normal\"\n                  : \"text-brand-cream\"\n              }`}\n            >\n              {wObj.original}\n            </motion.span>\n          ))}\n        </span>\n      ))}\n    </motion.h1>\n  );\n}\n"
    }
