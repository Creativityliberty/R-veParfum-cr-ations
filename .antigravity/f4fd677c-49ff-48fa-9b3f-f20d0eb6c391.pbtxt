    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Leaf, Award, Compass, Heart, MessageSquare, ShieldCheck, Sparkles } from \'lucide-react\';\n\nexport default function AboutPage() {\n  const values = [\n    {\n      title: \"Naturel\",\n      desc: \"De la pure cire de soja v\303\251g\303\251tale 100% biod\303\251gradable sans aucun d\303\251riv\303\251 p\303\251trochimique et des m\303\250ches saines sans plomb.\",\n      icon: <Leaf className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Fait Main\",\n      desc: \"Christelle et M\303\251lanie coulent, ornent de fleurs s\303\251ch\303\251es et pr\303\251parent chaque pi\303\250ce individuellement avec attention.\",\n      icon: <Award className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Soin du D\303\251tail\",\n      desc: \"De jolies \303\251tiquettes calligraphi\303\251es \303\240 la commande, d\'\303\251l\303\251gants rubans de lin pur et des emballages soyeux et protecteurs.\",\n      icon: <Sparkles className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Personnalisation\",\n      desc: \"Nous ajustons les teintes, les parfums, et imprimons vos messages pour faire de chaque objet un souvenir olfactif.\",\n      icon: <Compass className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Senteurs Durables\",\n      desc: \"Une haute concentration d\'extraits de parfums de Grasse assure une diffusion constante durant de longues semaines.\",\n      icon: <ShieldCheck className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Cadeau \303\211motionnel\",\n      desc: \"Nos cr\303\251ations ne sont pas de simples produits, elles racontent une histoire d\'amour pour le beau et le naturel.\",\n      icon: <Heart className=\"w-5 h-5 text-brand-pink\" />\n    }\n  ];\n\n  return (\n    <div className=\"space-y-20 pb-12\" id=\"about-page-view\">\n      \n      {/* 1. Hero banner */}\n      <section className=\"text-center max-w-3xl mx-auto space-y-4\">\n        <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">L\'\303\211toile derri\303\250re les Senteurs</span>\n        <h1 className=\"text-4xl md:text-5xl font-serif font-bold text-brand-cream leading-tight\">\n          Derri\303\250re R\303\252ve Parfum\303\251 Cr\303\251ation, deux passionn\303\251es du fait main\n        </h1>\n        <p className=\"text-sm md:text-base text-brand-text-muted leading-relaxed max-w-2xl mx-auto\">\n          M\303\251lanie et Christelle imaginent, con\303\247oivent et fabriquent avec tendresse des cr\303\251ations parfum\303\251es saines pour la maison, pour embellir vos pi\303\250ces ou c\303\251l\303\251brer vos c\303\251r\303\251monies.\n        </p>\n      </section>\n\n      {/* 2. Portrait / Histoire double colonnes */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        \n        {/* Photos d\'atelier et compositions */}\n        <div className=\"lg:col-span-5 relative grid grid-cols-2 gap-4\">\n          <div className=\"space-y-4\">\n            <div className=\"rounded-2xl overflow-hidden border border-brand-pink/10 aspect-[3/4] bg-brand-depth\">\n              <img \n                src=\"https://images.unsplash.com/photo-1556761175-b813f180196d?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Coulage de bougie artisanale\" \n                className=\"w-full h-full object-cover select-none filter sepia/20 hover:scale-105 transition-transform duration-500\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n            <div className=\"rounded-2xl overflow-hidden border border-brand-pink/10 aspect-square bg-brand-depth\">\n              <img \n                src=\"https://images.unsplash.com/photo-1605881428588-4444538eec6c?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Fleurs s\303\251ch\303\251es pour d\303\251coration\" \n                className=\"w-full h-full object-cover select-none filter sepia/10\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n          </div>\n          \n          <div className=\"space-y-4 pt-8\">\n            <div className=\"rounded-2xl overflow-hidden border border-brand-pink/10 aspect-square bg-brand-depth\">\n              <img \n                src=\"https://images.unsplash.com/photo-1540324155974-75220213450f?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Senteur et herboristerie\" \n                className=\"w-full h-full object-cover select-none\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n            <div className=\"rounded-2xl overflow-hidden border border-brand-pink/10 aspect-[3/4] bg-brand-depth\">\n              <img \n                src=\"https://images.unsplash.com/photo-1590736969955-71cc94801759?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Emballage lin et kraft\" \n                className=\"w-full h-full object-cover select-none filter sepia/35\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n          </div>\n\n          <div className=\"absolute -z-10 bg-brand-pink/5 filter blur-2xl rounded-full inset-0 m-6\" />\n        </div>\n\n        {/* Le texte sur M\303\251lanie & Christelle */}\n        <div className=\"lg:col-span-7 text-left space-y-6\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Duo de Cr\303\251atrices</span>\n          <h2 className=\"text-3xl font-serif font-bold text-brand-cream\">\n            L\'origine du R\303\252ve Parfum\303\251\n          </h2>\n\n          <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n            Bienvenue dans le cocon de l\'Atelier. <span className=\"text-brand-pink font-semibold\">R\303\252ve Parfum\303\251 Cr\303\251ation</span> est n\303\251 de la r\303\251union compl\303\251mentaire de nos deux amiti\303\251s et de notre amour sans limite pour le travail manuel. Nous, <span className=\"text-brand-cream font-medium\">M\303\251lanie</span> et <span className=\"text-brand-cream font-medium\">Christelle</span>, partagions l\'ambition d\'insuffler de la po\303\251sie olfactive dans vos int\303\251rieurs de mani\303\250re saine et bienveillante.\n          </p>\n\n          <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n            Dans un monde de surconsommation plastique et de parfums industriels de synth\303\250se aux \303\251manations douteuses, nous avons choisi la noblesse : travailler exclusivement la <span className=\"text-brand-pink font-medium\">pure cire v\303\251g\303\251tale de soja 100% naturelle</span> ainsi que de d\303\251licates essences de plantes originaires de <span className=\"text-brand-pink font-medium\">Grasse</span>, certifi\303\251es sans mutag\303\250nes ni phtalates.\n          </p>\n\n          <div className=\"p-6 bg-brand-depth/60 border border-brand-pink/10 rounded-2xl relative\">\n            <h4 className=\"font-serif italic font-bold text-brand-cream text-lg\">\"Chaque parfum est une \303\251motion suspendue...\"</h4>\n            <p className=\"text-xs text-brand-text-muted font-light mt-1.5 leading-relaxed\">\n              Qu\'il s\'agisse d\'un petit sachet de fondants en forme de c\305\223ur \303\240 offrir aux invit\303\251s de votre mariage, ou d\'une somptueuse tasse en c\303\251ramique coul\303\251e sous forme de bougie, nous fa\303\247onnons chaque article un par un. Nous esp\303\251rons que nos cr\303\251ations embelliront vos journ\303\251es d\'une douceur bienvenue.\n            </p>\n            <div className=\"mt-4 flex gap-4 text-xs font-mono text-brand-pink\">\n              <span>\342\200\224 M\303\251lanie G.</span>\n              <span>\342\200\224 Christelle L.</span>\n            </div>\n          </div>\n        </div>\n\n      </section>\n\n      {/* 3. Fabrication Artisanale Process Section */}\n      <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">\n        <div className=\"max-w-5xl mx-auto space-y-8 text-left\">\n          <div className=\"max-w-xl space-y-2\">\n            <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Le Respect de l\'Art</span>\n            <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">Notre charte de fabrication</h2>\n            <p className=\"text-sm text-brand-text-muted font-light\">\n              De l\'achat de nos mati\303\250res premi\303\250res jusqu\'\303\240 l\'exp\303\251dition de vos d\303\251licats colis, nous ne faisons aucune concession sur la qualit\303\251 :\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 pt-4\">\n            <div className=\"space-y-2\">\n              <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">\n                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>\n                Extraits de Grasse de premi\303\250re qualit\303\251\n              </h3>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Nous choisissons nos concentr\303\251s de parfum aupr\303\250s des nez les plus r\303\251put\303\251s de Grasse. Ils respectent toutes les r\303\251gulations europ\303\251ennes les plus strictes : aucun CMR (Canc\303\251rog\303\250ne, Mutag\303\250ne, Reprotoxique) ni phtalates n\'est pr\303\251sent dans nos formules.\n              </p>\n            </div>\n\n            <div className=\"space-y-2\">\n              <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">\n                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>\n                Inclusions botaniques cueillies\n              </h3>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Les fleurs s\303\251ch\303\251es qui parent nos bouquets \303\240 rotin ou nos tablettes de cire suspendues proviennent d\'herbiers s\303\251lectionn\303\251s. P\303\251tales de rose, lavande bio, fleurs de camomille ou bl\303\251 champ\303\252tre sont plac\303\251s d\303\251licatement un par un.\n              </p>\n            </div>\n\n            <div className=\"space-y-2\">\n              <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">\n                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>\n                Partenariats avec des c\303\251ramistes locaux\n              </h3>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Nos pots en gr\303\250s artisanal de notre collection \'C\303\251ramique Divine\' sont model\303\251s \303\240 la main au tour d\'artiste \303\240 proximit\303\251. Cela favorise l\'\303\251conomie circulaire locale et garantit des objets 100% r\303\251utilisables apr\303\250s combustion.\n              </p>\n            </div>\n\n            <div className=\"space-y-2\">\n              <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">\n                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>\n                Z\303\251ro stock industriel dormant\n              </h3>\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Tout est fabriqu\303\251 ou assembl\303\251 sur commande afin de vous assurer de recevoir des cr\303\251ations tr\303\250s fra\303\256ches, dont la tenue des huiles de parfum est conserv\303\251e \303\240 son intensit\303\251 maximale et constante durant plusieurs mois.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 4. Nos Valeurs Cards Grid */}\n      <section className=\"space-y-12\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Engag\303\251es et Responsables</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Les 6 piliers de R\303\252ve Parfum\303\251\n          </h2>\n          <p className=\"text-xs text-brand-text-muted\">\n            En choisissant nos cr\303\251ations, vous soutenez un artisanat po\303\251tique, attentif et respectueux de la sant\303\251 de votre foyer.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {values.map((v, i) => (\n            <div \n              key={i} \n              className=\"p-6 bg-brand-depth border border-brand-pink/5 rounded-2xl hover:border-brand-pink/20 hover:-translate-y-1 transition-all duration-300 text-left space-y-3\"\n            >\n              <div className=\"w-10 h-10 rounded-full bg-brand-pink/15 flex items-center justify-center\">\n                {v.icon}\n              </div>\n              <h3 className=\"font-serif font-bold text-base text-brand-cream\">{v.title}</h3>\n              <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">{v.desc}</p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
    }
