  file_change {
    absolute_path_uri: "file:///src/components/LegalPages.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { ShieldCheck, Scale, FileText, Truck, MapPin, HandMetal, AlertCircle } from \'lucide-react\';\n\ninterface LegalPagesProps {\n  initialSubTab?: string;\n}\n\nexport default function LegalPages({ initialSubTab = \'mentions\' }: LegalPagesProps) {\n  const [subTab, setSubTab] = useState<string>(initialSubTab);\n\n  // Sync state if initialSubTab changes from parent\n  useEffect(() => {\n    setSubTab(initialSubTab);\n  }, [initialSubTab]);\n\n  const tabs = [\n    { id: \'mentions\', label: \'Mentions L\303\251gales\', icon: <Scale className=\"w-4 h-4\" /> },\n    { id: \'cgv\', label: \'Conditions G\303\251n\303\251rales (CGV)\', icon: <FileText className=\"w-4 h-4\" /> },\n    { id: \'confidentialite\', label: \'Confidentialit\303\251\', icon: <ShieldCheck className=\"w-4 h-4\" /> },\n    { id: \'livraison-retrait\', label: \'Livraison & Retrait\', icon: <Truck className=\"w-4 h-4\" /> }\n  ];\n\n  return (\n    <div className=\"space-y-10 pb-12\" id=\"legal-pages-container\">\n      \n      {/* 1. Header and navigation */}\n      <div className=\"text-center max-w-xl mx-auto space-y-3\">\n        <h1 className=\"text-3xl font-serif font-bold text-brand-cream\">Directives & Cadres L\303\251gaux</h1>\n        <p className=\"text-xs text-brand-text-muted\">\n          Nous mettons un point d\'honneur \303\240 op\303\251rer en toute transparence. Vous trouverez ici nos structures d\'entreprises, nos politiques de retour et nos garanties de fabrication.\n        </p>\n      </div>\n\n      {/* 2. Sub-tabs Selector */}\n      <div className=\"flex flex-wrap justify-center gap-2 border-b border-brand-pink/10 pb-6\">\n        {tabs.map((tab) => (\n          <button\n            key={tab.id}\n            onClick={() => {\n              setSubTab(tab.id);\n              window.scrollTo({ top: 300, behavior: \'smooth\' });\n            }}\n            className={`px-4.5 py-2.5 rounded-full text-xs font-medium tracking-wide flex items-center gap-2 transition-all cursor-pointer ${\n              subTab === tab.id \n                ? \'bg-brand-pink text-brand-bg font-semibold shadow-md\' \n                : \'bg-brand-depth/60 text-brand-text-muted border border-brand-pink/5 hover:border-brand-pink/30 hover:text-brand-cream\'\n            }`}\n          >\n            {tab.icon}\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      {/* 3. Sub-tabs Content */}\n      <div className=\"max-w-4xl mx-auto text-left bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-10 shadow-xl min-h-[400px]\">\n        {subTab === \'mentions\' && (\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"space-y-6\"\n          >\n            <div className=\"border-b border-brand-pink/10 pb-4\">\n              <h2 className=\"text-2xl font-serif font-bold text-brand-pink\">Mentions L\303\251gales</h2>\n              <p className=\"text-xs text-brand-text-muted\">En vigueur conform\303\251ment \303\240 la l\303\251gislation fran\303\247aise.</p>\n            </div>\n\n            <div className=\"space-y-4 text-xs text-brand-text-muted leading-relaxed font-light\">\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">1. \303\211diteur du Site</h3>\n                <p>Le site internet <strong className=\"text-brand-pink font-medium\">R\303\252ve Parfum\303\251 Cr\303\251ation</strong> est une enseigne commerciale g\303\251r\303\251e conjointement par :</p>\n                <ul className=\"list-disc pl-5 mt-2 space-y-1.5 font-mono text-[11px]\">\n                  <li>\n                    <strong className=\"text-brand-cream\">M\303\251lanie G.</strong> \342\200\224 Entrepreneur Individuel (EI) <br />\n                    SIRET : 123 456 789 00018 <br />\n                    Si\303\250ge social : 21000 Dijon, Bourgogne, France <br />\n                    Courriel : <span className=\"text-brand-pink\">melanie@reveparfume.fr</span>\n                  </li>\n                  <li className=\"pt-2\">\n                    <strong className=\"text-brand-cream\">Christelle L.</strong> \342\200\224 Entrepreneur Individuel (EI) <br />\n                    SIRET : 987 654 321 00021 <br />\n                    Si\303\250ge social : 71000 M\303\242con, Bourgogne, France <br />\n                    Courriel : <span className=\"text-brand-pink\">christelle@reveparfume.fr</span>\n                  </li>\n                </ul>\n                <p className=\"mt-2 text-[11px] italic\">Chaque cr\303\251atrice g\303\250re sa micro-entreprise enregistr\303\251e en France et la facturation est partag\303\251e selon la provenance de la fabrication.</p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">2. Responsabilit\303\251 \303\251ditrice</h3>\n                <p>\n                  Directrices de la publication : M\303\251lanie G. & Christelle L. <br />\n                  Courriel g\303\251n\303\251ral d\342\200\231atelier : <strong>contact@reveparfume.fr</strong>\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">3. H\303\251bergement du Site</h3>\n                <p>\n                  Ce site est h\303\251berg\303\251 de fa\303\247on moderne et hautement s\303\251curis\303\251e sur des conteneurs isol\303\251s en Europe. <br />\n                  H\303\251bergeur : Google Cloud Platform (Cloud Run containers) <br />\n                  Adresse : Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irlande.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">4. Propri\303\251t\303\251 Intellectuelle</h3>\n                <p>\n                  L\342\200\231ensemble de ce site (charte graphique, photographies de mises en sc\303\250ne des bougies, descriptions po\303\251tiques des fragrances, logos cr\303\251atifs et codes interactifs) constitue une \305\223uvre prot\303\251g\303\251e par les lois en vigueur sur la propri\303\251t\303\251 intellectuelle. Toute copie, extraction, ou exploitation commerciale sans l\342\200\231accord pr\303\251alable \303\251crit de Christelle ou M\303\251lanie constituera un d\303\251lit de contrefa\303\247on passible de poursuites.\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-brand-pink/5 rounded-xl border border-brand-pink/10 text-[11px] leading-relaxed\">\n                <strong>Attention Amicale :</strong> Les fragrances propos\303\251es sont des \303\251vocations de parfums connus mais restent des cr\303\251ations libres et ind\303\251pendantes de l\'atelier d\'art de Grasse.\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {subTab === \'cgv\' && (\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"space-y-6\"\n          >\n            <div className=\"border-b border-brand-pink/10 pb-4\">\n              <h2 className=\"text-2xl font-serif font-bold text-brand-pink\">Conditions G\303\251n\303\251rales de Vente (CGV)</h2>\n              <p className=\"text-xs text-brand-text-muted\">Ces conditions r\303\251gissent les commandes de l\'atelier po\303\251tique.</p>\n            </div>\n\n            <div className=\"space-y-5 text-xs text-brand-text-muted leading-relaxed font-light\">\n              \n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">1. Objet & Application</h3>\n                <p>\n                  Les pr\303\251sentes Conditions G\303\251n\303\251rales de Vente (CGV) encadrent la vente de cr\303\251ations parfum\303\251es artisanales (bougies parfum\303\251es, fondants, bouquets de rotin, et cadres) propos\303\251es par l\'enseigne R\303\252ve Parfum\303\251 Cr\303\251ation, \303\240 destination de clients particuliers et professionnels \303\240 l\'\303\251chelle fran\303\247aise.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">2. Nature des Produits</h3>\n                <p>\n                  Nos cr\303\251ations \303\251tant <strong className=\"text-brand-pink\">enti\303\250rement fabriqu\303\251es \303\240 la main</strong>, chaque pi\303\250ce dispose de l\303\251g\303\250res diff\303\251rences naturelles de couleur, d\'agencement floral ou de coulure. Ces variations font le charme unique et certifient l\'artisanat pur de notre travail. Les photos repr\303\251sent\303\251es au catalogue se veulent les plus repr\303\251sentatives possibles mais ne sont pas contractuelles \303\240 100%.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">3. Validation des Commandes</h3>\n                <p>\n                  Le client pr\303\251pare sa s\303\251lection \303\240 travers le catalogue. Lors du clic sur Commander, un brouillon de message est envoy\303\251 par WhatsApp. Les commandes ne deviennent <strong className=\"text-brand-cream\">d\303\251finitives et valid\303\251es</strong> qu\'apr\303\250s confirmation explicite par message de notre part du stock, des senteurs choisies, des options de personnalisation, et des frais de port r\303\251els applicables.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">4. Tarifs & Moyens de Paiement</h3>\n                <p>\n                  Les tarifs sont affich\303\251s en Euros (\342\202\254), hors taxes (TVA non applicable - article 293 B du CGI pour notre r\303\251gime de micro-entreprise). <br />\n                  Le r\303\250glement de la commande s\'effectue avant fabrication par : \n                </p>\n                <ul className=\"list-disc pl-5 mt-1 space-y-1\">\n                  <li><strong>PayPal</strong> (S\303\251curis\303\251, id\303\251al)</li>\n                  <li><strong>Wero</strong> (Paiement instantan\303\251 mobile sans frais)</li>\n                  <li>Virement Bancaire direct</li>\n                </ul>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">5. D\303\251lai de R\303\251tractation Obligatoire</h3>\n                <p>\n                  Conform\303\251ment \303\240 l\342\200\231article L.221-18 du Code de la Consommation, le consommateur dispose d\'un d\303\251lai de 14 jours pour exercer son droit de r\303\251tractation. Les retours sont \303\240 sa charge et ne s\'appliquent qu\'aux produits scell\303\251s n\'ayant jamais \303\251t\303\251 br\303\273l\303\251s, allum\303\251s ou ouverts.\n                </p>\n                <div className=\"mt-2 p-3 bg-brand-purple/10 rounded-xl border border-brand-purple/20\">\n                  \342\232\240\357\270\217 <strong>Exception L\303\251gale Importante :</strong> Les produits personnalis\303\251s sp\303\251cifiquement \303\240 la demande du client (choix color\303\251s n\'existant pas au catalogue habituel, \303\251tiquettes \303\240 pr\303\251noms sur-mesure pour mariages) sont express\303\251ment exclus du droit de retour et ne pourront \303\252tre annul\303\251s apr\303\250s coulage de la cire v\303\251g\303\251tale.\n                </div>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">6. Litiges & R\303\250glement amiable</h3>\n                <p>\n                  En cas de litige, contactez l\'atelier sous 48 heures par courriel ou WhatsApp. Nous trouverons toujours une solution humaine, chaleureuse et pragmatique.\n                </p>\n              </div>\n\n            </div>\n          </motion.div>\n        )}\n\n        {subTab === \'confidentialite\' && (\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"space-y-6\"\n          >\n            <div className=\"border-b border-brand-pink/10 pb-4\">\n              <h2 className=\"text-2xl font-serif font-bold text-brand-pink\">Politique de Confidentialit\303\251 (RGPD)</h2>\n              <p className=\"text-xs text-brand-text-muted\">S\303\251curit\303\251 et int\303\251grit\303\251 de vos donn\303\251es de discussion.</p>\n            </div>\n\n            <div className=\"space-y-4 text-xs text-brand-text-muted leading-relaxed font-light\">\n              <p>\n                Chez R\303\252ve Parfum\303\251 Cr\303\251ation, nous n\342\200\231aimons pas le spam et respectons les directives europ\303\251ennes RGPD. Nous ne collectons que les informations strictement n\303\251cessaires \303\240 la livraison de vos colis d\'odeurs douces.\n              </p>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">1. Qu\'est-ce que nous collectons ?</h3>\n                <p>Lorsque vous utilisez nos formulaires interactifs d\'estimation ou de devis WhatsApp, nous g\303\251n\303\251rons du texte contenant :</p>\n                <ul className=\"list-disc pl-5 mt-1 space-y-1\">\n                  <li>Votre Nom & Pr\303\251nom</li>\n                  <li>Votre Num\303\251ro de t\303\251l\303\251phone portable</li>\n                  <li>Vos choix d\'essences parfum\303\251es</li>\n                  <li>Votre adresse email pour les devis institutionnels</li>\n                  <li>Votre adresse de livraison postales (fournie volontairement lors de la validation finale du colis)</li>\n                </ul>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">2. Finalit\303\251s & Non-partage</h3>\n                <p>\n                  Ces donn\303\251es ne quittent pas notre canal de discussion WhatsApp et ne sont <strong>absolument jamais revendues</strong> \303\240 des bases de publicit\303\251 tierces ou transmises \303\240 d\'autres tiers hormis le transporteur postal charg\303\251 de votre colis.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">3. Vos Droits</h3>\n                <p>\n                  Vous pouvez \303\240 n\342\200\231importe quel moment demander la suppression d\303\251finitive de vos devis, adresse et historique de conversation de notre r\303\251pertoire de cire en \303\251crivant simplement par courriel \303\240 <strong>contact@reveparfume.fr</strong>. Vos donn\303\251es seront purg\303\251es sous 48 heures.\n                </p>\n              </div>\n\n              <div className=\"inline-flex items-center gap-2 p-3 bg-green-950/20 text-emerald-400 border border-emerald-900/40 rounded-xl text-[11px]\">\n                <ShieldCheck className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                <span>Nous n\'enregistrons aucun cookie de pistage publicitaire invasif sur notre site. C\'est l\'assurance d\'une navigation pure.</span>\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {subTab === \'livraison-retrait\' && (\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"space-y-6\"\n          >\n            <div className=\"border-b border-brand-pink/10 pb-4\">\n              <h2 className=\"text-2xl font-serif font-bold text-brand-pink\">Politique Logistique : Livraison & Retraits</h2>\n              <p className=\"text-xs text-brand-text-muted\">Des r\303\250gles claires adapt\303\251es \303\240 la fragilit\303\251 de nos cires saines.</p>\n            </div>\n\n            <div className=\"space-y-5 text-xs text-brand-text-muted leading-relaxed font-light\">\n              \n              <div className=\"p-4 bg-brand-pink/5 rounded-2xl border border-brand-pink/15 flex gap-3 text-left\">\n                <AlertCircle className=\"w-5 h-5 text-brand-pink shrink-0 mt-0.5 animate-pulse\" />\n                <div className=\"space-y-1\">\n                  <h4 className=\"font-serif font-bold text-brand-cream text-xs uppercase tracking-wider\">Limitations de Transport Thermique</h4>\n                  <p className=\"text-[11px] leading-relaxed\">\n                    La cire pure de soja de nos bougies et fondants est d\342\200\231origine v\303\251g\303\251tale sensible et poss\303\250de une temp\303\251rature de fusion basse (48\302\260C). <br />\n                    En cons\303\251quence, <strong className=\"text-brand-pink\">les envois postaux de colis sont ouverts et assur\303\251s de Octobre \303\240 Mars</strong>. Hors de cette saison froide, nous privil\303\251gions express\303\251ment le retrait gratuit \303\240 l\'atelier en Bourgogne ou \303\240 proximit\303\251 pour garantir l\'\303\251tat parfait des cr\303\251ations.\n                  </p>\n                </div>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">1. D\303\251lais de Cure Chimique (Environ 2 semaines)</h3>\n                <p>\n                  Parce que nous militons pour de hauts rendus d\'odeurs et ne rajoutons aucun adjuvant industriel de s\303\251chage rapide, chaque bougie ou fondant suspendu n\303\251cessite <strong className=\"text-brand-cream\">environ deux semaines</strong> de repos de cure en placard d\'atelier avant d\342\200\231\303\252tre pr\303\252t pour le transport. Les grosses commandes de mariages doivent id\303\251alement \303\252tre estim\303\251es 1 mois \303\240 l\'avance.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">2. Transporteurs Partenaires</h3>\n                <p>Pour assurer la s\303\251curit\303\251 de livraison, nous faisons confiance aux transporteurs r\303\251put\303\251s de France :</p>\n                <ul className=\"list-disc pl-5 mt-1.5 space-y-1\">\n                  <li><strong>Mondial Relay</strong> (Le choix pr\303\251f\303\251r\303\251, \303\251conomique et pratique de point relais)</li>\n                  <li><strong>La Poste / Colissimo</strong> (Livraison directe \303\240 votre domicile sous signature)</li>\n                  <li>Chronopost (R\303\251serv\303\251 aux urgences d\'\303\251v\303\251nements sp\303\251cifiques)</li>\n                </ul>\n                <p className=\"mt-2\">Les co\303\273ts postaux sont calcul\303\251s \303\240 prix co\303\273tant selon la grille officielle des transporteurs en fonction du poids total de votre panier d\'ateliers.</p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">3. Retrait \303\240 Domicile Direct (Bourgogne)</h3>\n                <p>\n                  D\303\250s que votre colis de cire est finalis\303\251 dans notre atelier de Bourgogne, nous convenons d\'un rendez-vous ou d\'un cr\303\251neau souple pour un retrait direct gratuit. L\'adresse de notre point atelier vous sera transmise sur votre message de discussion WhatsApp.\n                </p>\n              </div>\n\n              <div>\n                <h3 className=\"font-serif font-bold text-sm text-brand-cream mb-1\">4. Protection colis active & Suivi d\'exp\303\251dition</h3>\n                <p>\n                  Chaque cr\303\251ation de porcelaine, bouquet de rotin fleuri ou bougie est emball\303\251e sous triple \303\251paisseur de papier bulle \303\251co-con\303\247u et cal\303\251 dans des copeaux de paille biod\303\251gradables. <strong className=\"text-brand-cream\">Afin de garantir et d\'\303\251liminer toute erreur de transport, une preuve photographique ou vid\303\251o de nos colis ouverts est pr\303\251serv\303\251e avant remise au bureau de poste</strong>. L\'\303\251tat d\303\251grad\303\251 \303\251ventuel commis par le service postal sera alors \303\251tudi\303\251 en toute transparence.\n                </p>\n              </div>\n\n            </div>\n          </motion.div>\n        )}\n      </div>\n\n    </div>\n  );\n}\n"
    }
