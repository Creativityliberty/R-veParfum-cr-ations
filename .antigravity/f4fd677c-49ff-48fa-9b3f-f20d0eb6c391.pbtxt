  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Sparkles, \n  Leaf, \n  Calendar, \n  MessageSquare, \n  ShoppingBag, \n  Compass, \n  BookHeart, \n  Truck, \n  PhoneCall, \n  Clock, \n  Grid,\n  Heart,\n  Eye,\n  ArrowRight,\n  ShieldCheck,\n  Award,\n  ChevronRight,\n  ChevronDown,\n  Droplet\n} from \'lucide-react\';\n\nimport Header from \'./components/Header\';\nimport ScentQuiz from \'./components/ScentQuiz\';\nimport ProductCard from \'./components/ProductCard\';\nimport ProductDetailsModal from \'./components/ProductDetailsModal\';\nimport ReviewSection from \'./components/ReviewSection\';\nimport EventQuoteBuilder from \'./components/EventQuoteBuilder\';\nimport HomePartiesBuilder from \'./components/HomePartiesBuilder\';\n\nimport { PRODUCTS, CATEGORIES, SCENTS } from \'./data\';\nimport { Product } from \'./types\';\n\nexport default function App() {\n  const [currentTab, setCurrentTab] = useState<string>(\'accueil\');\n  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null);\n  const [showQuizModal, setShowQuizModal] = useState<boolean>(false);\n  \n  // Boutique state filters\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'Tous\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [scentFilter, setScentFilter] = useState<string>(\'Tous\');\n  \n  // Custom toast notification state\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const triggerToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 4500);\n  };\n\n  // Filter products beautifully\n  const filteredProducts = PRODUCTS.filter(p => {\n    const matchesCategory = selectedCategory === \'Tous\' || p.category === selectedCategory;\n    const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || \n                          p.description.toLowerCase().includes(searchQuery.toLowerCase());\n    const matchesScent = scentFilter === \'Tous\' || p.scents.includes(scentFilter);\n    return matchesCategory && matchesSearch && matchesScent;\n  });\n\n  return (\n    <div className=\"min-h-screen bg-brand-bg text-brand-cream selection:bg-brand-pink selection:text-brand-bg overflow-x-hidden pt-24 md:pt-28 pb-12 font-sans relative\">\n      \n      {/* Dynamic Background decorative warm ambient light globes */}\n      <div className=\"absolute top-0 right-0 w-[45rem] h-[45rem] bg-brand-pink/5 rounded-full filter blur-[120px] pointer-events-none\" />\n      <div className=\"absolute top-[80vh] left-0 w-[35rem] h-[35rem] bg-brand-purple/5 rounded-full filter blur-[100px] pointer-events-none\" />\n      <div className=\"absolute bottom-20 right-10 w-[40rem] h-[40rem] bg-brand-wax/5 rounded-full filter blur-[140px] pointer-events-none\" />\n\n      {/* Floating Header Navigation */}\n      <Header \n        currentTab={currentTab} \n        setCurrentTab={setCurrentTab} \n        openScentQuiz={() => {\n          setShowQuizModal(true);\n          // Auto-scroll to quiz area when opened on simple page layouts\n          const quizEl = document.getElementById(\'scent-finder-anchor\');\n          if (quizEl) {\n            quizEl.scrollIntoView({ behavior: \'smooth\' });\n          }\n        }} \n      />\n\n      {/* Floating notification Toast */}\n      <AnimatePresence>\n        {toastMessage && (\n          <motion.div \n            initial={{ opacity: 0, y: 40 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: 40 }}\n            className=\"fixed bottom-6 right-6 z-50 px-6 py-4 rounded-2xl bg-brand-depth border border-brand-pink/30 text-brand-pink font-medium text-sm shadow-2xl flex items-center gap-2\"\n          >\n            <Sparkles className=\"w-5 h-5 animate-pulse text-amber-300\" />\n            <span>{toastMessage}</span>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <AnimatePresence mode=\"wait\">\n          \n          {/* ==================== 1. ACCUEIL TAB ==================== */}\n          {currentTab === \'accueil\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-24\"\n            >\n              \n              {/* Immersive Hero Section */}\n              <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-6 md:py-12\" id=\"section-hero\">\n                <div className=\"lg:col-span-7 space-y-8 text-left\">\n                  <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-pink/10 border border-brand-pink/15 text-brand-pink text-xs font-mono uppercase tracking-widest\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    Atelier artisanal \302\267 Cires & Fragrances\n                  </div>\n\n                  <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-brand-cream leading-[1.1]\">\n                    Des cr\303\251ations parfum\303\251es <br />\n                    <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-brand-pink to-brand-purple italic font-light\">\n                      artisanales & naturelles\n                    </span>\n                  </h1>\n\n                  <p className=\"text-base sm:text-lg text-brand-text-muted leading-relaxed max-w-2xl font-light\">\n                    Bougies v\303\251g\303\251tales, fondants floraux coeurs, bouquets capillarit\303\251 aux rotins naturels et cadres de cire botaniques coul\303\251s \303\240 la main. Tous nos parfums proviennent directement de <span className=\"text-brand-pink\">Grasse</span>, sans substances de synth\303\250se CMR ni phtalates.\n                  </p>\n\n                  <div className=\"flex flex-col sm:flex-row gap-4\">\n                    <button \n                      onClick={() => setCurrentTab(\'boutique\')}\n                      className=\"px-8 py-4 bg-brand-pink text-brand-bg font-extrabold text-sm tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer\"\n                    >\n                      <ShoppingBag className=\"w-4 h-4\" />\n                      D\303\251couvrir la Boutique\n                    </button>\n                    \n                    <button \n                      onClick={() => {\n                        setShowQuizModal(true);\n                        setTimeout(() => {\n                          document.getElementById(\'scent-finder-anchor\')?.scrollIntoView({ behavior: \'smooth\' });\n                        }, 100);\n                      }}\n                      className=\"px-8 py-4 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 transition-all text-sm font-semibold tracking-wider uppercase flex items-center justify-center gap-2 cursor-pointer\"\n                    >\n                      \360\237\224\256 Trouver ma senteur\n                    </button>\n                  </div>\n\n                  {/* Trust factors logos */}\n                  <div className=\"pt-4 grid grid-cols-3 gap-4 border-t border-brand-pink/10 max-w-lg\">\n                    <div>\n                      <span className=\"block text-lg font-bold font-serif text-brand-pink\">100% soja</span>\n                      <span className=\"text-xs text-brand-text-muted\">Cire v\303\251g\303\251tale saine</span>\n                    </div>\n                    <div>\n                      <span className=\"block text-lg font-bold font-serif text-brand-pink\">Grasse</span>\n                      <span className=\"text-xs text-brand-text-muted\">Fragrances sans CMR</span>\n                    </div>\n                    <div>\n                      <span className=\"block text-lg font-bold font-serif text-brand-pink\">Fait main</span>\n                      <span className=\"text-xs text-brand-text-muted\">Chaque pi\303\250ce est unique</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right side Visual Showcase */}\n                <div className=\"lg:col-span-5 relative\">\n                  {/* Glowing background ring */}\n                  <div className=\"absolute inset-0 bg-gradient-to-tr from-brand-pink/20 to-brand-purple/20 rounded-[2.5rem] filter blur-xl transform translate-x-3 translate-y-3 opacity-60\" />\n\n                  <div className=\"relative rounded-[2.5rem] overflow-hidden border border-brand-pink/15 aspect-[4/3] lg:aspect-square bg-brand-depth shadow-2xl\">\n                    <img \n                      src=\"/src/assets/images/hero_perfume_1779963676925.png\" \n                      alt=\"R\303\252ve Parfum\303\251 Cr\303\251ations artisanales\" \n                      className=\"w-full h-full object-cover select-none\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n\n                    {/* Miniature interactive tag overlay on Image */}\n                    <div className=\"absolute bottom-6 left-6 right-6 backdrop-blur-md bg-brand-bg/80 border border-brand-pink/10 p-4 rounded-2xl flex items-center justify-between\">\n                      <div>\n                        <span className=\"block text-xs uppercase font-mono tracking-widest text-brand-pink font-semibold\">Incontournable</span>\n                        <h4 className=\"font-serif text-sm font-bold text-brand-cream\">Bougie en C\303\251ramique & Rotin</h4>\n                      </div>\n                      <span className=\"font-mono text-xs bg-brand-pink text-brand-bg font-extrabold px-3 py-1.5 rounded-full\">\n                        D\303\250s 18,50 \342\202\254\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Floating abstract blossom details */}\n                  <div className=\"absolute -top-4 -left-4 w-12 h-12 rounded-full bg-brand-pink/10 flex items-center justify-center border border-brand-pink/15 text-brand-pink shadow-md animate-bounce\">\n                    \360\237\214\270\n                  </div>\n                  <div className=\"absolute -bottom-4 -right-4 w-10.5 h-10.5 rounded-full bg-brand-purple/15 flex items-center justify-center border border-brand-purple/15 text-brand-purple shadow-md animate-pulse\">\n                    \342\234\250\n                  </div>\n                </div>\n              </section>\n\n              {/* Curated Product Category Showcase Row */}\n              <section className=\"space-y-8\" id=\"section-curated-products\">\n                <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n                  <div className=\"space-y-2\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Inspirations de l\'Atelier</span>\n                    <h2 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">\n                      D\303\251couvrez nos 4 familles phares\n                    </h2>\n                  </div>\n                  <button \n                    onClick={() => setCurrentTab(\'boutique\')}\n                    className=\"group text-brand-pink font-semibold text-sm hover:text-brand-cream flex items-center gap-1.5 self-start cursor-pointer transition-colors\"\n                  >\n                    Voir tout le catalogue complet\n                    <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                  </button>\n                </div>\n\n                {/* 4 Cards Floating */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                  {PRODUCTS.slice(0, 4).map((product) => (\n                    <ProductCard \n                      key={product.id} \n                      product={product} \n                      onSelect={(p) => setSelectedProduct(p)} \n                    />\n                  ))}\n                </div>\n              </section>\n\n              {/* ================= SECTION POURQUOI CHOISIR ================= */}\n              <section className=\"bg-brand-depth/40 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">\n                <div className=\"max-w-7xl mx-auto space-y-12\">\n                  <div className=\"text-center max-w-xl mx-auto space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Un Choix Responsable & Po\303\251tique</span>\n                    <h2 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">Pourquoi voter pour R\303\252ve Parfum\303\251 ?</h2>\n                    <p className=\"text-sm text-brand-text-muted\">\n                      Des collections uniques pens\303\251es pour envelopper vos journ\303\251es d\'un cocon parfum\303\251 sans aucun compromis pour votre bien-\303\252tre.\n                    </p>\n                  </div>\n\n                  {/* Layout caf\303\251 adaptation: centered visual + 4 arguments around */}\n                  <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n                    \n                    {/* Column Left (Arguments 1 & 2) */}\n                    <div className=\"lg:col-span-4 space-y-8 text-right\">\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">01</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">100% Ingr\303\251dients Naturels</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          De la cire v\303\251g\303\251tale de soja biod\303\251gradable sans OGM, sans paraphine d\303\251riv\303\251e de p\303\251trole. Pour une combustion saine et responsable.\n                        </p>\n                      </div>\n\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">02</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Atelier Fran\303\247ais Fait Main</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          M\303\251lanie et Christelle coulent artisanalement chaque fondant, cadre et bougie \303\240 la main d\'artiste. Des fleurs s\303\251ch\303\251es aux contenants.\n                        </p>\n                      </div>\n                    </div>\n\n                    {/* Column Center (Centerpiece visual) */}\n                    <div className=\"lg:col-span-4 justify-center flex relative\">\n                      <div className=\"absolute inset-0 bg-brand-purple/5 filter blur-3xl pointer-events-none rounded-full\" />\n                      <div className=\"relative p-6 bg-brand-depth border border-brand-pink/10 rounded-full w-64 h-64 flex items-center justify-center text-center shadow-lg group\">\n                        <div className=\"bg-brand-bg/80 border border-brand-pink/20 rounded-full w-52 h-52 flex flex-col items-center justify-center p-4\">\n                          <Droplet className=\"w-8 h-8 text-brand-pink animate-pulse mb-2\" />\n                          <h4 className=\"font-serif text-base font-bold text-brand-cream leading-tight\">Grasse Essences</h4>\n                          <p className=\"text-[10px] text-brand-text-muted mt-1 uppercase tracking-widest\">Z\303\251ro phtalate</p>\n                          <p className=\"text-[9px] text-brand-purple mt-0.5\">Note olfactive s\303\273re</p>\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Column Right (Arguments 3 & 4) */}\n                    <div className=\"lg:col-span-4 space-y-8 text-left\">\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">03</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Enti\303\250rement Personnalisable</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          Nous adaptons les couleurs de cire, vos fragrances d\'ambiance et m\303\252me l\'impression d\'\303\251tiquettes de voeux pour vos c\303\251r\303\251monies et cadeaux d\'invit\303\251s.\n                        </p>\n                      </div>\n\n                      <div className=\"space-y-2 group\">\n                        <span className=\"inline-flex w-10 h-10 rounded-full bg-brand-pink/15 text-brand-pink font-serif text-lg font-bold items-center justify-center mb-1 group-hover:bg-brand-pink group-hover:text-brand-bg transition-all\">04</span>\n                        <h3 className=\"text-xl font-serif font-semibold text-brand-cream\">Tradition Cadeaux d\'\303\211motion</h3>\n                        <p className=\"text-sm text-brand-text-muted leading-relaxed font-light\">\n                          Boutiques pr\303\252tes \303\240 offrir, coffrets mignons fleuris en carton biod\303\251gradable herm\303\251tiques. Une odeur r\303\251confortante qui reste.\n                        </p>\n                      </div>\n                    </div>\n\n                  </div>\n                </div>\n              </section>\n\n              {/* ================= SCENT FINDER WIZARD TRIGGER AREA ================= */}\n              <section className=\"scroll-mt-28\" id=\"scent-finder-anchor\">\n                <ScentQuiz \n                  onSelectProduct={(p) => setSelectedProduct(p)} \n                />\n              </section>\n\n              {/* ================= PARTNERSHIP SUMMARY TILES ================= */}\n              <section className=\"grid grid-cols-1 md:grid-cols-2 gap-8 pt-4\">\n                <div className=\"p-8 bg-brand-depth border border-brand-pink/15 rounded-3xl flex flex-col justify-between\">\n                  <div className=\"space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-semibold\">Cadeaux \303\211v\303\251nementiels Sur-Mesure</span>\n                    <h3 className=\"text-2xl font-serif font-bold text-brand-cream leading-tight\">Vous pr\303\251parez un mariage, bapt\303\252me ou cherchez des cadeaux CE ?</h3>\n                    <p className=\"text-sm text-brand-text-muted font-light leading-relaxed\">\n                      D\303\251couvrez nos miniatures d\'invit\303\251s adaptables \303\240 vos nuanciers floraux. Personnalisation gratuite pour les \303\251tiquettes de remerciements. Tarifs d\303\251gressifs.\n                    </p>\n                  </div>\n                  <button \n                    onClick={() => setCurrentTab(\'evenements\')}\n                    className=\"mt-6 self-start px-5 py-2.5 bg-brand-pink text-brand-bg font-bold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors\"\n                  >\n                    Estimer mon devis personnalis\303\251\n                  </button>\n                </div>\n\n                <div className=\"p-8 bg-brand-depth border border-brand-pink/15 rounded-3xl flex flex-col justify-between\">\n                  <div className=\"space-y-3\">\n                    <span className=\"text-xs font-mono text-brand-purple uppercase tracking-widest font-semibold\">Atelier H\303\264tesse \303\240 Domicile</span>\n                    <h3 className=\"text-2xl font-serif font-bold text-brand-cream leading-tight\">Organisez une R\303\251union Parfum\303\251e chez vous</h3>\n                    <p className=\"text-sm text-brand-text-muted font-light leading-relaxed\">\n                      Inscrivez-vous pour accueillir M\303\251lanie et sa malle \303\240 senteurs olfactive lors d\'une apr\303\250s-midi cocooning. Gagnez 10% de toutes les commandes pass\303\251es en bons boutique !\n                    </p>\n                  </div>\n                  <button \n                    onClick={() => setCurrentTab(\'reunions\')}\n                    className=\"mt-6 self-start px-5 py-2.5 bg-brand-purple text-brand-bg font-bold text-xs tracking-wider uppercase rounded-full hover:bg-white/90 transition-all\"\n                  >\n                    R\303\251server une date d\'atelier\n                  </button>\n                </div>\n              </section>\n\n            </motion.div>\n          )}\n\n          {/* ==================== 2. BOUTIQUE CATALOGUE TAB ==================== */}\n          {currentTab === \'boutique\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-10\"\n              id=\"boutique-main-view\"\n            >\n              <div className=\"text-center max-w-xl mx-auto space-y-3\">\n                <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">le Comptoir de l\'Atelier</span>\n                <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream\">\n                  Nos Cr\303\251ations Parfum\303\251es\n                </h1>\n                <p className=\"text-sm text-brand-text-muted leading-relaxed\">\n                  Faites d\303\251filer nos cr\303\251ations coul\303\251es \303\240 la main. Tous les tarifs indiqu\303\251s sont transparents et incluent la pr\303\251paration d\303\251licate de nos sachets.\n                </p>\n              </div>\n\n              {/* Filters Panel Area */}\n              <div className=\"bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-8 space-y-6\">\n                \n                {/* Search & Scents Dropdowns */}\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                  \n                  {/* Search text */}\n                  <div>\n                    <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Recheracher une pi\303\250ce</label>\n                    <input \n                      type=\"text\" \n                      placeholder=\"Ex : Cerisier, bougie...\"\n                      value={searchQuery}\n                      onChange={(e) => setSearchQuery(e.target.value)}\n                      className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream placeholder-gray-500 focus:outline-none focus:border-brand-pink transition-colors\"\n                    />\n                  </div>\n\n                  {/* Scent filter */}\n                  <div>\n                    <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Note parfum\303\251e cl\303\251</label>\n                    <select\n                      value={scentFilter}\n                      onChange={(e) => setScentFilter(e.target.value)}\n                      className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                    >\n                      <option value=\"Tous\">Toutes les essences parfum\303\251es</option>\n                      <option value=\"Fleur de Coton\">\360\237\214\270 Fleur de Coton</option>\n                      <option value=\"Vanille des \303\256les\">\360\237\215\246 Vanille des \303\256les</option>\n                      <option value=\"Caramel beurre sal\303\251\">\360\237\245\236 Caramel beurre sal\303\251</option>\n                      <option value=\"Fleur de Cerisier\">\360\237\214\270 Fleur de Cerisier</option>\n                      <option value=\"Lavande de Provence\">\360\237\214\276 Lavande de Provence</option>\n                      <option value=\"Eucalyptus & Menthe\">\360\237\214\277 Eucalyptus & Menthe</option>\n                      <option value=\"Ambre Imp\303\251rial\">\360\237\224\245 Ambre Imp\303\251rial</option>\n                      <option value=\"Mono\303\257 Absolu\">\360\237\245\245 Mono\303\257 Absolu</option>\n                    </select>\n                  </div>\n\n                  {/* Order notification details */}\n                  <div className=\"flex items-center p-3 bg-brand-pink/5 rounded-xl border border-brand-pink/10\">\n                    <p className=\"text-[10px] text-brand-purple leading-normal font-light\">\n                      \360\237\214\237 Nous fonctionnons sous forme de catalogue-commande assist\303\251. Configurez vos senteurs, validez et notre bouton WhatsApp pr\303\251-rempira instantan\303\251ment votre message !\n                    </p>\n                  </div>\n\n                </div>\n\n                {/* Categories Horizontal Tabs */}\n                <div className=\"space-y-2\">\n                  <span className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest leading-none mb-3\">Filtrer par cat\303\251gorie</span>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {CATEGORIES.map((cat) => (\n                      <button\n                        key={cat}\n                        onClick={() => setSelectedCategory(cat)}\n                        className={`px-4.5 py-2 rounded-full text-xs font-medium tracking-wide transition-all cursor-pointer ${\n                          selectedCategory === cat \n                            ? \'bg-brand-pink text-brand-bg font-semibold shadow-md\' \n                            : \'bg-brand-bg/50 text-brand-text-muted border border-brand-pink/5 hover:border-brand-pink/30 hover:text-brand-cream\'\n                        }`}\n                      >\n                        {cat}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n              </div>\n\n              {/* Infinite products listings */}\n              <div className=\"space-y-4\">\n                <div className=\"flex justify-between items-center text-xs text-brand-text-muted uppercase font-mono tracking-wider px-2\">\n                  <span>R\303\251sultats trouv\303\251s :</span>\n                  <span>{filteredProducts.length} cr\303\251ations parfum\303\251es</span>\n                </div>\n\n                {filteredProducts.length > 0 ? (\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    {filteredProducts.map((p) => (\n                      <ProductCard \n                        key={p.id} \n                        product={p} \n                        onSelect={(prod) => setSelectedProduct(prod)} \n                      />\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"bg-brand-depth border border-brand-pink/10 rounded-3xl p-12 text-center max-w-md mx-auto space-y-3\">\n                    <span className=\"text-3xl\">\360\237\215\202</span>\n                    <h3 className=\"text-lg font-serif font-bold text-brand-cream\">Aucune cr\303\251ation ne correspond</h3>\n                    <p className=\"text-xs text-brand-text-muted\">\n                      Modifiez votre filtre d\'essence ou votre recherche de texte pour d\303\251bloquer de merveilleux produits.\n                    </p>\n                    <button \n                      onClick={() => {\n                        setSelectedCategory(\'Tous\');\n                        setScentFilter(\'Tous\');\n                        setSearchQuery(\'\');\n                      }} \n                      className=\"mt-2 text-xs text-brand-pink font-semibold underline hover:text-brand-cream transition-colors cursor-pointer\"\n                    >\n                      R\303\251initialiser tous les filtres\n                    </button>\n                  </div>\n                )}\n              </div>\n\n            </motion.div>\n          )}\n\n          {/* ==================== 3. EVENEMENTS TAB ==================== */}\n          {currentTab === \'evenements\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <EventQuoteBuilder />\n            </motion.div>\n          )}\n\n          {/* ==================== 4. REUNIONS TAB ==================== */}\n          {currentTab === \'reunions\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <HomePartiesBuilder />\n            </motion.div>\n          )}\n\n          {/* ==================== 5. AVIS CLIENTS TAB ==================== */}\n          {currentTab === \'avis\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"space-y-6\"\n            >\n              <ReviewSection onAddReviewNotification={(text) => triggerToast(text)} />\n            </motion.div>\n          )}\n\n          {/* ==================== 6. LIVRAISON & INFORMATION TAB ==================== */}\n          {currentTab === \'livraison\' && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"max-w-4xl mx-auto space-y-12\"\n            >\n              <div className=\"text-center space-y-3\">\n                <Truck className=\"w-10 h-10 text-brand-pink mx-auto animate-pulse\" />\n                <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream\">\n                  Exp\303\251dition, Retrait & Informations\n                </h1>\n                <p className=\"text-sm text-brand-text-muted\">\n                  Chez R\303\252ve Parfum\303\251 Cr\303\251ation, chaque produit n\'attend pas sur une \303\251tag\303\250re froide. Nous fabriquons \303\240 la demande pour pr\303\251server les puissances odorantes.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                \n                {/* Rule Card 1 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Clock className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">D\303\251lai global de 2 semaines</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Nous n\'utilisons aucun process industriel de s\303\251chage forc\303\251. Vos bougies, bouquets artisanaux et suspensions florales reposent un temps r\303\251glementaire de cure en atelier pour lib\303\251rer l\'expression optimale de l\'huile de parfum. Comptez environ deux semaines entre votre validation WhatsApp et la dispo.\n                  </p>\n                </div>\n\n                {/* Rule Card 2 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Truck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">Livraisons de Septembre \303\240 Mars</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    La cire 100% v\303\251g\303\251tale de soja et les fondants coeurs poss\303\250dent une temp\303\251rature de fusion basse de 48\302\260C. Afin d\'\303\251viter tout dommage thermique et coulures durant les acheminements postaux d\'\303\251t\303\251, les colis de livraison sont assur\303\251s de Septembre \303\240 Mars.\n                  </p>\n                </div>\n\n                {/* Rule Card 3 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <Compass className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">Retrait gratuit \303\240 l\'Atelier</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Le retrait direct \303\240 l\'adresse de notre atelier (ou lors de nos r\303\251unions) est privil\303\251gi\303\251 toute l\'ann\303\251e. Prenez date avec Christelle ou M\303\251lanie lors de votre conversation WhatsApp. Vos cr\303\251ations vous attendront pr\303\252tes \303\240 offrir dans notre cocon.\n                  </p>\n                </div>\n\n                {/* Rule Card 4 */}\n                <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-3\">\n                  <div className=\"flex items-center gap-2 text-brand-pink border-b border-brand-pink/10 pb-2\">\n                    <ShieldCheck className=\"w-5 h-5\" />\n                    <h3 className=\"font-serif font-bold text-lg text-brand-cream\">Charte \303\211co-Responsable</h3>\n                  </div>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">\n                    Nous recyclons nos contenants verre, offrons des recharges fondants \303\240 poser et n\'imprimons que le strict n\303\251cessaire d\'\303\251tiquette d\'envoi. Un choix \303\251thique au service de la po\303\251sie olfactive !\n                  </p>\n                </div>\n\n              </div>\n\n              {/* Legal information notice footer */}\n              <div className=\"p-8 bg-brand-depth/40 border border-brand-pink/5 rounded-3xl text-left space-y-4\">\n                <h3 className=\"font-serif font-bold text-xl text-brand-cream\">Mentions L\303\251gales & CGV Transparentes</h3>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 text-[11px] text-brand-text-muted font-mono leading-relaxed\">\n                  <div className=\"space-y-1\">\n                    <p className=\"font-bold text-brand-pink uppercase mb-1\">R\303\252ve Parfum\303\251 Cr\303\251ation</p>\n                    <p>Co-dirig\303\251 par : Christelle L. & M\303\251lanie G.</p>\n                    <p>Micro-entreprises enregistr\303\251es en France.</p>\n                    <p>Siret : 123 456 789 00018 / 987 654 321 00021</p>\n                    <p>Courriel : contact@reveparfume.fr</p>\n                  </div>\n                  <div className=\"space-y-1\">\n                    <p className=\"font-bold text-brand-pink uppercase mb-1\">R\303\250gles Commerciales</p>\n                    <p>Moyen de paiement accept\303\251s : PayPal, Wero, Virement</p>\n                    <p>Retours accept\303\251s sous 14 jours si scell\303\251s.</p>\n                    <p>Frais d\'exp\303\251dition calcul\303\251s lors du chat WhatsApp selon le barom\303\250tre postal.</p>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          )}\n\n        </AnimatePresence>\n      </main>\n\n      {/* ==================== INLINE CUSTOM CHEKOUT MODAL ==================== */}\n      {selectedProduct && (\n        <ProductDetailsModal \n          product={selectedProduct} \n          onClose={() => setSelectedProduct(null)} \n        />\n      )}\n\n      {/* ==================== FOOTER ==================== */}\n      <footer className=\"mt-24 border-t border-brand-pink/10 py-12 bg-brand-depth/20\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"text-left\">\n            <h3 className=\"text-lg font-serif font-bold text-brand-pink\">R\303\252ve Parfum\303\251 Cr\303\251ation</h3>\n            <p className=\"text-xs text-brand-text-muted font-light mt-1\">Concepteur de douceurs parfum\303\251es saines et artisanales \303\240 base de cire de soja.</p>\n          </div>\n          \n          <div className=\"flex flex-wrap gap-4 text-xs text-brand-text-muted\">\n            <button onClick={() => setCurrentTab(\'accueil\')} className=\"hover:text-brand-pink transition-colors\">Accueil</button>\n            <button onClick={() => setCurrentTab(\'boutique\')} className=\"hover:text-brand-pink transition-colors\">Boutique</button>\n            <button onClick={() => setCurrentTab(\'evenements\')} className=\"hover:text-brand-pink transition-colors\">Mariages & \303\211v\303\251nements</button>\n            <button onClick={() => setCurrentTab(\'reunions\')} className=\"hover:text-brand-pink transition-colors\">Atelier \303\240 Domicile</button>\n            <button onClick={() => setCurrentTab(\'livraison\')} className=\"hover:text-brand-pink transition-colors\">CGV & Informations</button>\n          </div>\n\n          <div className=\"text-xs text-brand-text-muted font-mono\">\n            &copy; {new Date().getFullYear()} R\303\252ve Parfum\303\251 \302\267 Fait main en France\n          </div>\n        </div>\n      </footer>\n\n      {/* Permanent floating chat trigger speed dial for mobile / desktop layout */}\n      <div className=\"fixed bottom-6 left-6 z-40\">\n        <a \n          href=\"https://wa.me/33600000000?text=Bonjour%20M%C3%A9lanie%20et%20Christelle%2C%20je%20souhaite%20me%20renseigner%20sur%20vos%20cr%C3%A9ations%20parfum%C3%A9es%20!\" \n          target=\"_blank\" \n          rel=\"noopener noreferrer\"\n          className=\"flex items-center gap-2 group p-4.5 bg-brand-pink text-brand-bg font-extrabold text-sm rounded-full shadow-2xl hover:bg-brand-pink-hover transition-all duration-300 scale-100 hover:scale-105\"\n          title=\"Parler sur WhatsApp\"\n        >\n          <PhoneCall className=\"w-5 h-5 text-brand-bg\" />\n          <span className=\"hidden md:inline-block text-xs uppercase tracking-widest leading-none font-bold\">Aide WhatsApp (Conseil)</span>\n        </a>\n      </div>\n\n    </div>\n  );\n}\n"
    }
