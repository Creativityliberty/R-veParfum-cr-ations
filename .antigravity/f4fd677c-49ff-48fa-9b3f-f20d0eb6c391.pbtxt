    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  ShieldCheck, \n  Scale, \n  FileText, \n  Truck, \n  ArrowRight, \n  AlertCircle, \n  Info, \n  Building, \n  Smartphone, \n  Globe, \n  Lock,\n  ChevronDown,\n  Clock,\n  MapPin,\n  CheckCircle,\n  HelpCircle,\n  PiggyBank,\n  AlertTriangle,\n  Heart,\n  Undo2,\n  FileSpreadsheet\n} from \'lucide-react\';\n\ninterface LegalPagesProps {\n  initialSubTab?: string;\n  onNavigateToContact?: () => void;\n}\n\n// ==========================================\n// REUSABLE LEGAL COMPONENTS\n// ==========================================\n\nexport function LegalPageLayout({ children }: { children: React.ReactNode }) {\n  return (\n    <div className=\"max-w-[1000px] mx-auto text-left space-y-8\" id=\"legal-layout-root\">\n      {children}\n    </div>\n  );\n}\n\nexport function LegalHero({ title, subtitle }: { title: string; subtitle: string }) {\n  return (\n    <div className=\"border-b border-brand-pink/15 pb-6 space-y-2 text-left\" id=\"legal-hero-section\">\n      <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream tracking-tight leading-tight\">{title}</h1>\n      <p className=\"text-sm text-brand-text-muted font-light\">{subtitle}</p>\n    </div>\n  );\n}\n\nexport function LegalSection({ id, title, children }: { id?: string; title: string; children: React.ReactNode }) {\n  return (\n    <div id={id} className=\"scroll-mt-24 space-y-3 pb-8 border-b border-brand-pink/10 last:border-b-0 pt-4 text-left\">\n      <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">\n        <span className=\"w-1.5 h-1.5 bg-brand-pink rounded-full shrink-0\" />\n        {title}\n      </h3>\n      <div className=\"text-xs md:text-sm text-brand-text-muted leading-relaxed font-light space-y-3 pl-3.5\">\n        {children}\n      </div>\n    </div>\n  );\n}\n\nexport function LegalInfoList({ items }: { items: { label: string; value: string | React.ReactNode }[] }) {\n  return (\n    <ul className=\"space-y-2 mt-2 font-mono text-[11px] md:text-xs bg-brand-bg/60 border border-brand-pink/5 p-4 rounded-xl\">\n      {items.map((it, idx) => (\n        <li key={idx} className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1 border-b border-brand-pink/5 last:border-b-0 pb-1.5 last:pb-0\">\n          <span className=\"text-brand-text-muted font-medium\">{it.label} :</span>\n          <span className=\"text-brand-pink font-semibold text-right\">{it.value}</span>\n        </li>\n      ))}\n    </ul>\n  );\n}\n\nexport function LegalNoticeBox({ children, type = \'info\' }: { children: React.ReactNode; type?: \'info\' | \'warning\' | \'success\' }) {\n  const styles = {\n    info: \'bg-brand-pink/5 border-brand-pink/20 text-brand-cream\',\n    warning: \'bg-brand-purple/5 border-brand-purple/25 text-brand-cream\',\n    success: \'bg-emerald-500/5 border-emerald-500/20 text-emerald-100\',\n  };\n\n  const icons = {\n    info: <Info className=\"w-4 h-4 text-brand-pink shrink-0\" />,\n    warning: <AlertTriangle className=\"w-4 h-4 text-brand-purple shrink-0\" />,\n    success: <CheckCircle className=\"w-4 h-4 text-emerald-400 shrink-0\" />,\n  };\n\n  return (\n    <div className={`p-4 border rounded-2xl flex gap-3 text-xs leading-relaxed font-light ${styles[type]}`}>\n      {icons[type]}\n      <div>{children}</div>\n    </div>\n  );\n}\n\n// ==========================================\n// CORE LEGAL PAGES EXPORT\n// ==========================================\n\nexport default function LegalPages({ initialSubTab = \'mentions\', onNavigateToContact }: LegalPagesProps) {\n  const [subTab, setSubTab] = useState<string>(initialSubTab);\n  const [activeAccordion, setActiveAccordion] = useState<number | null>(null);\n\n  useEffect(() => {\n    setSubTab(initialSubTab);\n  }, [initialSubTab]);\n\n  const tabs = [\n    { id: \'mentions\', label: \'Mentions L\303\251gales\', icon: <Scale className=\"w-4 h-4\" /> },\n    { id: \'cgv\', label: \'Conditions G\303\251n\303\251rales (CGV)\', icon: <FileText className=\"w-4 h-4\" /> },\n    { id: \'confidentialite\', label: \'Confidentialit\303\251\', icon: <ShieldCheck className=\"w-4 h-4\" /> },\n    { id: \'livraison-retrait\', label: \'Livraison & Retrait\', icon: <Truck className=\"w-4 h-4\" /> }\n  ];\n\n  const handleScrollToSection = (id: string) => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  const cgvSections = [\n    { id: \'cgv-1\', num: \'1\', title: \'Objet\' },\n    { id: \'cgv-2\', num: \'2\', title: \'Produits\' },\n    { id: \'cgv-3\', num: \'3\', title: \'Commandes\' },\n    { id: \'cgv-4\', num: \'4\', title: \'Tarifs & Prix\' },\n    { id: \'cgv-5\', num: \'5\', title: \'Modalit\303\251s de Paiement\' },\n    { id: \'cgv-6\', num: \'6\', title: \'Pr\303\251commande & D\303\251lais\' },\n    { id: \'cgv-7\', num: \'7\', title: \'Livraison & Retrait physique\' },\n    { id: \'cgv-8\', num: \'8\', title: \'Droit de r\303\251tractation\' },\n    { id: \'cgv-9\', num: \'9\', title: \'Produits endommag\303\251s\' },\n    { id: \'cgv-10\', num: \'10\', title: \'Litiges & Droit\' }\n  ];\n\n  return (\n    <div className=\"space-y-10 pb-12\" id=\"legal-pages-view\">\n      \n      {/* Tab Navigation header */}\n      <div className=\"flex flex-wrap justify-center gap-2 border-b border-brand-pink/10 pb-6\">\n        {tabs.map((tab) => (\n          <button\n            key={tab.id}\n            onClick={() => {\n              setSubTab(tab.id);\n              window.scrollTo({ top: 300, behavior: \'smooth\' });\n            }}\n            className={`px-4 md:px-5 py-2.5 rounded-full text-xs font-semibold tracking-wide flex items-center gap-2 transition-all cursor-pointer ${\n              subTab === tab.id \n                ? \'bg-brand-pink text-brand-bg shadow-md\' \n                : \'bg-brand-depth/60 text-brand-text-muted border border-brand-pink/5 hover:border-brand-pink/30 hover:text-brand-cream\'\n            }`}\n          >\n            {tab.icon}\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Main Container */}\n      <div className=\"max-w-5xl mx-auto\">\n        <LegalPageLayout>\n          \n          {/* ==========================================\n              TAB 1 : MENTIONS L\303\211GALES\n              ========================================== */}\n          {subTab === \'mentions\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-10 shadow-xl space-y-6\"\n            >\n              <LegalHero \n                title=\"Mentions l\303\251gales\" \n                subtitle=\"Informations relatives \303\240 l\342\200\231\303\251diteur, \303\240 l\342\200\231h\303\251bergement et \303\240 l\342\200\231utilisation du site.\" \n              />\n\n              <LegalSection title=\"1. \303\211diteur de l\'Atelier\">\n                <p>\n                  Ce site internet est l\342\200\231enseigne collective de pr\303\251sentation de notre manufacture artisanale. Ses activit\303\251s commerciales d\'art et vente assist\303\251e de bougies et fondants sont repr\303\251sent\303\251es individuellement par :\n                </p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Nom de l\'Enseigne\", value: \"R\303\252ve Parfum\303\251 Cr\303\251ation\" },\n                    { label: \"Responsable n\302\2601\", value: \"M\303\251lanie G. (Atelier d\'harmonie saine)\" },\n                    { label: \"Responsable n\302\2602\", value: \"Christelle L. (Atelier style & contenants)\" },\n                    { label: \"Statut l\303\251gal\", value: \"Micro-entreprises \303\240 confirmer\" },\n                    { label: \"SIRET M\303\251lanie\", value: \"[\303\200 compl\303\251ter pour M\303\251lanie]\" },\n                    { label: \"SIRET Christelle\", value: \"[\303\200 compl\303\251ter pour Christelle]\" },\n                    { label: \"Adresse de l\'Atelier\", value: \"[\303\200 compl\303\251ter pour l\'Atelier en Bourgogne]\" },\n                    { label: \"Adresse \303\211lectronique\", value: \"contact@reveparfume.fr\" },\n                    { label: \"T\303\251l\303\251phone direct\", value: \"[\303\200 compl\303\251ter si affich\303\251]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              <LegalSection title=\"2. Responsable de la Publication\">\n                <p>Le pilotage \303\251ditorial, la curation des photographies et la conformit\303\251 s\303\251mantique de notre catalogue de cire florale sont assur\303\251s par :</p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Nom du directeur de publication\", value: \"[\303\200 compl\303\251ter]\" },\n                    { label: \"Adresse de contact direct\", value: \"[\303\200 compl\303\251ter]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              <LegalSection title=\"3. H\303\251bergement du Domaine\">\n                <p>Le sillage technique et les flux visuels du site sont conserv\303\251s de mani\303\250re \303\251cologique aupr\303\250s de :</p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Nom de l\'H\303\251bergeur\", value: \"[\303\200 compl\303\251ter]\" },\n                    { label: \"Adresse physique postale\", value: \"[\303\200 compl\303\251ter]\" },\n                    { label: \"Site internet officiel\", value: \"[\303\200 compl\303\251ter]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              <LegalSection title=\"4. Propri\303\251t\303\251 Intellectuelle\">\n                <p className=\"font-light\">\n                  Les contenus du site, textes, photos, cr\303\251ations, visuels et \303\251l\303\251ments graphiques sont prot\303\251g\303\251s. Toute reproduction non autoris\303\251e est interdite.\n                </p>\n                <p className=\"text-[11px] italic text-brand-text-muted/80\">\n                  Chaque ornement de fleurs s\303\251ch\303\251es, chaque moulin c\303\251ramique d\'art, et chaque sillage de mots d\303\251crivant les essences aromatiques sont n\303\251s sous les doigts des cr\303\251atrices et sont r\303\251gis par le droit de la propri\303\251t\303\251 litt\303\251raire et artistique.\n                </p>\n              </LegalSection>\n\n              <LegalSection title=\"5. Responsabilit\303\251\">\n                <p className=\"font-light\">\n                  Les informations pr\303\251sentes sur le site peuvent \303\251voluer. Les commandes, prix finaux, frais de livraison et d\303\251lais sont confirm\303\251s avant paiement.\n                </p>\n                <LegalNoticeBox type=\"info\">\n                  <strong>Validation Humaine Obligatoire :</strong> R\303\252ve Parfum\303\251 Cr\303\251ation ne r\303\251alise aucun encaissement automatique ou transaction bancaire brute sans discussion et conseil assist\303\251 en amont.\n                </LegalNoticeBox>\n              </LegalSection>\n\n              <div className=\"pt-6 border-t border-brand-pink/10 flex flex-col sm:flex-row justify-between items-center gap-4\">\n                <p className=\"text-xs text-brand-text-muted/80 font-light\">\n                  Besoin de clarifier un point l\303\251gal ou d\'obtenir un re\303\247u pour vos cadeaux corporatifs ?\n                </p>\n                <button\n                  onClick={onNavigateToContact}\n                  className=\"px-5 py-2.5 rounded-full bg-brand-pink/10 hover:bg-brand-pink text-brand-pink hover:text-brand-bg text-[11px] font-bold tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer hover:-translate-y-0.5 shrink-0\"\n                >\n                  Nous contacter\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {/* ==========================================\n              TAB 2 : CONDITIONS G\303\211N\303\211RALES DE VENTRE (CGV)\n              ========================================== */}\n          {subTab === \'cgv\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\"\n            >\n              {/* Sticky Sidebar (Sommaire) for CGV Desktop / Compact for Mobile */}\n              <div className=\"lg:col-span-4 lg:sticky lg:top-24 space-y-4\">\n                <div className=\"bg-brand-depth border border-brand-pink/10 rounded-[24px] p-5 space-y-4\">\n                  <h3 className=\"font-serif font-bold text-sm text-brand-cream border-b border-brand-pink/5 pb-2\">\n                    Sommaire des CGV\n                  </h3>\n                  <div className=\"flex flex-col gap-1.5 text-xs\">\n                    {cgvSections.map((sec) => (\n                      <button\n                        key={sec.id}\n                        onClick={() => handleScrollToSection(sec.id)}\n                        className=\"py-1.5 px-2.5 rounded-lg text-left text-brand-text-muted hover:text-brand-pink hover:bg-brand-pink/5 transition-all flex items-center gap-2 font-mono text-[11px]\"\n                      >\n                        <span className=\"text-brand-pink font-bold w-4 shrink-0\">{sec.num}.</span>\n                        <span>{sec.title}</span>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                <div className=\"p-4 bg-brand-pink/5 border border-brand-pink/10 rounded-2xl text-[11px] text-brand-text-muted leading-relaxed font-light text-left\">\n                  \360\237\244\235 <strong>Dialogue d\'atelier :</strong> Nos ventes se font de gr\303\251 \303\240 gr\303\251 apr\303\250s validation de vos go\303\273ts sur WhatsApp. Les CGV servent \303\240 garantir un cadre s\303\251curisant pour vous et pour nous !\n                </div>\n              </div>\n\n              {/* Main CGV Content Cards */}\n              <div className=\"lg:col-span-8 bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl\">\n                <LegalHero \n                  title=\"Conditions G\303\251n\303\251rales de Vente\" \n                  subtitle=\"Les pr\303\251sentes conditions encadrent les commandes pass\303\251es aupr\303\250s de R\303\252ve Parfum\303\251 Cr\303\251ation.\" \n                />\n\n                {/* Section 1 */}\n                <LegalSection id=\"cgv-1\" title=\"1. Objet\">\n                  <p>\n                    Les pr\303\251sentes Conditions G\303\251n\303\251rales de Vente (CGV) encadrent en exclusivit\303\251 la vente de cr\303\251ations parfum\303\251es v\303\251g\303\251tales artisanales et de contenants d\'art en Bourgogne, propos\303\251es sous l\'enseigne commune <strong className=\"text-brand-cream\">R\303\252ve Parfum\303\251 Cr\303\251ation</strong> par Christelle L. et M\303\251lanie G.\n                  </p>\n                  <p>\n                    Toute passation de projet ou validation de cire suppose l\'acceptation enti\303\250re et sans r\303\251serve des pr\303\251sentes conditions, qui r\303\251gissent au mieux notre relation de confiance de gr\303\251 \303\240 gr\303\251.\n                  </p>\n                </LegalSection>\n\n                {/* Section 2 */}\n                <LegalSection id=\"cgv-2\" title=\"2. Produits &amp; Artisanat\">\n                  <p>\n                    Chacun de nos articles est une \305\223uvre d\'origine humaine faite main. Nous fabriquons des bougies, fondants, bouquets parfum\303\251s, cadres suspendus, suspensions, brumes et poudres, principalement \303\240 base de cire pure de soja saine et de fleurs d\'atelier.\n                  </p>\n                  <ul className=\"list-disc pl-5 space-y-1 mt-1 text-[11px] md:text-xs\">\n                    <li><strong>Variations Possibles :</strong> Du fait de notre proc\303\251d\303\251 non automatis\303\251, de l\303\251g\303\250res diff\303\251rences de teintes, d\'\303\251paisseur de gr\303\250s ou d\'agencement floraux botaniques surviennent \303\240 chaque coulage.</li>\n                    <li><strong>Photos Non-Contractuelles :</strong> Les photos du site sont pr\303\251sent\303\251es de la mani\303\250re la plus digne mais ne garantissent pas un aspect identique \303\240 100 %.</li>\n                    <li><strong>Personnalisations :</strong> Elles sont soumises \303\240 la faisabilit\303\251 technique et aux stocks de mati\303\250res botaniques de saison.</li>\n                  </ul>\n                </LegalSection>\n\n                {/* Section 3 */}\n                <LegalSection id=\"cgv-3\" title=\"3. Commandes\">\n                  <p>\n                    Conform\303\251ment au positionnement humain de l\'atelier, la validation s\'effectue par messagerie instantan\303\251e (WhatsApp) ou par formulaire de contact d\'\303\251criture :\n                  </p>\n                  <ul className=\"list-decimal pl-5 space-y-1 mt-1 text-[11px] md:text-xs\">\n                    <li>Prise de contact de l\'acheteur avec formulation de ses envies sp\303\251cifiques.</li>\n                    <li>\303\211change direct sur les essences parfum\303\251es de Grasse adapt\303\251es \303\240 son projet d\'int\303\251rieur.</li>\n                    <li>D\303\251livrance d\'un r\303\251capitulatif d\303\251taill\303\251 d\'atelier valider d\'un commun accord.</li>\n                    <li>La commande est consid\303\251r\303\251e ferme d\303\250s accord mutuel et validation du montant d\'attention, avec mise en production du coulage.</li>\n                  </ul>\n                </LegalSection>\n\n                {/* Section 4 */}\n                <LegalSection id=\"cgv-4\" title=\"4. Tarifs &amp; Prix\">\n                  <p>\n                    Les prix de nos cr\303\251ations de cire saine et suspensions sont exprim\303\251s en Euros (\342\202\254) et sont nets. TVA non applicable, en vertu de l\342\200\231article 293 B du Code G\303\251n\303\251ral des Imp\303\264ts (r\303\251gime micro-entreprises).\n                  </p>\n                  <p>\n                    Les frais de livraison et d\'emballage postal amortis sont factur\303\251s en suppl\303\251ment \303\240 prix co\303\273tant selon le mode d\'exp\303\251dition (Colissimo, Mondial Relay) convenu. Les devis \303\251v\303\251nements (mariages, comm\303\251morations) proposent des tarifs d\303\251gressifs selon les volumes.\n                  </p>\n                </LegalSection>\n\n                {/* Section 5 */}\n                <LegalSection id=\"cgv-5\" title=\"5. Modalit\303\251s de Paiement\">\n                  <p>\n                    Le r\303\250glement de vos cr\303\251ations s\'effectue \303\240 l\'aide des passerelles d\303\251sign\303\251es lors de l\'\303\251change amiable :\n                  </p>\n                  <ul className=\"list-disc pl-5 space-y-1 mt-1\">\n                    <li><strong>PayPal :</strong> Transfert s\303\251curis\303\251 de fonds entre particuliers ou professionnels.</li>\n                    <li><strong>Wero / Paylib / Virement imm\303\251diat :</strong> Solution directe sans frais pour nos clients.</li>\n                  </ul>\n                  <LegalNoticeBox type=\"warning\">\n                    <strong>R\303\250gle d\'Atelier :</strong> <code>[Pr\303\251ciser acompte ou paiement total avant fabrication]</code>. Par d\303\251faut, pour les s\303\251ries de f\303\252tes ou cadeaux personnalis\303\251s d\'invit\303\251s, un paiement complet ou d\'acompte de 50% est requis avant l\'incorporation des huiles de Grasse et le coulage d\303\251coratif des cires de soja.\n                  </LegalNoticeBox>\n                </LegalSection>\n\n                {/* Section 6 */}\n                <LegalSection id=\"cgv-6\" title=\"6. Pr\303\251commande &amp; D\303\251lais\">\n                  <p>\n                    Afin d\'offrir la plus saine et fra\303\256che des exp\303\251riences d\'effluves, nous ne conservons pas d\'important stock industriel. Les produits sont fabriqu\303\251s ou pr\303\251par\303\251s sur commande.\n                  </p>\n                  <p>\n                    Le d\303\251lai moyen d\'ex\303\251cution d\342\200\231environ deux semaines est \303\240 pr\303\251voir pour le s\303\251chage lent. Lors des f\303\252tes de fin d\'ann\303\251e ou des c\303\251r\303\251monies rituelles d\'\303\251t\303\251, ce sillage de fabrication artisanale peut \303\252tre prolong\303\251.\n                  </p>\n                </LegalSection>\n\n                {/* Section 7 */}\n                <LegalSection id=\"cgv-7\" title=\"7. Livraison &amp; Retrait physique\">\n                  <p>\n                    Les exp\303\251ditions se coordonnent avec grand soin. Nos conditions logistiques pr\303\251cisent :\n                  </p>\n                  <ul className=\"list-disc pl-5 space-y-1 text-[11px] md:text-xs\">\n                    <li><strong>P\303\251riode Postale :</strong> Les colis d\'envois ne circulent que de d\'<strong>octobre \303\240 mars</strong> pour prot\303\251ger la cire naturelle \303\240 basse fusion des fortes temp\303\251ratures estivales.</li>\n                    <li><strong>Retrait sur Rendez-vous :</strong> Durant les p\303\251riodes chaudes d\'avril \303\240 septembre (ou toute l\'ann\303\251e pour les voisins), le retrait direct et gracieux \303\240 l\'atelier bourguignon est vivement recommand\303\251.</li>\n                  </ul>\n                </LegalSection>\n\n                {/* Section 8 */}\n                <LegalSection id=\"cgv-8\" title=\"8. Droit de r\303\251tractation\">\n                  <p>\n                    Conform\303\251ment aux directives de l\'article L221-18 du Code de la consommation, l\'acheteur dispose d\'un droit de 14 jours pour retourner une cr\303\251ation ordinaire, \303\240 ses frais exclusifs, dans son \303\251tat de scell\303\251 originel de cire.\n                  </p>\n                  <LegalNoticeBox type=\"warning\">\n                    <strong>Exception l\303\251gale importante :</strong> Les produits personnalis\303\251s ou fabriqu\303\251s selon les sp\303\251cifications claires du client (\303\251tiquettes d\'\303\251v\303\251nement, inscriptions grav\303\251es, m\303\251langes exclusifs de fleurs) sont exclus de tout droit de r\303\251tractation et d\'\303\251change, sauf anomalie due \303\240 l\'atelier. Cette section est fournie sous r\303\251serve de validation juridique r\303\251ciproque.\n                  </LegalNoticeBox>\n                </LegalSection>\n\n                {/* Section 9 */}\n                <LegalSection id=\"cgv-9\" title=\"9. Produits endommag\303\251s\">\n                  <p>\n                    \303\200 la r\303\251ception, si votre contenant en c\303\251ramique d\'art ou votre cadre de cire solide a subi des heurts postaux :\n                  </p>\n                  <ul className=\"list-disc pl-5 space-y-1\">\n                    <li>Prendre des photos nettes et imm\303\251diates du colis ouvert ainsi que des d\303\251gradations de la pi\303\250ce.</li>\n                    <li>Nous transmettre le dossier sous 48h sur WhatsApp.</li>\n                    <li>Chaque incident fera l\'objet d\'une analyse amicale au cas par cas pour un remplacement de sillage ou un remboursement.</li>\n                  </ul>\n                </LegalSection>\n\n                {/* Section 10 */}\n                <LegalSection id=\"cgv-10\" title=\"10. Litiges &amp; Droit applicable\">\n                  <p>\n                    Les pr\303\251sentes CGV d\'artisanat sont r\303\251gies par la loi fran\303\247aise. En cas de discorde ou d\'insatisfaction :\n                  </p>\n                  <p>\n                    Une solution amiable et respectueuse est toujours privil\303\251gi\303\251e en premier ressort. \303\200 d\303\251faut d\'accord direct, le litige sera soumis \303\240 la m\303\251diation ou port\303\251 devant les tribunaux comp\303\251tents de la juridiction de l\'atelier du vendeur.\n                  </p>\n                </LegalSection>\n\n                {/* Interactive CTA */}\n                <div className=\"pt-6 border-t border-brand-pink/10 flex flex-col md:flex-row justify-between items-center gap-4 text-left\">\n                  <div className=\"space-y-1 text-xs\">\n                    <p className=\"text-brand-cream font-serif font-bold\">Un projet sp\303\251cial en Bourgogne ?</p>\n                    <p className=\"text-brand-text-muted font-light leading-relaxed\">Les commandes de mariages exigent au moins un mois d\'anticipation avant la date.</p>\n                  </div>\n                  <button\n                    onClick={onNavigateToContact}\n                    className=\"px-6 py-3 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer shadow hover:-translate-y-0.5 shrink-0\"\n                  >\n                    Nous \303\251crire sur WhatsApp\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n\n              </div>\n            </motion.div>\n          )}\n\n          {/* ==========================================\n              TAB 3 : POLITIQUE DE CONFIDENTIALIT\303\211\n              ========================================== */}\n          {subTab === \'confidentialite\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-10 shadow-xl space-y-6\"\n            >\n              <LegalHero \n                title=\"Politique de confidentialit\303\251\" \n                subtitle=\"Cette page explique comment vos donn\303\251es sont utilis\303\251es dans le cadre des demandes, commandes et \303\251changes avec R\303\252ve Parfum\303\251 Cr\303\251ation.\" \n              />\n\n              <LegalSection title=\"1. Donn\303\251es collect\303\251es de bon usage\">\n                <p>\n                  Dans le cadre strict de l\'organisation artisanale de l\'Atelier, nous ne collectons que les informations indispensables pour \303\251laborer votre sillage parfum\303\251 de cire bio. Ces donn\303\251es incluent :\n                </p>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2\">\n                  <div className=\"p-4 bg-brand-bg/50 border border-brand-pink/5 rounded-xl text-xs space-y-1\">\n                    <strong className=\"text-brand-cream\">Donn\303\251es Civiles :</strong>\n                    <p className=\"text-[11px] text-brand-text-muted\">Nom, pr\303\251nom et coordonn\303\251es de contact choisis pour formuler votre nom sur les colis.</p>\n                  </div>\n                  <div className=\"p-4 bg-brand-bg/50 border border-brand-pink/5 rounded-xl text-xs space-y-1\">\n                    <strong className=\"text-brand-cream\">Sillage Postal :</strong>\n                    <p className=\"text-[11px] text-brand-text-muted\">Adresse postale de votre demeure pour g\303\251n\303\251rer les bordereaux Colissimo ou Mondial Relay.</p>\n                  </div>\n                  <div className=\"p-4 bg-brand-bg/50 border border-brand-pink/5 rounded-xl text-xs space-y-1\">\n                    <strong className=\"text-brand-cream\">Dialogue d\'Atelier :</strong>\n                    <p className=\"text-[11px] text-brand-text-muted\">Notes de nos \303\251changes de personnalisation et de s\303\251lections aromatiques sur WhatsApp.</p>\n                  </div>\n                  <div className=\"p-4 bg-brand-bg/50 border border-brand-pink/5 rounded-xl text-xs space-y-1\">\n                    <strong className=\"text-brand-cream\">Coordonn\303\251es de Facturation :</strong>\n                    <p className=\"text-[11px] text-brand-text-muted\">D\303\251tails des r\303\250glements confirm\303\251s (historique d\'acompte, dates, types de soutien).</p>\n                  </div>\n                </div>\n              </LegalSection>\n\n              <LegalSection title=\"2. Finalit\303\251s du Traitement\">\n                <p>Les donn\303\251es que vous choisissez de nous confier sont trait\303\251es aux fins uniques de :</p>\n                <ol className=\"list-decimal pl-5 space-y-1 mt-1 text-[11px] md:text-xs\">\n                  <li>R\303\251pondre chaleureusement \303\240 vos interrogations de fragrances et fabriquer vos cires de soja sur-mesure ;</li>\n                  <li>Pr\303\251parer les colis et assurer le sillage postal de livraison ou de retrait \303\240 notre domicile de Bourgogne ;</li>\n                  <li>\303\211mettre les devis \303\251v\303\251nementiels ou d\'ateliers \303\240 domicile ;</li>\n                  <li>Conserver l\'historique commercial n\303\251cessaire aux obligations comptables de nos micro-entreprises.</li>\n                </ol>\n              </LegalSection>\n\n              <LegalSection title=\"3. Services Tiers &amp; Partenaires\">\n                <p>\n                  Pour donner vie \303\240 notre sillage en ligne, nous utilisons des outils de confiance. Voici les prestataires qui peuvent avoir acc\303\250s \303\240 un fragment d\'information :\n                </p>\n                <LegalInfoList \n                  items={[\n                    { label: \"Canal \303\211changes\", value: \"WhatsApp (Meta Platforms, Inc.) - [\303\200 confirmer]\" },\n                    { label: \"Paiement direct\", value: \"PayPal de gr\303\251 \303\240 gr\303\251 / Paylib pour le virement\" },\n                    { label: \"Flux Logistiques\", value: \"La Poste / Colissimo et Mondial Relay\" },\n                    { label: \"H\303\251bergement\", value: \"Cloud Run / Services d\'atelier d\'art [\303\200 confirmer]\" }\n                  ]}\n                />\n              </LegalSection>\n\n              <LegalSection title=\"4. Engagement de Non-Cession\">\n                <p className=\"font-semibold text-brand-cream\">\n                  Vos donn\303\251es ne sont jamais revendues, lou\303\251es, ni c\303\251d\303\251es \303\240 des fins mercantiles \303\240 des entreprises de publicit\303\251.\n                </p>\n                <p>\n                  Elles sont gard\303\251es pr\303\251cieusement au sein de nos messageries de mani\303\250re confidentielle et ne circulent que pour mat\303\251rialiser vos commandes de fondants et c\303\251ramiques.\n                </p>\n              </LegalSection>\n\n              <LegalSection title=\"5. Droits RGPD de la Client\303\250le\">\n                <p>\n                  En conformit\303\251 avec le R\303\250glement G\303\251n\303\251ral sur la Protection des Donn\303\251es (RGPD), vous disposez \303\240 tout moment de droits de regard souverains sur vos informations :\n                </p>\n                <ul className=\"list-disc pl-5 space-y-1 text-[11px] md:text-xs\">\n                  <li>Droit d\'acc\303\250s et d\'obtention de la copie de vos \303\251changes ;</li>\n                  <li>Droit de modification ou de rectification des adresses erron\303\251es ;</li>\n                  <li>Droit de suppression de vos donn\303\251es de contact de notre r\303\251pertoire d\'atelier ;</li>\n                  <li>Droit de limitation de nos discussions.</li>\n                </ul>\n                <p className=\"mt-2 text-[11px]\">\n                  Pour exercer ces droits, vous pouvez nous \303\251crire de fa\303\247on fraternelle \303\240 notre email RGPD : <strong className=\"text-brand-pink\">contact@reveparfume.fr</strong> ou via notre fil WhatsApp d\'atelier.\n                </p>\n              </LegalSection>\n\n              <LegalSection title=\"6. Gestion des Cookies\">\n                <p>\n                  Le site utilise uniquement les cookies n\303\251cessaires \303\240 son fonctionnement. Aucun cookie publicitaire intrusif n\342\200\231est dispos\303\251 en arri\303\250re-plan.\n                </p>\n                <LegalNoticeBox type=\"info\">\n                  <strong>Mesures d\342\200\231audience :</strong> Si un module d\'analyse d\'audience (type Google Analytics) venait \303\240 \303\252tre branch\303\251 sur notre vitrine artisanale, un bandeau de consentement conforme et gracieux verra le jour afin de recueillir respectueusement vos choix.\n                </LegalNoticeBox>\n              </LegalSection>\n\n              <div className=\"pt-6 border-t border-brand-pink/10 text-center\">\n                <p className=\"text-[11px] text-brand-text-muted italic\">\n                  Derni\303\250re mise \303\240 jour de notre sillage de confidentialit\303\251 faite avec amour : 28 mai 2026.\n                </p>\n              </div>\n\n            </motion.div>\n          )}\n\n          {/* ==========================================\n              TAB 4 : POLITIQUE LIVRAISON / RETRAIT\n              ========================================== */}\n          {subTab === \'livraison-retrait\' && (\n            <motion.div \n              initial={{ opacity: 0, y: 12 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-10 shadow-xl space-y-6\"\n            >\n              <LegalHero \n                title=\"Politique de livraison et de retrait\" \n                subtitle=\"Retrouvez les conditions de pr\303\251paration, d\342\200\231envoi et de retrait des cr\303\251ations R\303\252ve Parfum\303\251 Cr\303\251ation.\" \n              />\n\n              {/* 1. Pr\303\251paration des commandes */}\n              <LegalSection title=\"1. Pr\303\251paration exigeante des commandes\">\n                <p>\n                  La fabrication d\'une bougie ou d\'un cadre suspendu \303\240 l\'atelier est un geste lent qui s\'\303\251labore \303\240 la commande. Apr\303\250s coulage et incrustation de fleurs s\303\251ch\303\251es, la cire de soja bio exige une p\303\251riode de cure d\'environ deux semaines pour lier les fragrances v\303\251g\303\251tales de Grasse. \n                </p>\n                <p>\n                  Il convient donc de prendre en compte ce d\303\251lai moyen d\'environ deux semaines de cure avant de planifier la remise de vos cadeaux ou d\303\251corations de tables.\n                </p>\n              </LegalSection>\n\n              {/* 2. Envois */}\n              <LegalSection title=\"2. Envois postaux saisonniers (Octobre \303\240 Mars)\">\n                <p>\n                  Notre cire pure de soja ne contient pas d\'additif paraffineux p\303\251trochimique dur. Elle a donc un point de fusion bas, ce qui la rend sensible \303\240 la chaleur estivale des camions postaux.\n                </p>\n                <p className=\"font-semibold text-brand-cream\">\n                  Afin de pr\303\251server l\'\303\251l\303\251gance de nos herbiers botaniques et des reliefs de cire, les colis d\'exp\303\251dition ne sont pris en charge que d\'octobre \303\240 mars.\n                </p>\n                <p>\n                  Les envois se font en France m\303\251tropolitaine selon faisabilit\303\251. Les bo\303\256tes sont exp\303\251di\303\251es garnies de capitonnage biod\303\251gradable afin qu\'aucun flacon de verre ou bord de gr\303\250s c\303\251ramique ne souffre de l\'acheminement.\n                </p>\n              </LegalSection>\n\n              {/* 3. Retrait \303\240 domicile */}\n              <LegalSection title=\"3. Retrait physique \303\240 notre Atelier en Bourgogne\">\n                <p>\n                  Durant les p\303\251riodes d\'ensoleillement d\'avril \303\240 septembre (hors-envois postaux) ou \303\240 tout moment pour les clients voisins, nous privil\303\251gions la convivialit\303\251 du retrait direct.\n                </p>\n                <ul className=\"list-disc pl-5 space-y-1\">\n                  <li><strong>Sur Rendez-vous :</strong> Le cr\303\251neau d\'accueil est convenu souplement avec vous via WhatsApp ;</li>\n                  <li><strong>Pr\303\251cision G\303\251ographique :</strong> Notre adresse professionnelle est partag\303\251e chaleureusement lors du r\303\251capitulatif de commande ;</li>\n                  <li><strong>Pr\303\251f\303\251rence estivale :</strong> Le retrait direct est le meilleur moyen d\'obtenir vos bouquets suspendus d\'\303\251t\303\251 en parfait \303\251tat.</li>\n                </ul>\n              </LegalSection>\n\n              {/* 4. Frais de livraison (Cost Table Matching prompt requirements) */}\n              <LegalSection title=\"4. Frais de livraison \303\240 prix co\303\273tant\">\n                <p>\n                  Les frais de distribution d\303\251pendent strictement des grilles r\303\251elles de poids global de vos cr\303\251ations (Colissimo, Mondial Relay). Ils sont confirm\303\251s d\'un commun accord lors de notre discussion avant que vous ne concr\303\251tisiez votre paiement.\n                </p>\n                \n                {/* Visual table placeholder to show transparent shipping cost estimation */}\n                <div className=\"overflow-x-auto rounded-2xl border border-brand-pink/15 bg-brand-bg/40 mt-3\">\n                  <table className=\"w-full text-left font-mono text-[11px] leading-relaxed\">\n                    <thead>\n                      <tr className=\"bg-brand-pink/10 text-brand-pink border-b border-brand-pink/15\">\n                        <th className=\"p-3.5 font-bold uppercase tracking-wider font-sans\">Cat\303\251gorie Cr\303\251ation</th>\n                        <th className=\"p-3.5 font-bold uppercase tracking-wider font-sans\">Poids Moyen</th>\n                        <th className=\"p-3.5 font-bold uppercase tracking-wider font-sans\">Transporteur</th>\n                        <th className=\"p-3.5 font-bold uppercase tracking-wider font-sans\">Frais Estim\303\251s</th>\n                      </tr>\n                    </thead>\n                    <tbody className=\"divide-y divide-brand-pink/5 text-brand-text-muted\">\n                      <tr className=\"hover:bg-brand-pink/5 transition-colors\">\n                        <td className=\"p-3.5 font-semibold text-brand-cream\">S\303\251rie Fondants / Suspensions</td>\n                        <td className=\"p-3.5\">~100g - 300g</td>\n                        <td className=\"p-3.5\">Mondial Relay</td>\n                        <td className=\"p-3.5 text-brand-pink\">\303\200 confirmer selon volume</td>\n                      </tr>\n                      <tr className=\"hover:bg-brand-pink/5 transition-colors\">\n                        <td className=\"p-3.5 font-semibold text-brand-cream\">Bougies C\303\251ramiques d\'art / Cadres</td>\n                        <td className=\"p-3.5\">~400g - 1.2kg</td>\n                        <td className=\"p-3.5\">Colissimo / Mondial Relay</td>\n                        <td className=\"p-3.5 text-brand-pink\">\303\200 confirmer selon gr\303\250s</td>\n                      </tr>\n                      <tr className=\"hover:bg-brand-pink/5 transition-colors\">\n                        <td className=\"p-3.5 font-semibold text-brand-cream\">Coffret Cadeaux Fleuris / \303\211v\303\251nement</td>\n                        <td className=\"p-3.5\">Variable (&gt; 1.5kg)</td>\n                        <td className=\"p-3.5\">Colissimo Suivi</td>\n                        <td className=\"p-3.5 text-brand-pink\">Calcul\303\251 \303\240 prix d\342\200\231atelier net</td>\n                      </tr>\n                    </tbody>\n                  </table>\n                </div>\n                <p className=\"text-[10px] italic text-brand-text-muted/70 mt-1.5\">\n                  Remarque : Les tarifs exacts Colissimo en vigueur au guichet postal sont appliqu\303\251s sans marge cach\303\251e afin de garantir la transparence.\n                </p>\n              </LegalSection>\n\n              {/* 5. D\303\251lais transporteur */}\n              <LegalSection title=\"5. D\303\251lais transporteur indicatifs\">\n                <p>\n                  Les d\303\251lais d\'acheminement \303\240 partir de la remise postale (g\303\251n\303\251ralement 48h \303\240 72h ouvr\303\251s pour Colissimo et 3 \303\240 5 jours pour Mondial Relay) ne d\303\251pendent pas de R\303\252ve Parfum\303\251 Cr\303\251ation. Bien que nous suivions chaque envoi, nous ne pouvons \303\252tre tenues pour responsables des lenteurs internes des services postaux.\n                </p>\n              </LegalSection>\n\n              {/* 6. En cas de colis ab\303\256m\303\251 */}\n              <LegalSection title=\"6. Proc\303\251dure pour colis ou verre ab\303\256m\303\251\">\n                <p>\n                  Si votre flacon ambr\303\251 ou contenant c\303\251ramique arrivait bris\303\251 malgr\303\251 la qualit\303\251 de notre double matelassage :\n                </p>\n                <div className=\"space-y-2 mt-2 bg-brand-bg/60 border border-brand-pink/10 p-4 rounded-xl text-xs font-light\">\n                  <p>\360\237\223\270 <strong>\303\211tape 1 :</strong> Photographiez imm\303\251diatement l\'\303\251tiquette d\'envoi et les bris \303\240 l\'int\303\251rieur de la bo\303\256te avant d\303\251ballage complet.</p>\n                  <p>\360\237\222\254 <strong>\303\211tape 2 :</strong> Alertez-nous sous 48 heures maximum sur notre fil WhatsApp avec ces pi\303\250ces d\'illustration.</p>\n                  <p>\360\237\244\215 <strong>\303\211tape 3 :</strong> Nous \303\251tudierons de fa\303\247on amicale un recoulage s\'il s\'agit d\'une pi\303\250ce personnalis\303\251e ou un remboursement s\'il y a lieu.</p>\n                </div>\n              </LegalSection>\n\n              {/* 7. Responsabilit\303\251 transport */}\n              <LegalSection title=\"7. Responsabilit\303\251 transport &amp; Suivi\">\n                <p>\n                  R\303\252ve Parfum\303\251 Cr\303\251ation pr\303\251pare chaque colis de cire saine avec le plus grand soin et conserve des captures ou courts enregistrements d\'atelier lors du scellage pour \303\251carter tout litige d\'oubli d\'\303\251tiquette. Une fois le colis remis au bureau de poste, les incidents li\303\251s \303\240 la manutention sont couverts et \303\251tudi\303\251s selon les conditions g\303\251n\303\251rales de vente du transporteur concern\303\251.\n                </p>\n              </LegalSection>\n\n              <div className=\"pt-6 border-t border-brand-pink/10 text-center\">\n                <button\n                  onClick={onNavigateToContact}\n                  className=\"px-6 py-3 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all inline-flex items-center gap-1.5 cursor-pointer shadow hover:-translate-y-0.5\"\n                >\n                  Contacter l\342\200\231atelier pour d\'autres questions\n                  <ArrowRight className=\"w-3.5 h-3.5 text-brand-bg\" />\n                </button>\n              </div>\n\n            </motion.div>\n          )}\n\n        </LegalPageLayout>\n      </div>\n\n    </div>\n  );\n}\n"
    }
