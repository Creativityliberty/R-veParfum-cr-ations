  file_change {
    absolute_path_uri: "file:///src/components/AboutPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Heart, \n  Sparkles, \n  MessageSquare, \n  ArrowRight, \n  Check, \n  Award, \n  Flame, \n  Droplet, \n  Compass, \n  Leaf, \n  ShieldCheck, \n  PenTool, \n  PackageOpen, \n  Camera,\n  Users\n} from \'lucide-react\';\n\ninterface AboutPageProps {\n  onNavigateToBoutique?: () => void;\n  onNavigateToContact?: () => void;\n}\n\nexport default function AboutPage({ onNavigateToBoutique, onNavigateToContact }: AboutPageProps) {\n  \n  const values = [\n    {\n      title: \"Naturel\",\n      desc: \"De la pure cire de soja v\303\251g\303\251tale 100% biod\303\251gradable, exempte de d\303\251riv\303\251s p\303\251trochimiques ou paraffine, et des m\303\250ches en coton non trait\303\251 ou en bois cr\303\251pitant.\",\n      icon: <Leaf className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Fait Main\",\n      desc: \"Chaque cr\303\251ation est coul\303\251e, par\303\251e de botaniques et \303\251tiquet\303\251e manuellement par Christelle et M\303\251lanie au c\305\223ur de la Bourgogne.\",\n      icon: <Award className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Soin du D\303\251tail\",\n      desc: \"Des \303\251tiquettes calligraphi\303\251es avec d\303\251licatesse, des rubans de lin v\303\251ritable et une finition parfum\303\251e soign\303\251e pour un d\303\251ballage inoubliable.\",\n      icon: <Sparkles className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Personnalisation\",\n      desc: \"Ajustez les harmonies chromatiques, s\303\251lectionnez vos fragrances pr\303\251f\303\251r\303\251es et gravez vos messages pour donner vie \303\240 un objet d\'\303\251motion.\",\n      icon: <Compass className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Senteurs Durables\",\n      desc: \"Une saine saturation en concentr\303\251s exclusifs de Grasse garantit une diffusion d\'effluves prolong\303\251e et homog\303\250ne durant plusieurs mois.\",\n      icon: <ShieldCheck className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      title: \"Cadeau \303\211motionnel\",\n      desc: \"Une invitation au ralentissement et \303\240 l\'\303\251corce des sens. Offrir nos cires, c\'est offrir un fragment de douceur suspendu dans le temps.\",\n      icon: <Heart className=\"w-5 h-5 text-brand-pink\" />\n    }\n  ];\n\n  const steps = [\n    {\n      num: \"1\",\n      title: \"Curation olfactive\",\n      desc: \"S\303\251lection rigoureuse des plus nobles essences de Grasse. Les accords de t\303\252te, de c\305\223ur et de fond sont test\303\251s pour s\'unir sans aucune substance CMR.\",\n      icon: <Droplet className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      num: \"2\",\n      title: \"Coulage d\'\303\251motion\",\n      desc: \"Chauff\303\251e \303\240 douce temp\303\251rature, la cire pure de soja incorpore les parfums avant d\'\303\252tre vers\303\251e lentement \303\240 la main dans des contenants exclusifs.\",\n      icon: <Flame className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      num: \"3\",\n      title: \"Ornementation botanique\",\n      desc: \"Avant que la cire ne se fige compl\303\250tement, de v\303\251ritables fleurs s\303\251ch\303\251es, boutons de rose et herbiers locaux sont pinc\303\251s un par un sur la surface.\",\n      icon: <PenTool className=\"w-5 h-5 text-brand-pink\" />\n    },\n    {\n      num: \"4\",\n      title: \"Sceau et \303\251crin\",\n      desc: \"Chaque pi\303\250ce s\303\250che paisiblement pendant 48 heures minimum. Elle est ensuite v\303\251rifi\303\251e, polie, flanqu\303\251e de lin et envelopp\303\251e soigneusement pour l\'envoi.\",\n      icon: <PackageOpen className=\"w-5 h-5 text-brand-pink\" />\n    }\n  ];\n\n  const handleWhatsAppStoryContact = () => {\n    const textMsg = encodeURIComponent(\n      \"Bonjour M\303\251lanie et Christelle, je viens de lire l\'histoire de R\303\252ve Parfum\303\251 Cr\303\251ation et j\'aimerais beaucoup commander une cr\303\251ation artisanale !\"\n    );\n    window.open(`https://wa.me/33600000000?text=${textMsg}`, \'_blank\', \'noreferrer,noopener\');\n  };\n\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    show: {\n      opacity: 1,\n      transition: { staggerChildren: 0.08 }\n    }\n  };\n\n  const itemVariants = {\n    hidden: { opacity: 0, y: 20 },\n    show: { opacity: 1, y: 0, transition: { type: \"spring\", stiffness: 100 } }\n  };\n\n  return (\n    <div className=\"space-y-24 pb-16 text-left\" id=\"about-page-root\">\n      \n      {/* 1. HERO \303\200 PROPOS */}\n      <section className=\"text-center space-y-6 relative max-w-4xl mx-auto py-12 px-4\">\n        <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-brand-pink/10 rounded-full blur-[70px] pointer-events-none\" />\n        \n        <div className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand-pink/10 border border-brand-pink/20 text-brand-pink text-xs font-mono font-bold uppercase tracking-widest leading-none\">\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          Atelier Artisanal Bourgogne\n        </div>\n\n        <h1 className=\"text-4xl md:text-6xl font-serif font-bold text-brand-cream tracking-tight leading-none\">\n          Derri\303\250re R\303\252ve Parfum\303\251 Cr\303\251ation, <br />\n          <span className=\"font-light italic text-brand-purple\">deux passionn\303\251es</span> du fait main\n        </h1>\n\n        <p className=\"text-sm md:text-base text-brand-text-muted leading-relaxed max-w-2xl mx-auto font-light\">\n          M\303\251lanie et Christelle imaginent, con\303\247oivent et fabriquent des cr\303\251ations parfum\303\251es po\303\251tiques, naturelles et enti\303\250rement personnalisables au gr\303\251 de vos inspirations.\n        </p>\n\n        <div className=\"flex flex-wrap items-center justify-center gap-4 pt-4\">\n          <button\n            onClick={onNavigateToBoutique}\n            className=\"px-6 py-3.5 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md flex items-center gap-1.5 cursor-pointer hover:-translate-y-0.5\"\n          >\n            D\303\251couvrir la boutique\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n          <button\n            onClick={onNavigateToContact}\n            className=\"px-6 py-3.5 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 font-bold text-xs tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer\"\n          >\n            Nous contacter\n            <MessageSquare className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </section>\n\n      {/* 2. HISTOIRE DE LA MARQUE */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        \n        {/* Story details */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Notre Gen\303\250se</span>\n          <h2 className=\"text-3xl md:text-4xl font-serif font-bold text-brand-cream\">\n            Une histoire de senteurs, de mati\303\250res et de patience\n          </h2>\n\n          <p className=\"text-xs md:text-sm text-brand-text-muted leading-relaxed font-light\">\n            Bienvenue dans notre havre olfactif. <span className=\"text-brand-pink font-semibold\">R\303\252ve Parfum\303\251 Cr\303\251ation</span> a \303\251clos d\'un r\303\252ve partag\303\251 par deux amies unies par le plaisir des textures et de l\'harmonie florale. Notre ambition \303\251tait humble mais essentielle : recr\303\251er des bougies et cr\303\251ations parfum\303\251es saines, sans fum\303\251es nocives ni artifices froids, qui subliment l\'instant pr\303\251sent.\n          </p>\n\n          <p className=\"text-xs md:text-sm text-brand-text-muted leading-relaxed font-light\">\n            Chaque objet que nous exp\303\251dions est pens\303\251 comme une d\303\251licate intention : \303\240 s\'offrir pour un retour au calme chez soi, ou \303\240 partager lors de vos plus pr\303\251cieux mariages et f\303\252tes de famille. Nous marions la noblesse de la <span className=\"text-brand-pink font-medium\">cire de soja pure</span> \303\240 la cr\303\251ativit\303\251 des poteries model\303\251es \303\240 la main, pour que l\'\303\251tincelle soit aussi belle \303\251teinte qu\'allum\303\251e.\n          </p>\n\n          <div className=\"p-5 bg-brand-depth/60 border border-brand-pink/10 rounded-2xl relative\">\n            <h4 className=\"font-serif italic font-bold text-brand-cream text-base\">\"Un geste artisanal lent qui c\303\251l\303\250bre le beau.\"</h4>\n            <p className=\"text-[11px] text-brand-text-muted font-light mt-1.5 leading-relaxed\">\n              Nous n\'achetons aucun produit industriel pr\303\251-moul\303\251. De la fonte de la cire de soja jusqu\'\303\240 la d\303\251coupe d\303\251licate des herbiers de rose, nos doigts fa\303\247onnent chaque d\303\251tail pour parfaire l\'\303\251motion de vos cadeaux.\n            </p>\n          </div>\n        </div>\n\n        {/* Custom Visual (Not generic) */}\n        <div className=\"lg:col-span-5 grid grid-cols-2 gap-4 relative\">\n          <div className=\"space-y-4\">\n            <div className=\"rounded-[28px] overflow-hidden border border-brand-pink/15 aspect-[4/5] bg-brand-depth/40 relative group shadow-lg\">\n              <img \n                src=\"https://images.unsplash.com/photo-1603006905393-0d4862594bc0?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Coulage manuel de la cire\" \n                className=\"w-full h-full object-cover filter transition-transform duration-500 group-hover:scale-105\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-brand-bg/90 to-transparent opacity-40\" />\n            </div>\n            <div className=\"rounded-[24px] overflow-hidden border border-brand-pink/10 aspect-square bg-brand-depth/30 shadow-inner\">\n              <img \n                src=\"https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Arrangement d\303\251licat de fleurs s\303\251ch\303\251es\" \n                className=\"w-full h-full object-cover filter sepia-[15%]\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n          </div>\n          \n          <div className=\"space-y-4 pt-8\">\n            <div className=\"rounded-[24px] overflow-hidden border border-brand-pink/10 aspect-square bg-brand-depth/30 shadow-inner\">\n              <img \n                src=\"https://images.unsplash.com/photo-1540324155974-75220213450f?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Poterie de contenu unique pour cire\" \n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n            <div className=\"rounded-[28px] overflow-hidden border border-brand-pink/15 aspect-[4/5] bg-brand-depth/40 relative group shadow-lg\">\n              <img \n                src=\"https://images.unsplash.com/photo-1588854337236-6889d631faa8?auto=format&fit=crop&w=400&q=80\" \n                alt=\"Finition lin bio et emballage\" \n                className=\"w-full h-full object-cover filter brightness-[90%]\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-brand-bg/90 to-transparent opacity-40\" />\n            </div>\n          </div>\n\n          <div className=\"absolute -z-10 bg-brand-pink/5 filter blur-[50px] rounded-full inset-0 m-6 pointer-events-none\" />\n        </div>\n\n      </section>\n\n      {/* 3. PR\303\211SENTATION M\303\211LANIE & CHRISTELLE */}\n      <section className=\"space-y-10\">\n        <div className=\"text-center space-y-2\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Portraits d\'Atelier</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Vos cr\303\251atrices en Bourgogne\n          </h2>\n          <p className=\"text-xs text-brand-text-muted max-w-sm mx-auto\">\n            Chaque commande passe directement entre nos quatre mains bienveillantes.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto\">\n          \n          {/* Portrait Card M\303\251lanie */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-[32px] p-6 text-left relative overflow-hidden flex flex-col justify-between group hover:border-brand-pink/30 hover:bg-brand-depth/65 transition-all duration-300\">\n            <div className=\"space-y-4\">\n              <div className=\"relative w-28 h-28 rounded-2xl overflow-hidden border border-brand-pink/15 bg-brand-bg shrink-0\">\n                <img \n                  src=\"https://images.unsplash.com/photo-1544005313-94ddf0286df2??auto=format&fit=crop&w=200&q=80\" \n                  alt=\"M\303\251lanie - R\303\252ve Parfum\303\251\" \n                  className=\"w-full h-full object-cover filter brightness-[96%] contrast-[105%]\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 bg-brand-pink/10 mixture-overlay\" />\n              </div>\n\n              <div className=\"space-y-1\">\n                <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-pink font-semibold\">Le Nez de l\'Atelier</span>\n                <h3 className=\"text-xl font-serif font-bold text-brand-cream\">M\303\251lanie</h3>\n                <p className=\"text-[11px] text-brand-purple font-mono uppercase\">Harmonie olfactive &amp; Botanique</p>\n              </div>\n\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Passionn\303\251e par le pouvoir insoup\303\247onn\303\251 des odeurs sur la m\303\251moire, M\303\251lanie \303\251tudie les \303\251quilibres d\'accords aromatiques et s\303\251lectionne les plantes s\303\251ch\303\251es. Elle s\'assure que chaque fondant ou bougie exhale un sillage d\'une \303\251l\303\251gance absolue sans aucune trace de CMR.\n              </p>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-brand-pink/5 flex items-center gap-2 text-[10px] font-mono text-brand-text-muted/70\">\n              <Check className=\"w-3.5 h-3.5 text-brand-pink\" />\n              Signature : Fleur de Cerisier &amp; Douceur de Cocon\n            </div>\n          </div>\n\n          {/* Portrait Card Christelle */}\n          <div className=\"bg-brand-depth/40 border border-brand-pink/10 rounded-[32px] p-6 text-left relative overflow-hidden flex flex-col justify-between group hover:border-brand-pink/30 hover:bg-brand-depth/65 transition-all duration-300\">\n            <div className=\"space-y-4\">\n              <div className=\"relative w-28 h-28 rounded-2xl overflow-hidden border border-brand-pink/15 bg-brand-bg shrink-0\">\n                <img \n                  src=\"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=200&q=80\" \n                  alt=\"Christelle - R\303\252ve Parfum\303\251\" \n                  className=\"w-full h-full object-cover filter brightness-[96%] contrast-[105%]\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 bg-brand-pink/10 mixture-overlay\" />\n              </div>\n\n              <div className=\"space-y-1\">\n                <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-pink font-semibold\">L\'Artisane Styliste</span>\n                <h3 className=\"text-xl font-serif font-bold text-brand-cream\">Christelle</h3>\n                <p className=\"text-[11px] text-brand-purple font-mono uppercase\">Moulage &amp; Contenants C\303\251ramiques</p>\n              </div>\n\n              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n                Fascin\303\251e par la noblesse des mati\303\250res brutes, Christelle prend soin de la pr\303\251paration physique des supports. Du tour de c\303\251ramiste jusqu\'\303\240 la d\303\251coupe des lin de protection ou des mini cadres, elle apporte cette pr\303\251cision gestuelle qui sublime le packaging et la long\303\251vit\303\251 de notre cire saine.\n              </p>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-brand-pink/5 flex items-center gap-2 text-[10px] font-mono text-brand-text-muted/70\">\n              <Check className=\"w-3.5 h-3.5 text-brand-pink\" />\n              Signature : C\303\251ramique Divine &amp; Caramel Beurre Sal\303\251\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n      {/* 4. FABRICATION - LE PROCESS EN 4 \303\211TAPES */}\n      <section className=\"bg-brand-depth/25 border-y border-brand-pink/10 py-16 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8\">\n        <div className=\"max-w-5xl mx-auto space-y-12\">\n          \n          <div className=\"text-left max-w-2xl space-y-2\">\n            <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">L\'Art du Temps</span>\n            <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n              Le parcours d\'une cr\303\251ation parfum\303\251e\n            </h2>\n            <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">\n              De l\'intention brute \303\240 votre colis \303\251tincelant, chaque pi\303\250ce n\303\251cessite un respect strict de notre rituel de fabrication artisanal.\n            </p>\n          </div>\n\n          {/* Steps Timeline Grid */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-2\">\n            {steps.map((st, idx) => (\n              <div \n                key={idx}\n                className=\"p-6 bg-brand-depth border border-brand-pink/5 rounded-2xl space-y-4 hover:border-brand-pink/20 transition-all flex flex-col justify-between group\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-2xl font-mono font-bold text-brand-pink/20 group-hover:text-brand-pink/40 transition-colors\">\n                      {st.num}\n                    </span>\n                    <span className=\"p-2 bg-brand-bg rounded-xl border border-brand-pink/10 flex items-center justify-center shrink-0\">\n                      {st.icon}\n                    </span>\n                  </div>\n                  <h3 className=\"font-serif font-bold text-sm text-brand-cream\">{st.title}</h3>\n                  <p className=\"text-[11px] text-brand-text-muted leading-relaxed font-light\">{st.desc}</p>\n                </div>\n                <div className=\"pt-2 border-t border-brand-pink/5 text-[9px] font-mono text-brand-pink/60\">\n                  \303\211tape indispensable\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Material Pills / Mati\303\250res nobles */}\n          <div className=\"p-6 bg-brand-depth/40 border border-brand-pink/10 rounded-2xl text-left space-y-4\">\n            <h4 className=\"font-serif font-semibold text-xs uppercase tracking-wider text-brand-cream\">Nos mati\303\250res de pr\303\251dilection :</h4>\n            <div className=\"flex flex-wrap gap-2.5\">\n              <span className=\"px-3.5 py-1.5 rounded-full bg-brand-bg border border-brand-pink/10 text-[10px] font-mono text-brand-text-muted\">\n                \360\237\214\261 Pure Cire de Soja v\303\251g\303\251tale biod\303\251gradable\n              </span>\n              <span className=\"px-3.5 py-1.5 rounded-full bg-brand-bg border border-brand-pink/10 text-[10px] font-mono text-brand-text-muted\">\n                \360\237\214\271 V\303\251ritables boutons de rose &amp; Lavande de Provence\n              </span>\n              <span className=\"px-3.5 py-1.5 rounded-full bg-brand-bg border border-brand-pink/10 text-[10px] font-mono text-brand-text-muted\">\n                \360\237\217\272 Gr\303\250s d\'art &amp; c\303\251ramiques tourn\303\251es en Bourgogne\n              </span>\n              <span className=\"px-3.5 py-1.5 rounded-full bg-brand-bg border border-brand-pink/10 text-[10px] font-mono text-brand-text-muted\">\n                \360\237\215\203 Huiles de Grasse garanties sans phtalates ni CMR\n              </span>\n              <span className=\"px-3.5 py-1.5 rounded-full bg-brand-bg border border-brand-pink/10 text-[10px] font-mono text-brand-text-muted\">\n                \360\237\252\265 M\303\250ches de bois d\'\303\251rable naturel cr\303\251pitantes\n              </span>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n      {/* 5. VALEURS GRID (6 CARTES BENTO UNIQUE) */}\n      <section className=\"space-y-12\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Nos 6 piliers</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Engag\303\251es pour un art de vivre sinc\303\250re\n          </h2>\n          <p className=\"text-xs text-brand-text-muted max-w-sm mx-auto leading-relaxed\">\n            En choisissant R\303\252ve Parfum\303\251 Cr\303\251ation, vous encouragez des engagements nobles, sains et respectueux de la sant\303\251 de votre demeure.\n          </p>\n        </div>\n\n        <motion.div \n          variants={containerVariants}\n          initial=\"hidden\"\n          whileInView=\"show\"\n          viewport={{ once: true, margin: \"-100px\" }}\n          className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\"\n        >\n          {values.map((v, i) => (\n            <motion.div \n              key={i} \n              variants={itemVariants}\n              className=\"p-6 bg-brand-depth/40 border border-brand-pink/10 rounded-2xl hover:border-brand-pink/30 hover:bg-brand-depth/60 transition-all duration-300 text-left space-y-3 relative group\"\n            >\n              <div className=\"w-10 h-10 rounded-xl bg-brand-pink/10 flex items-center justify-center border border-brand-pink/15\">\n                {v.icon}\n              </div>\n              <h3 className=\"font-serif font-bold text-base text-brand-cream tracking-wide\">{v.title}</h3>\n              <p className=\"text-xs text-brand-text-muted font-light leading-relaxed\">{v.desc}</p>\n            </motion.div>\n          ))}\n        </motion.div>\n      </section>\n\n      {/* 6. GALERIE DE L\'ATELIER (ASYMETRIC GRID WITH CAPTIONS) */}\n      <section className=\"space-y-8\">\n        <div className=\"text-left border-b border-brand-pink/10 pb-4\">\n          <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Instants d\'Atelier</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Captures de notre quotidien cr\303\251atif\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 pt-2\">\n          \n          <div className=\"md:col-span-4 rounded-3xl overflow-hidden border border-brand-pink/10 relative group h-80 shadow-md\">\n            <img \n              src=\"https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=500&q=80\" \n              alt=\"Moulage des herbiers fleuris\" \n              className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-brand-bg/90 via-brand-bg/40 to-transparent p-5 flex flex-col justify-end text-left\">\n              <span className=\"text-[9px] font-mono uppercase tracking-widest text-brand-pink font-bold\">Inspiration</span>\n              <h4 className=\"font-serif font-bold text-sm text-brand-cream\">Harmonie des fleurs s\303\251ch\303\251es</h4>\n            </div>\n          </div>\n\n          <div className=\"md:col-span-8 rounded-3xl overflow-hidden border border-brand-pink/10 relative group h-80 shadow-md\">\n            <img \n              src=\"https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=800&q=80\" \n              alt=\"Modelage du gr\303\250s c\303\251ramique\" \n              className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter brightness-[95%] sepia-[10%]\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-brand-bg/90 via-brand-bg/40 to-transparent p-5 flex flex-col justify-end text-left\">\n              <span className=\"text-[9px] font-mono uppercase tracking-widest text-brand-pink font-bold font-semibold\">C\303\251ramique</span>\n              <h4 className=\"font-serif font-bold text-sm text-brand-cream\">Tournage local de nos contenants</h4>\n            </div>\n          </div>\n\n          <div className=\"md:col-span-8 rounded-3xl overflow-hidden border border-brand-pink/10 relative group h-80 shadow-md\">\n            <img \n              src=\"https://images.unsplash.com/photo-1540324155974-75220213450f?auto=format&fit=crop&w=800&q=80\" \n              alt=\"Mesure m\303\251ticuleuse des fragrances\" \n              className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter brightness-[90%]\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-brand-bg/90 via-brand-bg/40 to-transparent p-5 flex flex-col justify-end text-left\">\n              <span className=\"text-[9px] font-mono uppercase tracking-widest text-brand-pink font-bold font-semibold\">Parfumerie</span>\n              <h4 className=\"font-serif font-bold text-sm text-brand-cream\">Savoir-faire grassois</h4>\n            </div>\n          </div>\n\n          <div className=\"md:col-span-4 rounded-3xl overflow-hidden border border-brand-pink/10 relative group h-80 shadow-md\">\n            <img \n              src=\"https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=500&q=80\" \n              alt=\"Finitions des \303\251tuis en tissu de lin\" \n              className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter brightness-[95%]\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-brand-bg/90 via-brand-bg/40 to-transparent p-5 flex flex-col justify-end text-left\">\n              <span className=\"text-[9px] font-mono uppercase tracking-widest text-brand-pink font-bold font-semibold\">Exp\303\251dition</span>\n              <h4 className=\"font-serif font-bold text-sm text-brand-cream\">Lin de lin &amp; Kraft protecteurs</h4>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n      {/* 7. CTA FINAL FOR ABOUT PAGE */}\n      <section className=\"text-center bg-brand-depth/40 border border-brand-pink/10 rounded-3xl p-8 md:p-12 space-y-6 max-w-3xl mx-auto relative overflow-hidden\">\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-brand-pink/5 rounded-full blur-[90px] pointer-events-none\" />\n        <span className=\"text-[10px] uppercase tracking-widest font-mono text-brand-pink font-bold\">Un voyage sensoriel unique</span>\n        <h3 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n          Envie d\342\200\231essayer vos premi\303\250res senteurs ?\n        </h3>\n        <p className=\"text-xs text-brand-text-muted max-w-md mx-auto leading-relaxed\">\n          Que ce soit pour un coup de foudre en salon, une brume d\'oreiller enveloppante ou des cadeaux marquants d\'invit\303\251s, Christelle et M\303\251lanie sont \303\240 votre \303\251coute.\n        </p>\n        <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-center gap-4\">\n          <button\n            onClick={onNavigateToBoutique}\n            className=\"px-6 py-3 rounded-full bg-brand-pink text-brand-bg hover:bg-brand-pink-hover font-bold text-xs tracking-wider uppercase transition-all shadow-md flex items-center gap-1.5 cursor-pointer w-full sm:w-auto justify-center hover:-translate-y-0.5\"\n          >\n            D\303\251couvrir le Catalogue\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n          <button\n            onClick={handleWhatsAppStoryContact}\n            className=\"px-6 py-3 rounded-full bg-brand-depth text-brand-pink hover:bg-white/5 border border-brand-pink/20 font-bold text-xs tracking-wider uppercase transition-all flex items-center gap-1.5 cursor-pointer w-full sm:w-auto justify-center\"\n          >\n            <MessageSquare className=\"w-4 h-4\" />\n            Commander sur WhatsApp\n          </button>\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
    }
