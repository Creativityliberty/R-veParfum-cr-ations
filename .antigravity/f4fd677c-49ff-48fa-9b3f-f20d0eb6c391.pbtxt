          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <LegalSection id=\"cgv-10\" title=\"10. Litiges &amp; Droit applicable\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    Les pr\303\251sentes CGV d\'artisanat sont r\303\251gies par la loi fran\303\247aise. En cas de discorde ou d\'insatisfaction :"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  </p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    Une solution amiable et respectueuse est toujours privil\303\251gi\303\251e en premier ressort. \303\200 d\303\251faut d\'accord direct, le litige sera soumis \303\240 la m\303\251diation ou port\303\251 devant les tribunaux comp\303\251tents de la juridiction de l\'atelier du vendeur."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
