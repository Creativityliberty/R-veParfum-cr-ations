          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <strong className=\"text-brand-cream\">Donn\303\251es Civiles :</strong>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <p className=\"text-[11px] text-brand-text-muted\">Nom, pr\303\251nom et coordonn\303\251es de contact choisis pour formuler votre nom sur les colis.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <div className=\"p-4 bg-brand-bg/50 border border-brand-pink/5 rounded-xl text-xs space-y-1\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
