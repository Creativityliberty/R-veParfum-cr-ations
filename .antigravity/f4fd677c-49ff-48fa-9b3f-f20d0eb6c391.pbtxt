  file_change {
    absolute_path_uri: "file:///src/components/HeroVideo.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport { homePageConfig } from \'../config/homePageConfig\';\n\ninterface HeroVideoProps {\n  videoUrl: string;\n  posterUrl: string;\n  fallbackImageUrl: string;\n}\n\nexport default function HeroVideo({ videoUrl, posterUrl, fallbackImageUrl }: HeroVideoProps) {\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const [opacity, setOpacity] = useState(0);\n  const [hasError, setHasError] = useState(false);\n  const configFade = homePageConfig.motion.heroVideoFade;\n\n  useEffect(() => {\n    const video = videoRef.current;\n    if (!video) return;\n\n    if (window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches) {\n      setOpacity(1);\n      return;\n    }\n\n    const handleCanPlay = () => {\n      video.play().catch(() => {\n        // Handle autoplay blocking gently\n      });\n      // Fade-in over configured ms\n      let start: number | null = null;\n      const animateFadeIn = (timestamp: number) => {\n        if (!start) start = timestamp;\n        const progress = (timestamp - start) / configFade.fadeInMs;\n        if (progress < 1) {\n          setOpacity(progress);\n          requestAnimationFrame(animateFadeIn);\n        } else {\n          setOpacity(1);\n        }\n      };\n      requestAnimationFrame(animateFadeIn);\n    };\n\n    const handleTimeUpdate = () => {\n      const remainingTime = video.duration - video.currentTime;\n      // Start fade out slightly before the end, if enabled\n      if (configFade.enabled && remainingTime <= configFade.endFadeThreshold) {\n        setOpacity(Math.max(0, remainingTime / configFade.endFadeThreshold));\n      }\n    };\n\n    const handleEnded = () => {\n      setOpacity(0);\n      setTimeout(() => {\n        if (video) {\n          video.currentTime = 0;\n          video.play().catch(() => {});\n          setOpacity(1);\n        }\n      }, configFade.restartDelayMs);\n    };\n\n    video.addEventListener(\'canplay\', handleCanPlay);\n    video.addEventListener(\'timeupdate\', handleTimeUpdate);\n    video.addEventListener(\'ended\', handleEnded);\n\n    return () => {\n      video.removeEventListener(\'canplay\', handleCanPlay);\n      video.removeEventListener(\'timeupdate\', handleTimeUpdate);\n      video.removeEventListener(\'ended\', handleEnded);\n    };\n  }, [configFade]);\n\n  return (\n    <div className=\"absolute inset-0 w-full h-full pointer-events-none select-none z-0\">\n      {!hasError ? (\n        <video\n          ref={videoRef}\n          src={videoUrl}\n          poster={posterUrl}\n          autoPlay\n          muted\n          playsInline\n          loop={!configFade.enabled}\n          aria-hidden=\"true\"\n          onError={() => setHasError(true)}\n          style={{ opacity, transition: \'opacity 0.6s ease\' }}\n          className=\"absolute inset-0 w-full h-full object-cover\"\n        />\n      ) : (\n        <img\n          src={fallbackImageUrl}\n          alt=\"Atelier R\303\252ve Parfum\303\251\"\n          className=\"absolute inset-0 w-full h-full object-cover opacity-60\"\n          referrerPolicy=\"no-referrer\"\n        />\n      )}\n\n      {/* Atmospheric overlays layered together to prevent flat styling */}\n      <div className=\"absolute inset-0 bg-gradient-to-b from-brand-bg/35 via-brand-bg/20 to-brand-bg transition-all\" />\n      <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,transparent_0%,rgba(42,27,34,0.35)_60%,rgba(42,27,33,0.85)_100%)]\" />\n\n      {/* Wax glow ellipse backdrop behind main header */}\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80vw] max-w-[960px] h-[350px] md:h-[500px] bg-amber-400/5 rounded-full filter blur-[90px] pointer-events-none transition-all duration-1000\" />\n    </div>\n  );\n}\n"
    }
