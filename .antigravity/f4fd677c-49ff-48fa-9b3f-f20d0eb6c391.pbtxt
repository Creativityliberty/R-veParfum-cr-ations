          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <li><strong>Pr\303\251cision G\303\251ographique :</strong> Notre adresse professionnelle est partag\303\251e chaleureusement lors du r\303\251capitulatif de commande ;</li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
