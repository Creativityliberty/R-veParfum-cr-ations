          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <p>\360\237\223\270 <strong>\303\211tape 1 :</strong> Photographiez imm\303\251diatement l\'\303\251tiquette d\'envoi et les bris \303\240 l\'int\303\251rieur de la bo\303\256te avant d\303\251ballage complet.</p>"
