    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Mail, PhoneCall, HelpCircle, ShoppingBag, MapPin, Clock, MessageSquare, Palette, Sparkles, Send } from \'lucide-react\';\n\ninterface ContactPageProps {\n  setCurrentTab: (tab: string) => void;\n  onSuccess: (text: string) => void;\n}\n\nexport default function ContactPage({ setCurrentTab, onSuccess }: ContactPageProps) {\n  const [formData, setFormData] = useState({\n    name: \'\',\n    phone: \'\',\n    subject: \'Question g\303\251n\303\251rale\',\n    message: \'\'\n  });\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({ ...prev, [name]: value }));\n  };\n\n  const handleWhatsAppSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.name || !formData.message) {\n      onSuccess(\"Veuillez renseigner votre nom et votre message de contact. \360\237\230\212\");\n      return;\n    }\n\n    const compiledText = `Bonjour M\303\251lanie et Christelle, j\'ai une envie de contact :\nNom : ${formData.name}\nT\303\251l\303\251phone : ${formData.phone || \'Non renseign\303\251\'}\nSujet : ${formData.subject}\nMessage : ${formData.message}\n\nMerci \360\237\230\212`;\n\n    const encodedText = encodeURIComponent(compiledText);\n    const url = `https://wa.me/33600000000?text=${encodedText}`;\n    \n    onSuccess(\"Connexion directe avec notre atelier lanc\303\251e via WhatsApp... \360\237\214\270\");\n    window.open(url, \'_blank\', \'noreferrer,noopener\');\n  };\n\n  const handlePredefinedWhatsApp = (subject: string, msg: string) => {\n    const encoded = encodeURIComponent(msg);\n    window.open(`https://wa.me/33600000000?text=${encoded}`, \'_blank\', \'noreferrer,noopener\');\n    onSuccess(`Lancement de la demande : ${subject}`);\n  };\n\n  return (\n    <div className=\"space-y-16 pb-12\" id=\"contact-page-view\">\n      \n      {/* 1. Hero */}\n      <section className=\"text-center max-w-2xl mx-auto space-y-3\">\n        <span className=\"text-xs font-mono text-brand-pink uppercase tracking-widest font-bold\">Un Atelier \303\200 Votre \303\211coute</span>\n        <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-brand-cream\">\n          Une question ou une envie particuli\303\250re ?\n        </h1>\n        <p className=\"text-sm text-brand-text-muted leading-relaxed\">\n          Nous sommes toujours ravies d\'\303\251changer avec vous. \303\211vitez les formulaires froids de commerce classique : ici, le contact est direct, humain et passe par notre ligne WhatsApp pour vous conseiller au mieux !\n        </p>\n      </section>\n\n      {/* 2. Cartes de contact rapide */}\n      <section className=\"space-y-6\">\n        <h2 className=\"text-center font-serif font-bold text-xl text-brand-cream uppercase tracking-wide\">\n          Comment pouvons-nous vous aider aujourd\'hui ?\n        </h2>\n        \n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n          \n          <button \n            onClick={() => handlePredefinedWhatsApp(\n              \"Demande de Commande\", \n              \"Bonjour R\303\252ve Parfum\303\251 ! Je viens de parcourir votre catalogue d\'atelier et je souhaite prendre conseil pour commander des produits s\'il vous pla\303\256t. \360\237\230\212\"\n            )}\n            className=\"p-5 bg-brand-depth border border-brand-pink/5 hover:border-brand-pink/30 rounded-2xl text-center space-y-3 flex flex-col justify-between items-center transition-all cursor-pointer group\"\n          >\n            <div className=\"p-3 bg-brand-pink/10 rounded-full text-brand-pink group-hover:scale-110 transition-transform\">\n              <ShoppingBag className=\"w-5 h-5\" />\n            </div>\n            <div className=\"space-y-1\">\n              <h3 className=\"font-serif font-bold text-sm text-brand-cream\">Commander un Produit</h3>\n              <p className=\"text-[10px] text-brand-text-muted font-light leading-normal\">\n                Discutons de vos cr\303\251ations de cire pr\303\251f\303\251r\303\251es en direct.\n              </p>\n            </div>\n            <span className=\"text-[10px] font-mono text-brand-pink uppercase font-semibold\">Parler WhatsApp \342\236\224</span>\n          </button>\n\n          <button \n            onClick={() => {\n              setCurrentTab(\'personnalisation\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"p-5 bg-brand-depth border border-brand-pink/5 hover:border-brand-pink/30 rounded-2xl text-center space-y-3 flex flex-col justify-between items-center transition-all cursor-pointer group\"\n          >\n            <div className=\"p-3 bg-brand-pink/10 rounded-full text-brand-pink group-hover:scale-110 transition-transform\">\n              <Palette className=\"w-5 h-5\" />\n            </div>\n            <div className=\"space-y-1\">\n              <h3 className=\"font-serif font-bold text-sm text-brand-cream\">Demander une Personnalisation</h3>\n              <p className=\"text-[10px] text-brand-text-muted font-light leading-normal\">\n                Choisissez senteur, couleur et packaging unique.\n              </p>\n            </div>\n            <span className=\"text-[10px] font-mono text-brand-pink uppercase font-semibold\">Voir le module \342\236\224</span>\n          </button>\n\n          <button \n            onClick={() => {\n              setCurrentTab(\'evenements\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"p-5 bg-brand-depth border border-brand-pink/5 hover:border-brand-pink/30 rounded-2xl text-center space-y-3 flex flex-col justify-between items-center transition-all cursor-pointer group\"\n          >\n            <div className=\"p-3 bg-brand-pink/10 rounded-full text-brand-pink group-hover:scale-110 transition-transform\">\n              <Sparkles className=\"w-5 h-5\" />\n            </div>\n            <div className=\"space-y-1\">\n              <h3 className=\"font-serif font-bold text-sm text-brand-cream\">Devis Mariage / \303\211v\303\251nement</h3>\n              <p className=\"text-[10px] text-brand-text-muted font-light leading-normal\">\n                Commande de gros volumes ou cadeaux d\'invit\303\251s fleuris.\n              </p>\n            </div>\n            <span className=\"text-[10px] font-mono text-brand-pink uppercase font-semibold\">Estimer devis \342\236\224</span>\n          </button>\n\n          <button \n            onClick={() => {\n              setCurrentTab(\'reunions\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"p-5 bg-brand-depth border border-brand-pink/5 hover:border-brand-pink/30 rounded-2xl text-center space-y-3 flex flex-col justify-between items-center transition-all cursor-pointer group\"\n          >\n            <div className=\"p-3 bg-brand-pink/10 rounded-full text-brand-pink group-hover:scale-110 transition-transform\">\n              <MessageSquare className=\"w-5 h-5\" />\n            </div>\n            <div className=\"space-y-1\">\n              <h3 className=\"font-serif font-bold text-sm text-brand-cream\">R\303\251union \303\240 Domicile</h3>\n              <p className=\"text-[10px] text-brand-text-muted font-light leading-normal\">\n                Organiser un moment convivial olfactif entre amies.\n              </p>\n            </div>\n            <span className=\"text-[10px] font-mono text-brand-pink uppercase font-semibold\">R\303\251server date \342\236\224</span>\n          </button>\n\n          <button \n            onClick={() => {\n              setCurrentTab(\'livraison\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"p-5 bg-brand-depth border border-brand-pink/5 hover:border-brand-pink/30 rounded-2xl text-center space-y-3 flex flex-col justify-between items-center transition-all cursor-pointer group\"\n          >\n            <div className=\"p-3 bg-brand-pink/10 rounded-full text-brand-pink group-hover:scale-110 transition-transform\">\n              <HelpCircle className=\"w-5 h-5\" />\n            </div>\n            <div className=\"space-y-1\">\n              <h3 className=\"font-serif font-bold text-sm text-brand-cream\">Question Livraison & Info</h3>\n              <p className=\"text-[10px] text-brand-text-muted font-light leading-normal\">\n                D\303\251lais de cure, transporteurs ou retrait de colis.\n              </p>\n            </div>\n            <span className=\"text-[10px] font-mono text-brand-pink uppercase font-semibold\">Lire les infos \342\236\224</span>\n          </button>\n\n        </div>\n      </section>\n\n      {/* 3. Formulaire de contact g\303\251n\303\251ral + Infos Pratiques */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Colonne gauche : Formulaire */}\n        <div className=\"lg:col-span-7 bg-brand-depth border border-brand-pink/15 rounded-3xl p-8 text-left space-y-6\">\n          <div className=\"space-y-1.5 border-b border-brand-pink/10 pb-4\">\n            <h3 className=\"font-serif font-bold text-2xl text-brand-cream\">\303\211crivez-nous</h3>\n            <p className=\"text-xs text-brand-text-muted\">\n              R\303\251digez votre message libre. Il sera converti en une demande ordonn\303\251e sur notre service de clavardage WhatsApp.\n            </p>\n          </div>\n\n          <form onSubmit={handleWhatsAppSubmit} className=\"space-y-5\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Votre Nom *</label>\n                <input \n                  type=\"text\" \n                  name=\"name\"\n                  required\n                  placeholder=\"Ex : Martine\"\n                  value={formData.name}\n                  onChange={handleInputChange}\n                  className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n              \n              <div>\n                <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Votre T\303\251l\303\251phone (Optionnel)</label>\n                <input \n                  type=\"tel\" \n                  name=\"phone\"\n                  placeholder=\"Ex : 0600000000\"\n                  value={formData.phone}\n                  onChange={handleInputChange}\n                  className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Sujet principal de demande</label>\n              <select\n                name=\"subject\"\n                value={formData.subject}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n              >\n                <option value=\"Question g\303\251n\303\251rale\">\342\234\211 Question g\303\251n\303\251rale sur les senteurs</option>\n                <option value=\"Suivi de commande de cire\">\360\237\223\246 Suivi ou d\303\251lai de ma commande</option>\n                <option value=\"Cr\303\251ation sp\303\251ciale \303\240 la demande\">\360\237\216\250 Projet de cr\303\251ation sp\303\251ciale \303\240 la pi\303\250ce</option>\n                <option value=\"Tarifs ou conditions de CE\">\360\237\222\274 Partenariats commercial, comit\303\251s ou boutiques revendeuses</option>\n                <option value=\"Partager une jolie id\303\251e\">\360\237\222\241 Signaler une id\303\251e constructive</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Votre Message *</label>\n              <textarea\n                name=\"message\"\n                required\n                rows={5}\n                placeholder=\"Racontez-nous tout...\"\n                value={formData.message}\n                onChange={handleInputChange}\n                className=\"w-full px-4 py-3 bg-brand-bg border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors resize-none\"\n              />\n            </div>\n\n            <button \n              type=\"submit\"\n              className=\"w-full py-4 bg-brand-pink text-brand-bg font-extrabold text-xs tracking-wider uppercase rounded-full hover:bg-brand-pink-hover transition-colors flex items-center justify-center gap-2 shadow-lg cursor-pointer\"\n            >\n              <Send className=\"w-3.5 h-3.5\" />\n              Envoyer sur WhatsApp\n            </button>\n          </form>\n        </div>\n\n        {/* Colonne droite : Infos de contact & carte d\'atelier */}\n        <div className=\"lg:col-span-5 space-y-6 text-left\">\n          \n          <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-4\">\n            <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2 pb-2 border-b border-brand-pink/5\">\n              <MapPin className=\"w-5 h-5 text-brand-pink\" />\n              O\303\271 sommes-nous situ\303\251es ?\n            </h3>\n            <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n              Notre chaleureux atelier d\'artisanat se trouve en <span className=\"text-brand-cream font-medium\">Bourgogne, France</span>. C\'est \303\240 partir de cet espace baign\303\251 d\'odeurs de lavande et de pin que nous exp\303\251dions nos cr\303\251ations et accueillons les retraits d\'ateliers sur rendez-vous.\n            </p>\n            <div className=\"text-xs text-brand-pink font-mono leading-none\">\n              \360\237\223\215 Retrait gratuit d\'atelier : Bourgogne-Franche-Comt\303\251\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-4\">\n            <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2 pb-2 border-b border-brand-pink/5\">\n              <Clock className=\"w-5 h-5 text-brand-pink\" />\n              R\303\251activit\303\251 & R\303\251ponse\n            </h3>\n            <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n              Parce que nous pr\303\251parons vos cr\303\251ations de nos propres mains, notre temps est parfois partag\303\251 entre cires et parfums. Cependant, nous r\303\251pondons \303\240 100% de vos messages WhatsApp <span className=\"text-brand-pink font-medium\">sous moins de 24 heures</span> en moyenne.\n            </p>\n            <div className=\"text-xs text-brand-purple font-mono leading-none\">\n              \360\237\225\234 Dispo chat : Lundi au Samedi (9h - 19h)\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl space-y-4\">\n            <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2 pb-2 border-b border-brand-pink/5\">\n              <Mail className=\"w-5 h-5 text-brand-pink\" />\n              Courrier \303\251lectronique principal\n            </h3>\n            <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">\n              Pour des demandes formelles de devis d\'entreprise (CE) ou de facturations officielles, vous pouvez \303\251galement joindre Christelle ou M\303\251lanie \303\240 cette adresse :\n            </p>\n            <a \n              href=\"mailto:contact@reveparfume.fr\" \n              className=\"text-xs text-brand-pink font-mono font-bold hover:underline block\"\n            >\n              \342\234\211 contact@reveparfume.fr\n            </a>\n          </div>\n\n        </div>\n\n      </section>\n\n    </div>\n  );\n}\n"
    }
