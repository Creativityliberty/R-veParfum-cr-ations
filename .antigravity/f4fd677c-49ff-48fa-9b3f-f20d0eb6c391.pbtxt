e=\"Caramel beurre sal\303\251\">\360\237\245\236 Caramel beurre sal\303\251</option>\n                      <option value=\"Fleur de Cerisier\">\360\237\214\270 Fleur de Cerisier</option>\n                      <option value=\"Lavande de Provence\">\360\237\214\276 Lavande de Provence</option>\n                      <option value=\"Eucalyptus & Menthe\">\360\237\214\277 Eucalyptus & Menthe</option>\n                      <option value=\"Ambre Imp\303\251rial\">\360\237\224\245 Ambre Imp\303\251rial</option>\n                      <option value=\"Mono\303\257 Absolu\">\360\237\245\245 Mono\303\257 Absolu</option>\n                    </select>\n                  </div>\n\n                  {/* Order notification details */}\n                  <div className=\"flex items-center p-3 bg-brand-pink/5 rounded-xl border border-brand-pink/10\">\n                    <p className=\"text-[10px] text-brand-purple leading-normal font-light\">\n                      \360\237\214\237 Nous fonctionnons sous forme de catalogue-commande assist\303\251. Configurez vos senteurs, validez et notre bouton WhatsApp pr\303\251-rempira instantan\303\251ment votre message !\n                    </p>\n                  </div>\n\n                </div>\n\n                {/* Categories Horizontal Tabs */}\n                <div className=\"space-y-2\">\n                  <span className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest leading-none mb-3\">Filtrer par cat\303\251gorie</span>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {CATEGORIES.map((cat) => (\n                      <button\n                        key={cat}\n                        onClick={() => setSelectedCategory(cat)}\n                        className={`px-4.5 py-2 rounded-full text-xs font-medium tracking-wide transition-all cursor-pointer ${\n                          selectedCategory === cat \n                            ? \'bg-brand-pink text-brand-bg font-semibold shadow-md\' \n                            : \'bg-brand-bg/50 text-brand-text-muted border border-brand-pink/5 hover:border-brand-pink/30 hover:text-brand-cream\'\n                        }`}\n                      >\n                        {cat}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n              </div>"
      replacement_content: "              {/* Filters Panel Area */}\n              <div className=\"bg-brand-depth border border-brand-pink/10 rounded-3xl p-6 md:p-8 space-y-6\">\n                \n                {/* Search, Scents, and Custom Checkbox */}\n                <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n                  \n                  {/* Search text (Col span 4) */}\n                  <div className=\"md:col-span-4\">\n                    <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Rechercher une pi\303\250ce</label>\n                    <input \n                      type=\"text\" \n                      placeholder=\"Ex : Cerisier, bougie...\"\n                      value={searchQuery}\n                      onChange={(e) => setSearchQuery(e.target.value)}\n                      className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream placeholder-gray-500 focus:outline-none focus:border-brand-pink transition-colors\"\n                    />\n                  </div>\n\n                  {/* Scent filter (Col span 4) */}\n                  <div className=\"md:col-span-4\">\n                    <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Famille olfactive</label>\n                    <select\n                      value={scentFilter}\n                      onChange={(e) => setScentFilter(e.target.value)}\n                      className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                    >\n                      <option value=\"Tous\">Toutes les fragrances</option>\n                      <option value=\"Florale\">\360\237\214\270 Senteurs Florales</option>\n                      <option value=\"Fruit\303\251\">\360\237\215\223 Senteurs Fruit\303\251es</option>\n                      <option value=\"Gourmand\">\360\237\245\236 Senteurs Gourmandes</option>\n                      <option value=\"Frais / Herbac\303\251\">\360\237\215\203 Senteurs Fra\303\256ches & Bois\303\251es</option>\n                      <option value=\"Doux / Cocon\">\342\230\201\357\270\217 Notes Douces & Cocon</option>\n                    </select>\n                  </div>\n\n                  {/* Occasion Filter (Col span 4) */}\n                  <div className=\"md:col-span-4\">\n                    <label className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest mb-1.5\">Pour quelle occasion ?</label>\n                    <select\n                      value={occasionFilter}\n                      onChange={(e) => setOccasionFilter(e.target.value)}\n                      className=\"w-full px-4 py-3 bg-brand-bg/60 border border-brand-pink/15 rounded-xl text-xs text-brand-cream focus:outline-none focus:border-brand-pink transition-colors\"\n                    >\n                      <option value=\"Tous\">Toutes les occasions</option>\n                      <option value=\"Cadeau\">\360\237\216\201 Id\303\251e Cadeau Pr\303\251cieux</option>\n                      <option value=\"Mariage\">\360\237\221\260 Mariage &amp; C\303\251l\303\251bration</option>\n                      <option value=\"Maison\">\360\237\217\241 Parfum d\'Ambiance Int\303\251rieur</option>\n                      <option value=\"Voiture\">\360\237\232\227 Fra\303\256cheur en Voiture</option>\n                      <option value=\"D\303\251tente\">\360\237\247\230 Moment Rituel D\303\251tente</option>\n                    </select>\n                  </div>\n\n                </div>\n\n                {/* Categories and Extra Filters details */}\n                <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 pt-2 border-t border-brand-pink/5\">\n                  \n                  {/* Category Selection (Col span 7) */}\n                  <div className=\"lg:col-span-7 space-y-2\">\n                    <span className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest leading-none mb-2\">Filtrer par cat\303\251gorie</span>\n                    <div className=\"flex flex-wrap gap-2\">\n                      {CATEGORIES.map((cat) => (\n                        <button\n                          key={cat}\n                          onClick={() => setSelectedCategory(cat)}\n                          className={`px-4 py-2 rounded-full text-xs font-medium tracking-wide transition-all cursor-pointer ${\n                            selectedCategory === cat \n                              ? \'bg-brand-pink text-brand-bg font-semibold shadow-md\' \n                              : \'bg-brand-bg/50 text-brand-text-muted border border-brand-pink/5 hover:border-brand-pink/30 hover:text-brand-cream\'\n                          }`}\n                        >\n                          {cat}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Price budget slider (Col span 3) */}\n                  <div className=\"lg:col-span-3 space-y-2\">\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"block text-xs font-mono text-brand-text-muted uppercase tracking-widest leading-none\">Budget maximum</span>\n                      <span className=\"text-xs font-mono text-brand-pink font-bold\">{maxPrice} \342\202\254</span>\n                    </div>\n                    <input \n                      type=\"range\" \n                      min=\"5\" \n                      max=\"50\" \n                      step=\"2\" \n                      value={maxPrice} \n                      onChange={(e) => setMaxPrice(Number(e.target.value))}\n                      className=\"w-full accent-brand-pink cursor-pointer bg-brand-bg h-1 rounded-lg outline-none\"\n                    />\n                  </div>\n\n                  {/* Customizable Toggle Switch (Col span 2) */}\n                  <div className=\"lg:col-span-2 flex items-center justify-end\">\n                    <label className=\"flex items-center gap-2 cursor-pointer select-none\">\n                      <input \n                        type=\"checkbox\" \n                        checked={onlyCustomizable} \n                        onChange={(e) => setOnlyCustomizable(e.target.checked)}\n                        className=\"rounded border-brand-pink/15 text-brand-pink focus:ring-brand-pink bg-brand-bg w-4 h-4 accent-brand-pink\"\n                      />\n                      <span className=\"text-xs font-mono text-brand-text-muted uppercase tracking-wider\">Personnalisable</span>\n                    </label>\n                  </div>\n\n                </div>\n\n              </div>"
