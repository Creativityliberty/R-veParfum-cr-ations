          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              <LegalSection title=\"2. Propri\303\251t\303\251 &amp; Confidentialit\303\251 absolue\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                <p>Vos discussions ne quittent jamais notre fil WhatsApp priv\303\251 et ne sont sous aucun pr\303\251texte divulgu\303\251es ou c\303\251d\303\251es de mani\303\250re mercantile \303\240 des tiers, \303\240 l\'exception de l\'\303\251tiquette postale Colissimo ou Mondial Relay.</p>"
