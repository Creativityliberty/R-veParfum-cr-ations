    instruction: "Replace static examples list with rich white cards and integrate LifestyleCarousel within the Customization view"
    replacement_infos {
      original_chunk {
        target_content: "      {/* 4. Exemples d\'usages */}\n      <section className=\"space-y-10\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Inspirations pour vos instants de vie\n          </h2>\n          <p className=\"text-xs text-brand-text-muted\">\n            Laissez-vous charmer par les demandes les plus souvent formul\303\251es par notre aimable client\303\250le.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto\">\n          {examples.map((ex, i) => (\n            <div \n              key={i} \n              className=\"p-6 bg-brand-depth border border-brand-pink/10 rounded-2xl flex gap-4 items-start hover:border-brand-purple/20 transition-all text-left\"\n            >\n              <div className=\"p-3 bg-brand-bg/50 rounded-xl leading-none flex items-center justify-center shrink-0\">\n                {ex.icon}\n              </div>\n              <div className=\"space-y-1.5 flex-1\">\n                <h3 className=\"font-serif font-bold text-base text-brand-cream\">{ex.title}</h3>\n                <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">{ex.desc}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>"
        replacement_content: "      {/* 4. Carousel d\'Inspirations Interactif & Mises en situation */}\n      <section className=\"py-6 border-b border-brand-pink/10 pb-12\">\n        <LifestyleCarousel />\n      </section>\n\n      {/* 5. Exemples d\'usages avec Touch of White (Touches de Blanc) */}\n      <section className=\"space-y-10\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-brand-cream\">\n            Collections &amp; Formats Les Plus Demand\303\251s\n          </h2>\n          <p className=\"text-xs text-brand-text-muted\">\n            Laissez-vous charmer par les configurations artistiques et \303\251l\303\251gantes pl\303\251biscit\303\251es par notre client\303\250le distingu\303\251e.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto\">\n          {examples.map((ex, i) => (\n            <div \n              key={i} \n              className=\"p-6 bg-white border border-brand-pink/20 rounded-2xl flex gap-4 items-start shadow-xl hover:shadow-2xl transition-all text-left text-zinc-900 group relative overflow-hidden\"\n            >\n              {/* Subtle top light background border line */}\n              <div className=\"absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-pink to-brand-purple\" />\n              \n              <div className=\"p-3 bg-brand-bg/5 rounded-xl leading-none flex items-center justify-center shrink-0\">\n                {ex.icon}\n              </div>\n              <div className=\"space-y-1.5 flex-1 select-none\">\n                <span className=\"text-[9px] font-mono uppercase tracking-widest text-brand-purple font-bold\">Inspiration Artisanal</span>\n                <h3 className=\"font-serif font-bold text-lg text-zinc-900\">{ex.title}</h3>\n                <p className=\"text-xs text-zinc-600 leading-relaxed font-light\">{ex.desc}</p>\n                <div className=\"pt-2 text-[10px] font-mono text-zinc-500 flex items-center gap-1\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" /> Disponible pour votre projet\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>"
      }
      num_matches: 1
    }
  }
}
