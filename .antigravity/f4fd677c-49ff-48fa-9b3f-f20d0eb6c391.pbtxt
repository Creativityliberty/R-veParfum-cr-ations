        }
        lines {
          text: "              <h3 className=\"font-serif font-bold text-lg text-brand-cream flex items-center gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                <span className=\"text-brand-pink font-mono text-base font-bold\">\342\234\223</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                Inclusions botaniques cueillies"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              </h3>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              <p className=\"text-xs text-brand-text-muted leading-relaxed font-light\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                Les fleurs s\303\251ch\303\251es qui parent nos bouquets \303\240 rotin ou nos tablettes de cire suspendues proviennent d\'herbiers s\303\251lectionn\303\251s. P\303\251tales de rose, lavande bio, fleurs de camomille ou bl\303\251 champ\303\252tre sont plac\303\251s d\303\251licatement un par un."
